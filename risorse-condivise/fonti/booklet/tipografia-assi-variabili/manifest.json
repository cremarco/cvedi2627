{
  "schemaVersion": 1,
  "date": "2026-10-20",
  "purpose": "Clarify the five registered variation axes with paired authentic samples on the existing typography slide.",
  "construction": "Original diagram; all lettering is retained-font outlines. FontTools pins all axes to exact static instances, then CoreText shapes each exact source face. Only baseline translations and a y-axis reflection are used; no synthetic slant, stretching or weight. Transparent background and no frames.",
  "palette": {
    "ink": "#2c333f",
    "blue": "#17608b"
  },
  "rules": [
    "Both samples in every pair use the same nominal displayed body.",
    "Only the illustrated variation axis differs within each pair.",
    "The ital pair uses the true fvar ital axis of the combined Nunito font, not separate Roman/Italic files.",
    "The opsz pair changes the intended optical size while preserving the displayed body.",
    "The italic example does not claim a mandatory structural change to a or g."
  ],
