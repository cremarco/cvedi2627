      "texts": [
        {
          "id": "I3200:1328;3189:4585",
          "text": "¹",
          "parent": "I3200:1328;3320:13657"
        },
        {
          "id": "I3200:1328;3189:4586;3200:1335",
          "text": "Max Wertheimer, Untersuchungen zur Lehre von der Gestalt. II,\nPsychologische Forschung, vol. 4, 1923, pp. 301–350.",
          "parent": "I3200:1328;3189:4586"
        },
        {
          "id": "198:4249",
          "text": "le leggi della gestalt",
          "parent": "198:4238"
        },
        {
          "id": "I3039:240;3030:470;3039:244",
          "text": "Legge della vicinanza\n(proximity)",
          "parent": "I3039:240;3030:470"
        },
        {
          "id": "198:4246",
          "text": "A parità di altre condizioni, gli elementi più vicini tendono a essere percepiti come appartenenti a un gruppo.¹\n\nIl principio della vicinanza permette di organizzare i contenuti così che risultino più facilmente percepibili dagli utenti. È utile posizionare gli oggetti correlati l’uno vicino all’altro per creare una connessione poiché gli elementi più vicini tra loro, a parità di altre condizioni, vengono percepiti come appartenenti alla stessa unità.",
          "parent": "3708:2335"
        }
      ]
    },
    {
      "id": "198:4250",
