      "texts": [
        {
          "id": "I3200:1338;3189:4585",
          "text": "¹",
          "parent": "I3200:1338;3320:13657"
        },
        {
          "id": "I3200:1338;3189:4586;3200:1345",
          "text": "Max Wertheimer, Untersuchungen zur Lehre von der Gestalt. II,\nPsychologische Forschung, vol. 4, 1923, pp. 301–350.",
          "parent": "I3200:1338;3189:4586"
        },
        {
          "id": "198:4260",
          "text": "le leggi della gestalt",
          "parent": "198:4250"
        },
        {
          "id": "I3039:245;3030:470;3039:249",
          "text": "La legge della somiglianza\n(similarity)",
          "parent": "I3039:245;3030:470"
        },
        {
          "id": "198:4258",
          "text": "Gli elementi con caratteristiche visive simili, come dimensione, colore e forma, tendono a essere percepiti come appartenenti a un gruppo. ¹\n\nGli elementi vengono raggruppati visivamente se hanno somiglianze visive. Per creare somiglianze tra elementi simili si possono usare le stesse dimensioni, colori e forme.",
          "parent": "3708:2349"
        }
      ]
    },
    {
      "id": "198:4261",
      "children": [
        {
