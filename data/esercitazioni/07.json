  {
    "title": "Verificare il contrasto in entrambi i temi",
    "kind": "content",
    "blocks": [
      {
        "kind": "text",
        "paragraphs": [
          {
            "text": "Per il testo ordinario, WCAG 2.2 richiede almeno 4,5:1; per il testo grande la soglia è 3:1.",
            "runs": [
              {
                "text": "Per il testo ordinario, WCAG 2.2 richiede almeno 4,5:1; per il testo grande la soglia è 3:1."
              }
            ]
          },
          {
            "text": "Misura la coppia reale di testo e sfondo anche negli stati. Un nome come primary non garantisce da solo il contrasto.",
            "runs": [
              {
                "text": "Misura la coppia reale di testo e sfondo anche negli stati. Un nome come primary non garantisce da solo il contrasto."
              }
            ]
          }
        ]
