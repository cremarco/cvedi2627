        <div class="carousel-container"><a><span class="arrow prev">&#10094;</span><span class="arrow next">&#10095;</span><div class="carousel-track"><div class="slide" id="slide-1"><img alt="Webcam immagine 1"><div class="overlay"><h3 /></div></div><div class="slide" id="slide-2"><img alt="Webcam immagine 2"><div class="overlay"><h3 /></div></div></div></a></div><style type="text/css">.carousel-container{position:relative;max-width:660px;margin:auto;overflow:hidden}.carousel-track{display:flex;overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x mandatory;gap:10px;padding:10px}.carousel-track::-webkit-scrollbar{display:none}.slide{flex:0 0 calc(50% - 5px);position:relative;scroll-snap-align:start;border-radius:8px;overflow:hidden;height:180px}.slide img{width:100%;display:block;height:100%}.overlay{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.6);color:#fff;padding:7px;text-align:center}.overlay h3{margin:0 auto;font-size:1.1em}.overlay h3 span{margin:0 0 5px;font-size:1.1rem}.arrow{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.7);color:#333;padding:15px;text-decoration:none;font-weight:700;font-size:20px;z-index:10;border-radius:50%;width:45px;height:45px;display:flex;align-items:center;justify-content:center;transition:background .3s}.arrow:hover{background:#fff}.prev{left:15px;display:none}.next{right:15px}@media (max-width:600px),(min-width:768px) and (max-width:900px){.slide{flex:0 0 100%}#slide-2{display:none}}</style>
    </div>
</div>
<script type="text/javascript" async defer>
      const webcam_strip_target = document.querySelector('#box_webcam_container');
      const webcam_strip_url = "/portale/strip-webcam-amp.php?city=Bologna&lid=745&v=1.0";
      if (window.IntersectionObserver) {
        const config = { rootMargin:'0px 0px 50px 0px', threshold:0 };
        let observer = new IntersectionObserver(function(entries, self) {
          entries.forEach(async (entry) => {
            if (entry.isIntersecting) {
              try {
                console.log("###", webcam_strip_url);
                const webcam_strip_response = await fetch(webcam_strip_url);
                if (!webcam_strip_response.ok) throw new Error('Errore nel caricamento');
                const htmlText = await webcam_strip_response.text();

                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlText, 'text/html');
                const imgs = doc.querySelectorAll('img');
                const ps = doc.querySelectorAll('p');

                const link = doc.querySelector('a[href*=".ilmeteo.it/webcam/"]');
                console.log("###", link.getAttribute('href'));
                $('.carousel-container > a').attr('href', link.getAttribute('href'));

                const arraySrc = Array.from(imgs)
                    .filter(img => {
                        const src = img.getAttribute('src') || '';
                        // Teniamo l'immagine solo se NON statica ilmeteo
                        return !src.includes('ilmeteo.it/webcam/static/images/');
                    })
                    .slice(0, 2) // Prende solo le prime due immagini
                    .map(img => img.getAttribute('src'));
                const arrayTxt = Array.from(ps)
                    .slice(0, 2) // Prende solo i primi due paragrafi
                    .map(p => p.textContent.trim());

                arraySrc.forEach((src, index) => {
                    console.log("###", src, index);
                    $('#slide-' + (index+1) + ' img').attr('src', src).attr('alt', arrayTxt[index]);
                    $('#slide-' + (index+1) + ' h3').html(arrayTxt[index]);
                });

                if (arraySrc.length == 1) {
                    $('#slide-2').remove();
                    $('#slide-1').css('flex', '0 0 100%');
                }
              }
              catch (error) {
                  console.error("###", error);
              }
              self.unobserve(entry.target);
            }
          });
        }, config);
        observer.observe(webcam_strip_target);
      }
</script>
