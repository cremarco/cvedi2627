    <style type="text/css">
<!--
.page-rating-tool{float:right; width:120px; height:19px; font-size:0.7em; color:white; position:relative}
.page-rating-tool .rating{display:block; width:80px; height:19px; margin-right:4px; float:left; background:url("/portale/themes/ilmeteo10/5stars2.png") no-repeat 0 0}
.page-rating-tool .rating-0{background-position:-80px 0}
.page-rating-tool .rating-1{background-position:-64px 0}
.page-rating-tool .rating-2{background-position:-48px 0}
.page-rating-tool .rating-3{background-position:-32px 0}
.page-rating-tool .rating-4{background-position:-16px 0}
.page-rating-tool .rating-5{background-position:0 0}
.page-rating-tool .rating-expa{position:absolute; left:0; top:0; width:inherit; height:19px; overflow:hidden; background:#007AB9; border:1px solid #007AB9; -webkit-border-radius:5px; -moz-border-radius:5px; border-radius:5px; cursor:pointer}
.rating-details{margin:0 5px 5px; padding-bottom:5px; border-bottom:1px solid white;}
.rating-title{display:none}
#rating-button, #rating-button-mobile{margin:0 5px}
#rating-button-stars, #rating-button-stars-mobile{cursor:pointer}
#rating-label, #rating-label-stars, #rating-label-mobile, #rating-label-stars-mobile{margin-top:2px}
#rating-close, #rating-close-mobile{width:16px; height:16px; position:absolute; right:2px; top:2px; display:none; cursor:pointer; background:url("/portale/themes/ilmeteo10/close-white-16.png") no-repeat 0 0}
#home-page-right-box .page-rating-tool{position:absolute; left:3px; bottom:7px; font-size:0.85em}
//-->
</style>
<script type="text/javascript">
<!--
var ratid='5f0f5e5f33945135b874349cfbed4fb9';
var cur_page='745';
var base_url='https://www.ilmeteo.it';
console.log('md5 id: '+ratid);

function page_rating_toggle(v){
$('#page-rating-expa,#page-rating-expa-mobile').css('height', v ? '120px' : '19px');
$('#page-rating-expa,#page-rating-expa-mobile').css('cursor', v ? 'default' : 'pointer');
$('#rating-label,#rating-label-mobile').css('display', v ? 'none' : 'block');
$('#rating-close,#rating-close-mobile').css('display', v ? 'block' : 'none');
$('#page-rating-expa,#page-rating-expa-mobile').css('-webkit-box-shadow', v ? '0px 0px 10px 0px rgba(50, 50, 50, 0.75)' : '');
$('#page-rating-expa,#page-rating-expa-mobile').css('-moz-box-shadow', v ? '0px 0px 10px 0px rgba(50, 50, 50, 0.75)' : '');
$('#page-rating-expa,#page-rating-expa-mobile').css('box-shadow', v ? '0px 0px 10px 0px rgba(50, 50, 50, 0.75)' : '');
$('#page-rating-expa,#page-rating-expa-mobile').css('z-index', v ? '99999999999' : '10');
}
function page_rating_done(){page_rating_toggle(false);$('#rating-button,#rating-button-mobile').html('Hai gi&agrave; votato questa pagina. Grazie!');}
function x2star(x){if( x < 16 ) return 1; else if( x < 32 ) return 2; else if( x < 48 ) return 3; else if( x < 64 ) return 4; else return 5;}
$(document).ready(function(){
    if ((v=$.cookie('r.'+ratid))!=null) {
        page_rating_done();
        $('#rating-votes').text(Math.max(v,$('#rating-votes').text()));
        $('#rating-votes-mobile').text($('#rating-votes').text());
    }
	$('#rating-close,#rating-close-mobile').click(function(event){
		page_rating_toggle(false);
		event.stopPropagation();
	});
	$('#page-rating-expa,#page-rating-expa-mobile').click(function(){
		if($('#page-rating-expa,#page-rating-expa-mobile').height()<30)
        	page_rating_toggle(true);
	});
	$('#page-rating-expa,#page-rating-expa-mobile').mouseover(function(){
        $('#page-rating-expa,#page-rating-expa-mobile').css('border', '1px solid white');
	});
	$('#page-rating-expa,#page-rating-expa-mobile').mouseout(function(){
        $('#page-rating-expa,#page-rating-expa-mobile').css('border', $('#page-rating-expa').height()<30 ? '1px solid #007AB9' : '1px solid white');
	});
    $('#rating-button-stars,#rating-button-stars-mobile').mousemove(function(e){
		var offset = $(this).parent().offset();
		s=x2star(e.pageX - offset.left);
		$('#rating-button-stars,#rating-button-stars-mobile').attr('class', 'rating rating-'+s);
		$('#rating-label-stars').html(s+'/5');
		$('#rating-button-stars-mobile').html(s+'/5');
	});
	$('#rating-button-stars,#rating-button-stars-mobile').click(function(e){
		$('#rating-label-stars,#rating-button-stars-mobile').hide();
		var offset = $(this).parent().offset();
		s=x2star(e.pageX - offset.left);


		//$.ajax('https://www.ilmeteo.it/portale/rating/'+ratid+'/'+s+'/'+location.pathname.replace(/\//g,'|'));
		$.post(base_url+'/portale/rating/'+ratid+'/'+s+'/'+cur_page);


		v=parseInt($('#rating-votes').text())+1;
        $.cookie('r.'+ratid, v, {path:'/',expires:1});
		$('#rating-button-stars,#rating-button-stars-mobile').fadeOut(function(){
        	$('#rating-votes,#rating-votes-mobile').text(v);
			$('#rating-label-stars,#rating-button-stars-mobile').text('Grazie!');
			$('#rating-label-stars,#rating-button-stars-mobile').fadeIn();
			setTimeout('page_rating_done()', 2000);
		});
		event.stopPropagation();
	});
});
//-->
</script>


    
