<script type="text/javascript">
	// link altri dati meteo
	$(".forecast_gadgets2__more_data__button").on("click", function() {
		$(".weather_table").toggleClass("more_data");
		$(".forecast_gadgets2__more_data").toggleClass("active");
	});

    let popupForecast;
    // Apre il popup
    $(".forecast-dialog-open").click(function() {
        let dialogIdForecast = 'dialog-dettaglio-' + $(this).data('dialogid');
        popupForecast = document.getElementById(dialogIdForecast);
        popupForecast.showModal();
    });
    // Chiude il popup
    $('.meteo-dialog-close').click(function() {
        popupForecast.close();
    });

    // switch temperatura °C / °F
    function splitTemp(text) {
      text = text.trim();
      let p = ['', ''];
      const chrs = '0123456789.,+-';
      for (let i = 0; i < text.length; ++i) {
        if (chrs.indexOf(text[i]) < 0) {
          p[0] = parseFloat(text.substr(0, i));
	  if (isNaN(p[0])) p[0] = '';
          p[1] = text.substr(i);
          return p;
        }
      };
      p[0] = parseFloat(text);
      if (isNaN(p[0])) p[0] = text;
      return p;
    }
    function c2f(val, dec = 1) {
      val = parseFloat(val);
      if (isNaN(val)) return '';
      let res = 32 + val * 1.8;
      return Number.isInteger(res) || res.toFixed(dec) % 1 === 0 ? res.toFixed(0) : res.toFixed(dec);
    }
    function updateAllTempCF(to, dec) {
      if (isNaN(dec)) dec = 0;
      var isUserAnonymous = window.isUserAnonymous || false;
      if (!isUserAnonymous) {
	// mostra sempre la temp corrente (°C) da loggato
	$(".temp_cf").show();
	$(".tperc_cf").show();
        return;
      }
      $(".switch_cf.c").removeClass("active");
      $(".switch_cf.f").removeClass("active");
      if (to == "F") {
        $(".switch_cf.f").addClass("active");
        $(".temp_cf").each(function(index) {
          let parts = splitTemp($(this).text());
          $(this).data("temp_c", parts[0]);
          $(this).text(c2f(parts[0], dec) + parts[1].replace("C", "F"));
        });
        $(".tperc_cf").each(function(index) {
          let parts = splitTemp($(this).text());
          $(this).data("temp_c", parts[0]);
          $(this).text(c2f(parts[0], dec) + parts[1].replace("C", "F"));
        });
        // aggiungere suffisso °F a temperatura Fahrenheit in tabella previsioni
        $(".weather_table .temp_cf, .weather_table .tperc_cf, .data-table-meteo .temp_cf").each(function(idx) {
           $(this).text($(this).text() + "°F");
        });
        $(".forecast_day_selector__list__item__link__values__lower, .forecast_day_selector__list__item__link__values__higher").each(function(index) {
          let parts = splitTemp($(this).text());
          $(this).data("temp_c", parts[0]);
          $(this).text(c2f(parts[0], 0) + parts[1].replace("C", "F"));
        });
        $(".descrih").each(function(index) {
          $(this).html($(this).html().replace(/^0°C/g, "32°F").replace(/\(°C\)/g, "(°F)"));
        });
      }
      else {
        $(".switch_cf.c").addClass("active");
        $(".temp_cf").each(function(index) {
          let parts = splitTemp($(this).text());
          let tf = $(this).data("temp_c");
          $(this).text(tf + parts[1].replace("F", "C"));
        });
        $(".tperc_cf").each(function(index) {
          let parts = splitTemp($(this).text());
          let tf = $(this).data("temp_c");
          $(this).text(tf + parts[1].replace("F", "C"));
        });
        // rimuovere suffisso °C a temperatura Celsius in tabella previsioni
        $(".weather_table .temp_cf, .weather_table .tperc_cf, .data-table-meteo .temp_cf").each(function(idx) {
           $(this).text($(this).text().replace("°C", ""));
        });
        $(".forecast_day_selector__list__item__link__values__lower, .forecast_day_selector__list__item__link__values__higher").each(function(index) {
          let parts = splitTemp($(this).text());
          let tf = $(this).data("temp_c");
          $(this).text(tf + parts[1].replace("F", "C"));
        });
        $(".descrih").each(function(index) {
          $(this).html($(this).html().replace(/^32°F/g, "0°C").replace(/\(°F\)/g, "(°C)"));
        });
      }
      $(".temp_cf").show();
      $(".tperc_cf").show();
      $(".forecast_day_selector__list__item__link__values").css('display', 'block');
    }
    $(".weather_table .switch_cf").parent().click(function() {
      if ($.cookie("temp_c_f2") == "F") {
        $.cookie('temp_c_f2', null, {path:'/'}); // cookie rimosso
        updateAllTempCF("C", 1);
      }
      else {
        $.cookie('temp_c_f2', "F", {path:'/', expires:2/1440}); // cookie scade dopo 2 minuti
        updateAllTempCF("F", 1);
      }
    });
    $(".data-table-meteo .switch_cf").parent().click(function() {
      if ($.cookie("temp_c_f2") == "F") {
        $.cookie('temp_c_f2', null, {path:'/'}); // cookie rimosso
        updateAllTempCF("C", 0);
      }
      else {
        $.cookie('temp_c_f2', "F", {path:'/', expires:2/1440}); // cookie scade dopo 2 minuti
        updateAllTempCF("F", 0);
      }
    });
    if ($.cookie("temp_c_f2") == "F") {
      const dec = $(".weather_table").length ? 1 : 0;
      updateAllTempCF("F", dec);
    }
    else {
      $(".temp_cf").show();
      $(".tperc_cf").show();
      $(".switch_cf.c").addClass("active");
      $(".forecast_day_selector__list__item__link__values").css('display', 'block');
    }

    // switch vento km/h / nodi
    function splitWind(text) {
      text = text.trim();
      let p = ['', ''];
      const chrs = '0123456789.,';
      for (let i = 0; i < text.length; ++i) {
        if (chrs.indexOf(text[i]) < 0) {
          p[0] = parseFloat(text.substr(0, i));
	  if (isNaN(p[0])) p[0] = '';
          p[1] = text.substr(i);
          return p;
        }
      };
      p[0] = parseFloat(text);
      if (isNaN(p[0])) p[0] = text;
      return p;
    }
    function km2kn(val, dec = 0) {
      val = parseFloat(val);
      if (isNaN(val)) return '';
      let res = val / 1.852;
      return Number.isInteger(res) || res.toFixed(dec) % 1 === 0 ? res.toFixed(0) : res.toFixed(dec);
    }
    function updateAllWindKmKn(to) {
      $(".switch_kmkn.km").removeClass("active");
      $(".switch_kmkn.kn").removeClass("active");
      if (to == "kn") {
        $(".switch_kmkn.kn").addClass("active");
        $(".wind_kmkn").each(function(index) {
          let parts = splitWind($(this).text());
          $(this).data("wind_km", parts[0]);
          $(this).text(km2kn(parts[0]) + parts[1].replace("km/h", "nodi"));
        });
        // aggiungere suffisso kn a vento in nodi in tabella previsioni
        $(".weather_table .descri .wind_kmkn").each(function(idx) {
          $(this).after(" kn");
        });
	$(".weather_table td > abbr > .wind_kmkn").each(function(idx) {
	  if ($(this).parent().parent().children(".descri").children(".wind_kmkn").length == 0) $(this).after(" kn");
	});
        $(".data-table-meteo .mg-data-col.vento").each(function(idx) {
          var elem = $(this).children('span.wind_kmkn').eq(1);
          if (elem.length == 0) elem = $(this).children('span.wind_kmkn').first();
          elem.after(" kn");
        });
	$(".wind_sep_kmkn").removeClass("max");
      }
      else {
        $(".switch_kmkn.km").addClass("active");
        $(".wind_kmkn").each(function(index) {
          let parts = splitWind($(this).text());
          let tf = $(this).data("wind_km");
          $(this).text(tf + parts[1].replace("nodi", "km/h"));
          $(this).parent().html($(this).parent().html().replace(" kn", ""));
        });
	$(".wind_sep_kmkn").addClass("max");
      }
      $(".wind_kmkn").show();
    }
    $(".weather_table .switch_kmkn").parent().parent().click(function() {
      if ($.cookie("wind_km_kn2") == "kn") {
        $.cookie('wind_km_kn2', null, {path:'/'}); // cookie rimosso
        updateAllWindKmKn("km");
      }
      else {
        $.cookie('wind_km_kn2', "kn", {path:'/', expires:30}); // cookie scade dopo 30 giorni
        updateAllWindKmKn("kn");
      }
    });
    $(".data-table-meteo .switch_kmkn").parent().click(function() {
      if ($.cookie("wind_km_kn2") == "kn") {
        $.cookie('wind_km_kn2', null, {path:'/'}); // cookie rimosso
        updateAllWindKmKn("km");
      }
      else {
        $.cookie('wind_km_kn2', "kn", {path:'/', expires:30}); // cookie scade dopo 30 giorni
        updateAllWindKmKn("kn");
      }
    });
    if ($.cookie("wind_km_kn2") == "kn") {
      updateAllWindKmKn("kn");
    }
    else {
      $(".wind_kmkn").show();
      $(".switch_kmkn.km").addClass("active");
      $(".wind_sep_kmkn").addClass("max");
    }
</script>
<script defer type="text/javascript">
   $(document).ready(function() {
    	/*
        $(".meteo-dialog").dialog({
                autoOpen: false,
                show: {
                        effect: "blind",
                        duration: 500
                },
                hide: {
                        effect: "fade",
                        duration: 500
                }
        });
        */
        $('.data-row-radar-nowcasting.collapsed').click(function() {
            $('.data-row-radar-nowcasting-children').toggleClass('hidden');
            $('.caret', $(this)).toggleClass('opened');
        });
    });
</script>

<script type="text/javascript">
  (async () => {
     console.log("Promise", prUrls);
     const prUrlRes = prUrls.map(url => { fetch(url).then(res => {
        if (res.status == 200 && res.ok) {
                var js_script = document.createElement("script");
                js_script.type = "text/javascript";
                js_script.src = res.url;
                document.head.append(js_script);
        }
     })});
     Promise.all(prUrlRes).then(res => {
        console.log("Promise", "urls loaded", prFunctions.length);
        Promise.all(prFunctions.map( (f) => f.func(f.arg) ))
            .finally((res) => {
               prFinal();
	       initMainMenu();
	       idleSetup();
	       $(window).resize(function(){ilmeteo_sticky_pos()});
        });
     });
  })();
</script>

</body>
