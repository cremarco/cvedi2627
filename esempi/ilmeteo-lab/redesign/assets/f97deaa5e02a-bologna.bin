<script>

$(document).ready(function () {
            $('#formsegnala').submit(function (event) {
                event.preventDefault();
				var formData = $(this).serialize();
                $("#reporter-error").css("display","none")
                $.ajax({
                    url: $(this).attr('action')+"?"+ formData,
                    method:'POST',
                    success: function (response) {
                        $("#table-reporter").remove()
                        $("#reporter-success").css("display","block")
                        $("#reporter-error").css("display","none")
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $("#reporter-error-msg").html(jqXHR.responseJSON.message)
                        $("#reporter-error").css("display","block")
                    }
                });

            });
        });

</script>


