(async () => {
// Get the modal
var modal_reporter = document.getElementById("modal_segnala");

// Get the button that opens the modal
var btn_reporter = document.getElementById("amp_segnala_btn");

// Get the <span> element that closes the modal
var span_close_reporter = document.getElementsByClassName("close")[0];

// When the user clicks on the button, open the modal
if (btn_reporter) {
  btn_reporter.onclick = function() {
    modal_reporter.style.display = "block";
    const tempVal = $('.weather_table tr.-30.latest_detection td span.temp_cf').text().trim();
    if (tempVal.length > 0) {
       $('#formsegnala #edit-temperatura')
	  .val(parseFloat(tempVal.replace(',', '.')).toFixed(1))
          .trigger('input')
          .trigger('change');
    }
  }
}

// When the user clicks on <span> (x), close the modal
if (span_close_reporter) {
  span_close_reporter.onclick = function() {
    modal_reporter.style.display = "none";
  }
}

// When the user clicks anywhere outside of the modal, close it
window.onclick = function(event) {
  if (event.target == modal_reporter) {
    modal_reporter.style.display = "none";
  }
}
})();
</script><script type="text/javascript">
const timeLapseKey = 'ilmeteo-timelapse-hours';
const timeLapseHours = getStoredTimeLapseHours();
if (0 > 0) {
    try {
        if (timeLapseHours) document.getElementById('time-lapse-button-' + timeLapseHours).click();
            else setTimeLapse(1);
    }
    catch(e) {
    }
}
if (0 == 0) {
    if (timeLapseHours == 1 && 1 == 3 && !1) {
        try {
            $('.forecast_gadgets2__time_lapse').hide();
            setTimeLapse(1);
            $('.forecast_gadgets2__time_lapse').show();
        }
        catch(e) {
        }
    }
    else if (1) {
        try {
            $('.forecast_gadgets2__time_lapse').css('visibility', 'hidden');
        }
        catch(e) {
        }
    }
}

function getStoredTimeLapseHours() {
    return localStorage.getItem(timeLapseKey);
}

function storeTimeLapseHours(hours) {
    localStorage.setItem(timeLapseKey, hours);
}

function setTimeLapse(timeLapse) {
    var activeClass = 'forecast_gadgets2__time_lapse__button--active';
    var weatherTableClass = 'weather_table';
    var timeLapseButton3 = document.getElementById('time-lapse-button-3');
    var timeLapseButton1 = document.getElementById('time-lapse-button-1');
    if (timeLapse === 1) {
        timeLapseButton3.classList.remove(activeClass);
        timeLapseButton1.classList.add(activeClass);
        $('tr.forecast_3h').hide();
        $('tr.forecast_1h').removeClass('hidden').show();
	storeTimeLapseHours(1);
    }
    if (timeLapse === 3) {
        timeLapseButton1.classList.remove(activeClass);
        timeLapseButton3.classList.add(activeClass);
        $('tr.forecast_1h').hide();
        $('tr.forecast_3h').removeClass('hidden').show();
	storeTimeLapseHours(3);
    }
}

function toggleBulletin() {
    var bulletin = document.getElementsByClassName('forecast_gadgets2__bulletin__list')[0];
    if (bulletin.style.display === '' || bulletin.style.display === 'none') {
        bulletin.style.display = 'block';
    } else {
        bulletin.style.display = 'none';
    }
}

function toggleWeatherInformations(element) {
    element.parentNode.classList.toggle('weather_informations--collapse--opened');
}

function toggleRadar(element) {
    element.parentNode.classList.toggle('opened');
    element.parentNode.classList.toggle('closed');
}

function openWeatherModal() {
    var modalContent = document.getElementsByClassName('weather_modal_content')[0]
    modal.setContent(modalContent.innerHTML);
    modal.open();
}

function openReporterModal() {
    var modalContent = document.getElementsByClassName('reporter_modal_content')[0]
    modal.setContent(modalContent.innerHTML);
    modal.open();
}

</script><script defer type="text/javascript" src="/portale/smartbanner.min.js"></script>
<script defer type="text/javascript">
    function SB_deepLink( opts )
    {
        try{
            let dl = "ilmeteo://home";
            if( opts ){
                if( opts.weather_lid && opts.weather_lid>0 ){
                    dl = "ilmeteo://weather/" + opts.weather_lid;
                }
            }
            window.location = dl;
        }catch(e){}
    };

    function SB_showSmartBanner() {
        $('.smartbanner__exit').each(function(index,el) {
            //console.log(index)
            if(! $(el).hasClass('_custom_click') ) {
                $(el).click(function(e){
                    document.cookie = "sb_user_close=1; expires=Thu, 15 Oct 2026 19:59:05 UTC; path=/";
		    $('#space_for_smartbanner').remove();
                    $('#search-bar-row').removeClass('with-smartbanner');
                    $('.side_menu').removeClass('with-smartbanner');
                    $('header').css({ 'padding-top': 0 }).removeClass('with-smartbanner');
                });
            }
        });

        $('div.js_smartbanner').removeClass('smartbanner--android'); // Mette la grafica per iOS anche su Android

        if(!iOS_device) {
            $('div.js_smartbanner').attr('id','download_app_android')
                .attr('data-mrf-conversion','click_smartbanner_android'); // Marfeel tracking
        }

        let h = $('div.js_smartbanner').innerHeight();
        let header_top = 0;
        if( h>0 ){
            header_top = h + 'px';
        }
        $('#space_for_smartbanner').slideDown();
        $('div.js_smartbanner').css({
	    position: 'fixed',
	    top: 0,
	    'z-index': 2147483643,
	    display: 'flex',
	    'flex-direction': 'column',
	    'justify-content': 'center'
        }).slideDown();

        $('#modal_segnala').css({
            top: header_top,
        });

        header_top = parseInt($('header').css('padding-top'));
        $('#search-bar-row').addClass('with-smartbanner');
        $('.side_menu').addClass('with-smartbanner');
        $('header').css({
            'padding-top': (h + header_top) + 'px'
        }).addClass('with-smartbanner');

        /**
        $('.header-weather').css({
            marginTop: header_top
        });
        **/
    }

    function SB_setScroller() {
        // document.addEventListener('smartbanner.clickout', smartbanner.exit);

        //if (!iOS_device || !safariAgent) {
            var sb_scrolled = false, sb_smartbanner_on = false, lastScrollPos = 0, currentScrollPos;

            $(window).on('scroll', function() {
                if (!sb_smartbanner_on) {
                    currentScrollPos = $(window).scrollTop();

                    if (sb_scrolled && currentScrollPos < lastScrollPos) {
                        sb_smartbanner_on = true;
                        SB_showSmartBanner();
                    }

                    if (!sb_scrolled && $(window).scrollTop() > 90) {
                        sb_scrolled = true;
                    }

                    lastScrollPos = currentScrollPos;
                }
            });
        //}
    };

    // attende che lo SmartBanner sia caricato, e poi setta lo scroller
    (async () => {
        /* Hack per nascondere lo SB nativo per iOS Safari sulle pagine meteo */
        const isMeteoPage = window.location.pathname.toLowerCase().substr(0, 7) == '/meteo/';
        if (isMeteoPage && iOS_device && safariAgent) return;

        const SB_sleep = (ms) => {
          return new Promise((resolve) => setTimeout(() => resolve(), ms));
        };
        const isSmartBannerAvailable = () => {
          return $('div.js_smartbanner').length > 0;
        };

        //if (!iOS_device || !safariAgent) {
            let SB_avail = await isSmartBannerAvailable();
            while (!SB_avail) {
              await SB_sleep(100);
              SB_avail = isSmartBannerAvailable();
            }

            SB_setScroller(); /* mostra smartbanner allo scroll */
	    //SB_showSmartBanner(); /* mostra smartbanner fisso */
        //}
    })();
</script>

