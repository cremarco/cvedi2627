/* The Modal (background) */
.modal {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 10000000000; /* Sit on top */
  left: 0;
  top: 0;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: auto; /* Enable scroll if needed */
  background-color: rgb(0,0,0); /* Fallback color */
  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
}

/* Modal Content/Box */
.modal-content {
  background-color: #fefefe;
  margin: 15% auto; /* 15% from the top and centered */
  padding: 20px;
  border: 1px solid #888;
  width: 80%; /* Could be more or less, depending on screen size */
  max-width: 400px;
  font-size: 0.8em;
}

/* The Close Button */
.close {
  color: #aaa;
  float: right;
  font-size: 28px;
  font-weight: bold;
}

.close:hover,
.close:focus {
  color: black;
  text-decoration: none;
  cursor: pointer;
}

.temp-mare {
    font-size: 0.85em;
}

.notizia-geo .bli-notizia-geo, .bli-webcam-strip .bli-webcam-titolo, .box-loc-eff .eff-title, .box-loc-info .bli-comune, .infoloc .comune, .box-altre-info h2, .dati-sole .title, .dati-prec .title {
  padding: 0;
  background: #fff;
  text-transform: uppercase;
  border-bottom: 1px solid #0074b6;
  color: #333;
  font-family: 'OpenSansHebrewCondensed-Bold';
  font-size: 18px;
  width: 100%;
  white-space: nowrap;
  margin: 0;
}
.bli-webcam-strip, .box-loc-eff { background: #fff; margin-top: 5px }
.bli-webcam-strip .box-webcam-container { background: #e6e8ea }
.notizia-geo .bli-notizia-geo::after, .bli-webcam-strip .bli-webcam-titolo, .box-loc-eff .eff-title::after, .box-loc-info .bli-comune::after, .infoloc .comune::after, .box-altre-info h2::after, .dati-sole .title::after, .dati-prec .title::after {
  content: '';
  border-bottom: 5px solid #0074b6;
  width: 218px;
  display: block;
}
.responsive-content-container .box-altre-info h3 a.archivio { margin-top: 20px !important }
.box-loc-info.loc-closed-box>div:first-child, .box-altre-info.altre-closed-box h2 {
    background: url(/portale/themes/ilmeteo10/freccia-giu.png) 99% / 13px 7px no-repeat #fff;
}
.box-loc-info.loc-open-box>div:first-child, .box-altre-info.altre-open-box h2 {
    background: url(/portale/themes/ilmeteo10/freccia-su.png) 99% / 13px 7px no-repeat #fff;
}
.infoloc. eff { font-size: .9em }
.infoloc .eff-luna, .infoloc .eff-sole {
    display: inline-block;
    width: 20px;
    margin-top: -2px;
    height: 20px;
    vertical-align: middle;
}
.infoloc .eff-sole {
    background: url(/portale/themes/ilmeteo10/common3.png) -125px -268px;
}
.infoloc .eff-luna {
    background: url(/portale/themes/ilmeteo10/common3.png) -148px -268px;
}
.infoloc b, .dati-sole b, .dati-prec b {
    font-family: 'OpenSansHebrewCondensed-Bold';
}
.infoloc .eff .title {
    color: #2677b7;
    margin-left: 5px;
}
.dati-sole ul, .dati-prec ul {
  list-style-type: none;
  padding: 0;
  margin: 0;
}

ul.tab-giorni .deg { display: none }
ul.tab-giorni .tabfirst {
  background: #007ab9;
  color: #fff;
  display: none;
  align-items: center;
}
@media (min-width:500px) and (max-width:767px) {
  ul.tab-giorni span { display: inline }
  ul.tab-giorni .temp { font-size: 1.2em }
  ul.tab-giorni .temp .deg { display: inline }
  ul.tab-giorni .tabfirst { display: flex }
}
@media (min-width:870px) {
  ul.tab-giorni span { display: inline }
  ul.tab-giorni .temp { font-size: 1.2em }
  ul.tab-giorni .temp .deg { display: inline }
  ul.tab-giorni .tabfirst { display: flex }
}

.header-weather { display: block }

#header-previsioni {
  margin: 0;
  min-height: 66px !important;
}

.aria-graph-small .progress-circle span {
    width: 1.75em;
    height: 1.75em;
    top: 17%;
}

#banner-320-50, #banner-320-50-desktop, #banner-mnz-x40-mobile {display:flex; justify-content:center}

.title_bar {margin-bottom:0px !important}
.locsearch {margin-top:7px; margin-bottom:7px}
.locsearch-nav { display:inline-flex }
.locsearch select{border:0 !important; width:150px; height:20px; font-size:.9em; overflow:hidden; text-overflow:ellipsis; color:white !important; background:#919191 !important; -webkit-appearance:none; -moz-appearance:none; appearance:none; cursor:pointer}
.locsearch select:focus{outline:0}
.select-geo{position:relative; display:inline; margin-right:5px; margin-bottom:5px}
.select-geo:after { content:'\25BC'; color:white; right:4px; top:2px; position:absolute; pointer-events:none; z-index:10;}

.select-serv {
    margin: 0 !important;
    font-size: .9em !important;
}

select-serv:before {
    content: '';
    right: 2px;
    top: 0;
    width: 20px;
    height: 20px;
    background: #e8e8e8;
    position: absolute;
    pointer-events: none;
    display: block;
    z-index: 5;
}
.select-geo:before {
    content: '';
    right: 2px;
    top: 0;
    width: 20px;
    height: 20px;
    /* background: #919191; */
    display: block;
    z-index: 5;
}
.select-geo:after, .select-geo:before {
    position: absolute;
    pointer-events: none;
}

.select-serv select {
    width: 150px;
    background: #e8e8e8 !important;
    color: #007ab9 !important;
}
@media screen and (-webkit-min-device-pixel-ratio: 0) {
    .locsearch select {
        padding-right: 18px;
    }
}
.select-serv select {
    width: 150px;
    background: #e8e8e8 !important;
    color: #007ab9 !important;
}
.select-serv:after {
    content: "\25BC";
    color: #007ab9;
    right: 4px;
    top: 2px;
    position: absolute;
    pointer-events: none;
    z-index: 10;
}

/*
#apri-mappa-radar-amp {font-family:'OpenSansHebrewCondensed-Bold'}
*/
.realtime-title[data-value=amp-radar-title]:before, .data-row-realtime.radar-amp:after,
.realtime-title[data-value=forecast-ai-title]:before {
  position: relative;
  display: block;
  width: 100%;
  left: 0;
}
.data-row-realtime.radar-amp {
  display:flex !important;
  flex-wrap:wrap !important;
  height:auto !important;
}
.data-row-realtime.radar-amp .realtime-title {
  flex:1 1 100%;
  height:auto !important;
}
.data-row-realtime.radar-amp .data-col {
  /* flex:1;
  margin:0 5px; */
  height:auto;
  font-size:90% !important;
}
.data-row.data-row-realtime.situazione-realtime-amp { position:relative }

#header-previsioni {display:flex !important; flex-direction:column; align-items:center; margin:0}

#box-previsioni-aria {width:100%; margin-bottom:15px; margin-top:15px}
#box-previsioni-aria .iqa-cont {display:flex; background:#EBEBEB}
#box-previsioni-aria .iqa-circle-graphs-cont {display:flex !important; flex-direction:row; justify-content:space-around; flex: 1 0 0; padding:5px 0px; gap:5px}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graph-main {display:flex !important; flex-direction:row; align-items:center; width:49%}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graph-main > div:not(.aria-graph-small) {display:flex !important; flex-direction:row; gap:7px}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graph-main > span {white-space:normal; max-width:75px}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graphs-others {display:flex !important; flex-direction:column; align-items:center}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graphs-others > span {color:#333 !important; font-size:12px !important}
#box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graphs-others > div > span {font-family:'OpenSansHebrewCondensed-Bold'; color:#333 !important; font-size:12px !important}

#box-previsioni-mare {width:100%; margin-top:15px}
#box-previsioni-mare .simboli-mare {display:flex; flex-direction:row; justify-content:space-around; padding:5px 5px 10px 5px; align-items:center}
#box-previsioni-mare .simbolo-mare.large {width:49%; display:flex; flex-direction:row; align-items:center; color:#0A2CFF}
#box-previsioni-mare .simbolo-mare .sea {background-color:#0A2CFF; margin:0; border-radius:50%; top:0; padding:25px; filter:brightness(3); background-position-y:-30px}
#box-previsioni-mare .simbolo-mare .sea.sea0 {background-size:1145px 111px; background-position-y:-34px}
#box-previsioni-mare .simbolo-mare.large .sea {transform:scale(1)}
#box-previsioni-mare .simbolo-mare.large .simbolo-mare-descr {display:flex; flex-direction:column; margin-left:10px; line-height:1.1em; filter:brightness(3)}
#box-previsioni-mare .simbolo-mare-descr .descr {font-family:'OpenSansHebrewCondensed-Bold'}
#box-previsioni-mare .simbolo-mare-giorno {font-size:12px; position:relative; top:5px}
#box-previsioni-mare .simbolo-mare.large .simbolo-mare-descr .descr {font-size:18px}
#box-previsioni-mare .simbolo-mare.large .simbolo-mare-giorno {display:none}
#box-previsioni-mare .simbolo-mare.small {display:flex; flex-direction:column; align-items:center; color:#333}
#box-previsioni-mare .simbolo-mare.small > div {line-height:1em}
#box-previsioni-mare .simbolo-mare.small .simbolo-mare-descr {font-size:14px; margin-top:-5px; white-space:nowrap}
#box-previsioni-mare .simbolo-mare.small .simbolo-mare-descr .ora {display:none}
@media (max-width:768px) {
  #box-previsioni-mare .simboli-mare {gap:5px}
  #box-previsioni-mare .simboli-mare .simbolo-mare-descr .descr {font-size:13px}
}

@media (max-width:530px) {
  #box-previsioni-aria .iqa-circle-graphs-cont .iqa-circle-graph-main > div:not(.aria-graph-small) { flex-direction:column; gap:0 }
}

.aria-graph-small .progress-circle span {
    width: 1.7em;
    height: 1.7em;
    top: 13%;
    font-size: 21px;
    font-family: 'OpenSansHebrewCondensed-Bold';
}
.aria-graph-medium .progress-circle span {
    width: 1.6em;
    height: 1.6em;
    top: 14%;
}

#box-previsioni-mare .simboli-mare {display:flex; background:#EBEBEB}

.responsive-content-container {
  display: flex;
  margin-top: 10px;
  justify-content: space-between;
}
.responsive-content-container > div, .responsive-content-container .box-altre-info .bai-main { width: 48% }
.responsive-content-container .box-altre-info .bai-main .ieri-descri { margin-top: 10px !important }
.responsive-content-container .eff-title { display: none }
.responsive-content-container .box-altre-info { width: 100%; display: flex; flex-wrap: wrap; background: #fff }
.responsive-content-container #box-previ-bottom-nazione { margin-bottom:10px !important; width:auto !important; height:auto !important}
.responsive-content-container #box-previ-bottom-nazione img { width:100% !important; max-width:315px !important; max-height:315px !important}
.responsive-content-container.attend-prev { border:1px solid #aaa; margin:15px 0 10px; border-radius:10px; padding:20px; align-items:center; justify-content:center }

#banner-320-50, #banner-320-50-desktop, #banner-mnz-x40-mobile {display:flex; justify-content:center}

.sitelink_buttons { display:flex; flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:10px }
.sitelink_buttons a { background:#007ab9; color:#fff; border-radius:4px; text-align:center; width:18%; line-height:1em; display:flex; justify-content:center; align-items:center; height:39px; padding:5px 10px }
.sitelink_buttons a.confronto_previsioni .label { left:10px; position:relative }

.sitelink_buttons .newService {
    position: relative;
    background: red;
    padding: 4px;
    color: white;
    border-radius: 4px;
    top: -18px;
    right: -14px;
    font-size: 10px;
    line-height: 1;
}
.forecast_gadgets2__more_data .newService {
    position: relative;
