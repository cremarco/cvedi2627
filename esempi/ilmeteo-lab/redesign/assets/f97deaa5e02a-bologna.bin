	    <style type="text/css">
.social_condividi {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    align-items: center;
    margin: 10px 0;
    width: 100%;
}
.social_condividi__text {
    margin: 0;
    padding: 3px 17px 0px 22px;
    background-color: #fff;
    color: #000;
    font-size: 15px;
    border: 1px solid #afafaf;
    border-radius: 5px;
    height: 32px;
    display: flex;
    flex-direction: row;
    gap: 10px;
    align-items: center;
    flex-wrap: nowrap;
}
.social_condividi__text a { width: 24px; display: block }
.social_condividi__text__link--facebook {
    background-image: none;
}
.social_condividi__text__link--twitter {
    background-image: none;
}
.social_condividi__text svg {
  width: 75% !important;
}
@media (max-width:1024px) {
    .social_condividi {
        justify-content: space-between;
    }
    .social_condividi > * {
        flex: 1;
        box-sizing: border-box;
        padding: 6px;
        border: 1px solid #afafaf;
        border-radius: 4px;
    }
    .social_condividi__text {
        display: none;
    }
}

.whatsapp_channel, .google_favorite {
    padding: 10px;
    width: 48% !important;
    height: 64px;
}
.whatsapp_logo {
    float: left;
    margin-right: 10px !important;
}
.google_logo {
    float: right;
    margin-left: 10px !important;
}
.whatsapp_logo img, .google_logo img { width: 40px; height: 40px; display: block }
.whatsapp_channel .whatsapp_text, .google_favorite .google_text {
    color: #333;
    text-align: left;
    font-size: .95em;
}
.whatsapp_channel a, .google_favorite a { display: flex; flex-direction: row; align-items: center;  text-decoration: none; cursor: pointer }
.google_favorite a { justify-content: flex-end }
.google_favorite .google_text { text-align: right }
@media screen and (min-width: 1025px) {
    .whatsapp_channel {display: none}
    .social_condividi__text a { display:flex; justify-content: center; align-items: center }
    .google_favorite { height: 32px; border: 1px solid #afafaf; border-radius: 5px; display: flex; align-items: center; justify-content: center; width: auto !important; padding: 2px 10px }
    .google_logo img { width: 20px; height: 20px }
    .google_favorite .google_text { white-space: nowrap }
}
