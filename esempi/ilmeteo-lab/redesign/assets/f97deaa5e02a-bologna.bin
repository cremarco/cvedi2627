</style><script type="text/javascript" defer>
    document.addEventListener('DOMContentLoaded', function() {
        const key = 'tab-giorni-scrollpos';
        const lastYPosItemStr = localStorage.getItem(key);
        var lid, lastYPos, lastYPosItem;
        if (paywall_localita) {
            lid = paywall_localita.lid;
        }
        var scrollReset = false;
        if (lastYPosItemStr) {
            // resetta il cookie se è numerico (vecchia implementazione dello scroll)
            if (typeof lastYPosItemStr == 'number') scrollReset = true;
                else lastYPosItem = JSON.parse(lastYPosItemStr);
        }
        const now = new Date();
        if (!scrollReset && lastYPosItem) {
            // resetta il cookie se sono su un lid diverso o se è scaduto il ttl
            scrollReset = (lid > 0 && lastYPosItem.lid !== lid) || now.getTime() > lastYPosItem.expiry;
        }
        if (scrollReset) {
            localStorage.removeItem(key);
            return;
        }
        else if (lastYPosItem) {
            lastYPos = lastYPosItem.pos;
            window.scrollTo(0, lastYPos);
        }
        var onTabLinkClick = function() {
            var pos = window.scrollY;
            if (!$('#header-previsioni').length) pos += 40;
            var expiry;
            const now = new Date();
            const ttl = 60; // scadenza in secondi
            if (lastYPosItemStr && typeof lastYPosItemStr !== 'number') {
                const lastYPosItem = JSON.parse(lastYPosItemStr);
                expiry = lastYPosItem.expiry;
            }
            if (!expiry) expiry = now.getTime() + ttl * 1000;
            localStorage.setItem(key, JSON.stringify({ pos: pos, lid: lid, expiry: expiry }));
        };
        var links = document.querySelectorAll('ul.forecast_day_selector__list li a');
        for (var i = 0; i < links.length; i++) {
            links[i].addEventListener('click', onTabLinkClick);
        }
    });
</script><div class="forecast_gadgets2" data-nosnippet>
