  "cues": [
    {
      "start": 0.24,
      "end": 5.08,
      "text": "Le tre card descrivono tre capacità che\nuseremo insieme."
    },
    {
      "start": 5.08,
      "end": 8.82,
      "text": "Leggere una struttura significa\nriconoscere dove iniziano i contenuti,"
    },
    {
      "start": 9.18,
      "end": 11.98,
      "text": "quali bordi si allineano e quali distanze\nli separano."
    },
    {
      "start": 13.18,
      "end": 16.78,
      "text": "Dovremo indicare gli allineamenti,\ndistinguendo ciò che vediamo dalle"
    },
    {
      "start": 16.78,
      "end": 21.72,
      "text": "intenzioni dell'autore. Progettare il\nlayout significa scegliere una struttura"
    },
    {
      "start": 21.72,
      "end": 23.98,
      "text": "adatta ai materiali e decidere come\nusarla."
    },
    {
      "start": 24.84,
      "end": 26.6,
      "text": "Un'immagine può attraversare più"
    },
    {
      "start": 27.24,
      "end": 31.42,
      "text": "colonne; una nota può avere uno spazio\ndiverso dal testo principale."
    },
    {
      "start": 31.42,
      "end": 34.12,
      "text": "Dovremo motivare queste scelte in rapporto\nalla lettura."
    },
    {
      "start": 35.24,
      "end": 39.56,
      "text": "Verificare le regole significa infine\nprovare la soluzione con contenuti e"
    },
    {
      "start": 39.56,
      "end": 42.44,
      "text": "condizioni che possono metterla in\ndifficoltà."
    },
    {
      "start": 42.44,
      "end": 46.78,
      "text": "Un titolo più lungo o una finestra più\nstretta sono occasioni per capire se la"
    },
    {
      "start": 46.78,
      "end": 47.48,
      "text": "regola funziona."
    },
    {
      "start": 48.32,
      "end": 53.1,
      "text": "Alla fine dovremo poter descrivere una\nscelta, mostrarne l'effetto e registrare"
    },
    {
      "start": 53.1,
      "end": 58.12,
      "text": "ciò che va corretto. Cominciamo osservando\ncome cambia una composizione quando"
    },
    {
      "start": 58.12,
      "end": 59.58,
      "text": "introduciamo riferimenti comuni."
    }
  ]
}
