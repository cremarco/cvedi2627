  "cues": [
    {
      "start": 0.3,
      "end": 3.96,
      "text": "Quando alle colonne aggiungiamo\nsuddivisioni orizzontali, otteniamo i"
    },
    {
      "start": 3.96,
      "end": 7.72,
      "text": "moduli: unità con cui possiamo organizzare\ncontenuti che si ripetono."
    },
    {
      "start": 8.92,
      "end": 13.92,
      "text": "Nel catalogo illustrato, immagine, nome e\ndati tornano in posizioni confrontabili."
    },
    {
      "start": 14.76,
      "end": 18.8,
      "text": "Un oggetto può occupare più unità,\nconservando però i riferimenti utili a"
    },
    {
      "start": 18.8,
      "end": 20.16,
      "text": "riconoscere gli stessi ruoli."
    },
    {
      "start": 20.9,
      "end": 25.44,
      "text": "La modularità è particolarmente utile\nquando vogliamo scorrere e confrontare una"
    },
    {
      "start": 25.44,
      "end": 26.14,
      "text": "raccolta."
    },
    {
      "start": 26.52,
      "end": 28.82,
      "text": "Non obbliga ogni contenuto ad avere la\nstessa lunghezza."
    },
    {
      "start": 29.8,
      "end": 35.0,
      "text": "Qui nasce una decisione importante: se una\ndescrizione cresce, tutta la riga segue"
    },
    {
      "start": 35.0,
      "end": 38.54,
      "text": "l'elemento più alto oppure ogni scheda\nmantiene un'altezza autonoma?"
    },
    {
      "start": 39.58,
      "end": 43.82,
      "text": "Nel primo caso conserviamo alcuni\nallineamenti, nel secondo accettiamo un"
    },
    {
      "start": 43.82,
      "end": 48.52,
      "text": "andamento differente. Nessuna delle due\nscelte si risolve disegnando soltanto"
    },
    {
      "start": 48.52,
      "end": 49.54,
      "text": "rettangoli uguali."
    },
    {
      "start": 50.36,
      "end": 54.46,
      "text": "Occorrono descrizioni realistiche,\ncomprese quelle più lunghe, per capire che"
    },
    {
      "start": 54.46,
      "end": 59.08,
      "text": "cosa accade alle informazioni successive e\nquale sequenza si riesce a seguire con lo"
    },
    {
      "start": 59.08,
      "end": 59.715,
      "text": "sguardo."
    }
  ]
}
