  "cues": [
    {
      "start": 0.16,
      "end": 4.7,
      "text": "Il confronto conserva titolo,\npresentazione, programma e immagine della"
    },
    {
      "start": 4.7,
      "end": 5.68,
      "text": "stessa mostra immaginaria."
    },
    {
      "start": 6.54,
      "end": 9.56,
      "text": "Non stiamo scegliendo fra una versione\ncompleta e una abbreviata:"
    },
    {
      "start": 10.5,
      "end": 13.62,
      "text": "cambia il modo in cui distribuiamo lo\nspazio."
    },
    {
      "start": 13.62,
      "end": 18.08,
      "text": "Nel primo assetto testo e immagine\noccupano due campi di pari larghezza,"
    },
    {
      "start": 18.14,
      "end": 19.46,
      "text": "mentre il programma prosegue sotto."
    },
    {
      "start": 20.4,
      "end": 25.34,
      "text": "Nel secondo l'immagine guadagna spazio e\nil testo si restringe; il programma trova"
    },
    {
      "start": 25.34,
      "end": 27.38,
      "text": "posto nel campo sottostante all'immagine."
    },
    {
      "start": 28.52,
      "end": 30.1,
      "text": "Osservate dove cominciate a leggere,"
    },
    {
      "start": 30.74,
      "end": 34.86,
      "text": "quanto sono lunghe le righe e dove trovate\nle informazioni pratiche."
    },
    {
      "start": 34.86,
      "end": 39.0,
      "text": "Un'immagine più grande può valorizzare il\nsoggetto, ma lascia anche meno larghezza"
    },
    {
      "start": 39.0,
      "end": 43.26,
      "text": "alla prosa. L'asimmetria non è un\nmiglioramento automatico."
    },
    {
      "start": 43.26,
      "end": 47.46,
      "text": "Per giudicare i due assetti, dobbiamo\ncollegare ogni differenza a un compito"
    },
    {
      "start": 47.46,
      "end": 48.16,
      "text": "della pagina:"
    },
    {
      "start": 48.76,
      "end": 52.78,
      "text": "comprendere la mostra, riconoscerne il\ncarattere e trovare il programma senza"
    },
    {
      "start": 52.78,
      "end": 53.48,
      "text": "equivoci."
    }
  ]
}
