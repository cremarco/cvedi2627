  "cues": [
    {
      "start": 0.26,
      "end": 4.42,
      "text": "Una volta avviata la modifica, Sara deve\nconfrontare le disponibilità."
    },
    {
      "start": 4.42,
      "end": 8.96,
      "text": "Un calendario offre una visione del mese;\nuna lista può rendere più espliciti i"
    },
    {
      "start": 8.96,
      "end": 10.4,
      "text": "giorni effettivamente selezionabili."
    },
    {
      "start": 11.66,
      "end": 16.32,
      "text": "La scelta dipende dalla quantità delle\ndate e da ciò che serve per decidere."
    },
    {
      "start": 16.32,
      "end": 20.4,
      "text": "Nell’esempio, la lista mostra i giorni\ndisponibili e segnala con un’etichetta"
    },
    {
      "start": 20.4,
      "end": 21.1,
      "text": "quello selezionato."
    },
    {
      "start": 22.04,
      "end": 26.0,
      "text": "Il colore contribuisce a distinguerlo, ma\nnon porta da solo tutto il significato."
    },
    {
      "start": 27.06,
      "end": 29.42,
      "text": "Seguono gli orari, il riepilogo e la\nconferma."
    },
    {
      "start": 30.44,
      "end": 34.18,
      "text": "Proviamo anche un ritorno alla scelta\nprecedente: Sara deve ritrovare il"
    },
    {
      "start": 34.18,
      "end": 36.72,
      "text": "contesto e capire che cosa è ancora\nselezionato."
    },
    {
      "start": 37.68,
      "end": 41.52,
      "text": "Con la tastiera controlliamo che\nl’indicatore del focus mostri chiaramente"
    },
    {
      "start": 41.52,
      "end": 46.06,
      "text": "quale controllo riceve i comandi; con\nl’ingrandimento verifichiamo giorni e"
    },
    {
      "start": 46.06,
      "end": 50.6,
      "text": "orari completi. Nell’interfaccia\nfunzionante, anche la tecnologia assistiva"
    },
    {
      "start": 50.6,
      "end": 53.06,
      "text": "deve poter riconoscere quale giorno è\nselezionato."
    },
    {
      "start": 53.84,
      "end": 57.88,
      "text": "La prova riguarda quindi sia ciò che\nvediamo sia ciò che il controllo comunica."
    }
  ]
}
