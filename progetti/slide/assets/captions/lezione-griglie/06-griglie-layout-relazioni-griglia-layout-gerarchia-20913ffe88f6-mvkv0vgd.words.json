  "cues": [
    {
      "start": 0.14,
      "end": 5.88,
      "text": "Griglia, layout e gerarchia descrivono\naspetti collegati, ma differenti."
    },
    {
      "start": 5.88,
      "end": 8.1,
      "text": "La griglia è il sistema dei riferimenti\ndisponibili."
    },
    {
      "start": 9.1,
      "end": 13.34,
      "text": "Il layout è la disposizione concreta che\nscegliamo per una pagina."
    },
    {
      "start": 13.34,
      "end": 18.08,
      "text": "La gerarchia indica quali contenuti devono\nattirare prima l'attenzione e quali"
    },
    {
      "start": 18.08,
      "end": 22.74,
      "text": "restano subordinati. Nel diagramma il\nreticolo di sei colonne rimane comune,"
    },
    {
      "start": 23.36,
      "end": 25.18,
      "text": "mentre il campo dell'immagine occupa tre,"
    },
    {
      "start": 25.86,
      "end": 26.78,
      "text": "due o quattro colonne."
    },
    {
      "start": 27.4,
      "end": 29.8,
      "text": "Sono tre layout possibili sulla stessa\nbase."
    },
    {
      "start": 30.6,
      "end": 34.4,
      "text": "La presenza delle colonne non obbliga\nquindi a riempire ogni cella con un"
    },
    {
      "start": 34.4,
      "end": 35.1,
      "text": "elemento separato."
    },
    {
      "start": 35.92,
      "end": 40.8,
      "text": "La priorità dipende anche da dimensione,\npeso, posizione, contrasto e distanza."
    },
    {
      "start": 41.68,
      "end": 46.0,
      "text": "Se tutto è ugualmente grande e marcato, un\nallineamento accurato non basta a"
    },
    {
      "start": 46.0,
      "end": 47.04,
      "text": "suggerire da dove cominciare."
    },
    {
      "start": 48.1,
      "end": 52.46,
      "text": "Quando analizziamo una pagina chiediamoci\nseparatamente quali possibilità offre la"
    },
    {
      "start": 52.46,
      "end": 55.5,
      "text": "struttura, quali sono state usate e che\ncosa risalta."
    },
    {
      "start": 56.3,
      "end": 58.76,
      "text": "Anche gli spazi vuoti partecipano a queste\ndecisioni."
    }
  ]
}
