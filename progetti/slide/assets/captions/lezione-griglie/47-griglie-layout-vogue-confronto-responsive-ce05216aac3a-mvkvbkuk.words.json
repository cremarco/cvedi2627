  "cues": [
    {
      "start": 0.2,
      "end": 5.14,
      "text": "Osserviamo ora come cambia la disposizione\ndei contenuti tra computer e telefono,"
    },
    {
      "start": 5.22,
      "end": 8.0,
      "text": "confrontando due schermate dello stesso\nsito."
    },
    {
      "start": 8.0,
      "end": 13.26,
      "text": "Le schermate di Vogue Italia sono storiche\ne non conosciamo la data di cattura."
    },
    {
      "start": 13.26,
      "end": 15.82,
      "text": "Ci servono per leggere le disposizioni\nrappresentate,"
    },
    {
      "start": 16.58,
      "end": 18.66,
      "text": "senza attribuirle automaticamente al sito\nattuale."
    },
    {
      "start": 19.84,
      "end": 24.58,
      "text": "Sul desktop, la copertina e il contributo\nintitolato In the bag occupano campi"
    },
    {
      "start": 24.58,
      "end": 25.28,
      "text": "affiancati."
    },
    {
      "start": 25.92,
      "end": 28.62,
      "text": "Sul telefono, il secondo contributo segue\nla copertina."
    },
    {
      "start": 29.6,
      "end": 34.08,
      "text": "La testata è più compatta e il titolo\noccupa più righe."
    },
    {
      "start": 34.08,
      "end": 37.86,
      "text": "Cambia la distribuzione, mentre ritroviamo\nsoggetti e ruoli editoriali."
    },
    {
      "start": 38.86,
      "end": 41.04,
      "text": "L’icona del menu compare in entrambe le\nviste."
    },
    {
      "start": 41.6,
      "end": 45.26,
      "text": "Non possiamo quindi raccontare una\ntrasformazione della navigazione in icona"
    },
    {
      "start": 45.26,
      "end": 48.06,
      "text": "sulla sola base di queste immagini."
    },
    {
      "start": 48.14,
      "end": 52.76,
      "text": "Inoltre, parte dei contenuti è coperta\ndalla sovrapposizione delle schermate."
    },
    {
      "start": 52.96,
      "end": 56.88,
      "text": "Possiamo annotare allineamenti e\nsuccessioni osservabili; il numero delle"
    },
    {
      "start": 56.88,
      "end": 60.38,
      "text": "tracce, le soglie e le voci nascoste\nrichiedono altre verifiche."
    }
  ]
