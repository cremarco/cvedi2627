  "cues": [
    {
      "start": 0.26,
      "end": 4.62,
      "text": "Prima di iniziare, prepariamo il modo in\ncui registreremo i risultati."
    },
    {
      "start": 4.62,
      "end": 8.84,
      "text": "Una matrice di prove mette in relazione\nuna condizione, ciò che accade e"
    },
    {
      "start": 8.84,
      "end": 14.64,
      "text": "l’eventuale correzione. Scrivere soltanto\nfunziona oppure non funziona lascia"
    },
    {
      "start": 14.82,
      "end": 19.88,
      "text": "troppo spazio all’interpretazione. Per\nesempio: contenitore di trecentosessanta"
    },
    {
      "start": 19.88,
      "end": 23.86,
      "text": "pixel, titolo lungo, azione coperta dal\ntesto."
    },
    {
      "start": 23.86,
      "end": 24.98,
      "text": "La prova non è superata."
    },
    {
      "start": 26.04,
      "end": 30.84,
      "text": "Se scopriamo che la causa è un’altezza\nfissa, la eliminiamo e ripetiamo la prova,"
    },
    {
      "start": 30.84,
      "end": 34.64,
      "text": "sia a trecentosessanta sia a\nnovecentosessanta pixel."
    },
    {
      "start": 34.64,
      "end": 39.78,
      "text": "La correzione deve risolvere il problema\nsenza crearne un altro nel formato largo."
    },
    {
      "start": 39.78,
      "end": 42.82,
      "text": "Annotiamo contenuto, larghezza e\ningrandimento,"
    },
    {
      "start": 43.54,
      "end": 45.26,
      "text": "poi combiniamo le condizioni pertinenti."
    },
    {
      "start": 46.04,
      "end": 48.3,
      "text": "Se la stessa correzione serve in molte\nschede,"
    },
    {
      "start": 48.84,
      "end": 49.94,
      "text": "controlliamo la regola comune."
    },
    {
      "start": 50.78,
      "end": 54.4,
      "text": "Descriviamo la prova con abbastanza\nprecisione da poterla ripetere e"
    },
    {
      "start": 54.4,
      "end": 55.3,
      "text": "confrontare i risultati."
    }
  ]
}
