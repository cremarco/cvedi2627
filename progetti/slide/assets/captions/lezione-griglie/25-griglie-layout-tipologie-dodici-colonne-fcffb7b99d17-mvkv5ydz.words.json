  "cues": [
    {
      "start": 0.26,
      "end": 4.54,
      "text": "Dodici colonne sono frequenti perché il\nnumero dodici consente diverse divisioni"
    },
    {
      "start": 4.54,
      "end": 5.24,
      "text": "intere."
    },
    {
      "start": 5.66,
      "end": 7.98,
      "text": "Due campi possono occupare sei unità\nciascuno,"
    },
    {
      "start": 8.56,
      "end": 11.5,
      "text": "tre campi quattro unità, quattro campi tre\nunità."
    },
    {
      "start": 12.24,
      "end": 15.96,
      "text": "Le linee di riferimento restano comuni\nmentre cambia il raggruppamento dei"
    },
    {
      "start": 15.96,
      "end": 16.66,
      "text": "contenuti."
    },
    {
      "start": 17.22,
      "end": 19.96,
      "text": "Questo non significa mostrare dodici\nelementi affiancati:"
    },
    {
      "start": 20.9,
      "end": 23.44,
      "text": "anche un solo titolo può attraversare\nl'intero campo."
    },
    {
      "start": 24.12,
      "end": 25.36,
      "text": "Pensate a tre appuntamenti:"
    },
    {
      "start": 25.88,
      "end": 30.08,
      "text": "ciascuno potrebbe occupare quattro unità e\ncontenere servizio, data e comando."
    },
    {
      "start": 30.2,
      "end": 33.24,
      "text": "Ma la regolarità della divisione non\nbasta."
    },
    {
      "start": 33.92,
      "end": 37.86,
      "text": "Se il nome del servizio è lungo, dobbiamo\nverificare che quelle quattro unità"
    },
    {
      "start": 37.86,
      "end": 42.44,
      "text": "lascino spazio sufficiente. Dodici è\ndunque una convenzione utile in certi"
    },
    {
      "start": 42.44,
      "end": 43.14,
      "text": "sistemi."
    },
    {
      "start": 43.4,
      "end": 47.58,
      "text": "Per sceglierla dobbiamo considerare anche\nlo spazio richiesto dai contenuti e gli"
    },
    {
      "start": 47.58,
      "end": 52.08,
      "text": "intervalli fra loro. Questa convenzione\nnon impone una sequenza obbligatoria di"
    },
    {
      "start": 52.08,
      "end": 54.38,
      "text": "colonne per computer, tablet e telefono."
    },
    {
      "start": 55.08,
      "end": 58.34,
      "text": "Altri sistemi scelgono numeri diversi,\ncome vedremo più avanti."
    }
  ]
}
