  "cues": [
    {
      "start": 0.24,
      "end": 4.58,
      "text": "Le ultime fonti approfondiscono\nadattamento e accessibilità."
    },
    {
      "start": 4.58,
      "end": 8.68,
      "text": "Consultatele per sapere come svolgere le\nprove, che risultato aspettarvi e quali"
    },
    {
      "start": 8.68,
      "end": 13.08,
      "text": "eccezioni considerare. Riflusso,\ningrandimento e spaziatura restano"
    },
    {
      "start": 13.08,
      "end": 13.78,
      "text": "verifiche distinte."
    },
    {
      "start": 15.14,
      "end": 16.78,
      "text": "Con questo si conclude la lezione."
    },
    {
      "start": 18.02,
      "end": 19.54,
      "text": "Conservate gli abbozzi e la matrice:"
    },
    {
      "start": 20.38,
      "end": 24.3,
      "text": "mostrano il percorso dalle relazioni\nosservate alle regole scelte e corrette."
    },
    {
      "start": 25.34,
      "end": 28.4,
      "text": "Grazie per l’attenzione, e buon lavoro con\ni vostri progetti."
    }
