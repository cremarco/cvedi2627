  "cues": [
    {
      "start": 0.2,
      "end": 4.3,
      "text": "Un breakpoint è una soglia alla quale\ncambia una regola di layout."
    },
    {
      "start": 4.3,
      "end": 8.22,
      "text": "Possiamo cercarlo partendo dagli ingombri,\ninvece di associarlo subito a un modello"
    },
    {
      "start": 8.22,
      "end": 12.86,
      "text": "di telefono o tablet. Nell'esempio, due\nschede hanno bisogno di almeno"
    },
    {
      "start": 12.86,
      "end": 17.3,
      "text": "duecentoquaranta pixel ci esse esse\nciascuna, compresi bordi e spazi interni."
    },
    {
      "start": 18.24,
      "end": 23.26,
      "text": "Fra loro servono ventiquattro pixel e ai\nlati altri ventiquattro per parte."
    },
    {
      "start": 23.26,
      "end": 27.32,
      "text": "Duecentoquaranta più duecentoquaranta fa\nquattrocentottanta."
    },
    {
      "start": 27.32,
      "end": 31.46,
      "text": "Aggiungiamo ventiquattro pixel fra le\nschede e quarantotto per i margini: in"
    },
    {
      "start": 31.46,
      "end": 33.46,
      "text": "tutto cinquecentocinquantadue pixel."
    },
    {
      "start": 34.4,
      "end": 38.36,
      "text": "Sotto questa larghezza del contenitore le\ndue schede si impilano."
    },
    {
      "start": 38.36,
      "end": 42.12,
      "text": "La soglia risolve questo caso, non ogni\nraccolta di schede."
    },
    {
      "start": 42.22,
      "end": 46.92,
      "text": "Proviamo misure appena sotto e sopra,\ntesti più lunghi e ingrandimento."
    },
    {
      "start": 46.96,
      "end": 51.6,
      "text": "Ricordiamo anche che il pixel ci esse esse\nè un'unità logica, distinta dal singolo"
    },
    {
      "start": 51.6,
      "end": 56.08,
      "text": "pixel fisico dello schermo. Per applicare\nla regola dobbiamo infine dichiarare"
    },
    {
      "start": 56.08,
      "end": 60.6,
      "text": "rispetto a quale spazio misuriamo la\nsoglia: l'intera finestra oppure il"
    },
    {
      "start": 60.6,
      "end": 63.4,
      "text": "contenitore effettivamente disponibile al\ncomponente?"
    }
  ]
}
