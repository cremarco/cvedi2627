  "cues": [
    {
      "start": 0.18,
      "end": 4.38,
      "text": "La prima attività consiste nel ricomporre\ngli stessi materiali in tre strutture."
    },
    {
      "start": 5.64,
      "end": 9.9,
      "text": "Realizzate un abbozzo a una colonna\ncontinua, uno su una gabbia a sei unità e"
    },
    {
      "start": 9.9,
      "end": 10.6,
      "text": "uno modulare."
    },
    {
      "start": 11.26,
      "end": 13.7,
      "text": "Sono schemi rapidi: devono chiarire le\nscelte,"
    },
    {
      "start": 14.2,
      "end": 15.98,
      "text": "senza diventare tre impaginati rifiniti."
    },
    {
      "start": 17.4,
      "end": 22.82,
      "text": "Per ogni proposta indicate dove inizia la\nlettura, come prosegue e dove si trova la"
    },
    {
      "start": 22.82,
      "end": 27.7,
      "text": "nota di servizio. Conservate titolo,\npresentazione, tre appuntamenti e"
    },
    {
      "start": 27.7,
      "end": 28.4,
      "text": "immagine."
    },
    {
      "start": 29.24,
      "end": 33.32,
      "text": "Una figura può attraversare più unità e un\ncontenuto può richiedere un campo"
    },
    {
      "start": 33.32,
      "end": 37.88,
      "text": "maggiore. Confrontate gli abbozzi alla\nstessa dimensione."
    },
    {
      "start": 37.88,
      "end": 41.1,
      "text": "Cercate righe troppo lunghe, gruppi\nspezzati e dettagli persi."
    },
    {
      "start": 42.52,
      "end": 47.34,
      "text": "Il risultato atteso è un confronto fra tre\npossibilità, con una ragione per scegliere"
    },
    {
      "start": 47.34,
      "end": 48.04,
      "text": "quella da sviluppare."
    },
    {
      "start": 49.5,
      "end": 51.42,
      "text": "Evitate di votare soltanto la più\ngradevole:"
    },
    {
      "start": 52.32,
      "end": 54.24,
      "text": "spiegate quale relazione sostiene meglio."
    },
    {
      "start": 55.74,
      "end": 57.48,
      "text": "Sospendete ora l’audio per otto minuti."
    },
    {
      "start": 58.06,
      "end": 61.9,
      "text": "Alla ripresa useremo una delle proposte\nper descriverne l’adattamento."
    }
  ]
}
