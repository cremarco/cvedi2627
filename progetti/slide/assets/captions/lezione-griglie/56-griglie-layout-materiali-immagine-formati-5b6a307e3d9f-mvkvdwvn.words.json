  "cues": [
    {
      "start": 0.38,
      "end": 4.34,
      "text": "Guardate l’immagine del kit: il\nriferimento da conservare è il cerchio"
    },
    {
      "start": 4.34,
      "end": 5.48,
      "text": "giallo sul lato destro."
    },
    {
      "start": 6.2,
      "end": 8.9,
      "text": "Non basta che rimanga una piccola porzione\nriconoscibile:"
    },
    {
      "start": 9.66,
      "end": 11.54,
      "text": "deve restare interamente visibile."
    },
    {
      "start": 12.54,
      "end": 15.4,
      "text": "Questo vincolo permette di valutare\nl’effetto del ritaglio."
    },
    {
      "start": 15.86,
      "end": 20.8,
      "text": "Le due larghezze di contenitore saranno\nnovecentosessanta e trecentosessanta pixel"
    },
    {
      "start": 20.8,
      "end": 25.6,
      "text": "ci esse esse. Sono condizioni comuni per\nconfrontare le proposte dell’esercizio,"
    },
    {
      "start": 25.72,
      "end": 28.08,
      "text": "non soglie universali da applicare a ogni\nprogetto."
    },
    {
      "start": 28.9,
      "end": 33.38,
      "text": "Nella variante stretta controllate insieme\nimmagine e testo."
    },
    {
      "start": 33.38,
      "end": 37.08,
      "text": "Conservare il cerchio perdendo una data\nnon risolve la consegna."
    },
    {
      "start": 37.08,
      "end": 41.38,
      "text": "Dovrete descrivere una regola che mantenga\ndisponibili tutti i contenuti nei due"
    },
    {
      "start": 41.38,
      "end": 42.08,
      "text": "formati."
    }
  ]
