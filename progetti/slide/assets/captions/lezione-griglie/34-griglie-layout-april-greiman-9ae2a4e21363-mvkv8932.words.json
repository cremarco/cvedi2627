  "cues": [
    {
      "start": 0.32,
      "end": 5.06,
      "text": "Dopo le proporzioni regolari, osserviamo\nun’opera costruita con sovrapposizioni e"
    },
    {
      "start": 5.06,
      "end": 6.48,
      "text": "forti differenze di scala."
    },
    {
      "start": 7.48,
      "end": 11.76,
      "text": "Nel millenovecentottantasei April Greiman\nrealizza Does It Make Sense?"
    },
    {
      "start": 12.2,
      "end": 14.48,
      "text": "per il numero centotrentatré di Design\nQuarterly."
    },
    {
      "start": 15.34,
      "end": 19.9,
      "text": "L'opera si ripiega nel formato della\nrivista e combina un corpo digitalizzato"
    },
    {
      "start": 19.9,
      "end": 21.8,
      "text": "con immagini, segni e testi."
    },
    {
      "start": 22.64,
      "end": 23.98,
      "text": "Il corpo attraversa il"
    },
    {
      "start": 24.58,
      "end": 28.08,
      "text": "campo; intorno compaiono altri centri di\nattenzione."
    },
    {
      "start": 28.1,
      "end": 33.06,
      "text": "Seguite come le sovrapposizioni e i cambi\ndi dimensione costruiscono relazioni,"
    },
    {
      "start": 33.06,
      "end": 34.86,
      "text": "invece di cercare soltanto colonne\nregolari."
    },
    {
      "start": 35.84,
      "end": 40.76,
      "text": "La testimonianza dell'autrice collega il\nlavoro al passaggio da video a pixel."
    },
    {
      "start": 40.76,
      "end": 45.3,
      "text": "Quello che vediamo permette di descrivere\nscelte compositive, ma non di concludere"
    },
    {
      "start": 45.3,
      "end": 46.76,
      "text": "che l'opera sia priva di struttura."
    },
    {
      "start": 47.56,
      "end": 52.04,
      "text": "Anche un'immagine apparentemente libera\npuò organizzare direzioni, distanze e"
    },
    {
      "start": 52.04,
      "end": 56.96,
      "text": "pesi. Ci interessa capire quali rapporti\npropone e quale esperienza di lettura"
    },
    {
      "start": 56.96,
      "end": 57.66,
      "text": "rende possibile."
    }
  ]
}
