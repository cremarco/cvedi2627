  "cues": [
    {
      "start": 0.3,
      "end": 3.8,
      "text": "Applichiamo ora queste domande a un\ncompito concreto."
    },
    {
      "start": 3.8,
      "end": 7.8,
      "text": "Sara, nel nostro esempio simulato, ha\nprenotato una visita e vuole cambiare"
    },
    {
      "start": 7.8,
      "end": 8.5,
      "text": "giorno."
    },
    {
      "start": 9.34,
      "end": 13.46,
      "text": "Prima deve riconoscere la prenotazione\ncorretta e trovare l’azione di modifica."
    },
    {
      "start": 14.72,
      "end": 19.3,
      "text": "Nel primo assetto la promozione richiama\nl’attenzione e il comando è lontano dai"
    },
    {
      "start": 19.3,
      "end": 20.06,
      "text": "dati pertinenti."
    },
    {
      "start": 20.9,
      "end": 22.36,
      "text": "Nel secondo, servizio,"
    },
    {
      "start": 22.88,
      "end": 24.62,
      "text": "data e azione condividono un’area."
    },
    {
      "start": 25.74,
      "end": 27.38,
      "text": "Il titolo identifica la prenotazione,"
    },
    {
      "start": 28.3,
      "end": 32.84,
      "text": "la data permette di riconoscerla e il\ncomando resta vicino a entrambi."
    },
    {
      "start": 32.84,
      "end": 36.02,
      "text": "Cambia la priorità assegnata alle\ninformazioni."
    },
    {
      "start": 36.02,
      "end": 38.14,
      "text": "Questa è un’ipotesi da verificare."
    },
    {
      "start": 38.14,
      "end": 42.78,
      "text": "Chiediamo di spostare la visita senza\nindicare il comando e osserviamo percorso,"
    },
    {
      "start": 42.78,
      "end": 48.14,
      "text": "esitazioni ed esito. Se l’azione resta\npoco chiara, avvicinarla ai dati potrebbe"
    },
    {
      "start": 48.14,
      "end": 48.84,
      "text": "non bastare:"
    },
    {
      "start": 49.66,
      "end": 52.42,
      "text": "controlliamo anche le parole\ndell’etichetta e la risposta all’azione."
    },
    {
      "start": 53.48,
      "end": 55.72,
      "text": "Ripetiamo poi le prove di adattamento\nappena descritte."
    }
  ]
}
