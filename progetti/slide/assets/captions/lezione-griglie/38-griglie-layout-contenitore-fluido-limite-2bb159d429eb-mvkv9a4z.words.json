  "cues": [
    {
      "start": 0.34,
      "end": 4.52,
      "text": "Immaginiamo un campo centrato che lasci\nalmeno ventiquattro pixel ci esse esse"
    },
    {
      "start": 4.52,
      "end": 8.14,
      "text": "liberi per lato e non superi\nnovecentosessanta pixel di larghezza."
    },
    {
      "start": 9.46,
      "end": 11.32,
      "text": "La formula ci fa confrontare due quantità:"
    },
    {
      "start": 12.22,
      "end": 16.92,
      "text": "lo spazio disponibile meno i due margini\nminimi e il massimo consentito."
    },
    {
      "start": 16.92,
      "end": 18.96,
      "text": "Il campo prende la più piccola delle due."
    },
    {
      "start": 19.66,
      "end": 23.42,
      "text": "Con una larghezza disponibile di\nsettecentoventi pixel, sottraiamo"
    },
    {
      "start": 23.42,
      "end": 26.44,
      "text": "quarantotto pixel e otteniamo\nseicentosettantadue."
    },
    {
      "start": 27.12,
      "end": 28.32,
      "text": "Non abbiamo raggiunto il massimo,"
    },
    {
      "start": 28.94,
      "end": 33.02,
      "text": "quindi il contenitore segue la finestra e\nlascia ventiquattro pixel per lato."
    },
    {
      "start": 33.76,
      "end": 37.74,
      "text": "Con milleduecentottanta pixel disponibili,\ninvece, la sottrazione darebbe"
    },
    {
      "start": 37.74,
      "end": 41.44,
      "text": "milleduecentotrentadue. Il campo si ferma\na novecentosessanta:"
    },
    {
      "start": 42.24,
      "end": 46.42,
      "text": "i trecentoventi pixel rimanenti si\ndividono in due margini da centosessanta."
    },
    {
      "start": 47.44,
      "end": 49.28,
      "text": "Il calcolo vale per un campo centrato,"
    },
    {
      "start": 49.76,
      "end": 52.62,
      "text": "senza una barra laterale che gli sottragga\nspazio."
    },
    {
      "start": 52.66,
      "end": 57.12,
      "text": "In ci esse esse, fissare la larghezza\nmassima non centra il contenitore e non"
    },
    {
      "start": 57.12,
      "end": 59.26,
      "text": "crea i margini: sono decisioni separate."
    },
    {
      "start": 60.38,
      "end": 65.06,
      "text": "Inoltre raggiungere quel massimo non\nsignifica cambiare disposizione: il campo"
    },
    {
      "start": 65.06,
      "end": 67.72,
      "text": "può smettere di crescere mantenendo gli\nstessi gruppi."
    },
    {
      "start": 68.6,
      "end": 69.76,
      "text": "Questi numeri descrivono"
    },
    {
      "start": 70.44,
      "end": 72.9,
      "text": "l'esempio; la misura adatta dipende sempre\ndai contenuti."
    }
  ]
}
