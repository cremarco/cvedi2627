  "cues": [
    {
      "start": 0.24,
      "end": 5.14,
      "text": "L'affiancamento di due campi non comunica,\nda solo, come leggerli."
    },
    {
      "start": 5.14,
      "end": 9.24,
      "text": "Nel primo esempio abbiamo un unico\narticolo: arrivati in fondo alla colonna"
    },
    {
      "start": 9.24,
      "end": 12.64,
      "text": "sinistra, riprendiamo dall'inizio di\nquella destra."
    },
    {
      "start": 12.64,
      "end": 17.24,
      "text": "Titolo e continuità del testo devono\nrendere comprensibile questo passaggio."
    },
    {
      "start": 17.24,
      "end": 22.4,
      "text": "Nel secondo esempio, invece, ogni servizio\ncostituisce un'unità completa, con titolo,"
    },
    {
      "start": 22.7,
      "end": 27.38,
      "text": "data e azione. Leggere prima tutto il\ncampo sinistro oppure passare al destro"
    },
    {
      "start": 27.38,
      "end": 32.22,
      "text": "non interrompe una frase. Vicinanza ed\netichette aiutano a riconoscere questi"
    },
    {
      "start": 32.22,
      "end": 36.58,
      "text": "gruppi. Quando progettate colonne,\nstabilite quindi se ospitano la"
    },
    {
      "start": 36.58,
      "end": 39.32,
      "text": "continuazione di un discorso o contenuti\nautonomi."
    },
    {
      "start": 39.94,
      "end": 42.22,
      "text": "La disposizione deve confermare quella\nscelta."
    }
  ]
}
