  "cues": [
    {
      "start": 0.14,
      "end": 4.44,
      "text": "Per approfondire sistemi e opere, partite\ndalle fonti raccolte qui."
    },
    {
      "start": 4.44,
      "end": 7.46,
      "text": "Il manuale di Müller Brockmann sviluppa il\nmetodo della"
    },
    {
      "start": 8.04,
      "end": 13.08,
      "text": "griglia; le schede documentarie aiutano a\nleggere le opere nel loro contesto."
    },
    {
      "start": 13.08,
      "end": 14.16,
      "text": "Unigrid e i sistemi"
    },
    {
      "start": 14.72,
      "end": 18.72,
      "text": "digitali mostrano come regole condivise\npossano coordinare contenuti diversi."
    },
    {
      "start": 19.82,
      "end": 23.94,
      "text": "Sono riferimenti da studiare nelle\nrispettive condizioni d’uso, evitando di"
    },
    {
      "start": 23.94,
      "end": 26.72,
      "text": "trasformare le loro misure in prescrizioni\nuniversali."
    }
  ]
