  "cues": [
    {
      "start": 0.24,
      "end": 2.9,
      "text": "Qui il contenuto è una lista di\nappuntamenti simulata."
    },
    {
      "start": 3.64,
      "end": 6.88,
      "text": "Per riconoscere una prenotazione servono\nil servizio e la"
    },
    {
      "start": 7.38,
      "end": 11.32,
      "text": "data; per intervenire serve anche trovare\nil comando pertinente."
    },
    {
      "start": 11.32,
      "end": 15.6,
      "text": "Se questi dati cambiassero posizione a\nogni riga, dovremmo capire da capo quali"
    },
    {
      "start": 15.6,
      "end": 16.4,
      "text": "dati vanno insieme."
    },
    {
      "start": 17.48,
      "end": 20.52,
      "text": "Nell'esempio date e azioni tornano sulle\nstesse verticali."
    },
    {
      "start": 21.34,
      "end": 24.74,
      "text": "Lo sguardo può confrontare un'informazione\ncon quella della riga successiva."
    },
    {
      "start": 25.8,
      "end": 30.78,
      "text": "Anche il bianco lavora: un intervallo più\nampio separa due prenotazioni, mentre una"
    },
    {
      "start": 30.78,
      "end": 34.56,
      "text": "distanza più breve tiene vicini etichetta\ne valore."
    },
    {
      "start": 34.56,
      "end": 38.84,
      "text": "Questo disegno propone una soluzione, ma\nnon dimostra da solo che ogni persona sarà"
    },
    {
      "start": 38.84,
      "end": 43.42,
      "text": "più veloce. Per verificarlo possiamo\nchiedere di trovare la prenotazione di un"
    },
    {
      "start": 43.42,
      "end": 44.12,
      "text": "certo servizio,"
    },
    {
      "start": 44.76,
      "end": 45.84,
      "text": "senza suggerire dove guardare."
    },
    {
      "start": 46.86,
      "end": 48.18,
      "text": "Osserviamo come la persona procede,"
    },
    {
      "start": 48.82,
      "end": 50.44,
      "text": "dove esita e quali errori commette."
    },
    {
      "start": 51.3,
      "end": 54.98,
      "text": "La domanda sul layout diventa così una\ndomanda su un compito preciso."
    },
    {
      "start": 55.86,
      "end": 60.38,
      "text": "Per descrivere bene la soluzione dobbiamo\nperò distinguere tre termini che spesso"
    },
    {
      "start": 60.38,
      "end": 61.08,
      "text": "vengono sovrapposti."
    }
  ]
}
