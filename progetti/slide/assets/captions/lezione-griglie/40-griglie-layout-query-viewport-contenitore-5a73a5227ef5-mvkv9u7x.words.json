  "cues": [
    {
      "start": 0.3,
      "end": 1.78,
      "text": "La distinzione è visibile qui:"
    },
    {
      "start": 2.5,
      "end": 6.74,
      "text": "la finestra resta larga\nmilleduecentottanta pixel ci esse esse, ma"
    },
    {
      "start": 6.74,
      "end": 9.94,
      "text": "contiene un campo da trecentoventi e uno\nda seicentoquaranta."
    },
    {
      "start": 11.06,
      "end": 15.56,
      "text": "Le stesse schede si impilano nel primo e\nsi affiancano nel secondo, usando la"
    },
    {
      "start": 15.56,
      "end": 18.46,
      "text": "soglia di cinquecentocinquantadue pixel\nappena calcolata."
    },
    {
      "start": 19.22,
      "end": 21.98,
      "text": "Una media query sulla larghezza considera\nil viewport."
    },
    {
      "start": 22.78,
      "end": 27.04,
      "text": "Una container query considera invece la\nlarghezza del contenitore che ospita il"
    },
    {
      "start": 27.04,
      "end": 30.0,
      "text": "componente, se è stato predisposto per\nquesto controllo."
    },
    {
      "start": 30.46,
      "end": 34.48,
      "text": "Questo permette di adattare una scheda\nallo spazio che riceve dentro una barra"
    },
    {
      "start": 34.48,
      "end": 38.14,
      "text": "laterale oppure nell'area principale della\nstessa pagina."
    },
    {
      "start": 38.14,
      "end": 40.08,
      "text": "Il contenuto e il criterio restano"
    },
    {
      "start": 40.68,
      "end": 42.2,
      "text": "uguali; cambia il riferimento della\nmisura."
    },
    {
      "start": 42.82,
      "end": 46.16,
      "text": "Perciò documentare soltanto un numero non\nbasta."
    },
    {
      "start": 46.16,
      "end": 50.22,
      "text": "Occorre precisare quale contenitore\ngoverna il cambiamento e verificare il"
    },
    {
      "start": 50.22,
      "end": 52.38,
      "text": "componente nei contesti in cui sarà usato."
    }
  ]
}
