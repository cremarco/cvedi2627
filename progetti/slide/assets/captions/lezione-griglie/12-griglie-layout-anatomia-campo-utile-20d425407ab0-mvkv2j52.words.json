  "cues": [
    {
      "start": 0.28,
      "end": 3.24,
      "text": "Prima di scegliere le colonne dobbiamo\nconoscere il supporto,"
    },
    {
      "start": 3.8,
      "end": 5.96,
      "text": "lo spazio disponibile e i contenuti da\nospitare."
    },
    {
      "start": 7.32,
      "end": 10.44,
      "text": "Nel diagramma il foglio e il campo\nutilizzabile sono distinti:"
    },
    {
      "start": 11.3,
      "end": 15.42,
      "text": "ciò che resta all'esterno della gabbia\nsvolge comunque un compito."
    },
    {
      "start": 15.42,
      "end": 19.3,
      "text": "Nel libro il margine interno tiene conto\ndel dorso e della rilegatura."
    },
    {
      "start": 19.88,
      "end": 23.7,
      "text": "Il margine esterno separa i contenuti dal\ntaglio della pagina."
    },
    {
      "start": 23.7,
      "end": 24.4,
      "text": "Il piede,"
    },
    {
      "start": 24.74,
      "end": 29.2,
      "text": "cioè il margine inferiore, lascia spazio\nanche al folio, il numero di pagina."
    },
    {
      "start": 29.2,
      "end": 34.16,
      "text": "Non sono necessariamente distanze uguali,\nperché rispondono a condizioni diverse."
    },
    {
      "start": 34.16,
      "end": 38.52,
      "text": "Nell'interfaccia dobbiamo considerare\nanche la finestra, la navigazione e le"
    },
    {
      "start": 38.52,
      "end": 39.92,
      "text": "aree riservate ai controlli."
    },
    {
      "start": 40.58,
      "end": 44.12,
      "text": "Lo spazio che sembra libero nello schermo\npotrebbe già avere una funzione."
    },
    {
      "start": 45.14,
      "end": 49.14,
      "text": "Definire il campo utile significa\nstabilire quali parti possiamo davvero"
    },
    {
      "start": 49.14,
      "end": 52.54,
      "text": "organizzare e quali limiti dobbiamo\nrispettare."
    },
    {
      "start": 52.6,
      "end": 55.5,
      "text": "Dentro quel campo possiamo cominciare a\ncostruire il reticolo."
    }
  ]
}
