  "cues": [
    {
      "start": 0.22,
      "end": 3.04,
      "text": "La formula segue un procedimento semplice."
    },
    {
      "start": 3.04,
      "end": 7.52,
      "text": "Dalla larghezza totale togliamo il margine\nsinistro, quello destro e tutti gli"
    },
    {
      "start": 7.52,
      "end": 12.28,
      "text": "intervalli fra le colonne. Dividiamo poi\nlo spazio rimasto per il numero di colonne"
    },
    {
      "start": 12.28,
      "end": 13.44,
      "text": "uguali che vogliamo ottenere."
    },
    {
      "start": 14.42,
      "end": 17.12,
      "text": "Nell'esempio il foglio misura\ncentosettanta millimetri."
    },
    {
      "start": 18.04,
      "end": 22.84,
      "text": "Sottraiamo quindici millimetri a sinistra,\ndiciotto a destra e cinque per l'unica"
    },
    {
      "start": 22.84,
      "end": 23.54,
      "text": "intercolonna."
    },
    {
      "start": 24.32,
      "end": 27.3,
      "text": "Restano centotrentadue millimetri\ndestinati alle due colonne."
    },
    {
      "start": 28.28,
      "end": 31.48,
      "text": "Dividendoli per due otteniamo sessantasei\nmillimetri per ciascuna."
    },
    {
      "start": 32.36,
      "end": 36.98,
      "text": "Per contare gli intervalli ricordate che\nstanno fra le colonne: due colonne hanno"
    },
    {
      "start": 36.98,
      "end": 39.36,
      "text": "un intervallo, tre colonne ne hanno due."
    },
    {
      "start": 40.0,
      "end": 42.74,
      "text": "I margini esterni sono già stati sottratti\nseparatamente."
    },
    {
      "start": 43.76,
      "end": 47.86,
      "text": "Il calcolo distribuisce correttamente la\nlarghezza, ma non dimostra ancora che il"
    },
    {
      "start": 47.86,
      "end": 52.54,
      "text": "testo si legga bene. Ora possiamo usare\nquelle misure per assegnare a un elemento"
    },
    {
      "start": 52.54,
      "end": 56.685,
      "text": "uno spazio più ampio, attraversando più\ncolonne dello stesso reticolo."
    }
  ]
}
