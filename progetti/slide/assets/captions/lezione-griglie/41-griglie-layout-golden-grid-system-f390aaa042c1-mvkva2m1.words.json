  "cues": [
    {
      "start": 0.16,
      "end": 4.96,
      "text": "Il Golden Grid System di Joni Korpi è un\nesempio storico di griglia fluida e"
    },
    {
      "start": 4.96,
      "end": 10.26,
      "text": "ripiegabile. Parte da diciotto colonne\nuguali: due funzionano come margini"
    },
    {
      "start": 10.26,
      "end": 13.46,
      "text": "esterni e sedici restano disponibili per\nil layout."
    },
    {
      "start": 14.22,
      "end": 17.9,
      "text": "I gruppi possono essere accorpati in otto\no quattro campi più larghi."
    },
    {
      "start": 18.64,
      "end": 23.0,
      "text": "Il diagramma rende leggibile questa\noperazione: diminuisce il numero dei campi"
    },
    {
      "start": 23.0,
      "end": 24.36,
      "text": "e aumenta la loro larghezza."
    },
    {
      "start": 25.16,
      "end": 28.14,
      "text": "Non si tratta di far scomparire\narbitrariamente i contenuti,"
    },
    {
      "start": 28.62,
      "end": 30.6,
      "text": "ma di riorganizzare lo spazio che\noccupano."
    },
    {
      "start": 31.34,
      "end": 35.46,
      "text": "Il nome Golden non significa che la\ndivisione utilizzi il rapporto aureo"
    },
    {
      "start": 35.46,
      "end": 39.8,
      "text": "studiato prima. Il progetto originale è\nconservato in un repository archiviato."
    },
    {
      "start": 40.32,
      "end": 44.5,
      "text": "Lo consideriamo utile per comprendere un\nmetodo, senza assumerlo come soluzione"
    },
    {
      "start": 44.5,
      "end": 46.88,
      "text": "necessaria per un prodotto attuale."
    },
    {
      "start": 46.88,
      "end": 50.86,
      "text": "L'aspetto da riprendere è il rapporto\nesplicito fra struttura di base e"
    },
    {
      "start": 50.86,
      "end": 52.427,
      "text": "trasformazione dei campi."
    }
  ]
}
