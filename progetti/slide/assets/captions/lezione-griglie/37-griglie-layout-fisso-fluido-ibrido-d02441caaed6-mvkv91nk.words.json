  "cues": [
    {
      "start": 0.3,
      "end": 4.0,
      "text": "Fisso e fluido descrivono il comportamento\ndi una misura."
    },
    {
      "start": 4.0,
      "end": 6.08,
      "text": "Nel layout fisso una larghezza resta"
    },
    {
      "start": 6.96,
      "end": 9.24,
      "text": "costante; nel layout fluido segue lo\nspazio disponibile."
    },
    {
      "start": 10.26,
      "end": 14.26,
      "text": "Nello stesso progetto possono convivere\nentrambi i comportamenti, creando un"
    },
    {
      "start": 14.26,
      "end": 18.8,
      "text": "assetto ibrido. Nel confronto, per\nesempio, il menu conserva la propria"
    },
    {
      "start": 18.8,
      "end": 21.28,
      "text": "larghezza mentre il campo principale si\nadatta."
    },
    {
      "start": 21.9,
      "end": 25.72,
      "text": "Questa scelta può funzionare finché l'area\ndei contenuti mantiene una larghezza"
    },
    {
      "start": 25.72,
      "end": 30.44,
      "text": "sufficiente per leggere. Riducendo ancora\nla finestra, però, il menu potrebbe"
    },
    {
      "start": 30.44,
      "end": 33.18,
      "text": "lasciare troppo poco spazio alla lettura."
    },
    {
      "start": 33.18,
      "end": 37.36,
      "text": "A quel punto non basta continuare a\nrestringere il campo: serve cambiare la"
    },
    {
      "start": 37.36,
      "end": 42.02,
      "text": "disposizione della navigazione. La\nfluidità ha dunque bisogno di limiti e"
    },
    {
      "start": 42.02,
      "end": 42.72,
      "text": "regole:"
    },
    {
      "start": 43.16,
      "end": 46.48,
      "text": "larghezze minime, larghezze massime e\nritorni a capo."
    },
    {
      "start": 46.48,
      "end": 50.08,
      "text": "Il progetto responsivo può combinare\nquesti strumenti con cambi di assetto."
    },
    {
      "start": 50.78,
      "end": 54.8,
      "text": "Per capire quando servono, osserviamo\nprima un contenitore che cresce senza"
    },
    {
      "start": 54.8,
      "end": 56.04,
      "text": "superare una misura massima."
    }
  ]
}
