  "cues": [
    {
      "start": 0.26,
      "end": 3.3,
      "text": "Le singole schermate acquistano\nsignificato quando le colleghiamo."
    },
    {
      "start": 4.3,
      "end": 5.44,
      "text": "Sara arriva dalla prenotazione,"
    },
    {
      "start": 6.16,
      "end": 8.32,
      "text": "sceglie una nuova data e raggiunge il\nriepilogo."
    },
    {
      "start": 9.38,
      "end": 13.3,
      "text": "Prima di confermare deve poter controllare\nil giorno e l’orario che sta per"
    },
    {
      "start": 13.3,
      "end": 14.0,
      "text": "accettare."
    },
    {
      "start": 14.42,
      "end": 18.42,
      "text": "Dopo la conferma deve capire che la\nmodifica è riuscita e riconoscere quale"
    },
    {
      "start": 18.42,
      "end": 22.94,
      "text": "appuntamento è stato aggiornato. Il\ndisegno a bassa definizione collega questi"
    },
    {
      "start": 22.94,
      "end": 23.64,
      "text": "stati:"
    },
    {
      "start": 24.16,
      "end": 28.7,
      "text": "mostra da dove arriva Sara, che cosa può\nfare e quale risultato ottiene."
    },
    {
      "start": 28.7,
      "end": 32.5,
      "text": "Non basta che ciascuna schermata sia\nordinata: dobbiamo poter seguire il"
    },
    {
      "start": 32.5,
      "end": 34.06,
      "text": "passaggio dall’una all’altra."
    },
    {
      "start": 34.88,
      "end": 38.68,
      "text": "Se il riepilogo perde il riferimento alla\nvisita o il messaggio finale resta"
    },
    {
      "start": 38.68,
      "end": 40.96,
      "text": "generico, il percorso lascia\nun’incertezza."
    },
    {
      "start": 41.78,
      "end": 43.5,
      "text": "La prova osserva il compito completo,"
    },
    {
      "start": 44.26,
      "end": 45.96,
      "text": "compreso il riconoscimento del risultato."
    },
    {
      "start": 46.72,
      "end": 50.48,
      "text": "Possiamo così distinguere un problema di\ndisposizione da uno di etichette,"
    },
    {
      "start": 51.28,
      "end": 52.56,
      "text": "stato o risposta del sistema."
    }
  ]
}
