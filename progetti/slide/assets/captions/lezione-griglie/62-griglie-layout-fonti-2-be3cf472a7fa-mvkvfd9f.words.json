  "cues": [
    {
      "start": 0.2,
      "end": 4.3,
      "text": "Questa seconda raccolta riguarda la\ncostruzione dei layout e il trattamento"
    },
    {
      "start": 4.3,
      "end": 8.5,
      "text": "delle immagini. Gli standard descrivono il\ncomportamento delle"
    },
    {
      "start": 9.3,
      "end": 14.5,
      "text": "proprietà; la documentazione tecnica offre\nspiegazioni ed esempi per sperimentarlo."
    },
    {
      "start": 14.5,
      "end": 18.64,
      "text": "Consultatela quando dovete distinguere il\nriquadro misurato, l’allineamento fra le"
    },
    {
      "start": 18.64,
      "end": 21.02,
      "text": "righe, la scelta della risorsa o\nl’inquadratura."
    },
    {
      "start": 21.94,
      "end": 26.78,
      "text": "La verifica più utile collega una regola\ndocumentata a un piccolo caso concreto del"
    },
    {
      "start": 26.78,
      "end": 27.52,
      "text": "vostro progetto."
    }
  ]
