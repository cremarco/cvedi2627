  "cues": [
    {
      "start": 0.18,
      "end": 3.52,
      "text": "Nel manuale pubblicato nel\nmillenovecentottantuno, Josef"
    },
    {
      "start": 3.52,
      "end": 6.88,
      "text": "Müller-Brockmann presenta la griglia come\nuno strumento sistematico."
    },
    {
      "start": 8.18,
      "end": 12.96,
      "text": "Il formato, i margini, le colonne, le\nsuddivisioni orizzontali e i caratteri"
    },
    {
      "start": 12.96,
      "end": 14.0,
      "text": "vengono messi in rapporto."
    },
    {
      "start": 14.94,
      "end": 19.3,
      "text": "La posizione di ogni elemento dipende\ndalle altre scelte e può essere spiegata"
    },
    {
      "start": 19.3,
      "end": 20.84,
      "text": "anche a chi lavorerà sul progetto."
    },
    {
      "start": 21.66,
      "end": 23.56,
      "text": "Il diagramma interpreta questo metodo."
    },
    {
      "start": 24.2,
      "end": 29.06,
      "text": "Da una parte ogni elemento è disposto per\nconto proprio; dall’altra, un sistema di"
    },
    {
      "start": 29.06,
      "end": 31.08,
      "text": "guide permette di costruire pagine\ndiverse."
    },
    {
      "start": 32.1,
      "end": 35.78,
      "text": "Non stiamo osservando una riproduzione\ndelle tavole del manuale, ma una"
    },
    {
      "start": 35.78,
      "end": 38.66,
      "text": "spiegazione del suo principio\norganizzativo."
    },
    {
      "start": 38.7,
      "end": 42.78,
      "text": "Possiamo così discutere il progetto e\nmotivare perché un'immagine occupa un"
    },
    {
      "start": 42.78,
      "end": 46.08,
      "text": "certo spazio e perché la didascalia segue\nuna misura diversa."
    },
    {
      "start": 47.0,
      "end": 50.08,
      "text": "La ripetizione rende confrontabili le\nscelte."
    },
    {
      "start": 50.08,
      "end": 53.92,
      "text": "Se il contenuto non trova una forma\nleggibile, però, va rivista anche la"
    },
    {
      "start": 53.92,
      "end": 57.46,
      "text": "struttura. Per vedere come questi rapporti\npossano diventare espressivi,"
    },
    {
      "start": 58.5,
      "end": 60.08,
      "text": "osserviamo un manifesto dello stesso\nautore."
    }
  ]
}
