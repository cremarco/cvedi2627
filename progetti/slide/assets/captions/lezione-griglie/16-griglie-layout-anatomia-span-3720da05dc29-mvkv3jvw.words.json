  "cues": [
    {
      "start": 0.18,
      "end": 4.16,
      "text": "Un elemento che attraversa più colonne\noccupa anche gli intervalli interni"
    },
    {
      "start": 4.16,
      "end": 5.38,
      "text": "all'area che abbiamo riunito."
    },
    {
      "start": 6.28,
      "end": 9.3,
      "text": "Pensate a un'immagine che si estende da\nuna colonna alla successiva:"
    },
    {
      "start": 10.38,
      "end": 13.88,
      "text": "non lascia necessariamente una fessura\nvuota in corrispondenza dell'intercolonna."
    },
    {
      "start": 14.92,
      "end": 18.58,
      "text": "Quello spazio entra nella sua larghezza\ncomplessiva."
    },
    {
      "start": 18.62,
      "end": 22.86,
      "text": "Riprendiamo il caso precedente. Due\ncolonne da sessantasei millimetri, con"
    },
    {
      "start": 22.86,
      "end": 27.26,
      "text": "cinque millimetri fra loro, formano\nun'area larga centotrentasette millimetri."
    },
    {
      "start": 28.14,
      "end": 29.88,
      "text": "Sommiamo quindi sessantasei,"
    },
    {
      "start": 30.46,
      "end": 31.4,
      "text": "cinque e sessantasei."
    },
    {
      "start": 32.2,
      "end": 36.08,
      "text": "Se moltiplicassimo soltanto la larghezza\ndella colonna per due, otterremmo"
    },
    {
      "start": 36.08,
      "end": 39.82,
      "text": "centotrentadue e dimenticheremmo\nl'intervallo centrale."
    },
    {
      "start": 39.84,
      "end": 42.56,
      "text": "La formula esprime questa somma per\ncolonne uguali."
    },
    {
      "start": 43.14,
      "end": 46.94,
      "text": "Con colonne asimmetriche dobbiamo invece\nsommare le diverse larghezze"
    },
    {
      "start": 46.94,
      "end": 50.24,
      "text": "effettivamente attraversate, insieme agli\nintervalli compresi."
    },
    {
      "start": 50.98,
      "end": 53.6,
      "text": "I margini della pagina restano fuori\ndall'area."
    },
    {
      "start": 54.34,
      "end": 58.26,
      "text": "Questo conteggio chiarisce lo spazio\nassegnato al contenuto; dobbiamo ora"
    },
    {
      "start": 58.26,
      "end": 62.02,
      "text": "distinguere anche le distanze esterne e\ninterne ai singoli elementi."
    }
  ]
}
