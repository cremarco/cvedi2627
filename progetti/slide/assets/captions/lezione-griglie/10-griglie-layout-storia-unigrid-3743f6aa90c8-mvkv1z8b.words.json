  "cues": [
    {
      "start": 0.24,
      "end": 4.92,
      "text": "Nel millenovecentosettantasette Vincent\nGleason, responsabile delle pubblicazioni"
    },
    {
      "start": 4.92,
      "end": 9.58,
      "text": "del National Park Service, coinvolge\nMassimo Vignelli nella definizione di"
    },
    {
      "start": 9.58,
      "end": 10.28,
      "text": "Unigrid."
    },
    {
      "start": 10.9,
      "end": 12.54,
      "text": "Il sistema riguarda molte brochure:"
    },
    {
      "start": 13.44,
      "end": 17.76,
      "text": "devono ospitare contenuti diversi,\nmantenere una riconoscibilità comune e"
    },
    {
      "start": 17.76,
      "end": 20.06,
      "text": "poter essere prodotte attraverso regole\ncondivise."
    },
    {
      "start": 21.0,
      "end": 25.98,
      "text": "Il sistema coordina formati, pieghe e\ntipografia, oltre alla disposizione delle"
    },
    {
      "start": 25.98,
      "end": 26.68,
      "text": "informazioni."
    },
    {
      "start": 27.18,
      "end": 32.16,
      "text": "I pannelli di base misurano quattro\npollici per otto pollici e un quarto."
    },
    {
      "start": 32.16,
      "end": 36.16,
      "text": "Combinandoli si possono ottenere soluzioni\ndiverse senza ricominciare ogni volta"
    },
    {
      "start": 36.16,
      "end": 36.86,
      "text": "dall'inizio."
    },
    {
      "start": 37.46,
      "end": 40.86,
      "text": "La brochure dedicata a Clara Barton, del\nmillenovecentosettantotto,"
    },
    {
      "start": 41.46,
      "end": 43.84,
      "text": "è il primo esempio per un parco."
    },
    {
      "start": 43.84,
      "end": 48.88,
      "text": "Nell'immagine osserviamo la testata, le\ncolonne, la cronologia e la mappa."
    },
    {
      "start": 48.9,
      "end": 53.12,
      "text": "Questi contenuti hanno esigenze diverse,\nma devono trovare posto gli uni accanto"
    },
    {
      "start": 53.12,
      "end": 57.86,
      "text": "agli altri. Il valore della griglia emerge\nproprio quando deve coordinare questa"
    },
    {
      "start": 57.86,
      "end": 58.56,
      "text": "varietà."
    },
    {
      "start": 58.8,
      "end": 62.7,
      "text": "Non basta che le pagine si assomiglino:\ndevono accogliere ciò che hanno da"
    },
    {
      "start": 62.7,
      "end": 63.4,
      "text": "comunicare."
    }
  ]
}
