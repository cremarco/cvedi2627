  "cues": [
    {
      "start": 0.16,
      "end": 5.02,
      "text": "Il confronto mantiene la stessa larghezza\ndichiarata, duecentoquaranta pixel, ma"
    },
    {
      "start": 5.02,
      "end": 6.46,
      "text": "cambia la convenzione di misura."
    },
    {
      "start": 7.48,
      "end": 11.64,
      "text": "La proprietà box sizing stabilisce a quale\nriquadro si riferisce quella larghezza."
    },
    {
      "start": 12.6,
      "end": 17.84,
      "text": "Il margine resta comunque esterno. Con\nborder box i duecentoquaranta pixel"
    },
    {
      "start": 17.84,
      "end": 19.06,
      "text": "comprendono contenuto,"
    },
    {
      "start": 19.6,
      "end": 20.76,
      "text": "spazi interni e bordi."
    },
    {
      "start": 21.72,
      "end": 26.58,
      "text": "Abbiamo sedici pixel di padding a sinistra\ne altrettanti a destra, più un pixel di"
    },
    {
      "start": 26.58,
      "end": 31.4,
      "text": "bordo per lato. Per trovare lo spazio del\ncontenuto sottraiamo quindi trentadue"
    },
    {
      "start": 31.4,
      "end": 35.58,
      "text": "pixel e altri due: restano duecentosei\npixel."
    },
    {
      "start": 35.62,
      "end": 39.52,
      "text": "Con content box, invece, i\nduecentoquaranta pixel appartengono al"
    },
    {
      "start": 39.52,
      "end": 43.92,
      "text": "solo contenuto. Padding e bordi si\naggiungono, e l'ingombro diventa"
    },
    {
      "start": 43.92,
      "end": 48.92,
      "text": "duecentosettantaquattro pixel. Sono le due\nsituazioni rappresentate nel diagramma."
    },
    {
      "start": 49.78,
      "end": 53.2,
      "text": "La stessa misura dichiarata può quindi\nprodurre ingombri differenti."
    },
    {
      "start": 54.12,
      "end": 57.68,
      "text": "Quando documentiamo un layout\nspecifichiamo sempre da quale limite"
    },
    {
      "start": 57.68,
      "end": 58.38,
      "text": "misuriamo,"
    },
    {
      "start": 58.74,
      "end": 62.82,
      "text": "così il passaggio dal disegno alle regole\nnon introduce distanze inattese."
    }
  ]
}
