  "cues": [
    {
      "start": 0.24,
      "end": 4.18,
      "text": "Il bianco è una parte misurabile della\ncomposizione."
    },
    {
      "start": 4.18,
      "end": 8.14,
      "text": "Il distacco dal bordo della pagina,\nl'intervallo fra due gruppi e lo spazio"
    },
    {
      "start": 8.14,
      "end": 10.32,
      "text": "dentro un controllo hanno funzioni\ndiverse."
    },
    {
      "start": 11.18,
      "end": 14.62,
      "text": "Per renderle riconoscibili possiamo\nscegliere una scala di spaziatura,"
    },
    {
      "start": 15.28,
      "end": 17.08,
      "text": "cioè un insieme di distanze collegate."
    },
    {
      "start": 18.0,
      "end": 20.62,
      "text": "Nel diagramma usiamo otto unità dentro il\ngruppo,"
    },
    {
      "start": 21.28,
      "end": 23.44,
      "text": "sedici fra gruppi e trentadue fra sezioni."
    },
    {
      "start": 24.36,
      "end": 26.06,
      "text": "Ogni passaggio raddoppia il precedente."
    },
    {
      "start": 26.84,
      "end": 28.82,
      "text": "I valori rendono evidente una relazione:"
    },
    {
      "start": 29.64,
      "end": 33.84,
      "text": "più due contenuti sono strettamente\ncollegati, più breve è la distanza che li"
    },
    {
      "start": 33.84,
      "end": 36.56,
      "text": "tiene insieme. Sono valori scelti per\nquesto esempio."
    },
    {
      "start": 37.48,
      "end": 40.34,
      "text": "Nel progetto dovremo specificare anche\nl’unità di misura."
    },
    {
      "start": 41.1,
      "end": 43.76,
      "text": "Non occorre adottare sempre questi numeri."
    },
    {
      "start": 43.76,
      "end": 47.32,
      "text": "Occorre sapere che cosa esprime ciascuna\ndistanza e mantenerlo coerente."
    },
    {
      "start": 48.3,
      "end": 52.7,
      "text": "Un testo più lungo non dovrebbe cancellare\nla pausa fra gruppi diversi."
    },
    {
      "start": 52.7,
      "end": 57.1,
      "text": "La possibilità di ripetere e discutere\nqueste decisioni è centrale anche nei"
    },
    {
      "start": 57.1,
      "end": 59.18,
      "text": "metodi storici della progettazione\ngrafica."
    }
  ]
}
