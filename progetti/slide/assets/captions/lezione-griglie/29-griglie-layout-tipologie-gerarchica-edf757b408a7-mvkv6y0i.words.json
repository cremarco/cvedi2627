  "cues": [
    {
      "start": 0.24,
      "end": 3.28,
      "text": "Una raccolta non contiene sempre elementi\ndella stessa importanza."
    },
    {
      "start": 4.64,
      "end": 8.64,
      "text": "In questo confronto, nella pagina di\nnotizie presentata, il contenuto"
    },
    {
      "start": 8.64,
      "end": 13.02,
      "text": "principale occupa il campo maggiore e ha\nun titolo più evidente."
    },
    {
      "start": 13.02,
      "end": 16.24,
      "text": "Aggiornamento e servizio condividono\ninvece una verticale laterale."
    },
    {
      "start": 17.1,
      "end": 20.48,
      "text": "Le misure differenti rendono riconoscibili\nruoli differenti,"
    },
    {
      "start": 21.16,
      "end": 24.88,
      "text": "mentre allineamenti e distanze tengono\ninsieme la pagina."
    },
    {
      "start": 24.88,
      "end": 27.02,
      "text": "Questa è la logica di una griglia\ngerarchica:"
    },
    {
      "start": 27.88,
      "end": 31.58,
      "text": "partire dalle priorità del contenuto per\nassegnare le aree."
    },
    {
      "start": 31.6,
      "end": 36.0,
      "text": "L’asimmetria riguarda il modo in cui aree\ngrandi e piccole si distribuiscono nella"
    },
    {
      "start": 36.0,
      "end": 39.36,
      "text": "pagina. Da sola non ci dice se le priorità\nsiano chiare."
    },
    {
      "start": 40.32,
      "end": 44.4,
      "text": "Prima di aggiungere una nuova larghezza,\nchiedete quale differenza deve comunicare."
    },
    {
      "start": 45.18,
      "end": 49.66,
      "text": "Se due notizie hanno lo stesso ruolo, una\ndimensione arbitrariamente maggiore può"
    },
    {
      "start": 49.66,
      "end": 51.54,
      "text": "suggerire un'importanza che non esiste."
    },
    {
      "start": 52.38,
      "end": 56.12,
      "text": "Se invece la priorità è reale, la\nvariazione può orientare la lettura."
    },
    {
      "start": 57.08,
      "end": 60.08,
      "text": "Ogni misura introdotta dovrebbe quindi\navere una ragione riconoscibile."
    }
  ]
}
