  "cues": [
    {
      "start": 0.3,
      "end": 3.42,
      "text": "Queste misure vanno provate con i\ncontenuti."
    },
    {
      "start": 3.42,
      "end": 8.46,
      "text": "Un reticolo vuoto può sembrare convincente\nanche quando non riesce a ospitarli."
    },
    {
      "start": 8.46,
      "end": 13.1,
      "text": "Nel diagramma compaiono tre casi diversi:\nun titolo su due righe, un'immagine"
    },
    {
      "start": 13.1,
      "end": 14.44,
      "text": "verticale e un elenco."
    },
    {
      "start": 15.12,
      "end": 19.78,
      "text": "Ci permettono di vedere come lo stesso\nsistema reagisca a forme diverse."
    },
    {
      "start": 19.78,
      "end": 21.58,
      "text": "Questo campione è soltanto un inizio."
    },
    {
      "start": 22.3,
      "end": 26.16,
      "text": "Nel progetto servono anche didascalie\nlunghe, nomi propri e casi ordinari."
    },
    {
      "start": 26.9,
      "end": 30.02,
      "text": "Un nome non si può accorciare\narbitrariamente per farlo"
    },
    {
      "start": 30.72,
      "end": 34.06,
      "text": "entrare; un'immagine verticale non occupa\nlo stesso campo di una panoramica."
    },
    {
      "start": 34.86,
      "end": 37.22,
      "text": "Le regole devono confrontarsi con queste\nesigenze."
    },
    {
      "start": 38.06,
      "end": 42.76,
      "text": "Se ogni nuovo caso richiede una correzione\nlocale, conviene rivedere le colonne, gli"
    },
    {
      "start": 42.76,
      "end": 44.9,
      "text": "intervalli o lo spazio assegnato ai\ncontenuti."
    },
    {
      "start": 45.8,
      "end": 50.52,
      "text": "Un'eccezione può essere motivata, ma una\nserie continua di eccezioni suggerisce che"
    },
    {
      "start": 50.52,
      "end": 55.1,
      "text": "il modello di base non è adatto. Ora\npossiamo scegliere fra diverse logiche di"
    },
    {
      "start": 55.1,
      "end": 57.8,
      "text": "organizzazione, in funzione della lettura\nda sostenere."
    }
  ]
}
