  "cues": [
    {
      "start": 0.26,
      "end": 3.72,
      "text": "Dopo aver seguito un compito, passiamo a\nprogettare con materiali comuni."
    },
    {
      "start": 4.84,
      "end": 7.92,
      "text": "Il kit Luce e spazio descrive un\nlaboratorio immaginario:"
    },
    {
      "start": 8.96,
      "end": 13.34,
      "text": "contiene un titolo, una presentazione di\nottanta parole, tre appuntamenti,"
    },
    {
      "start": 13.44,
      "end": 15.96,
      "text": "un’immagine e una nota di servizio."
    },
    {
      "start": 16.0,
      "end": 17.28,
      "text": "Ogni parte ha un ruolo diverso."
    },
    {
      "start": 18.08,
      "end": 23.14,
      "text": "La presentazione introduce il laboratorio,\nil programma permette di confrontare date"
    },
    {
      "start": 23.14,
      "end": 23.84,
      "text": "e attività,"
    },
    {
      "start": 24.3,
      "end": 26.26,
      "text": "la nota comunica una condizione pratica."
    },
    {
      "start": 27.28,
      "end": 29.82,
      "text": "L’immagine deve conservare un dettaglio\nriconoscibile."
    },
    {
      "start": 30.6,
      "end": 34.62,
      "text": "Usiamo gli stessi materiali in tutte le\nproposte e manteniamone il significato."
    },
    {
      "start": 35.5,
      "end": 39.42,
      "text": "Possiamo così confrontare l’effetto di\nstrutture diverse sugli stessi contenuti."
    }
  ]
}
