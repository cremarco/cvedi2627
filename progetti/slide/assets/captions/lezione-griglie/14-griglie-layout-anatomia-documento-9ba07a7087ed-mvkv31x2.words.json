  "cues": [
    {
      "start": 0.18,
      "end": 4.26,
      "text": "In questa tavola i colori ci aiutano a\ndistinguere le parti."
    },
    {
      "start": 4.26,
      "end": 9.06,
      "text": "Il campo magenta evidenzia una colonna:\nuna porzione verticale che contribuisce a"
    },
    {
      "start": 9.06,
      "end": 10.52,
      "text": "suddividere la larghezza disponibile."
    },
    {
      "start": 11.42,
      "end": 15.82,
      "text": "La fascia azzurra attraversa invece il\nreticolo in orizzontale e permette di"
    },
    {
      "start": 15.82,
      "end": 17.26,
      "text": "coordinare quote e altezze."
    },
    {
      "start": 18.0,
      "end": 22.5,
      "text": "Il sottile intervallo verde fra due\ncolonne è l'intercolonna, chiamata anche"
    },
    {
      "start": 22.5,
      "end": 23.2,
      "text": "gutter."
    },
    {
      "start": 23.42,
      "end": 26.18,
      "text": "È uno spazio interno alla gabbia che\nsepara colonne vicine."
    },
    {
      "start": 26.92,
      "end": 31.94,
      "text": "Il margine sul bordo destro separa invece\nil campo utile dal limite della pagina."
    },
    {
      "start": 31.94,
      "end": 34.78,
      "text": "Questa distinzione evita un errore di\nmisura."
    },
    {
      "start": 34.78,
      "end": 38.48,
      "text": "Non possiamo trattare il vuoto fra due\ncolonne come se fosse uno dei margini"
    },
    {
      "start": 38.48,
      "end": 40.92,
      "text": "esterni, perché partecipa a un conteggio\ndiverso."
    },
    {
      "start": 41.7,
      "end": 43.26,
      "text": "Una volta riconosciute queste parti,"
    },
    {
      "start": 43.84,
      "end": 47.72,
      "text": "possiamo calcolare una griglia di colonne\nuguali senza confondere lo spazio del"
    },
    {
      "start": 47.72,
      "end": 49.38,
      "text": "contenuto con quello degli intervalli."
    }
  ]
}
