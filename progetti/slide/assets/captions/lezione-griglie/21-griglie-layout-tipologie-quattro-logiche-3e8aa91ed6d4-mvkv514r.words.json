  "cues": [
    {
      "start": 0.24,
      "end": 5.3,
      "text": "Le quattro strutture del confronto non\nsono quattro stili da applicare a piacere:"
    },
    {
      "start": 5.38,
      "end": 6.98,
      "text": "rispondono a esigenze di lettura\ndifferenti."
    },
    {
      "start": 8.56,
      "end": 11.22,
      "text": "La struttura a blocco accompagna un\ndiscorso continuo."
    },
    {
      "start": 12.12,
      "end": 14.16,
      "text": "Le colonne permettono di accostare campi."
    },
    {
      "start": 15.06,
      "end": 19.82,
      "text": "La griglia modulare aggiunge riferimenti\norizzontali, utili quando tornano immagini"
    },
    {
      "start": 19.82,
      "end": 21.06,
      "text": "e dati con ruoli simili."
    },
    {
      "start": 21.94,
      "end": 26.14,
      "text": "La struttura gerarchica assegna invece\naree diverse a priorità diverse."
    },
    {
      "start": 27.3,
      "end": 31.54,
      "text": "Prima di scegliere, chiedetevi che cosa\ndeve fare chi legge: seguire un"
    },
    {
      "start": 31.54,
      "end": 33.92,
      "text": "ragionamento, confrontare alternative,"
    },
    {
      "start": 34.48,
      "end": 37.56,
      "text": "scorrere un catalogo oppure individuare\nuna notizia principale?"
    },
    {
      "start": 38.54,
      "end": 40.18,
      "text": "La risposta orienta la struttura."
    },
    {
      "start": 41.12,
      "end": 42.7,
      "text": "Le categorie possono anche convivere:"
    },
    {
      "start": 43.28,
      "end": 46.36,
      "text": "un sistema modulare può contenere una\ngrande immagine dominante."
    },
    {
      "start": 47.66,
      "end": 50.66,
      "text": "Ci interessa descrivere le relazioni che\nil progetto rende possibili,"
    },
    {
      "start": 51.42,
      "end": 54.48,
      "text": "più che assegnargli un'etichetta\ndefinitiva."
    },
    {
      "start": 54.52,
      "end": 55.62,
      "text": "Partiamo dal caso più continuo,"
    },
    {
      "start": 56.32,
      "end": 57.34,
      "text": "quello di una sola colonna."
    }
  ]
}
