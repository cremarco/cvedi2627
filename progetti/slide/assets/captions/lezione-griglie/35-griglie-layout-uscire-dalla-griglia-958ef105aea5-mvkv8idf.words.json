  "cues": [
    {
      "start": 0.28,
      "end": 4.28,
      "text": "Una deroga ha senso quando possiamo\nriconoscere la regola dalla quale si"
    },
    {
      "start": 4.28,
      "end": 9.86,
      "text": "allontana. Nel diagramma un elemento\nattraversa due campi, mentre margini,"
    },
    {
      "start": 10.34,
      "end": 13.0,
      "text": "corpo e allineamenti del testo mantengono\nil sistema comune."
    },
    {
      "start": 13.9,
      "end": 18.38,
      "text": "L'eccezione è circoscritta e può quindi\nsegnalare una differenza."
    },
    {
      "start": 18.4,
      "end": 21.68,
      "text": "Pensate a un titolo che supera una colonna\nper aprire una sezione,"
    },
    {
      "start": 22.2,
      "end": 25.46,
      "text": "oppure a una figura che si estende per\nmostrare meglio un dettaglio."
    },
    {
      "start": 25.98,
      "end": 28.52,
      "text": "La variazione deve avere uno scopo\ncomprensibile."
    },
    {
      "start": 29.54,
      "end": 33.88,
      "text": "Se ogni elemento introduce una misura\nnuova, diventa difficile distinguere ciò"
    },
    {
      "start": 33.88,
      "end": 36.88,
      "text": "che è ordinario da ciò che deve emergere."
    },
    {
      "start": 36.88,
      "end": 41.6,
      "text": "Dopo la scelta espressiva, controlliamo\nancora le relazioni: il titolo resta"
    },
    {
      "start": 41.74,
      "end": 42.48,
      "text": "associato al paragrafo?"
    },
    {
      "start": 43.16,
      "end": 45.88,
      "text": "La didascalia si riconosce come parte\ndella figura?"
    },
    {
      "start": 46.54,
      "end": 50.62,
      "text": "Il taglio o la piega centrale nascondono\nuna parte importante dell’immagine?"
    },
    {
      "start": 51.3,
      "end": 52.68,
      "text": "Questi vincoli non scompaiono."
    },
    {
      "start": 53.8,
      "end": 55.6,
      "text": "Sullo schermo si aggiungerà un'altra\ndomanda:"
    },
    {
      "start": 56.36,
      "end": 59.92,
      "text": "come si conserva la relazione quando\ncambia lo spazio disponibile?"
    }
  ]
}
