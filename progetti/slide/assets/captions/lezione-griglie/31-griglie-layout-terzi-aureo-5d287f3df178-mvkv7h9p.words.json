  "cues": [
    {
      "start": 0.28,
      "end": 4.44,
      "text": "Possiamo ora guardare alle proporzioni con\ncui dividere il campo."
    },
    {
      "start": 4.44,
      "end": 9.78,
      "text": "La regola dei terzi colloca due divisioni\na circa un terzo e due terzi della misura."
    },
    {
      "start": 10.72,
      "end": 15.06,
      "text": "Le divisioni auree si trovano invece a\ncirca il trentotto virgola due e il"
    },
    {
      "start": 15.06,
      "end": 16.64,
      "text": "sessantuno virgola otto per cento."
    },
    {
      "start": 17.44,
      "end": 21.46,
      "text": "Nel confronto sullo stesso rettangolo le\nlinee sono vicine, ma non coincidono."
    },
    {
      "start": 22.42,
      "end": 27.08,
      "text": "Sono due ipotesi compositive diverse,\nutili per provare posizioni e relazioni."
    },
    {
      "start": 28.26,
      "end": 32.1,
      "text": "Nessuna delle due stabilisce da sola dove\nmettere un titolo o quale immagine"
    },
    {
      "start": 32.1,
      "end": 32.8,
      "text": "scegliere."
    },
    {
      "start": 33.22,
      "end": 37.58,
      "text": "Un soggetto decentrato, per esempio, va\nvalutato insieme alla direzione del suo"
    },
    {
      "start": 37.58,
      "end": 40.44,
      "text": "sguardo e allo spazio necessario al testo."
    },
    {
      "start": 40.44,
      "end": 44.14,
      "text": "Per usare questi riferimenti\nconsapevolmente dobbiamo distinguere la"
    },
    {
      "start": 44.2,
      "end": 46.68,
      "text": "costruzione geometrica dal giudizio sul\nrisultato."
    },
    {
      "start": 47.52,
      "end": 51.722,
      "text": "Vediamo quindi che cosa definisce, in modo\npreciso, il rapporto aureo."
    }
  ]
}
