  "cues": [
    {
      "start": 0.2,
      "end": 4.94,
      "text": "Nel confronto vediamo tre distanze: lo\nspazio attorno al gruppo di schede, la"
    },
    {
      "start": 4.94,
      "end": 9.5,
      "text": "distanza fra una scheda e l’altra e lo\nspazio interno a ciascuna scheda, fra"
    },
    {
      "start": 9.5,
      "end": 10.42,
      "text": "bordo e contenuto."
    },
    {
      "start": 11.7,
      "end": 14.9,
      "text": "Possono anche avere la stessa misura, ma\ndescrivono relazioni diverse."
    },
    {
      "start": 16.16,
      "end": 21.5,
      "text": "Nei fogli di stile, che chiamiamo ci esse\nesse, margin indica lo spazio esterno a un"
    },
    {
      "start": 21.5,
      "end": 22.2,
      "text": "elemento."
    },
    {
      "start": 22.92,
      "end": 27.32,
      "text": "Gap può definire la distanza fra le righe\no le colonne di una griglia."
    },
    {
      "start": 27.44,
      "end": 31.1,
      "text": "Padding indica invece lo spazio interno al\nriquadro."
    },
    {
      "start": 31.1,
      "end": 34.32,
      "text": "I nomi collegano il disegno alle regole."
    },
    {
      "start": 34.32,
      "end": 36.74,
      "text": "Aumentare il gap allontana le schede."
    },
    {
      "start": 36.74,
      "end": 41.5,
      "text": "Aumentare il padding, mantenendo uguale\nl'ingombro esterno, lascia meno spazio al"
    },
    {
      "start": 41.66,
      "end": 42.84,
      "text": "testo dentro ciascuna scheda."
    },
    {
      "start": 43.78,
      "end": 46.52,
      "text": "Se aggiungiamo distanze in più punti,\nqueste si sommano."
    },
    {
      "start": 47.22,
      "end": 51.12,
      "text": "Non possiamo contarle una sola volta\nperché nell'immagine sembravano un unico"
    },
    {
      "start": 51.12,
      "end": 51.82,
      "text": "vuoto."
    },
    {
      "start": 52.34,
      "end": 56.42,
      "text": "Prima di sommare queste misure, dobbiamo\nchiarire che cosa comprende la larghezza"
    },
    {
      "start": 56.42,
      "end": 57.38,
      "text": "indicata nel progetto."
    }
  ]
}
