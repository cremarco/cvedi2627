  "cues": [
    {
      "start": 0.18,
      "end": 5.06,
      "text": "Se vogliamo accostare contenuti, una base\na colonne offre riferimenti comuni senza"
    },
    {
      "start": 5.06,
      "end": 8.36,
      "text": "imporre a ogni elemento la stessa\nlarghezza."
    },
    {
      "start": 8.36,
      "end": 10.26,
      "text": "Nel diagramma partiamo da sei unità."
    },
    {
      "start": 11.2,
      "end": 13.44,
      "text": "Possiamo raggrupparle in due campi da tre\nunità,"
    },
    {
      "start": 14.08,
      "end": 15.26,
      "text": "oppure in due campi diversi:"
    },
    {
      "start": 15.9,
      "end": 20.32,
      "text": "uno da due e uno da quattro, o uno da una\ne uno da cinque."
    },
    {
      "start": 20.32,
      "end": 23.06,
      "text": "Cambiano così lo spazio per il testo e il\npeso dell'immagine."
    },
    {
      "start": 24.08,
      "end": 26.76,
      "text": "Questi numeri contano le colonne occupate."
    },
    {
      "start": 26.76,
      "end": 31.16,
      "text": "Non descrivono automaticamente rapporti\nesatti fra le larghezze finali, perché"
    },
    {
      "start": 31.16,
      "end": 35.22,
      "text": "ogni gruppo comprende anche le\nintercolonne al proprio interno."
    },
    {
      "start": 35.22,
      "end": 38.64,
      "text": "Ricordate il calcolo dello spazio occupato\nda più colonne."
    },
    {
      "start": 38.64,
      "end": 42.26,
      "text": "La scelta dipende da ciò che dobbiamo\nmettere in questi spazi."
    },
    {
      "start": 42.26,
      "end": 46.66,
      "text": "Una fascia da una sola unità può ospitare\nuna nota breve, ma un paragrafo lungo"
    },
    {
      "start": 46.66,
      "end": 52.2,
      "text": "potrebbe spezzarsi continuamente. La\nstruttura offre possibilità; il contenuto"
    },
    {
      "start": 52.2,
      "end": 53.8,
      "text": "permette di scegliere fra esse."
    }
  ]
