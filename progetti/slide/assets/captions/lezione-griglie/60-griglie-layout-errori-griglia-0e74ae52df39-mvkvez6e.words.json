  "cues": [
    {
      "start": 0.22,
      "end": 4.2,
      "text": "Le attività riportano ai tre obiettivi\niniziali."
    },
    {
      "start": 4.2,
      "end": 8.6,
      "text": "Leggere significa riconoscere relazioni:\nun titolo introduce un paragrafo,"
    },
    {
      "start": 9.28,
      "end": 10.94,
      "text": "un’azione riguarda un oggetto,"
    },
    {
      "start": 11.44,
      "end": 16.1,
      "text": "una didascalia spiega una figura. Se\nquesti legami restano ambigui, una"
    },
    {
      "start": 16.1,
      "end": 19.44,
      "text": "distribuzione regolare non li corregge da\nsola."
    },
    {
      "start": 19.72,
      "end": 23.28,
      "text": "Progettare significa scegliere regole\ncapaci di accogliere i contenuti."
    },
    {
      "start": 24.08,
      "end": 25.12,
      "text": "Quando qualcosa non entra,"
    },
    {
      "start": 25.74,
      "end": 29.9,
      "text": "possiamo rivedere come raggruppare i\ncontenuti, come farli proseguire e quanto"
    },
    {
      "start": 29.98,
      "end": 34.64,
      "text": "spazio assegnare a ciascuno. Prima di\nridurre il corpo del testo, chiediamoci se"
    },
    {
      "start": 34.64,
      "end": 36.58,
      "text": "stiamo assegnando lo spazio nel modo\ngiusto."
    },
    {
      "start": 37.58,
      "end": 41.36,
      "text": "Verificare significa risalire alla causa e\nriprovare."
    },
    {
      "start": 41.36,
      "end": 45.16,
      "text": "Una correzione ripetuta segnala che\npotrebbe essere la regola comune a dover"
    },
    {
      "start": 45.16,
      "end": 50.06,
      "text": "cambiare. Controlliamo tutte le occorrenze\ninteressate, non soltanto quella che ha"
    },
    {
      "start": 50.06,
      "end": 55.28,
      "text": "mostrato per prima il problema. Il lavoro\nsulla griglia tiene insieme queste azioni:"
    },
    {
      "start": 55.5,
      "end": 60.08,
      "text": "osservare una relazione, formulare una\nscelta e confrontarla con il comportamento"
    },
    {
      "start": 60.14,
      "end": 60.84,
      "text": "dei contenuti."
    }
  ]
}
