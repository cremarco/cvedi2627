  "cues": [
    {
      "start": 0.16,
      "end": 2.66,
      "text": "Un esempio precedente al manuale è Musica\nViva,"
    },
    {
      "start": 3.3,
      "end": 8.6,
      "text": "un manifesto di Josef Müller-Brockmann del\nmillenovecentocinquantasette."
    },
    {
      "start": 8.6,
      "end": 12.82,
      "text": "Nella parte superiore le informazioni del\nconcerto si raccolgono in quattro campi"
    },
    {
      "start": 12.82,
      "end": 13.52,
      "text": "verticali."
    },
    {
      "start": 14.12,
      "end": 18.26,
      "text": "Possiamo seguire gli inizi dei blocchi e\nosservare come le pause distinguano gruppi"
    },
    {
      "start": 18.26,
      "end": 18.96,
      "text": "di informazioni."
    },
    {
      "start": 19.74,
      "end": 22.3,
      "text": "Nella parte inferiore cambia il ritmo."
    },
    {
      "start": 22.3,
      "end": 26.06,
      "text": "Segni obliqui di lunghezza e spessore\ndifferenti si confrontano con la"
    },
    {
      "start": 26.06,
      "end": 26.76,
      "text": "superficie libera."
    },
    {
      "start": 27.34,
      "end": 31.76,
      "text": "Il manifesto mette quindi in relazione\nun'area informativa più fitta e un campo"
    },
    {
      "start": 31.76,
      "end": 36.16,
      "text": "grafico più aperto. La struttura\ncontribuisce all'espressione dell'opera,"
    },
    {
      "start": 36.16,
      "end": 40.5,
      "text": "oltre a distribuire il testo. Possiamo\ndescrivere questi allineamenti e queste"
    },
    {
      "start": 40.5,
      "end": 44.94,
      "text": "pause. Non sappiamo invece se coincidano\ncon il reticolo originale del progettista:"
    },
    {
      "start": 45.92,
      "end": 48.74,
      "text": "la sola immagine non consente di\nricostruirlo con certezza."
    },
    {
      "start": 49.62,
      "end": 54.14,
      "text": "Teniamo quindi distinto ciò che osserviamo\nda ciò che possiamo documentare."
    },
    {
      "start": 54.14,
      "end": 58.34,
      "text": "Dal singolo manifesto passiamo ora a un\nsistema destinato a coordinare molte"
    },
    {
      "start": 58.34,
      "end": 59.04,
      "text": "pubblicazioni."
    }
  ]
}
