  "cues": [
    {
      "start": 0.24,
      "end": 4.1,
      "text": "La seconda prova riguarda la crescita del\ntesto."
    },
    {
      "start": 4.1,
      "end": 8.98,
      "text": "Il criterio uno punto quattro punto\nquattro, livello doppia A, richiede che il"
    },
    {
      "start": 8.98,
      "end": 13.46,
      "text": "testo possa essere ingrandito fino al\nduecento per cento con le normali funzioni"
    },
    {
      "start": 13.46,
      "end": 14.16,
      "text": "del browser,"
    },
    {
      "start": 14.82,
      "end": 16.36,
      "text": "senza richiedere tecnologie assistive."
    },
    {
      "start": 17.38,
      "end": 20.14,
      "text": "Il risultato deve conservare contenuti e\nfunzionalità."
    },
    {
      "start": 21.14,
      "end": 25.34,
      "text": "Le eccezioni previste riguardano i\nsottotitoli dei media e le immagini di"
    },
    {
      "start": 25.34,
      "end": 30.54,
      "text": "testo. Pensiamo alla prenotazione: dopo\nl’ingrandimento, la data deve restare"
    },
    {
      "start": 30.54,
      "end": 33.72,
      "text": "completa e il comando Conferma deve essere\nraggiungibile."
    },
    {
      "start": 34.58,
      "end": 38.5,
      "text": "Se il testo entra ma il pulsante viene\ncoperto, il compito è comunque"
    },
    {
      "start": 38.5,
      "end": 42.72,
      "text": "compromesso. Controlliamo anche le\netichette che vanno su più righe e i"
    },
    {
      "start": 42.72,
      "end": 47.6,
      "text": "messaggi di errore. Non sostituiamo questa\nprova con quella precedente."
    },
    {
      "start": 47.6,
      "end": 51.48,
      "text": "Restringere lo spazio e ingrandire il\ntesto sollecitano il layout in modi"
    },
    {
      "start": 51.48,
      "end": 52.18,
      "text": "diversi."
    },
    {
      "start": 52.78,
      "end": 56.32,
      "text": "Entrambe le verifiche devono riguardare\nl’interfaccia funzionante e il"
    },
    {
      "start": 56.32,
      "end": 57.46,
      "text": "completamento delle azioni."
    }
  ]
