  "cues": [
    {
      "start": 0.24,
      "end": 3.86,
      "text": "Dopo aver scelto ciò che deve rimanere\nvisibile, distinguiamo due problemi."
    },
    {
      "start": 4.54,
      "end": 9.76,
      "text": "Il primo è la risoluzione: possiamo avere\nfile con più o meno pixel che mostrano la"
    },
    {
      "start": 9.76,
      "end": 11.68,
      "text": "stessa scena, con la stessa inquadratura."
    },
    {
      "start": 12.92,
      "end": 17.42,
      "text": "Nel linguaggio acca ti emme elle, possiamo\nindicare al browser quali file ha a"
    },
    {
      "start": 17.42,
      "end": 20.36,
      "text": "disposizione e quanto spazio prevediamo\nper l’immagine."
    },
    {
      "start": 21.4,
      "end": 26.14,
      "text": "Lo spazio dichiarato guida la scelta del\nfile, ma non imposta da solo la larghezza"
    },
    {
      "start": 26.14,
      "end": 30.82,
      "text": "dell’immagine nella pagina. Il secondo\nproblema è compositivo."
    },
    {
      "start": 30.82,
      "end": 34.42,
      "text": "Nel campo stretto può servire\nun’inquadratura diversa, che valorizzi il"
    },
    {
      "start": 34.42,
      "end": 35.12,
      "text": "soggetto."
    },
    {
      "start": 35.58,
      "end": 39.06,
      "text": "L’elemento picture può proporre una\nsorgente dedicata a questa condizione."
    },
    {
      "start": 40.34,
      "end": 41.52,
      "text": "Guardate il cerchio giallo:"
    },
    {
      "start": 42.0,
      "end": 46.26,
      "text": "una versione con più pixel migliora il\ndettaglio disponibile, ma non recupera un"
    },
    {
      "start": 46.26,
      "end": 48.72,
      "text": "soggetto escluso dal ritaglio."
    },
    {
      "start": 48.72,
      "end": 53.28,
      "text": "Risoluzione e inquadratura richiedono\nquindi decisioni coordinate, con obiettivi"
    },
    {
      "start": 53.28,
      "end": 53.98,
      "text": "diversi."
    }
  ]
}
