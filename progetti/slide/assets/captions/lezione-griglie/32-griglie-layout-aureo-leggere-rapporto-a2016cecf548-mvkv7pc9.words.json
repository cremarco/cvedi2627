  "cues": [
    {
      "start": 0.28,
      "end": 5.4,
      "text": "La barra distingue una parte maggiore,\nindicata con a, e una parte minore,"
    },
    {
      "start": 5.42,
      "end": 6.12,
      "text": "indicata con bi."
    },
    {
      "start": 6.66,
      "end": 12.6,
      "text": "Il totale è la loro somma. La divisione è\naurea quando il rapporto fra totale"
    },
    {
      "start": 12.6,
      "end": 17.84,
      "text": "e parte maggiore è uguale al rapporto fra\nparte maggiore e parte minore."
    },
    {
      "start": 17.84,
      "end": 18.6,
      "text": "Possiamo dirlo così:"
    },
    {
      "start": 19.34,
      "end": 23.58,
      "text": "il totale sta alla parte maggiore come la\nparte maggiore sta alla minore."
    },
    {
      "start": 24.72,
      "end": 28.96,
      "text": "Nella formula le due divisioni descrivono\nproprio questi confronti."
    },
    {
      "start": 28.96,
      "end": 31.32,
      "text": "La lettera greca fi indica il valore\ncomune,"
    },
    {
      "start": 32.28,
      "end": 33.54,
      "text": "circa uno virgola seicentodiciotto."
    },
    {
      "start": 34.74,
      "end": 38.54,
      "text": "Non indica la percentuale occupata dalla\nparte maggiore."
    },
    {
      "start": 38.54,
      "end": 43.12,
      "text": "Nel disegno, su mille unità complessive,\nla parte maggiore ne occupa circa"
    },
    {
      "start": 43.12,
      "end": 46.34,
      "text": "seicentodiciotto e la minore circa\ntrecentottantadue:"
    },
    {
      "start": 47.24,
      "end": 51.6,
      "text": "sono misure arrotondate. Entrambe le parti\ndevono avere lunghezza positiva,"
    },
    {
      "start": 52.26,
      "end": 54.84,
      "text": "e quella maggiore deve essere più lunga\ndella minore."
    },
    {
      "start": 55.94,
      "end": 58.94,
      "text": "La relazione resta la stessa cambiando la\nlunghezza totale:"
    },
    {
      "start": 59.6,
      "end": 62.64,
      "text": "conta la proporzione, non un particolare\nnumero di millimetri."
    }
  ]
}
