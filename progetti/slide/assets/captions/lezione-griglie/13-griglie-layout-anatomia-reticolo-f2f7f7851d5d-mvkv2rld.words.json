  "cues": [
    {
      "start": 0.22,
      "end": 4.74,
      "text": "Nel reticolo incontriamo riferimenti\nverticali e orizzontali."
    },
    {
      "start": 4.74,
      "end": 9.56,
      "text": "Le colonne suddividono la larghezza; le\nfasce orizzontali aiutano ad allineare gli"
    },
    {
      "start": 9.56,
      "end": 10.94,
      "text": "elementi a determinate altezze."
    },
    {
      "start": 11.82,
      "end": 16.4,
      "text": "Le loro intersezioni individuano moduli,\nche possiamo usare singolarmente oppure"
    },
    {
      "start": 16.4,
      "end": 21.54,
      "text": "riunire in aree più ampie. Osservate la\ndifferenza fra campi chiari e campi più"
    },
    {
      "start": 21.54,
      "end": 24.74,
      "text": "intensi. I primi mostrano la costruzione\ndisponibile,"
    },
    {
      "start": 25.38,
      "end": 28.4,
      "text": "i secondi lo spazio effettivamente\noccupato dai contenuti."
    },
    {
      "start": 29.02,
      "end": 32.64,
      "text": "Un'immagine può attraversare più moduli e\ndiventare un'unica area."
    },
    {
      "start": 33.48,
      "end": 36.78,
      "text": "Questo non elimina la griglia ma sfrutta\nuna delle sue possibilità."
    },
    {
      "start": 37.3,
      "end": 41.52,
      "text": "Le linee di flusso sono riferimenti\norizzontali sui quali possono cominciare"
    },
    {
      "start": 41.52,
      "end": 46.1,
      "text": "blocchi diversi. Due contenuti affiancati\npossono quindi condividere una quota"
    },
    {
      "start": 46.1,
      "end": 46.8,
      "text": "iniziale,"
    },
    {
      "start": 47.14,
      "end": 51.72,
      "text": "pur avendo altezze differenti. Nel leggere\nil diagramma distinguiamo le guide della"
    },
    {
      "start": 51.72,
      "end": 56.04,
      "text": "griglia dai bordi dei contenuti. Per\nnominare con precisione questi spazi"
    },
    {
      "start": 56.04,
      "end": 60.46,
      "text": "guardiamo ora un documento in cui le parti\nsono evidenziate con segni e colori."
    }
  ]
}
