  "cues": [
    {
      "start": 0.16,
      "end": 3.26,
      "text": "I tre pannelli schematici chiariscono il\nprincipio appena visto."
    },
    {
      "start": 4.28,
      "end": 8.84,
      "text": "La testata rimane alla stessa altezza,\nmentre sotto cambia la disposizione dei"
    },
    {
      "start": 8.84,
      "end": 14.04,
      "text": "contenuti. Una mappa ha bisogno di un\ncampo continuo; una cronologia ordina"
    },
    {
      "start": 14.04,
      "end": 18.08,
      "text": "eventi in sequenza; un testo richiede una\nmisura adatta alla lettura."
    },
    {
      "start": 19.0,
      "end": 21.6,
      "text": "Questi disegni rappresentano possibili\ndisposizioni,"
    },
    {
      "start": 22.2,
      "end": 25.1,
      "text": "non brochure o mappe reali del National\nPark Service."
    },
    {
      "start": 25.8,
      "end": 27.64,
      "text": "Ci permettono di isolare la regola:"
    },
    {
      "start": 28.28,
      "end": 28.98,
      "text": "alcuni"
    },
    {
      "start": 28.98,
      "end": 29.92,
      "text": "riferimenti restano stabili,"
    },
    {
      "start": 30.94,
      "end": 35.12,
      "text": "altri variano per dare spazio a contenuti\ncon esigenze differenti."
    },
    {
      "start": 35.12,
      "end": 39.24,
      "text": "Coordinare significa decidere quali\nriferimenti mantenere e quali adattare,"
    },
    {
      "start": 40.18,
      "end": 42.46,
      "text": "senza imporre la stessa forma a tutto."
    },
    {
      "start": 42.46,
      "end": 46.54,
      "text": "Se una lunga descrizione viene compressa\nin un campo troppo piccolo soltanto per"
    },
    {
      "start": 46.54,
      "end": 50.28,
      "text": "imitare un altro pannello, la coerenza\napparente nasconde un problema."
    },
    {
      "start": 51.14,
      "end": 53.44,
      "text": "Dobbiamo provare materiali diversi."
    },
    {
      "start": 53.44,
      "end": 57.24,
      "text": "Prima di costruire altre pagine, vediamo\nquindi quali parti definiscono"
    },
    {
      "start": 57.24,
      "end": 58.906,
      "text": "concretamente la griglia."
    }
  ]
}
