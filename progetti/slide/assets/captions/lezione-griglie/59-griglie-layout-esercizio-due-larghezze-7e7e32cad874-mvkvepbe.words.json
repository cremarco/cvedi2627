  "cues": [
    {
      "start": 0.26,
      "end": 3.78,
      "text": "Scegliete la proposta da sviluppare e\ntraducetela nei contenitori di"
    },
    {
      "start": 3.78,
      "end": 8.1,
      "text": "novecentosessanta e trecentosessanta pixel\nci esse esse."
    },
    {
      "start": 8.1,
      "end": 10.74,
      "text": "Tutti i contenuti restano presenti."
    },
    {
      "start": 10.74,
      "end": 15.8,
      "text": "Prima di spostarli, dichiarate margini\nminimi, intervalli e larghezza massima."
    },
    {
      "start": 15.8,
      "end": 19.48,
      "text": "Se usate unità di griglia, annotate quante\nne occupa ciascun gruppo."
    },
    {
      "start": 20.28,
      "end": 24.68,
      "text": "Nella variante stretta indicate quali\ngruppi si impilano e controllate l’ordine"
    },
    {
      "start": 24.68,
      "end": 25.38,
      "text": "di lettura."
    },
    {
      "start": 25.88,
      "end": 30.26,
      "text": "Per l’immagine confrontate riduzione\nproporzionale e ritaglio, conservando"
    },
    {
      "start": 30.26,
      "end": 32.46,
      "text": "interamente il cerchio giallo."
    },
    {
      "start": 32.46,
      "end": 36.54,
      "text": "Aggiungete nella matrice una condizione\nche mette in crisi la proposta: per"
    },
    {
      "start": 36.54,
      "end": 40.62,
      "text": "esempio un titolo più lungo o una data che\nva su due righe."
    },
    {
      "start": 40.68,
      "end": 44.74,
      "text": "Descrivete il problema, correggete la\nregola e ricontrollate entrambi i formati."
    },
    {
      "start": 45.52,
      "end": 49.62,
      "text": "Il risultato atteso comprende i due\nassetti e la spiegazione di una correzione"
    },
    {
      "start": 49.62,
      "end": 50.32,
      "text": "verificata."
    },
    {
      "start": 51.2,
      "end": 52.86,
      "text": "Sospendete l’audio per sette minuti."
    },
    {
      "start": 53.62,
      "end": 57.24,
      "text": "Quando riprendete, confrontate il\ncomportamento ottenuto con le regole che"
    },
    {
      "start": 57.24,
      "end": 58.06,
      "text": "avevate dichiarato."
    }
  ]
}
