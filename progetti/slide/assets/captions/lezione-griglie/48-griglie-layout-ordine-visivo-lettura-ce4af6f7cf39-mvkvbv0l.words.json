  "cues": [
    {
      "start": 0.26,
      "end": 4.16,
      "text": "La successione che riconosciamo sullo\nschermo deve essere confrontata con quella"
    },
    {
      "start": 4.16,
      "end": 4.86,
      "text": "del documento."
    },
    {
      "start": 5.58,
      "end": 10.22,
      "text": "Nel linguaggio acca ti emme elle, i\ncontenuti hanno un ordine."
    },
    {
      "start": 10.22,
      "end": 15.18,
      "text": "Il posizionamento con ci esse esse può\nspostarli visivamente lasciando invariata"
    },
    {
      "start": 15.18,
      "end": 15.88,
      "text": "quella sequenza."
    },
    {
      "start": 16.8,
      "end": 20.6,
      "text": "Chi usa una tecnologia assistiva o\npercorre i controlli con la tastiera"
    },
    {
      "start": 20.6,
      "end": 22.82,
      "text": "potrebbe allora incontrare un percorso\ndiverso."
    },
    {
      "start": 23.84,
      "end": 28.34,
      "text": "Nel diagramma, uno, due e tre rendono\nesplicita la sequenza che vogliamo"
    },
    {
      "start": 28.34,
      "end": 31.06,
      "text": "conservare quando i campi si impilano."
    },
    {
      "start": 31.08,
      "end": 34.7,
      "text": "Partiamo dal significato: prima le\ninformazioni che permettono di capire,"
    },
    {
      "start": 35.48,
      "end": 36.34,
      "text": "poi l’azione pertinente."
    },
    {
      "start": 37.54,
      "end": 40.96,
      "text": "La verifica richiede l’interfaccia\nfunzionante."
    },
    {
      "start": 40.98,
      "end": 42.1,
      "text": "Leggiamo l’ordine del documento,"
    },
    {
      "start": 42.9,
      "end": 46.82,
      "text": "percorriamo i controlli con la tastiera e\nconfrontiamo tutto con il percorso"
    },
    {
      "start": 46.82,
      "end": 47.84,
      "text": "suggerito dalla composizione."
    }
  ]
}
