  "cues": [
    {
      "start": 0.26,
      "end": 4.2,
      "text": "Passiamo dallo schema a una doppia pagina\neditoriale."
    },
    {
      "start": 4.2,
      "end": 8.6,
      "text": "Nel documento Muscoli e zucchero, le guide\nsovrapposte ci aiutano a riconoscere"
    },
    {
      "start": 8.6,
      "end": 13.42,
      "text": "divisioni e allineamenti che la pagina\nutilizza per coordinare testi, fotografie"
    },
    {
      "start": 13.42,
      "end": 14.12,
      "text": "e riquadri."
    },
    {
      "start": 15.02,
      "end": 17.66,
      "text": "Il reticolo sostiene elementi di\ndimensioni diverse:"
    },
    {
      "start": 18.32,
      "end": 22.56,
      "text": "non richiede che ogni fotografia coincida\ncon una singola colonna."
    },
    {
      "start": 22.56,
      "end": 25.18,
      "text": "Provate a seguire due riferimenti\norizzontali condivisi,"
    },
    {
      "start": 25.96,
      "end": 29.08,
      "text": "poi cercate un elemento che attraversa più\ncolonne."
    },
    {
      "start": 29.1,
      "end": 30.1,
      "text": "Quali campi mette in relazione?"
    },
    {
      "start": 31.48,
      "end": 35.56,
      "text": "Il titolo prepara un unico percorso oppure\nintroduce una parte autonoma?"
    },
    {
      "start": 36.38,
      "end": 40.14,
      "text": "Questa osservazione collega la costruzione\ngeometrica all'ordine di lettura."
    },
    {
      "start": 41.3,
      "end": 43.9,
      "text": "Le guide rendono visibile la struttura del\nconfronto,"
    },
    {
      "start": 44.66,
      "end": 47.02,
      "text": "ma non sostituiscono la lettura dei\ncontenuti."
    },
    {
      "start": 47.94,
      "end": 52.5,
      "text": "Per valutare il progetto dobbiamo ancora\nconsiderare prossimità delle didascalie,"
    },
    {
      "start": 52.84,
      "end": 55.3,
      "text": "peso delle immagini e continuità dei\ntesti."
    }
  ]
}
