  "cues": [
    {
      "start": 0.26,
      "end": 3.2,
      "text": "Prendiamo una scheda che occupa quattro\ncolonne."
    },
    {
      "start": 3.2,
      "end": 4.8,
      "text": "Sappiamo quanto spazio riceve dalla"
    },
    {
      "start": 5.44,
      "end": 10.04,
      "text": "pagina; ora dobbiamo organizzare titolo,\ndescrizione, stato e azione al suo"
    },
    {
      "start": 10.04,
      "end": 15.02,
      "text": "interno. Osservate le due schede: la\ndescrizione non ha la stessa lunghezza."
    },
    {
      "start": 16.0,
      "end": 19.62,
      "text": "La soluzione deve accogliere questa\ndifferenza conservando un ordine"
    },
    {
      "start": 19.62,
      "end": 20.32,
      "text": "riconoscibile."
    },
    {
      "start": 20.96,
      "end": 22.44,
      "text": "Il titolo introduce l’oggetto,"
    },
    {
      "start": 23.06,
      "end": 27.78,
      "text": "il testo lo spiega, lo stato aggiunge\nun’informazione e l’azione permette di"
    },
    {
      "start": 27.78,
      "end": 28.48,
      "text": "intervenire."
    },
    {
      "start": 29.16,
      "end": 33.32,
      "text": "Se fissiamo l’altezza in base al testo più\nbreve, quello lungo rischia di coprire il"
    },
    {
      "start": 33.32,
      "end": 36.12,
      "text": "comando oppure di essere tagliato."
    },
    {
      "start": 36.12,
      "end": 38.76,
      "text": "Lasciare crescere il contenitore è una\npossibile risposta."
    },
    {
      "start": 39.9,
      "end": 43.94,
      "text": "La stabilità delle relazioni interne conta\nquanto l’allineamento dei bordi."
    }
  ]
}
