  "cues": [
    {
      "start": 0.2,
      "end": 4.28,
      "text": "In un focus group alcune persone discutono\nun argomento con la guida di un"
    },
    {
      "start": 4.28,
      "end": 9.18,
      "text": "moderatore. Possono raccontare esperienze,\nconfrontare aspettative e reagire a"
    },
    {
      "start": 9.18,
      "end": 14.0,
      "text": "un’idea di prodotto. Questo formato può\naiutarci a conoscere il linguaggio usato"
    },
    {
      "start": 14.0,
      "end": 16.44,
      "text": "dalle persone e i temi che considerano\nimportanti."
    },
    {
      "start": 17.54,
      "end": 20.66,
      "text": "Le risposte si costruiscono però anche\nnella dinamica del gruppo:"
    },
    {
      "start": 21.52,
      "end": 24.04,
      "text": "qualcuno introduce un esempio, altri\nconcordano,"
    },
    {
      "start": 24.54,
      "end": 27.28,
      "text": "altri possono esitare a esprimere un punto\ndi vista diverso."
    },
    {
      "start": 28.22,
      "end": 31.68,
      "text": "Nel test di usabilità la situazione che\nvogliamo osservare è diversa."
    },
    {
      "start": 32.52,
      "end": 36.02,
      "text": "Chiediamo a una persona di provare a\nsvolgere un compito e seguiamo le sue"
    },
    {
      "start": 36.02,
      "end": 36.72,
      "text": "azioni."
    },
    {
      "start": 37.28,
      "end": 41.66,
      "text": "Per scegliere il metodo dobbiamo quindi\npartire dalla domanda di ricerca: vogliamo"
    },
    {
      "start": 41.66,
      "end": 46.28,
      "text": "esplorare opinioni e aspettative oppure\ncapire come viene affrontato un percorso"
    },
    {
      "start": 46.28,
      "end": 46.98,
      "text": "di interazione?"
    }
  ]
}
