  "cues": [
    {
      "start": 0.2,
      "end": 4.94,
      "text": "Osservare alcuni compiti su servizi\nesistenti ci permette di imparare prima di"
    },
    {
      "start": 4.94,
      "end": 5.64,
      "text": "costruire."
    },
    {
      "start": 6.32,
      "end": 10.72,
      "text": "Possiamo documentare quali informazioni\nvengono cercate, quali percorsi sono"
    },
    {
      "start": 10.72,
      "end": 14.78,
      "text": "tentati e dove si crea un equivoco."
    },
    {
      "start": 14.78,
      "end": 18.26,
      "text": "L’output utile è un insieme di episodi e\ndomande di progetto."
    },
    {
      "start": 19.22,
      "end": 23.04,
      "text": "Se il totale è difficile da trovare,\npossiamo chiederci come renderlo"
    },
    {
      "start": 23.04,
      "end": 24.58,
      "text": "disponibile nel nostro confronto."
    },
    {
      "start": 26.36,
      "end": 30.6,
      "text": "Evitiamo di trasformare pochi percorsi in\nuna classifica generale dei concorrenti:"
    },
    {
      "start": 31.58,
      "end": 35.56,
      "text": "le conclusioni devono restare legate ai\ncompiti e alle persone osservate."
    }
  ]
