  "cues": [
    {
      "start": 0.1,
      "end": 2.96,
      "text": "Più cicli permettono di verificare il\nlavoro di revisione."
    },
    {
      "start": 3.68,
      "end": 7.88,
      "text": "Nel primo troviamo una difficoltà,\ncambiamo il progetto e nel successivo"
    },
    {
      "start": 7.88,
      "end": 13.14,
      "text": "osserviamo la nuova versione. Ripetere\nserve anche a capire se la correzione ha"
    },
    {
      "start": 13.14,
      "end": 14.42,
      "text": "introdotto altri problemi."
    },
    {
      "start": 15.02,
      "end": 19.44,
      "text": "Se spostiamo il costo nei risultati,\ncontrolliamo sia il confronto sia la"
    },
    {
      "start": 19.44,
      "end": 24.18,
      "text": "comprensione del riepilogo. Ogni ciclo\naggiunge conoscenza entro le condizioni"
    },
    {
      "start": 24.18,
      "end": 28.66,
      "text": "esplorate e può indicare quali persone o\nsituazioni coinvolgere nella prova"
    },
    {
      "start": 28.66,
      "end": 29.36,
      "text": "seguente."
    }
  ]
