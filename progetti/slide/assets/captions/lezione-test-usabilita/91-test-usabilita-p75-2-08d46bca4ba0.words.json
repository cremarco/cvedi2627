  "cues": [
    {
      "start": 0.4,
      "end": 5.56,
      "text": "Lasciare al partecipante alcuni dettagli\npuò rendere l’attività più significativa."
    },
    {
      "start": 5.56,
      "end": 9.76,
      "text": "Cercare un libro che desidera davvero gli\npermette di usare conoscenze e criteri"
    },
    {
      "start": 9.76,
      "end": 10.46,
      "text": "personali,"
    },
    {
      "start": 10.96,
      "end": 13.02,
      "text": "invece di eseguire soltanto una ricerca\nassegnata."
    },
    {
      "start": 14.52,
      "end": 19.0,
      "text": "La libertà deve però rimanere compatibile\ncon la domanda dello studio."
    },
    {
      "start": 19.0,
      "end": 22.92,
      "text": "Se ogni persona affronta un compito\ncompletamente diverso, diventa più"
    },
    {
      "start": 22.92,
      "end": 26.96,
      "text": "difficile confrontare i percorsi o capire\nda che cosa derivi una difficoltà."
    },
    {
      "start": 28.34,
      "end": 32.5,
      "text": "Possiamo distinguere condizioni comuni e\ndettagli liberi."
    },
    {
      "start": 32.5,
      "end": 36.16,
      "text": "Manteniamo, per esempio, il bisogno di\nconoscere il totale prima dell’acquisto,"
    },
    {
      "start": 37.02,
      "end": 39.38,
      "text": "lasciando scegliere il contenuto."
    },
    {
      "start": 39.42,
      "end": 42.28,
      "text": "Documentiamo poi la scelta effettuata."
    },
    {
      "start": 42.28,
      "end": 47.16,
      "text": "Sul caso Passo preferiamo dati predisposti\nquando servono domicilio o informazioni"
    },
    {
      "start": 47.16,
      "end": 47.86,
      "text": "personali."
    },
    {
      "start": 48.4,
      "end": 51.92,
      "text": "La pertinenza del compito può essere\ncostruita attraverso uno scenario"
    },
    {
      "start": 51.92,
      "end": 52.62,
      "text": "realistico,"
    },
    {
      "start": 53.2,
      "end": 56.92,
      "text": "senza trasformare la sessione nella\nraccolta di dettagli privati non"
    },
    {
      "start": 56.92,
      "end": 57.62,
      "text": "necessari."
    }
  ]
}
