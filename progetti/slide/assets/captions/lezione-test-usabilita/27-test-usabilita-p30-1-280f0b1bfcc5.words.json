  "cues": [
    {
      "start": 0.2,
      "end": 3.86,
      "text": "Un’euristica è una guida generale per\nvalutare un problema."
    },
    {
      "start": 3.86,
      "end": 7.38,
      "text": "Le euristiche di Nielsen raccolgono\naspetti ricorrenti dell’interazione:"
    },
    {
      "start": 8.42,
      "end": 12.96,
      "text": "capire lo stato del sistema, trovare\nparole familiari, mantenere il controllo e"
    },
    {
      "start": 12.96,
      "end": 14.14,
      "text": "ridurre il lavoro evitabile."
    },
    {
      "start": 15.4,
      "end": 18.54,
      "text": "Non ci dicono automaticamente come\ndisegnare ogni schermata."
    },
    {
      "start": 19.14,
      "end": 21.84,
      "text": "Per applicarle dobbiamo indicare un punto\ndel progetto,"
    },
    {
      "start": 22.66,
      "end": 25.8,
      "text": "descrivere il possibile ostacolo e\nspiegare il rapporto con il criterio."
    },
    {
      "start": 26.94,
      "end": 29.58,
      "text": "«Questa pagina è poco chiara» rimane\ntroppo generico."
    },
    {
      "start": 30.72,
      "end": 35.18,
      "text": "«Dopo l’invio non distingue richiesta\nricevuta e visita confermata» è già"
    },
    {
      "start": 35.18,
      "end": 37.48,
      "text": "un’osservazione discutibile e\nverificabile."
    },
    {
      "start": 38.26,
      "end": 40.76,
      "text": "Più criteri possono riguardare lo stesso\nepisodio."
    },
    {
      "start": 41.32,
      "end": 45.42,
      "text": "Una conferma ambigua coinvolge stato,\nlinguaggio e modello del servizio."
    },
    {
      "start": 46.52,
      "end": 49.92,
      "text": "Il nostro scopo è rendere esplicita la\nmotivazione della valutazione."
    },
    {
      "start": 50.98,
      "end": 53.06,
      "text": "L’ispezione produce criticità potenziali."
    },
    {
      "start": 54.02,
      "end": 58.88,
      "text": "Il test ci permetterà di osservare quali\nsi manifestano, come vengono affrontate e"
    },
    {
      "start": 58.88,
      "end": 61.16,
      "text": "quali altre difficoltà non avevamo\nprevisto."
    }
  ]
