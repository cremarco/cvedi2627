  "cues": [
    {
      "start": 0.32,
      "end": 4.8,
      "text": "Quando manca comprensione, aggiungere una\nspiegazione è una possibilità."
    },
    {
      "start": 4.8,
      "end": 9.34,
      "text": "Prima chiediamoci però se l’informazione\nnecessaria è oscurata da altri elementi o"
    },
    {
      "start": 9.34,
      "end": 10.28,
      "text": "da parole incoerenti."
    },
    {
      "start": 11.54,
      "end": 15.62,
      "text": "Sul riepilogo di Passo potremmo chiarire\nl’invio cambiando il comando e il"
    },
    {
      "start": 15.62,
      "end": 16.52,
      "text": "messaggio di stato,"
    },
    {
      "start": 17.06,
      "end": 18.32,
      "text": "anziché aggiungere un lungo paragrafo."
    },
    {
      "start": 19.18,
      "end": 21.04,
      "text": "La scelta dipende dalla causa che\nipotizziamo."
    },
    {
      "start": 22.32,
      "end": 25.82,
      "text": "Una revisione mirata ci permette di\nverificare se la comprensione cambia,"
    },
    {
      "start": 26.6,
      "end": 29.88,
      "text": "evitando di accumulare elementi dei quali\nnon sappiamo valutare l’effetto."
    }
  ]
