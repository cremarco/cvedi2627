  "cues": [
    {
      "start": 0.24,
      "end": 5.22,
      "text": "Il temperamatite mostra un limite fisico:\nl’apertura e la forma dell’oggetto guidano"
    },
    {
      "start": 5.22,
      "end": 10.32,
      "text": "l’inserimento della matita. Alcune azioni\nsono possibili e altre vengono ostacolate"
    },
    {
      "start": 10.4,
      "end": 11.1,
      "text": "dalla costruzione."
    },
    {
      "start": 12.3,
      "end": 16.34,
      "text": "Nell’interfaccia a destra la quantità non\npuò scendere sotto uno."
    },
    {
      "start": 16.34,
      "end": 20.82,
      "text": "Il valore minimo è scritto vicino al\nselettore e il pulsante meno è disattivato"
    },
    {
      "start": 20.82,
      "end": 22.12,
      "text": "quando il valore è già uno."
    },
    {
      "start": 22.78,
      "end": 25.84,
      "text": "Il limite impedisce di selezionare una\nquantità non valida."
    },
    {
      "start": 26.86,
      "end": 30.1,
      "text": "Il confronto mostra un vincolo fisico e\nuna regola digitale."
    },
    {
      "start": 30.88,
      "end": 33.72,
      "text": "In entrambi i casi il progetto restringe\nle azioni possibili."
    },
    {
      "start": 34.68,
      "end": 38.64,
      "text": "La regola deve essere comprensibile:\nvedere un comando disattivato senza"
    },
    {
      "start": 38.64,
      "end": 42.32,
      "text": "capirne il motivo può creare una nuova\ndifficoltà."
    },
    {
      "start": 42.32,
      "end": 46.64,
      "text": "Nel test osserveremmo se la persona\nriconosce il limite, comprende perché il"
    },
    {
      "start": 46.64,
      "end": 49.14,
      "text": "comando non è disponibile e sa come\nproseguire."
    },
    {
      "start": 50.02,
      "end": 53.9,
      "text": "Il vincolo funziona quando previene un\nerrore e rende chiaro che cosa si può"
    },
    {
      "start": 53.9,
      "end": 54.56,
      "text": "fare."
    }
  ]
}
