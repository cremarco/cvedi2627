  "cues": [
    {
      "start": 0.22,
      "end": 4.5,
      "text": "Osservare una sessione può cambiare il\nmodo in cui il gruppo immagina le persone"
    },
    {
      "start": 4.5,
      "end": 5.5,
      "text": "che useranno il servizio."
    },
    {
      "start": 6.5,
      "end": 11.68,
      "text": "Un percorso che sembrava ovvio diventa una\nsequenza di tentativi, interpretazioni e"
    },
    {
      "start": 11.68,
      "end": 12.38,
      "text": "domande."
    },
    {
      "start": 13.84,
      "end": 18.62,
      "text": "Questo incontro è utile se resistiamo alla\ntentazione di attribuire ogni difficoltà"
    },
    {
      "start": 18.62,
      "end": 19.32,
      "text": "al partecipante."
    },
    {
      "start": 20.3,
      "end": 24.42,
      "text": "Chiediamoci quali informazioni aveva e che\ncosa l’interfaccia gli stava suggerendo."
    },
    {
      "start": 25.88,
      "end": 31.18,
      "text": "Il test ci permette di rivedere le nostre\nipotesi sulla base di episodi concreti,"
    },
    {
      "start": 31.18,
      "end": 34.0,
      "text": "mantenendo attenzione alle condizioni in\ncui sono avvenuti."
    }
  ]
