  "cues": [
    {
      "start": 0.24,
      "end": 4.74,
      "text": "Una volta scelte le criticità, le\nordiniamo e associamo a ciascuna una prima"
    },
    {
      "start": 4.74,
      "end": 9.52,
      "text": "ipotesi di intervento. Indichiamo chi se\nne occuperà e quali risorse serviranno."
    },
    {
      "start": 10.68,
      "end": 14.4,
      "text": "L’ordine da uno a dieci serve a scegliere\nda dove cominciare."
    },
    {
      "start": 14.4,
      "end": 16.6,
      "text": "Il primo posto non è un voto di gravità."
    },
    {
      "start": 17.24,
      "end": 21.46,
      "text": "Fra poco vedremo una scala diversa, da\nzero a quattro, che descrive il problema."
    },
    {
      "start": 22.38,
      "end": 26.18,
      "text": "Dopo la modifica dovremo tornare al\ncompito per verificare se il percorso è"
    },
    {
      "start": 26.18,
      "end": 26.88,
      "text": "migliorato."
    }
  ]
