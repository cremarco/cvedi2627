  "cues": [
    {
      "start": 0.32,
      "end": 3.94,
      "text": "Possiamo iniziare a osservare prima di\navere un nostro prototipo."
    },
    {
      "start": 3.94,
      "end": 8.42,
      "text": "Un servizio esistente con attività simili\npermette di esplorare come le persone"
    },
    {
      "start": 8.42,
      "end": 12.66,
      "text": "cercano informazioni, interpretano le\nparole e confrontano le alternative."
    },
    {
      "start": 13.92,
      "end": 18.26,
      "text": "Il confronto può riguardare un concorrente\noppure un prodotto con un’organizzazione"
    },
    {
      "start": 18.26,
      "end": 19.18,
      "text": "pertinente alla domanda."
    },
    {
      "start": 20.0,
      "end": 24.4,
      "text": "Per Passo potremmo osservare come viene\nverificata la disponibilità di un servizio"
    },
    {
      "start": 24.4,
      "end": 27.36,
      "text": "e quando viene cercato il costo totale."
    },
    {
      "start": 27.6,
      "end": 29.38,
      "text": "Dobbiamo mantenere il contesto\ndell’osservazione."
    },
    {
      "start": 30.54,
      "end": 34.44,
      "text": "Una difficoltà incontrata su un altro sito\nsuggerisce una domanda per il nostro"
    },
    {
      "start": 35.28,
      "end": 38.88,
      "text": "progetto; non dimostra che la stessa\nsoluzione produrrebbe lo stesso risultato"
    },
    {
      "start": 38.88,
      "end": 39.68,
      "text": "in ogni servizio."
    },
    {
      "start": 40.68,
      "end": 44.7,
      "text": "Cominciare presto significa usare\nmateriali adatti a ciò che vogliamo capire"
    },
    {
      "start": 44.7,
      "end": 45.4,
      "text": "in quel momento."
    },
    {
      "start": 46.16,
      "end": 50.28,
      "text": "La ricerca può orientare le prime\ndecisioni, poi accompagnare le versioni"
    },
    {
      "start": 50.28,
      "end": 52.08,
      "text": "successive attraverso nuove prove."
    }
  ]
}
