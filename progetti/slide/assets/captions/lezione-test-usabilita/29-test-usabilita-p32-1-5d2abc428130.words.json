  "cues": [
    {
      "start": 0.18,
      "end": 4.46,
      "text": "Il sistema dovrebbe usare parole e\ncategorie comprensibili alle persone che"
    },
    {
      "start": 4.46,
      "end": 8.22,
      "text": "lo utilizzano. Nell’esempio della libreria\ntroviamo musica,"
    },
    {
      "start": 8.8,
      "end": 10.14,
      "text": "film, serie televisive,"
    },
    {
      "start": 10.7,
      "end": 13.86,
      "text": "podcast e audiolibri: categorie che\nrimandano ai contenuti,"
    },
    {
      "start": 14.44,
      "end": 18.58,
      "text": "senza richiedere di conoscere\nl’organizzazione tecnica del programma."
    },
    {
      "start": 18.58,
      "end": 20.64,
      "text": "La familiarità va valutata nel contesto."
    },
    {
      "start": 21.42,
      "end": 25.48,
      "text": "Un termine appropriato per chi lavora in\nun settore può richiedere una spiegazione"
    },
    {
      "start": 25.48,
      "end": 30.38,
      "text": "per chi vi entra la prima volta. Per Passo\ndobbiamo chiederci se «richiesta»,"
    },
    {
      "start": 30.88,
      "end": 34.96,
      "text": "«disponibilità» e «conferma» descrivono\nchiaramente quello che il servizio"
    },
    {
      "start": 34.96,
      "end": 35.86,
      "text": "permette di ottenere."
    },
    {
      "start": 36.58,
      "end": 40.26,
      "text": "La correttezza interna del termine non\ngarantisce che il significato sia"
    },
    {
      "start": 40.26,
      "end": 45.42,
      "text": "condiviso. Durante il test ascoltiamo le\nparole con cui il partecipante descrive il"
    },
    {
      "start": 45.42,
      "end": 46.12,
      "text": "percorso."
    },
    {
      "start": 46.62,
      "end": 50.34,
      "text": "Un termine diverso dal nostro può rivelare\nun’aspettativa utile da approfondire."
    }
  ]
}
