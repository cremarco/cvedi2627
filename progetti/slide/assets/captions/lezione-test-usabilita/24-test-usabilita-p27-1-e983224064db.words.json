  "cues": [
    {
      "start": 0.16,
      "end": 3.52,
      "text": "Un modello concettuale è una spiegazione\nsemplificata del funzionamento."
    },
    {
      "start": 4.58,
      "end": 9.0,
      "text": "Ci permette di collegare le azioni e\nprevederne le conseguenze senza conoscere"
    },
    {
      "start": 9.0,
      "end": 14.52,
      "text": "ogni dettaglio tecnico del sistema. La\nmetafora di una cartella ci aiuta a"
    },
    {
      "start": 14.52,
      "end": 16.76,
      "text": "pensare a documenti raccolti in un\ncontenitore."
    },
    {
      "start": 17.54,
      "end": 21.48,
      "text": "Non descrive come i dati siano\nmemorizzati, ma può sostenere azioni"
    },
    {
      "start": 21.48,
      "end": 25.88,
      "text": "comprensibili come aprire, spostare e\norganizzare."
    },
    {
      "start": 25.88,
      "end": 29.14,
      "text": "Anche un servizio di prenotazione propone\nun modello:"
    },
    {
      "start": 29.96,
      "end": 32.48,
      "text": "cerco, scelgo, invio una richiesta e\nricevo una risposta."
    },
    {
      "start": 33.52,
      "end": 36.82,
      "text": "Se le parole e gli stati lasciano\nimmaginare invece una prenotazione"
    },
    {
      "start": 36.82,
      "end": 41.44,
      "text": "immediata, nasce uno scarto fra la\nspiegazione costruita dalla persona e il"
    },
    {
      "start": 41.44,
      "end": 42.38,
      "text": "funzionamento reale."
    },
    {
      "start": 43.62,
      "end": 46.68,
      "text": "Il test può rendere visibile questo\nscarto."
    },
    {
      "start": 46.68,
      "end": 50.96,
      "text": "Dopo un passaggio possiamo chiedere che\ncosa la persona pensa sia successo e che"
    },
    {
      "start": 50.96,
      "end": 56.24,
      "text": "cosa si aspetta ora. Confrontiamo poi\nquella risposta con l’esito effettivo."
    }
  ]
}
