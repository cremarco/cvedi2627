  "cues": [
    {
      "start": 0.18,
      "end": 4.54,
      "text": "Il partecipante deve avere un rapporto\nplausibile con il prodotto e con il"
    },
    {
      "start": 4.54,
      "end": 8.6,
      "text": "compito. Può già usare il servizio oppure\navere bisogni ed esperienze pertinenti,"
    },
    {
      "start": 9.56,
      "end": 11.96,
      "text": "anche se lo incontra per la prima volta."
    },
    {
      "start": 11.96,
      "end": 16.3,
      "text": "Per Passo ci interessa qualcuno che possa\ncomprendere la ricerca di una visita a"
    },
    {
      "start": 16.3,
      "end": 19.18,
      "text": "domicilio e le condizioni della scelta."
    },
    {
      "start": 19.18,
      "end": 23.1,
      "text": "Essere disponibile a fare una prova non\nbasta, se la situazione è completamente"
    },
    {
      "start": 23.1,
      "end": 28.08,
      "text": "estranea alla sua esperienza. Dobbiamo\nanche considerare differenze rilevanti per"
    },
    {
      "start": 28.08,
      "end": 28.78,
      "text": "l’uso:"
    },
    {
      "start": 29.14,
      "end": 30.1,
      "text": "familiarità digitale,"
    },
    {
      "start": 30.68,
      "end": 34.16,
      "text": "lingua, dispositivi e tecnologie assistive\npossono cambiare il percorso."
    },
    {
      "start": 35.18,
      "end": 37.36,
      "text": "Non occorre che tutte le persone siano\nidentiche,"
    },
    {
      "start": 37.94,
      "end": 40.22,
      "text": "ma dobbiamo sapere quali situazioni\nabbiamo esplorato."
    },
    {
      "start": 41.48,
      "end": 44.02,
      "text": "Il reclutamento definisce il perimetro\ndelle conclusioni."
    },
    {
      "start": 44.98,
      "end": 49.28,
      "text": "Se abbiamo osservato solo persone esperte\nsu un computer, resta aperta la domanda"
    },
    {
      "start": 49.28,
      "end": 51.46,
      "text": "sull’uso da telefono o con altri\nstrumenti."
    }
  ]
