  "cues": [
    {
      "start": 0.22,
      "end": 4.2,
      "text": "Il libro di Norman pubblicato nel\nmillenovecentottantotto è un riferimento"
    },
    {
      "start": 4.2,
      "end": 5.6,
      "text": "importante per questa discussione."
    },
    {
      "start": 6.84,
      "end": 8.56,
      "text": "Nel percorso useremo sei concetti:"
    },
    {
      "start": 9.68,
      "end": 11.06,
      "text": "affordance, significanti,"
    },
    {
      "start": 11.8,
      "end": 14.74,
      "text": "mapping, vincoli, feedback e modello\nconcettuale."
    },
    {
      "start": 16.2,
      "end": 19.88,
      "text": "Li incontreremo separatamente per\ncomprenderli, anche se nell’uso"
    },
    {
      "start": 19.88,
      "end": 20.7,
      "text": "collaborano."
    },
    {
      "start": 21.26,
      "end": 26.28,
      "text": "Un comando rende possibile un’azione; la\nsua forma e la sua etichetta ci aiutano a"
    },
    {
      "start": 26.28,
      "end": 26.98,
      "text": "riconoscerla."
    },
    {
      "start": 27.84,
      "end": 32.14,
      "text": "La posizione mette in relazione il\ncontrollo e il risultato."
    },
    {
      "start": 32.14,
      "end": 37.84,
      "text": "I vincoli limitano alcune possibilità e il\nfeedback ci informa di ciò che è accaduto."
    },
    {
      "start": 37.84,
      "end": 41.92,
      "text": "Il modello concettuale tiene insieme\nqueste indicazioni in una spiegazione del"
    },
    {
      "start": 41.92,
      "end": 46.88,
      "text": "funzionamento. La terminologia è stata\nprecisata nel tempo: in particolare"
    },
    {
      "start": 46.88,
      "end": 51.1,
      "text": "terremo distinta la possibilità di agire\ndai segnali che la rendono percepibile."
    },
    {
      "start": 52.28,
      "end": 56.7,
      "text": "Questa distinzione evita di chiamare\naffordance qualsiasi elemento visivo che"
    },
    {
      "start": 56.7,
      "end": 57.4,
      "text": "attira l’attenzione."
    }
  ]
}
