  "cues": [
    {
      "start": 0.18,
      "end": 4.18,
      "text": "Nel pulsante dell’ascensore,\nl’illuminazione dopo la pressione segnala"
    },
    {
      "start": 4.18,
      "end": 6.44,
      "text": "che la chiamata è stata registrata."
    },
    {
      "start": 6.44,
      "end": 10.48,
      "text": "L’ascensore potrebbe ancora impiegare\ntempo ad arrivare, ma la persona riceve"
    },
    {
      "start": 10.48,
      "end": 15.18,
      "text": "una risposta all’azione. Sul pulsante\ndigitale compare un indicatore di"
    },
    {
      "start": 15.18,
      "end": 15.88,
      "text": "caricamento."
    },
    {
      "start": 16.4,
      "end": 18.66,
      "text": "Anche qui il messaggio riguarda il lavoro\nin corso."
    },
    {
      "start": 19.38,
      "end": 24.16,
      "text": "Il movimento può segnalare attività, ma da\nsolo non dice quanto durerà né se"
    },
    {
      "start": 24.16,
      "end": 25.22,
      "text": "l’operazione è terminata."
    },
    {
      "start": 26.04,
      "end": 28.58,
      "text": "Quando il risultato arriva, il feedback\ndeve aggiornarsi."
    },
    {
      "start": 29.48,
      "end": 33.52,
      "text": "Se invece compare un errore, deve offrire\nuna strada per recuperare."
    },
    {
      "start": 33.52,
      "end": 37.56,
      "text": "Il legame che ci interessa è fra azione,\nstato comunicato ed esito."
    },
    {
      "start": 38.54,
      "end": 43.1,
      "text": "Durante una prova osserveremmo se il\npartecipante aspetta, ripete il comando"
    },
    {
      "start": 43.14,
      "end": 46.02,
      "text": "oppure abbandona perché non capisce che\ncosa stia succedendo."
    }
  ]
}
