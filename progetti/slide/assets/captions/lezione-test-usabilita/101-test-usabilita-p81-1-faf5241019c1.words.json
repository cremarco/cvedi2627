  "cues": [
    {
      "start": 0.28,
      "end": 3.4,
      "text": "Cominciamo con un elenco comune dei\nproblemi segnalati dagli osservatori."
    },
    {
      "start": 4.48,
      "end": 9.96,
      "text": "Ogni voce dovrebbe richiamare uno o più\nepisodi: compito, difficoltà ed effetto"
    },
    {
      "start": 9.96,
      "end": 10.66,
      "text": "sul risultato."
    },
    {
      "start": 11.76,
      "end": 15.78,
      "text": "Le formulazioni simili possono essere\nriunite, mantenendo i riferimenti alle"
    },
    {
      "start": 15.78,
      "end": 16.48,
      "text": "sessioni."
    },
    {
      "start": 17.08,
      "end": 21.34,
      "text": "La procedura della slide propone di far\nemergere i problemi più gravi e poi"
    },
    {
      "start": 21.34,
      "end": 22.86,
      "text": "selezionarne un gruppo da discutere."
    },
    {
      "start": 23.78,
      "end": 28.52,
      "text": "I segni di accordo aiutano a organizzare\nla conversazione, ma non misurano da soli"
    },
    {
      "start": 28.52,
      "end": 29.76,
      "text": "la diffusione del problema."
    },
    {
      "start": 30.82,
      "end": 35.02,
      "text": "Cinque osservatori possono aver visto lo\nstesso unico episodio."
    },
    {
      "start": 35.02,
      "end": 38.4,
      "text": "La priorità deve considerare anche le\nconseguenze."
    },
    {
      "start": 38.4,
      "end": 42.08,
      "text": "Un equivoco sulla conferma della visita\npuò avere un impatto maggiore di"
    },
    {
      "start": 42.08,
      "end": 44.02,
      "text": "un’incertezza momentanea su un’icona,"
    },
    {
      "start": 44.58,
      "end": 45.92,
      "text": "anche se viene citato da meno persone."
    },
    {
      "start": 46.94,
      "end": 49.64,
      "text": "Il numero dieci è una scelta organizzativa\ndella proposta."
    },
    {
      "start": 50.6,
      "end": 54.44,
      "text": "Possiamo selezionare un elenco più breve\nse le risorse o le evidenze lo richiedono."
    },
    {
      "start": 55.36,
      "end": 59.68,
      "text": "L’importante è arrivare a problemi\ndescritti abbastanza bene da motivare un"
    },
    {
      "start": 59.96,
      "end": 62.4,
      "text": "intervento, conservando le questioni\nancora da approfondire."
    }
  ]
}
