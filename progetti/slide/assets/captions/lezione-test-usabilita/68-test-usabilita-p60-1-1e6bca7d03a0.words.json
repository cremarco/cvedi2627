  "cues": [
    {
      "start": 0.24,
      "end": 4.44,
      "text": "Nel pensiero ad alta voce chiediamo alla\npersona di raccontare ciò che cerca, si"
    },
    {
      "start": 4.44,
      "end": 7.98,
      "text": "aspetta e interpreta mentre svolge il\ncompito."
    },
    {
      "start": 7.98,
      "end": 12.04,
      "text": "Potremmo sentire: «Cerco il totale perché\nvoglio capire se rientra nella spesa»."
    },
    {
      "start": 13.82,
      "end": 18.78,
      "text": "Questo racconto aiuta a leggere le azioni,\nma non rende direttamente accessibile ogni"
    },
    {
      "start": 18.98,
      "end": 19.68,
      "text": "processo mentale."
    },
    {
      "start": 20.56,
      "end": 22.88,
      "text": "Parlare può anche modificare tempi e\ncomportamento."
    },
    {
      "start": 24.72,
      "end": 28.84,
      "text": "Registriamo quindi parole e azioni\ninsieme, considerando le condizioni della"
    },
    {
      "start": 28.84,
      "end": 30.6,
      "text": "prova quando interpretiamo il risultato."
    }
  ]
