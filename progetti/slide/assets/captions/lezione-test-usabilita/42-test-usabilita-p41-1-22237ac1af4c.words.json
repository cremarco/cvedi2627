  "cues": [
    {
      "start": 0.14,
      "end": 1.88,
      "text": "Entriamo ora nei test di usabilità."
    },
    {
      "start": 2.72,
      "end": 6.98,
      "text": "L’idea di base è osservare una persona\nmentre cerca di raggiungere un risultato"
    },
    {
      "start": 6.98,
      "end": 8.88,
      "text": "attraverso un prodotto o un servizio."
    },
    {
      "start": 10.28,
      "end": 14.54,
      "text": "Vedremo come scegliere la situazione,\ncondurre la sessione e usare ciò che"
    },
    {
      "start": 14.54,
      "end": 17.04,
      "text": "emerge per migliorare il progetto."
    },
    {
      "start": 17.04,
      "end": 20.76,
      "text": "Cominciamo distinguendo questo metodo da\nuna discussione di gruppo sulle opinioni."
    }
  ]
