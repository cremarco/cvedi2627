  "cues": [
    {
      "start": 0.22,
      "end": 5.12,
      "text": "La documentazione deve aiutare una persona\na svolgere un compito concreto."
    },
    {
      "start": 5.12,
      "end": 9.24,
      "text": "Una spiegazione generica del servizio può\nessere meno utile di un’indicazione"
    },
    {
      "start": 9.24,
      "end": 12.46,
      "text": "disponibile nel punto in cui nasce il\ndubbio."
    },
    {
      "start": 12.46,
      "end": 16.1,
      "text": "Su Passo una domanda potrebbe essere: «Ho\ninviato la richiesta:"
    },
    {
      "start": 16.78,
      "end": 18.72,
      "text": "quando saprò se la visita è confermata?»."
    },
    {
      "start": 19.18,
      "end": 22.04,
      "text": "La risposta deve chiarire stato e passo\nsuccessivo."
    },
    {
      "start": 23.16,
      "end": 26.8,
      "text": "Se esiste un percorso di assistenza, deve\nessere facile da trovare."
    },
    {
      "start": 27.48,
      "end": 29.92,
      "text": "La documentazione va coordinata con\nl’interfaccia."
    },
    {
      "start": 30.72,
      "end": 35.18,
      "text": "Una guida molto dettagliata non risolve\nautomaticamente un comando ambiguo; a"
    },
    {
      "start": 35.18,
      "end": 37.44,
      "text": "volte occorre correggere prima il comando."
    },
    {
      "start": 38.24,
      "end": 41.28,
      "text": "Nel test possiamo annotare quando nasce il\nbisogno di aiuto,"
    },
    {
      "start": 41.76,
      "end": 44.66,
      "text": "come viene cercato e se la spiegazione\npermette di riprendere."
    },
    {
      "start": 45.52,
      "end": 49.52,
      "text": "È il risultato sul compito a dirci se\nquell’informazione è stata utile."
    }
  ]
}
