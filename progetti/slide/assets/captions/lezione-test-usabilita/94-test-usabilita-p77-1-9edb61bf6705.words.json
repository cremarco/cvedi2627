  "cues": [
    {
      "start": 0.24,
      "end": 3.7,
      "text": "La parte più ampia della sessione è\ndedicata ai compiti."
    },
    {
      "start": 3.7,
      "end": 7.82,
      "text": "Il facilitatore presenta la situazione e\nlascia che la persona affronti il"
    },
    {
      "start": 7.82,
      "end": 10.14,
      "text": "percorso. Osserviamo dove comincia,"
    },
    {
      "start": 10.84,
      "end": 14.24,
      "text": "quali informazioni cerca e quali\nalternative prende in considerazione."
    },
    {
      "start": 15.5,
      "end": 18.94,
      "text": "Sosteniamo il pensiero ad alta voce con\ninviti brevi e neutrali,"
    },
    {
      "start": 19.58,
      "end": 24.6,
      "text": "senza interrompere ogni passaggio. Una\ndomanda come «Che cosa stai cercando?» può"
    },
    {
      "start": 24.6,
      "end": 25.52,
      "text": "chiarire un’esitazione."
    },
    {
      "start": 26.5,
      "end": 29.46,
      "text": "«Hai visto il comando in alto?» fornisce\ninvece un indizio."
    },
    {
      "start": 30.54,
      "end": 33.3,
      "text": "Annotiamo anche l’esito e gli interventi."
    },
    {
      "start": 33.3,
      "end": 37.28,
      "text": "Se il partecipante rimane bloccato,\npossiamo decidere di offrire un aiuto per"
    },
    {
      "start": 37.28,
      "end": 38.76,
      "text": "esplorare la parte successiva,"
    },
    {
      "start": 39.42,
      "end": 41.76,
      "text": "ma registriamo il punto in cui è stato\nnecessario."
    },
    {
      "start": 42.86,
      "end": 46.38,
      "text": "La cura della persona rimane una\ncondizione della prova."
    },
    {
      "start": 46.38,
      "end": 49.94,
      "text": "Non dobbiamo prolungare una situazione\nfrustrante per ottenere altri dati."
    },
    {
      "start": 50.68,
      "end": 55.0,
      "text": "Possiamo fermare un compito, passare a un\naltro o interrompere la sessione secondo"
    },
    {
      "start": 55.0,
      "end": 56.04,
      "text": "le condizioni concordate."
    },
    {
      "start": 57.02,
      "end": 59.46,
      "text": "Il risultato utile è un percorso\ndocumentato:"
    },
    {
      "start": 60.1,
      "end": 64.28,
      "text": "sappiamo che cosa è avvenuto\nautonomamente, dove è emersa la difficoltà"
    },
    {
      "start": 64.28,
      "end": 66.46,
      "text": "e che cosa è cambiato dopo il nostro\nintervento."
    }
  ]
}
