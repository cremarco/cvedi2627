  "cues": [
    {
      "start": 0.22,
      "end": 4.38,
      "text": "I vincoli restringono le azioni possibili\ne possono aiutare a evitare errori."
    },
    {
      "start": 5.28,
      "end": 10.38,
      "text": "Un’apertura che accoglie soltanto una\ncerta forma introduce un limite fisico."
    },
    {
      "start": 10.38,
      "end": 15.46,
      "text": "Una convenzione culturale orienta invece\nciò che ci sembra appropriato fare."
    },
    {
      "start": 15.46,
      "end": 18.46,
      "text": "I vincoli semantici dipendono dal\nsignificato della"
    },
    {
      "start": 19.42,
      "end": 21.86,
      "text": "situazione; quelli logici dalle relazioni\nfra gli elementi."
    },
    {
      "start": 22.68,
      "end": 26.24,
      "text": "Se un passaggio richiede una scelta\nprecedente, il sistema può rendere"
    },
    {
      "start": 26.24,
      "end": 27.36,
      "text": "esplicita questa dipendenza."
    },
    {
      "start": 28.52,
      "end": 32.28,
      "text": "Il punto è capire quando il limite aiuta e\nquando diventa un ostacolo."
    },
    {
      "start": 33.32,
      "end": 37.9,
      "text": "Disattivare un comando senza spiegare\nperché può lasciare la persona bloccata."
    },
    {
      "start": 37.9,
      "end": 41.76,
      "text": "Un vincolo utile dovrebbe accompagnarsi\nalle informazioni necessarie per"
    },
    {
      "start": 41.76,
      "end": 42.46,
      "text": "procedere."
    },
    {
      "start": 42.94,
      "end": 47.74,
      "text": "Su Passo, per esempio, l’indisponibilità\ndi un orario deve essere comprensibile e"
    },
    {
      "start": 47.74,
      "end": 50.26,
      "text": "deve lasciare accessibile la ricerca di\nun’alternativa."
    }
  ]
}
