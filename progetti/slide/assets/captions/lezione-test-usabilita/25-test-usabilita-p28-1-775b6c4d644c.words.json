  "cues": [
    {
      "start": 0.26,
      "end": 3.6,
      "text": "La cartella richiama un contenitore di\ndocumenti."
    },
    {
      "start": 3.6,
      "end": 6.56,
      "text": "Le altre immagini riprendono oggetti e\nazioni riconoscibili:"
    },
    {
      "start": 7.32,
      "end": 10.28,
      "text": "la stampante, le forbici, il cestino e la\ngraffetta."
    },
    {
      "start": 11.7,
      "end": 16.24,
      "text": "Questi riferimenti aiutano a costruire\nun’aspettativa su stampa, taglio,"
    },
    {
      "start": 16.46,
      "end": 17.64,
      "text": "eliminazione e allegati."
    },
    {
      "start": 18.46,
      "end": 20.96,
      "text": "La familiarità, però, dipende\ndall’esperienza."
    },
    {
      "start": 21.78,
      "end": 26.52,
      "text": "Inoltre il funzionamento digitale può\ndifferire dall’oggetto fisico: eliminare"
    },
    {
      "start": 26.52,
      "end": 29.96,
      "text": "potrebbe spostare un file nel cestino\noppure cancellarlo definitivamente."
    },
    {
      "start": 31.32,
      "end": 35.14,
      "text": "L’icona da sola non chiarisce sempre\nquesta differenza."
    },
    {
      "start": 35.14,
      "end": 39.24,
      "text": "Il modello concettuale funziona quando le\nindicazioni e il comportamento si"
    },
    {
      "start": 39.24,
      "end": 40.18,
      "text": "sostengono a vicenda."
    },
    {
      "start": 41.04,
      "end": 45.44,
      "text": "Se uso il cestino per una cancellazione\nirreversibile, devo rendere comprensibile"
    },
    {
      "start": 45.44,
      "end": 46.14,
      "text": "la conseguenza."
    },
    {
      "start": 47.18,
      "end": 51.46,
      "text": "Osservare ciò che la persona si aspetta ci\naiuta a individuare dove la metafora"
    },
    {
      "start": 51.46,
      "end": 54.0,
      "text": "sostiene la comprensione e dove lascia\nun’ambiguità."
    }
  ]
}
