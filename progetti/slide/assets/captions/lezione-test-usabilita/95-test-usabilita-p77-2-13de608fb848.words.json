  "cues": [
    {
      "start": 0.24,
      "end": 1.74,
      "text": "Se la persona chiede aiuto,"
    },
    {
      "start": 2.22,
      "end": 6.22,
      "text": "possiamo rispondere: «Che cosa faresti se\nio non ci fossi?»."
    },
    {
      "start": 6.22,
      "end": 9.98,
      "text": "La domanda permette di esplorare una\nstrategia senza indicare subito la"
    },
    {
      "start": 9.98,
      "end": 10.68,
      "text": "soluzione."
    },
    {
      "start": 11.28,
      "end": 12.46,
      "text": "Usiamola con attenzione,"
    },
    {
      "start": 13.0,
      "end": 15.08,
      "text": "senza ripeterla come una formula a ogni\ndifficoltà."
    },
    {
      "start": 16.06,
      "end": 18.26,
      "text": "Se emerge un blocco o la persona vuole\nfermarsi,"
    },
    {
      "start": 19.24,
      "end": 21.82,
      "text": "possiamo intervenire o chiudere il\ncompito."
    },
    {
      "start": 22.04,
      "end": 22.74,
      "text": "Registriamo la richiesta,"
    },
    {
      "start": 23.32,
      "end": 27.34,
      "text": "il tentativo successivo e l’eventuale\naiuto, così da distinguere ciò che"
    },
    {
      "start": 27.34,
      "end": 30.1,
      "text": "l’interfaccia ha sostenuto da ciò che ha\nrichiesto assistenza."
    }
  ]
}
