  "cues": [
    {
      "start": 0.24,
      "end": 4.24,
      "text": "Il mapping è la relazione fra i controlli\ne i loro effetti."
    },
    {
      "start": 4.24,
      "end": 8.24,
      "text": "Una disposizione coerente ci aiuta a\ncapire quale comando agisce su quale"
    },
    {
      "start": 8.24,
      "end": 9.74,
      "text": "elemento e in quale direzione."
    },
    {
      "start": 10.86,
      "end": 13.66,
      "text": "Pensiamo a una serie di interruttori per\npiù luci."
    },
    {
      "start": 13.66,
      "end": 15.94,
      "text": "Se la disposizione riprende quella degli\nambienti,"
    },
    {
      "start": 16.56,
      "end": 18.52,
      "text": "possiamo usare il rapporto spaziale per\nscegliere."
    },
    {
      "start": 19.36,
      "end": 21.48,
      "text": "Se sono tutti in fila senza riferimenti,"
    },
    {
      "start": 21.96,
      "end": 23.78,
      "text": "dobbiamo imparare o provare ogni\nassociazione."
    },
    {
      "start": 24.94,
      "end": 28.4,
      "text": "Nell’interfaccia un controllo per\naumentare una quantità può essere"
    },
    {
      "start": 28.4,
      "end": 32.92,
      "text": "collocato a destra del valore e quello per\ndiminuirla a sinistra."
    },
    {
      "start": 32.92,
      "end": 36.18,
      "text": "Questa disposizione si appoggia a\nconvenzioni familiari in molti contesti,"
    },
    {
      "start": 36.94,
      "end": 41.14,
      "text": "ma la direzione va verificata rispetto\nalla lingua e alla funzione."
    },
    {
      "start": 41.14,
      "end": 43.56,
      "text": "La posizione da sola non è una regola\nuniversale."
    },
    {
      "start": 44.74,
      "end": 49.5,
      "text": "Anche la barra di scorrimento comunica una\nrelazione: la posizione del cursore indica"
    },
    {
      "start": 49.5,
      "end": 54.04,
      "text": "dove siamo nel documento e il movimento\ndel controllo modifica la parte visibile."
    },
    {
      "start": 54.74,
      "end": 58.08,
      "text": "Lo spostamento sullo schermo dipende dalle\nproporzioni del documento,"
    },
    {
      "start": 58.62,
      "end": 63.26,
      "text": "quindi non dobbiamo intendere l’esempio\ncome identità esatta delle distanze."
    },
    {
      "start": 63.26,
      "end": 67.5,
      "text": "Per valutare il mapping chiediamo se la\npersona riesce ad anticipare il risultato"
    },
    {
      "start": 67.5,
      "end": 68.2,
      "text": "del comando."
    },
    {
      "start": 68.72,
      "end": 71.48,
      "text": "Un rapporto leggibile riduce tentativi e\ncorrezioni,"
    },
    {
      "start": 72.54,
      "end": 74.38,
      "text": "soprattutto quando bisogna intervenire\nrapidamente."
    }
  ]
}
