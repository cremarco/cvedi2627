  "cues": [
    {
      "start": 0.2,
      "end": 2.66,
      "text": "Con l’espressione «usabilità a costi\ncontenuti»,"
    },
    {
      "start": 3.38,
      "end": 8.52,
      "text": "Nielsen ha promosso un modo più leggero di\nintrodurre la valutazione nel progetto."
    },
    {
      "start": 8.52,
      "end": 12.76,
      "text": "Il contributo richiamato risale al\nmillenovecentottantanove."
    },
    {
      "start": 12.76,
      "end": 17.5,
      "text": "L’idea centrale è poter osservare,\ncorreggere e tornare a osservare senza"
    },
    {
      "start": 17.5,
      "end": 20.54,
      "text": "attendere ogni volta uno studio molto\nesteso."
    },
    {
      "start": 20.54,
      "end": 25.04,
      "text": "Un piccolo ciclo qualitativo può produrre\nindicazioni utili sulle difficoltà dei"
    },
    {
      "start": 25.04,
      "end": 30.36,
      "text": "compiti esplorati. La formula della slide\nsugli stessi risultati va letta entro"
    },
    {
      "start": 30.36,
      "end": 31.06,
      "text": "questo obiettivo."
    },
    {
      "start": 32.04,
      "end": 37.26,
      "text": "Ridurre partecipanti e organizzazione non\nrende equivalenti tutti i possibili studi,"
    },
    {
      "start": 37.48,
      "end": 41.86,
      "text": "soprattutto quando vogliamo confrontare\nprestazioni o stimare percentuali."
    },
    {
      "start": 41.86,
      "end": 44.62,
      "text": "Anche i costi qui riportati sono storici."
    },
    {
      "start": 44.62,
      "end": 49.48,
      "text": "Ci interessa il cambiamento nel processo:\nrendere la prova abbastanza sostenibile da"
    },
    {
      "start": 49.48,
      "end": 53.06,
      "text": "ripeterla e abbastanza curata da produrre\nosservazioni interpretabili."
    },
    {
      "start": 54.3,
      "end": 56.86,
      "text": "Il lavoro di preparazione e analisi rimane\nnecessario."
    }
  ]
}
