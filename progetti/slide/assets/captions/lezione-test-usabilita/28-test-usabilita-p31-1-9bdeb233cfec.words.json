  "cues": [
    {
      "start": 0.26,
      "end": 3.64,
      "text": "La prima euristica riguarda la visibilità\ndello stato del sistema."
    },
    {
      "start": 4.52,
      "end": 6.32,
      "text": "Nell’esempio vediamo un file in\ncaricamento,"
    },
    {
      "start": 7.12,
      "end": 9.3,
      "text": "una percentuale e la possibilità di\nannullare."
    },
    {
      "start": 10.54,
      "end": 14.32,
      "text": "Possiamo capire che il trasferimento è\nancora in corso e che abbiamo un controllo"
    },
    {
      "start": 14.32,
      "end": 15.02,
      "text": "disponibile."
    },
    {
      "start": 15.9,
      "end": 20.1,
      "text": "La conferma del link di recupero comunica\ninvece un’azione già completata dal"
    },
    {
      "start": 20.1,
      "end": 20.8,
      "text": "sistema."
    },
    {
      "start": 21.22,
      "end": 23.92,
      "text": "Dovrebbe aiutarci a capire dove cercare il\npassaggio successivo."
    },
    {
      "start": 25.14,
      "end": 28.44,
      "text": "Una percentuale è utile quando descrive un\navanzamento reale."
    },
    {
      "start": 29.08,
      "end": 33.34,
      "text": "Se resta ferma senza spiegazioni, oppure\narriva alla fine mentre manca ancora"
    },
    {
      "start": 33.34,
      "end": 36.72,
      "text": "un’operazione importante, può creare\nun’aspettativa sbagliata."
    },
    {
      "start": 37.76,
      "end": 42.28,
      "text": "Su Passo useremmo lo stesso criterio per\ndistinguere invio, attesa e risposta."
    },
    {
      "start": 43.24,
      "end": 47.42,
      "text": "Nel test ci interessa se la persona\nriconosce lo stato e sa che cosa fare,"
    },
    {
      "start": 47.86,
      "end": 49.96,
      "text": "anche quando la scelta corretta è\naspettare."
    }
  ]
}
