  "cues": [
    {
      "start": 0.22,
      "end": 4.56,
      "text": "La proposta di tre utenti riguarda piccoli\ncicli qualitativi orientati al"
    },
    {
      "start": 4.56,
      "end": 5.26,
      "text": "miglioramento."
    },
    {
      "start": 5.96,
      "end": 10.04,
      "text": "Lo scopo è trovare e comprendere\ndifficoltà nei compiti esplorati, per"
    },
    {
      "start": 10.04,
      "end": 11.04,
      "text": "decidere una revisione."
    },
    {
      "start": 12.24,
      "end": 16.48,
      "text": "Se vogliamo stimare una percentuale di\nsuccesso o confrontare due versioni con"
    },
    {
      "start": 16.48,
      "end": 17.3,
      "text": "una misura quantitativa,"
    },
    {
      "start": 18.32,
      "end": 22.62,
      "text": "dobbiamo progettare campione, protocollo e\nanalisi in funzione di quella domanda."
    },
    {
      "start": 23.32,
      "end": 27.66,
      "text": "Il numero tre non si trasferisce\nautomaticamente a quel tipo di studio."
    },
    {
      "start": 27.66,
      "end": 32.2,
      "text": "La frase sul processo poco rigoroso va\ninterpretata con attenzione."
    },
    {
      "start": 32.2,
      "end": 36.86,
      "text": "Un’organizzazione leggera può rimanere\nmetodica: consegne preparate, interventi"
    },
    {
      "start": 36.86,
      "end": 40.7,
      "text": "annotati, episodi documentati e\nconclusioni proporzionate alle"
    },
    {
      "start": 40.7,
      "end": 41.4,
      "text": "osservazioni."
    },
    {
      "start": 42.3,
      "end": 46.06,
      "text": "Possiamo dire che un problema è emerso in\nuna certa situazione."
    },
    {
      "start": 46.06,
      "end": 48.94,
      "text": "Per sostenere quanto sia diffuso servono\naltre evidenze."
    },
    {
      "start": 50.04,
      "end": 54.62,
      "text": "Anche un risultato qualitativo deve quindi\nessere preciso su chi ha partecipato, che"
    },
    {
      "start": 54.62,
      "end": 56.44,
      "text": "cosa ha fatto e in quali condizioni."
    }
  ]
}
