  "cues": [
    {
      "start": 0.22,
      "end": 4.22,
      "text": "Un compito descrive un’attività che la\npersona potrebbe avere motivo di svolgere."
    },
    {
      "start": 4.94,
      "end": 6.1,
      "text": "Può essere molto specifico,"
    },
    {
      "start": 6.72,
      "end": 11.26,
      "text": "come recuperare l’accesso a un account,\noppure più aperto, come scegliere una"
    },
    {
      "start": 11.26,
      "end": 13.04,
      "text": "visita compatibile con alcune condizioni."
    },
    {
      "start": 14.5,
      "end": 17.08,
      "text": "Il livello di apertura dipende dalla\ndomanda di ricerca."
    },
    {
      "start": 17.84,
      "end": 20.52,
      "text": "Se vogliamo capire come vengono\nconfrontate le alternative,"
    },
    {
      "start": 21.22,
      "end": 23.6,
      "text": "dobbiamo lasciare spazio alla scelta."
    },
    {
      "start": 23.6,
      "end": 27.46,
      "text": "Se studiamo un recupero da errore,\npossiamo predisporre una situazione che"
    },
    {
      "start": 27.46,
      "end": 28.86,
      "text": "renda osservabile quel passaggio."
    },
    {
      "start": 30.02,
      "end": 35.22,
      "text": "Nel caso Passo possiamo dare un contesto:\nuna visita a domicilio, una fascia serale"
    },
    {
      "start": 35.22,
      "end": 40.24,
      "text": "e un limite di spesa. Queste condizioni\nmotivano la decisione senza indicare i"
    },
    {
      "start": 40.24,
      "end": 40.94,
      "text": "comandi da usare."
    },
    {
      "start": 41.98,
      "end": 45.34,
      "text": "Il compito deve infine essere affrontabile\nnel materiale disponibile."
    },
    {
      "start": 46.12,
      "end": 50.24,
      "text": "Se il prototipo non rappresenta l’esito,\nnon possiamo interpretare la sua assenza"
    },
    {
      "start": 50.24,
      "end": 51.4,
      "text": "come un errore del partecipante."
    }
  ]
}
