  "cues": [
    {
      "start": 0.14,
      "end": 4.24,
      "text": "Un primo giro della pagina iniziale può\naiutarci a capire quale servizio la"
    },
    {
      "start": 4.24,
      "end": 6.5,
      "text": "persona pensa di avere davanti."
    },
    {
      "start": 6.5,
      "end": 8.6,
      "text": "Possiamo chiedere: «Guardando questa\npagina,"
    },
    {
      "start": 9.12,
      "end": 11.96,
      "text": "che cosa pensi di poter fare qui?»."
    },
    {
      "start": 12.02,
      "end": 15.9,
      "text": "Lasciamo che la risposta emerga dal\nmateriale, evitando di presentare prima"
    },
    {
      "start": 16.06,
      "end": 20.62,
      "text": "tutte le funzioni. Annotiamo le parole\nusate e ciò che viene riconosciuto o"
    },
    {
      "start": 20.62,
      "end": 21.32,
      "text": "trascurato."
    },
    {
      "start": 22.26,
      "end": 26.08,
      "text": "Questa osservazione riguarda la\ncomprensione iniziale; i compiti"
    },
    {
      "start": 26.08,
      "end": 30.64,
      "text": "successivi ci mostreranno come quella\nprima interpretazione orienta le azioni."
    }
  ]
