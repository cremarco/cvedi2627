  "cues": [
    {
      "start": 0.24,
      "end": 4.32,
      "text": "Tognazzini richiama la protezione del\nlavoro della persona e la conservazione"
    },
    {
      "start": 4.32,
      "end": 5.02,
      "text": "dello stato."
    },
    {
      "start": 5.74,
      "end": 10.12,
      "text": "Ogni informazione inserita, ogni filtro\nscelto e ogni confronto effettuato"
    },
    {
      "start": 10.48,
      "end": 12.86,
      "text": "rappresentano un investimento di tempo e\nattenzione."
    },
    {
      "start": 13.84,
      "end": 17.5,
      "text": "Se un campo è errato, correggiamo quel\ncampo e manteniamo i dati validi."
    },
    {
      "start": 18.22,
      "end": 22.52,
      "text": "Se la persona torna dai dettagli ai\nrisultati, conserviamo i criteri utili al"
    },
    {
      "start": 22.52,
      "end": 23.22,
      "text": "confronto."
    },
    {
      "start": 23.7,
      "end": 27.76,
      "text": "Se il percorso si interrompe, rendiamo\nriconoscibile il punto da cui può essere"
    },
    {
      "start": 27.76,
      "end": 30.1,
      "text": "ripreso, nei limiti del funzionamento\nprevisto."
    },
    {
      "start": 30.98,
      "end": 35.14,
      "text": "Su Passo immaginiamo che l’orario\nselezionato diventi indisponibile."
    },
    {
      "start": 35.14,
      "end": 38.78,
      "text": "Dobbiamo comunicare il cambiamento e\noffrire una nuova scelta."
    },
    {
      "start": 38.9,
      "end": 43.14,
      "text": "Costringere Viola a riscrivere domicilio e\nfascia oraria aggiungerebbe un lavoro che"
    },
    {
      "start": 43.14,
      "end": 44.42,
      "text": "non deriva dalla sua decisione."
    },
    {
      "start": 45.38,
      "end": 49.14,
      "text": "Nel test osserviamo che cosa resta\ndisponibile e che cosa deve essere"
    },
    {
      "start": 49.14,
      "end": 49.84,
      "text": "ricostruito."
    },
    {
      "start": 50.26,
      "end": 51.68,
      "text": "La persona ritrova i filtri?"
    },
    {
      "start": 52.3,
      "end": 54.8,
      "text": "Capisce che il vecchio orario non è più\nselezionabile?"
    },
    {
      "start": 55.52,
      "end": 58.18,
      "text": "Individua una nuova possibilità senza\nperdere il contesto?"
    },
    {
      "start": 58.88,
      "end": 61.7,
      "text": "Conservare lo stato richiede anche\nchiarezza."
    },
    {
      "start": 61.7,
      "end": 66.22,
      "text": "Un dato mantenuto ma non più valido deve\nessere segnalato, perché la continuità non"
    },
    {
      "start": 66.22,
      "end": 67.26,
      "text": "nasconda il cambiamento."
    },
    {
      "start": 68.12,
      "end": 72.56,
      "text": "Il criterio ci invita quindi a proteggere\nciò che rimane utile e rendere esplicito"
    },
    {
      "start": 72.68,
      "end": 73.44,
      "text": "ciò che va aggiornato."
    }
  ]
}
