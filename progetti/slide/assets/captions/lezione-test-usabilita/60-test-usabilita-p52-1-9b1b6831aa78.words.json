  "cues": [
    {
      "start": 0.28,
      "end": 3.28,
      "text": "Torniamo ai tre elementi centrali:\nfacilitatore,"
    },
    {
      "start": 3.86,
      "end": 4.56,
      "text": "compiti e partecipante."
    },
    {
      "start": 5.74,
      "end": 9.66,
      "text": "Il facilitatore organizza la situazione e\nmantiene le condizioni adatte"
    },
    {
      "start": 9.66,
      "end": 10.36,
      "text": "all’osservazione."
    },
    {
      "start": 11.54,
      "end": 13.62,
      "text": "Il compito rende concreto l’obiettivo."
    },
    {
      "start": 14.54,
      "end": 18.14,
      "text": "Il partecipante porta esperienza,\naspettative e strategie."
    },
    {
      "start": 19.02,
      "end": 22.72,
      "text": "Se uno di questi elementi è scelto male,\nl’interpretazione diventa più difficile."
    },
    {
      "start": 23.66,
      "end": 27.18,
      "text": "Una consegna troppo guidata può far\nsembrare facile il percorso."
    },
    {
      "start": 27.82,
      "end": 32.12,
      "text": "Una persona che conosce già il progetto\npotrebbe usare informazioni che altri non"
    },
    {
      "start": 32.12,
      "end": 36.94,
      "text": "possiedono. Un facilitatore che suggerisce\nogni passaggio cambia il comportamento"
    },
    {
      "start": 36.94,
      "end": 41.86,
      "text": "osservato. Prima della sessione dobbiamo\nquindi controllare la relazione fra i tre"
    },
    {
      "start": 41.86,
      "end": 42.56,
      "text": "elementi."
    },
    {
      "start": 42.94,
      "end": 45.8,
      "text": "Chi partecipa può riconoscersi nella\nsituazione?"
    },
    {
      "start": 46.16,
      "end": 48.3,
      "text": "Il materiale permette di affrontarla?"
    },
    {
      "start": 48.66,
      "end": 51.62,
      "text": "Le nostre domande lasciano spazio a un\npercorso autonomo?"
    },
    {
      "start": 52.22,
      "end": 54.48,
      "text": "Vediamo ora questa relazione nello schema."
    }
  ]
}
