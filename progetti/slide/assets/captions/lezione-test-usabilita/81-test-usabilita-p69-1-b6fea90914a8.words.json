  "cues": [
    {
      "start": 0.3,
      "end": 5.1,
      "text": "Invitare a osservare chi prende decisioni\naiuta a condividere una base concreta per"
    },
    {
      "start": 5.1,
      "end": 9.84,
      "text": "la revisione. Designer, sviluppatori e\nresponsabili possono vedere lo stesso"
    },
    {
      "start": 9.84,
      "end": 14.92,
      "text": "episodio e comprendere meglio perché una\ndifficoltà richieda attenzione."
    },
    {
      "start": 14.92,
      "end": 18.8,
      "text": "Prepariamo le condizioni perché possano\nseguire senza interferire."
    },
    {
      "start": 18.8,
      "end": 19.5,
      "text": "La sala separata,"
    },
    {
      "start": 19.96,
      "end": 24.7,
      "text": "lo schermo e l’audio servono a rendere il\npercorso comprensibile agli osservatori,"
    },
    {
      "start": 24.86,
      "end": 28.14,
      "text": "mantenendo la conduzione nelle mani del\nfacilitatore."
    },
    {
      "start": 28.14,
      "end": 33.18,
      "text": "Prima della sessione concordiamo anche che\ncosa annotare: compito, azione, parole"
    },
    {
      "start": 33.18,
      "end": 35.6,
      "text": "pertinenti, esito ed eventuali aiuti."
    },
    {
      "start": 36.24,
      "end": 39.4,
      "text": "Le interpretazioni possono essere aggiunte\ndistinguendole dai fatti."
    },
    {
      "start": 40.4,
      "end": 44.58,
      "text": "Se un osservatore ha una domanda, la\nraccogliamo per il momento opportuno."
    },
    {
      "start": 44.66,
      "end": 48.64,
      "text": "Interrompere il partecipante da più voci\npuò alterare l’esperienza e introdurre"
    },
    {
      "start": 48.64,
      "end": 49.34,
      "text": "suggerimenti."
    },
    {
      "start": 50.26,
      "end": 54.4,
      "text": "La partecipazione del gruppo acquista\nvalore quando è organizzata quanto quella"
    },
    {
      "start": 54.4,
      "end": 55.28,
      "text": "di chi prova il servizio."
    }
  ]
}
