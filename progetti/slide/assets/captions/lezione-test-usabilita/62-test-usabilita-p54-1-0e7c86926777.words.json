  "cues": [
    {
      "start": 0.2,
      "end": 4.66,
      "text": "Il facilitatore guida la sessione e\nprotegge le condizioni della prova."
    },
    {
      "start": 4.66,
      "end": 9.04,
      "text": "Deve spiegare come partecipare, rispondere\nai dubbi sull’organizzazione e porre"
    },
    {
      "start": 9.04,
      "end": 11.02,
      "text": "domande utili ad approfondire gli episodi."
    },
    {
      "start": 12.4,
      "end": 16.64,
      "text": "Il punto delicato è distinguere una\ndomanda sulla sessione da una domanda sul"
    },
    {
      "start": 16.64,
      "end": 17.78,
      "text": "funzionamento del prodotto."
    },
    {
      "start": 18.62,
      "end": 21.74,
      "text": "Se la persona chiede quanto tempo rimane,\nposso rispondere."
    },
    {
      "start": 22.46,
      "end": 26.92,
      "text": "Se chiede dove deve premere, una\nspiegazione potrebbe cancellare proprio la"
    },
    {
      "start": 26.92,
      "end": 28.68,
      "text": "difficoltà che stiamo cercando di\nosservare."
    },
    {
      "start": 29.52,
      "end": 32.9,
      "text": "Questo richiede attenzione, perché aiutare\nviene spontaneo,"
    },
    {
      "start": 33.5,
      "end": 36.2,
      "text": "soprattutto quando abbiamo progettato\nl’interfaccia."
    },
    {
      "start": 36.2,
      "end": 40.02,
      "text": "Possiamo lasciare spazio a un tentativo e\npoi chiedere che cosa la persona stia"
    },
    {
      "start": 40.02,
      "end": 43.84,
      "text": "cercando. Quando interveniamo, registriamo\nl’aiuto fornito."
    },
    {
      "start": 44.52,
      "end": 48.3,
      "text": "Il compito potrà proseguire, ma il\ncompletamento assistito dovrà essere"
    },
    {
      "start": 48.3,
      "end": 49.72,
      "text": "distinto da quello autonomo."
    },
    {
      "start": 50.6,
      "end": 53.4,
      "text": "Questa distinzione rende leggibile l’esito\ndella sessione."
    }
  ]
}
