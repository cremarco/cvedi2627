  "cues": [
    {
      "start": 0.2,
      "end": 4.56,
      "text": "La slide invita a evitare un reclutamento\neccessivamente stretto."
    },
    {
      "start": 4.56,
      "end": 8.46,
      "text": "Anche fra persone dello stesso settore\nesistono differenze di esperienza e"
    },
    {
      "start": 8.46,
      "end": 13.42,
      "text": "familiarità con il linguaggio. Essere\neconomisti, per esempio, non implica"
    },
    {
      "start": 13.42,
      "end": 16.98,
      "text": "conoscere ogni sigla usata da un servizio."
    },
    {
      "start": 16.98,
      "end": 21.12,
      "text": "Questo richiamo alla chiarezza è utile, ma\nnon rende intercambiabili i partecipanti."
    },
    {
      "start": 21.7,
      "end": 26.74,
      "text": "Per studiare un’attività specialistica può\nessere necessaria un’esperienza specifica."
    },
    {
      "start": 26.74,
      "end": 31.12,
      "text": "Per esplorare un percorso rivolto a\npersone diverse dovremo invece coinvolgere"
    },
    {
      "start": 31.12,
      "end": 35.84,
      "text": "quella varietà. Su Passo possiamo\ndistinguere familiarità con la ricerca"
    },
    {
      "start": 35.84,
      "end": 40.96,
      "text": "online e conoscenza del servizio. Una\npersona molto esperta di computer potrebbe"
    },
    {
      "start": 40.96,
      "end": 45.56,
      "text": "comunque non sapere come funziona una\nrichiesta di visita a domicilio."
    },
    {
      "start": 45.58,
      "end": 50.76,
      "text": "Definiamo quindi pochi criteri pertinenti\nalla domanda, spiegando perché contano."
    },
    {
      "start": 50.76,
      "end": 54.22,
      "text": "Evitiamo di scegliere persone solo perché\nassomigliano al profilo che abbiamo"
    },
    {
      "start": 54.22,
      "end": 56.46,
      "text": "immaginato o perché sono facili da\nraggiungere."
    },
    {
      "start": 57.7,
      "end": 61.92,
      "text": "Il reclutamento può essere pratico e\nsostenibile senza perdere il legame con"
    },
    {
      "start": 61.92,
      "end": 62.62,
      "text": "l’uso reale."
    },
    {
      "start": 63.0,
      "end": 67.38,
      "text": "La chiarezza dell’interfaccia va poi\nosservata sia con chi comincia sia con chi"
    },
    {
      "start": 67.38,
      "end": 68.76,
      "text": "conosce già il compito."
    }
  ]
}
