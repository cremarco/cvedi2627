  "cues": [
    {
      "start": 0.24,
      "end": 4.64,
      "text": "Quando si verifica un errore, la persona\ndeve poter riconoscere che cosa è accaduto"
    },
    {
      "start": 4.64,
      "end": 10.18,
      "text": "e come procedere. Nell’esempio i messaggi\nsono vicini ai campi: l’indirizzo di posta"
    },
    {
      "start": 10.18,
      "end": 15.64,
      "text": "non è valido e manca il telefono. Un\ncodice tecnico, da solo, non offre una"
    },
    {
      "start": 15.64,
      "end": 20.54,
      "text": "strada per correggere. Una spiegazione\nutile identifica il problema, usa parole"
    },
    {
      "start": 20.64,
      "end": 22.46,
      "text": "comprensibili e indica l’azione possibile."
    },
    {
      "start": 23.56,
      "end": 27.64,
      "text": "Il colore rosso può contribuire a\nsegnalarlo, ma deve essere accompagnato da"
    },
    {
      "start": 27.64,
      "end": 28.64,
      "text": "un messaggio riconoscibile."
    },
    {
      "start": 29.66,
      "end": 32.14,
      "text": "Anche i dati corretti vanno preservati."
    },
    {
      "start": 32.14,
      "end": 35.78,
      "text": "Se per un solo campo errato svuoto\nl’intero modulo, aggiungo un nuovo"
    },
    {
      "start": 35.78,
      "end": 36.7,
      "text": "ostacolo alla correzione."
    },
    {
      "start": 38.0,
      "end": 39.82,
      "text": "Nel test possiamo osservare il recupero:"
    },
    {
      "start": 40.62,
      "end": 45.16,
      "text": "il partecipante trova il campo, comprende\nl’indicazione e riesce a riprendere?"
    },
    {
      "start": 45.58,
      "end": 47.64,
      "text": "L’errore fa parte del percorso da\nprogettare."
    }
  ]
}
