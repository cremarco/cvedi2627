  "cues": [
    {
      "start": 0.36,
      "end": 5.0,
      "text": "Guardiamo i due lati della tavola. Nel\ncontenitore, la forma suggerisce un punto"
    },
    {
      "start": 5.0,
      "end": 7.46,
      "text": "da cui versare e una modalità di\nmanipolazione."
    },
    {
      "start": 8.92,
      "end": 12.6,
      "text": "La possibilità di usarlo dipende dalla sua\ncostruzione e da chi lo impugna."
    },
    {
      "start": 13.58,
      "end": 17.8,
      "text": "A destra compare un elemento con l’aspetto\ndi un pulsante, ma privo di etichetta."
    },
    {
      "start": 18.74,
      "end": 22.8,
      "text": "Possiamo riconoscere una possibile azione\nsenza sapere quale risultato produrrà."
    },
    {
      "start": 23.5,
      "end": 26.1,
      "text": "La domanda scritta sopra, «Cosa posso\nfare?»,"
    },
    {
      "start": 26.84,
      "end": 28.1,
      "text": "rimane quindi in parte aperta."
    },
    {
      "start": 28.82,
      "end": 32.98,
      "text": "Questo confronto ci permette di\ndistinguere riconoscibilità del controllo"
    },
    {
      "start": 32.98,
      "end": 34.22,
      "text": "e comprensione dell’effetto."
    },
    {
      "start": 35.08,
      "end": 36.5,
      "text": "Nel progetto servono entrambe."
    },
    {
      "start": 37.34,
      "end": 41.7,
      "text": "Un pulsante visibile può attirare il clic\ne lasciare comunque incerta la scelta."
    },
    {
      "start": 42.42,
      "end": 45.86,
      "text": "Passiamo allora ai segnali che comunicano\nl’azione e il suo significato."
    }
  ]
}
