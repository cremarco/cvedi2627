  "cues": [
    {
      "start": 0.14,
      "end": 4.3,
      "text": "Un primo problema tipico è la mancata\ncomprensione del servizio."
    },
    {
      "start": 4.3,
      "end": 7.36,
      "text": "La persona vede la pagina ma non capisce a\nche cosa serva,"
    },
    {
      "start": 8.0,
      "end": 10.78,
      "text": "oppure costruisce un’interpretazione\ndiversa da quella prevista."
    },
    {
      "start": 12.06,
      "end": 16.06,
      "text": "Su Passo potrebbe pensare di acquistare\ndirettamente una visita, mentre sta"
    },
    {
      "start": 16.06,
      "end": 16.98,
      "text": "inviando una richiesta."
    },
    {
      "start": 17.88,
      "end": 18.7,
      "text": "Prima di aggiungere comandi,"
    },
    {
      "start": 19.36,
      "end": 23.24,
      "text": "dobbiamo capire quali parole, immagini o\nstati contribuiscono all’equivoco."
    },
    {
      "start": 24.6,
      "end": 27.2,
      "text": "Documentiamo l’interpretazione e il punto\nin cui emerge:"
    },
    {
      "start": 27.88,
      "end": 30.5,
      "text": "questo rende più precisa la domanda per la\nrevisione."
    }
  ]
