  "cues": [
    {
      "start": 0.22,
      "end": 4.36,
      "text": "«Un utente è cento volte meglio di\nnessuno» è una formula volutamente"
    },
    {
      "start": 4.36,
      "end": 5.06,
      "text": "incisiva."
    },
    {
      "start": 5.46,
      "end": 10.2,
      "text": "Non indica un rapporto misurato fra due\nrisultati di ricerca: invita a cominciare"
    },
    {
      "start": 10.2,
      "end": 13.88,
      "text": "a osservare invece di rimandare ogni\nprova."
    },
    {
      "start": 13.94,
      "end": 17.5,
      "text": "Anche una sola sessione può mostrare una\ndifficoltà che non avevamo previsto."
    },
    {
      "start": 18.42,
      "end": 22.62,
      "text": "Non possiamo però concludere che quel\npercorso rappresenti tutte le persone o"
    },
    {
      "start": 22.62,
      "end": 25.16,
      "text": "che un test mal preparato sia comunque\naffidabile."
    },
    {
      "start": 26.48,
      "end": 30.1,
      "text": "Compiti che suggeriscono la risposta,\npartecipanti estranei alla situazione"
    },
    {
      "start": 30.68,
      "end": 36.04,
      "text": "e interventi continui del facilitatore\npossono rendere fuorviante l’osservazione."
    },
    {
      "start": 36.04,
      "end": 40.56,
      "text": "Il messaggio utile è organizzare una prima\nprova sostenibile e imparare a condurla"
    },
    {
      "start": 40.56,
      "end": 45.7,
      "text": "con cura. Poi allarghiamo e ripetiamo la\nricerca in funzione delle domande e dei"
    },
    {
      "start": 45.7,
      "end": 46.96,
      "text": "gruppi che dobbiamo comprendere."
    }
  ]
}
