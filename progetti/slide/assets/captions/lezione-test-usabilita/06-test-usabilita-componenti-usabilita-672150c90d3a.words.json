  "cues": [
    {
      "start": 0.22,
      "end": 4.3,
      "text": "Per osservare l’usabilità possiamo\ndistinguere cinque componenti."
    },
    {
      "start": 4.3,
      "end": 6.1,
      "text": "L’apprendibilità riguarda il primo\nincontro:"
    },
    {
      "start": 7.0,
      "end": 10.18,
      "text": "una persona riesce a capire come svolgere\ni compiti di base?"
    },
    {
      "start": 11.0,
      "end": 15.28,
      "text": "Su Passo potremmo osservare come avvia la\nricerca di una visita senza avere già"
    },
    {
      "start": 15.28,
      "end": 20.52,
      "text": "visto il servizio. L’efficienza riguarda\nl’uso dopo l’apprendimento."
    },
    {
      "start": 20.52,
      "end": 23.52,
      "text": "Una volta conosciuto il percorso, quanto\nlavoro richiede ripeterlo?"
    },
    {
      "start": 24.58,
      "end": 29.38,
      "text": "La memorabilità introduce invece una\ndistanza nel tempo: se torno dopo un"
    },
    {
      "start": 29.38,
      "end": 32.36,
      "text": "periodo di non utilizzo, riesco a\nriprendere?"
    },
    {
      "start": 32.4,
      "end": 35.26,
      "text": "Una sola sessione iniziale non basta a\nrispondere a questa domanda."
    },
    {
      "start": 36.38,
      "end": 39.62,
      "text": "Serve una nuova osservazione dopo la\npausa."
    },
    {
      "start": 39.62,
      "end": 42.14,
      "text": "La componente degli errori comprende ciò\nche va storto,"
    },
    {
      "start": 42.78,
      "end": 45.78,
      "text": "le conseguenze e la possibilità di\nrecuperare."
    },
    {
      "start": 45.86,
      "end": 49.86,
      "text": "Possiamo annotare un indirizzo inserito in\nmodo errato, ma anche verificare se la"
    },
    {
      "start": 49.86,
      "end": 52.68,
      "text": "persona capisce come correggerlo senza\nperdere tutto."
    },
    {
      "start": 53.58,
      "end": 56.5,
      "text": "La soddisfazione riguarda la valutazione\ndell’esperienza."
    },
    {
      "start": 57.22,
      "end": 61.68,
      "text": "Una persona può completare il compito e\ngiudicarlo comunque faticoso."
    },
    {
      "start": 61.68,
      "end": 64.88,
      "text": "Un’altra può dirsi soddisfatta pur avendo\nfrainteso l’esito."
    },
    {
      "start": 65.66,
      "end": 70.12,
      "text": "Per questo chiediamo un giudizio e lo\nleggiamo insieme al percorso osservato."
    },
    {
      "start": 70.12,
      "end": 73.04,
      "text": "Queste componenti ci aiutano a scegliere\nche cosa studiare."
    },
    {
      "start": 73.64,
      "end": 77.9,
