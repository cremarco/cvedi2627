  "cues": [
    {
      "start": 0.52,
      "end": 4.58,
      "text": "Donald Norman ci offre un primo insieme di\nstrumenti per leggere il rapporto fra"
    },
    {
      "start": 4.58,
      "end": 6.42,
      "text": "persone, oggetti e azioni."
    },
    {
      "start": 7.52,
      "end": 9.38,
      "text": "Molti esempi partono dagli oggetti\nquotidiani:"
    },
    {
      "start": 10.2,
      "end": 14.18,
      "text": "una porta, un comando, un contenitore."
    },
    {
      "start": 14.18,
      "end": 17.54,
      "text": "Vedremo come gli stessi interrogativi\naiutano a progettare un’interfaccia:"
    },
    {
      "start": 18.68,
      "end": 22.78,
      "text": "capire che cosa si può fare, anticipare\nl’effetto e riconoscere ciò che è"
    },
    {
      "start": 22.78,
      "end": 23.48,
      "text": "successo."
    }
  ]
