  "cues": [
    {
      "start": 0.24,
      "end": 4.74,
      "text": "Questa parte della tabella mette insieme\nfrequenza, numero dei partecipanti e"
    },
    {
      "start": 4.74,
      "end": 7.12,
      "text": "coinvolgimento del gruppo di lavoro."
    },
    {
      "start": 7.12,
      "end": 12.04,
      "text": "La proposta leggera usa pochi partecipanti\nper ciclo e invita chi prende decisioni a"
    },
    {
      "start": 12.04,
      "end": 16.98,
      "text": "vedere direttamente ciò che accade. Il\nnumero tre appartiene a questa modalità"
    },
    {
      "start": 16.98,
      "end": 18.56,
      "text": "pratica di ricerca qualitativa."
    },
    {
      "start": 19.34,
      "end": 23.26,
      "text": "Non garantisce di trovare tutti i problemi\nné permette di stimare quanto siano"
    },
    {
      "start": 23.26,
      "end": 23.96,
      "text": "diffusi."
    },
    {
      "start": 24.38,
      "end": 27.56,
      "text": "Il reclutamento e la varietà dei compiti\nrestano decisivi."
    },
    {
      "start": 28.3,
      "end": 29.32,
      "text": "I ruoli vanno distinti:"
    },
    {
      "start": 30.08,
      "end": 35.36,
      "text": "i partecipanti provano il servizio; il\ngruppo di progetto osserva le sessioni."
    },
    {
      "start": 35.36,
      "end": 39.84,
      "text": "Portare sviluppatori, responsabili e\ndesigner davanti agli stessi episodi può"
    },
    {
      "start": 39.84,
      "end": 42.42,
      "text": "rendere più concreta la discussione."
    },
    {
      "start": 42.42,
      "end": 45.1,
      "text": "Il loro accordo, però, deve poggiare su\nciò che è successo,"
    },
    {
      "start": 45.98,
      "end": 49.02,
      "text": "mantenendo separati fatti osservati e\npossibili interpretazioni."
    }
  ]
}
