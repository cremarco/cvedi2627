  "cues": [
    {
      "start": 0.26,
      "end": 4.92,
      "text": "Osserviamo una persona per volta, così\npossiamo seguire la sua interpretazione e"
    },
    {
      "start": 4.92,
      "end": 9.88,
      "text": "le sue scelte. Il materiale può essere un\nsito funzionante, un prototipo navigabile"
    },
    {
      "start": 9.88,
      "end": 10.7,
      "text": "o una bozza:"
    },
    {
      "start": 11.26,
      "end": 13.36,
      "text": "deve permettere di affrontare la domanda\nprevista."
    },
    {
      "start": 14.96,
      "end": 19.6,
      "text": "Con una bozza statica possiamo esplorare\nche cosa si riconosce e dove si"
    },
    {
      "start": 19.6,
      "end": 20.3,
      "text": "cercherebbe un’informazione."
    },
    {
      "start": 21.28,
      "end": 25.84,
      "text": "Per osservare invio, attesa e recupero di\nun errore servono invece stati e"
    },
    {
      "start": 25.84,
      "end": 26.68,
      "text": "collegamenti adeguati."
    },
    {
      "start": 28.12,
      "end": 32.88,
      "text": "Quando una persona si confonde, cerchiamo\nl’episodio che ha prodotto la difficoltà."
    },
    {
      "start": 32.88,
      "end": 33.74,
      "text": "Quali parole ha letto?"
    },
    {
      "start": 34.74,
      "end": 36.04,
      "text": "Quale azione si aspettava?"
    },
    {
      "start": 36.62,
      "end": 37.9,
      "text": "Che cosa ha tentato dopo?"
    },
    {
      "start": 39.02,
      "end": 43.44,
      "text": "Questa descrizione sarà più utile di un\ngiudizio generico sull’interfaccia."
    },
    {
      "start": 43.44,
      "end": 46.7,
      "text": "Permette di proporre una modifica\ncollegata a qualcosa che abbiamo"
    },
    {
      "start": 46.7,
      "end": 48.12,
      "text": "effettivamente osservato."
    }
  ]
}
