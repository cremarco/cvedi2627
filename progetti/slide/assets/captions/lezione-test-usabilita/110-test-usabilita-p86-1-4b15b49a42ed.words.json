  "cues": [
    {
      "start": 0.22,
      "end": 4.8,
      "text": "Nel test remoto non moderato la persona\nriceve le istruzioni e affronta il"
    },
    {
      "start": 4.8,
      "end": 7.6,
      "text": "percorso senza un facilitatore presente in\ntempo reale."
    },
    {
      "start": 8.46,
      "end": 12.22,
      "text": "Una piattaforma può raccogliere la\nregistrazione e gli esiti previsti dallo"
    },
    {
      "start": 12.22,
      "end": 12.92,
      "text": "studio."
    },
    {
      "start": 13.74,
      "end": 18.06,
      "text": "Questa modalità permette di distribuire le\nsessioni, ma aumenta l’importanza della"
    },
    {
      "start": 18.06,
      "end": 18.82,
      "text": "preparazione."
    },
    {
      "start": 19.38,
      "end": 23.82,
      "text": "Se la consegna è ambigua o il prototipo si\nblocca, non possiamo chiarire subito il"
    },
    {
      "start": 23.82,
      "end": 24.52,
      "text": "problema."
    },
    {
      "start": 25.16,
      "end": 28.18,
      "text": "Serve una prova preliminare del flusso e\ndelle istruzioni."
    },
    {
      "start": 28.72,
      "end": 32.88,
      "text": "Il servizio e il tempo di consegna citati\nnella slide appartengono all’esempio"
    },
    {
      "start": 32.88,
      "end": 37.28,
      "text": "storico. La scelta attuale dello strumento\nrichiederebbe una verifica delle sue"
    },
    {
      "start": 37.28,
      "end": 38.5,
      "text": "condizioni e capacità."
    },
    {
      "start": 39.34,
      "end": 41.22,
      "text": "Qui ci interessa il funzionamento del\nmetodo."
    },
    {
      "start": 42.18,
      "end": 46.46,
      "text": "Anche quando registrazione e reclutamento\nsono gestiti da una piattaforma, dobbiamo"
    },
    {
      "start": 46.46,
      "end": 49.94,
      "text": "controllare la pertinenza dei partecipanti\ne analizzare i materiali."
    },
    {
      "start": 51.0,
      "end": 54.76,
      "text": "Guardare un video richiede di ricostruire\ncompito, difficoltà ed esito."
    },
    {
      "start": 55.48,
      "end": 58.42,
      "text": "Se emerge una domanda alla quale la\nregistrazione non risponde,"
    },
    {
      "start": 59.36,
      "end": 62.16,
      "text": "possiamo prevedere un approfondimento\nsuccessivo."
    },
    {
      "start": 62.34,
      "end": 66.3,
      "text": "Moderato e non moderato sono quindi\nmodalità da scegliere rispetto a ciò che"
    },
    {
      "start": 66.3,
      "end": 70.38,
      "text": "dobbiamo capire e alla possibilità di\nosservare il percorso nelle condizioni"
    },
    {
      "start": 70.38,
      "end": 71.08,
      "text": "necessarie."
    }
  ]
}
