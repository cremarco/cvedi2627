  "cues": [
    {
      "start": 0.2,
      "end": 2.64,
      "text": "Il feedback informa la persona dopo\nun’azione."
    },
    {
      "start": 3.46,
      "end": 7.76,
      "text": "Può dire che il comando è stato ricevuto,\nche il sistema sta lavorando oppure che"
    },
    {
      "start": 7.76,
      "end": 8.82,
      "text": "l’operazione è terminata."
    },
    {
      "start": 10.16,
      "end": 14.76,
      "text": "Sono tre informazioni diverse, da\nscegliere in base allo stato effettivo."
    },
    {
      "start": 14.76,
      "end": 19.18,
      "text": "La rapidità conta perché collega ciò che\nfacciamo a ciò che vediamo accadere."
    },
    {
      "start": 19.64,
      "end": 23.48,
      "text": "La soglia di un decimo di secondo\nrichiamata nella slide è un riferimento"
    },
    {
      "start": 23.5,
      "end": 25.4,
      "text": "sulla percezione di risposta immediata,"
    },
    {
      "start": 25.98,
      "end": 30.1,
      "text": "non una garanzia che oltre quel valore\nogni persona si confonda."
    },
    {
      "start": 30.28,
      "end": 34.06,
      "text": "Se l’operazione richiede tempo, serve\nun’indicazione coerente dell’attesa."
    },
    {
      "start": 35.0,
      "end": 39.24,
      "text": "Su Passo possiamo confermare subito la\nricezione della richiesta e lasciare"
    },
    {
      "start": 39.24,
      "end": 41.92,
      "text": "esplicito che il professionista deve\nancora rispondere."
    },
    {
      "start": 42.74,
      "end": 46.98,
      "text": "Un riscontro rapido è utile proprio quando\nil risultato finale non può arrivare"
    },
    {
      "start": 46.98,
      "end": 47.68,
      "text": "immediatamente."
    }
  ]
}
