  "cues": [
    {
      "start": 0.3,
      "end": 3.28,
      "text": "Dopo le attività riprendiamo gli episodi\nche richiedono un chiarimento."
    },
    {
      "start": 4.24,
      "end": 8.54,
      "text": "Possiamo chiedere che cosa la persona si\naspettava in un punto preciso o come ha"
    },
    {
      "start": 8.82,
      "end": 11.02,
      "text": "interpretato il risultato, lasciando\naperta la risposta."
    },
    {
      "start": 12.48,
      "end": 15.84,
      "text": "Raccogliamo le eventuali domande degli\nosservatori attraverso il facilitatore."
    },
    {
      "start": 16.76,
      "end": 21.1,
      "text": "Poi ringraziamo il partecipante,\nconcludiamo la registrazione e gestiamo il"
    },
    {
      "start": 21.1,
      "end": 22.4,
      "text": "compenso secondo quanto concordato."
    },
    {
      "start": 23.62,
      "end": 26.04,
      "text": "Un esito difficile resta un contributo\nutile:"
    },
    {
      "start": 26.74,
      "end": 30.62,
      "text": "il riconoscimento della partecipazione non\ndipende dalla riuscita dei compiti."
    }
  ]
