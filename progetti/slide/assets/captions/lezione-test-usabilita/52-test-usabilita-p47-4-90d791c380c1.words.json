  "cues": [
    {
      "start": 0.2,
      "end": 3.28,
      "text": "Il confronto prosegue con chi analizza e\ncon quale obiettivo."
    },
    {
      "start": 4.22,
      "end": 8.52,
      "text": "Nel modello leggero, le persone che hanno\nosservato si incontrano presto e scelgono"
    },
    {
      "start": 8.52,
      "end": 11.38,
      "text": "le criticità su cui intervenire."
    },
    {
      "start": 11.38,
      "end": 15.48,
      "text": "Concentrarsi su pochi problemi importanti\nrende più probabile arrivare a una"
    },
    {
      "start": 15.48,
      "end": 16.18,
      "text": "modifica concreta."
    },
    {
      "start": 17.04,
      "end": 21.36,
      "text": "Un elenco molto lungo può essere accurato\ne lasciare comunque indeciso il primo"
    },
    {
      "start": 21.36,
      "end": 22.06,
      "text": "passo."
    },
    {
      "start": 22.58,
      "end": 24.7,
      "text": "L’analisi collettiva richiede però\ndisciplina:"
    },
    {
      "start": 25.56,
      "end": 30.1,
      "text": "«Non mi piace» e «Il partecipante non ha\nriconosciuto il totale prima di inviare»"
    },
    {
      "start": 30.44,
      "end": 34.36,
      "text": "sono contributi diversi. Il secondo\ncontiene un episodio che possiamo"
    },
    {
      "start": 34.36,
      "end": 36.94,
      "text": "discutere e collegare al compito."
    },
    {
      "start": 36.94,
      "end": 41.48,
      "text": "Terremo separati il problema, la sua\ninterpretazione e la soluzione proposta."
    },
    {
      "start": 41.48,
      "end": 45.76,
      "text": "Più avanti vedremo come valutarne la\ngravità e assegnare una priorità senza"
    },
    {
      "start": 45.76,
      "end": 49.4,
      "text": "confondere il numero di osservatori\nconcordi con il numero di persone"
    },
    {
      "start": 49.4,
      "end": 50.76,
      "text": "coinvolte nella difficoltà."
    }
  ]
