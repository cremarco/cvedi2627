  "cues": [
    {
      "start": 0.32,
      "end": 3.7,
      "text": "Ridurre lo sforzo richiesto\ndall’interfaccia significa lasciare alla"
    },
    {
      "start": 3.7,
      "end": 5.88,
      "text": "persona più risorse per il proprio\nobiettivo."
    },
    {
      "start": 6.86,
      "end": 11.48,
      "text": "Se sto confrontando delle visite, voglio\nragionare su disponibilità, costo e"
    },
    {
      "start": 11.48,
      "end": 14.5,
      "text": "compatibilità con i miei impegni."
    },
    {
      "start": 14.5,
      "end": 17.92,
      "text": "Cercare a lungo il significato di un\npulsante aggiunge un lavoro che il"
    },
    {
      "start": 17.92,
      "end": 19.08,
      "text": "servizio potrebbe evitarmi."
    },
    {
      "start": 20.44,
      "end": 24.62,
      "text": "Il carico cognitivo cresce anche quando\ndevo ricordare dati fra una schermata e"
    },
    {
      "start": 24.62,
      "end": 25.32,
      "text": "l’altra."
    },
    {
      "start": 25.64,
      "end": 29.7,
      "text": "Se il prezzo compare soltanto alla fine,\ndevo ricostruire il confronto oppure"
    },
    {
      "start": 29.7,
      "end": 30.4,
      "text": "ripartire."
    },
    {
      "start": 31.28,
      "end": 35.06,
      "text": "Anticipare l’informazione pertinente può\nsostenere una scelta più consapevole."
    },
    {
      "start": 36.34,
      "end": 38.58,
      "text": "Un flusso chiaro può favorire il\ncompletamento,"
    },
    {
      "start": 39.18,
      "end": 42.72,
      "text": "ma il completamento deve corrispondere a\nciò che la persona intendeva fare."
    },
    {
      "start": 43.36,
      "end": 47.26,
      "text": "Se procedo perché non ho capito una\ncondizione, il numero di richieste inviate"
    },
    {
      "start": 47.34,
      "end": 50.82,
      "text": "da solo racconta poco della qualità del\nprogetto."
    },
    {
      "start": 50.94,
      "end": 55.7,
      "text": "L’impressione sul servizio si costruisce\nanche attraverso questi episodi: capire lo"
    },
    {
      "start": 55.7,
      "end": 60.64,
      "text": "stato, correggere un dato e riconoscere\nl’esito contribuisce alla fiducia."
    },
    {
      "start": 60.64,
      "end": 64.62,
      "text": "Nel test cercheremo quindi i punti in cui\nl’interfaccia richiede uno sforzo"
    },
    {
      "start": 64.62,
      "end": 65.32,
      "text": "evitabile."
    }
  ]
}
