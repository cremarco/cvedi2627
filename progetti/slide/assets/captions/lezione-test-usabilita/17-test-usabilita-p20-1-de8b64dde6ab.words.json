  "cues": [
    {
      "start": 0.22,
      "end": 2.78,
      "text": "A sinistra la mano seleziona uno degli\ninterruttori."
    },
    {
      "start": 3.64,
      "end": 8.16,
      "text": "Per sapere quale effetto produrrà, servono\nun’associazione leggibile o un’esperienza"
    },
    {
      "start": 8.16,
      "end": 8.86,
      "text": "precedente."
    },
    {
      "start": 9.92,
      "end": 14.04,
      "text": "Il fatto che un comando sia raggiungibile\nnon chiarisce automaticamente che cosa"
    },
    {
      "start": 14.04,
      "end": 18.9,
      "text": "controlla. A destra la quantità è\ncollocata fra meno e più."
    },
    {
      "start": 18.9,
      "end": 22.8,
      "text": "I due segni, la posizione e\nl’aggiornamento del numero collaborano a"
    },
    {
      "start": 22.8,
      "end": 24.52,
      "text": "rendere comprensibile la relazione."
    },
    {
      "start": 25.46,
      "end": 28.62,
      "text": "Dopo aver premuto più, ci aspettiamo un\naumento del valore."
    },
    {
      "start": 29.14,
      "end": 33.28,
      "text": "Possiamo leggere l’esempio attraverso tre\ndomande: quale elemento cambia,"
    },
    {
      "start": 33.84,
      "end": 38.5,
      "text": "in quale direzione e di quanto? Se\nl’effetto contraddice questa aspettativa,"
    },
    {
      "start": 38.5,
      "end": 41.16,
      "text": "la persona deve ricostruire la regola."
    },
    {
      "start": 41.16,
      "end": 43.24,
      "text": "Nel test osserveremmo la prima scelta,"
    },
    {
      "start": 43.76,
      "end": 45.24,
      "text": "l’esito e l’eventuale correzione,"
    },
    {
      "start": 46.0,
      "end": 47.8,
      "text": "evitando di spiegare in anticipo il\nfunzionamento."
    }
  ]
}
