  "cues": [
    {
      "start": 0.22,
      "end": 2.04,
      "text": "Il temperamatite mostra un limite fisico:"
    },
    {
      "start": 3.04,
      "end": 6.62,
      "text": "l’apertura e la forma dell’oggetto guidano\nl’inserimento della matita."
    },
    {
      "start": 7.56,
      "end": 11.1,
      "text": "Alcune azioni sono possibili e altre\nvengono ostacolate dalla costruzione."
    },
    {
      "start": 12.66,
      "end": 16.74,
      "text": "Nella sequenza di ricette a destra,\ninvece, la scheda visibile solo in parte"
    },
    {
      "start": 16.74,
      "end": 19.32,
      "text": "suggerisce che il contenuto continua\nlateralmente."
    },
    {
      "start": 20.18,
      "end": 23.52,
      "text": "La persona può interpretare quel taglio\ncome invito a scorrere."
    },
    {
      "start": 24.46,
      "end": 27.28,
      "text": "Qui il disegno comunica una possibilità di\nnavigazione."
    },
    {
      "start": 28.3,
      "end": 31.98,
      "text": "Il confronto ci aiuta a riconoscere due\nmodi diversi di guidare l’uso:"
    },
    {
      "start": 32.8,
      "end": 34.56,
      "text": "restringere l’azione e suggerirla."
    },
    {
      "start": 35.34,
      "end": 38.66,
      "text": "Nel caso digitale dovremo verificare che\nil suggerimento sia sufficiente."
    },
    {
      "start": 39.96,
      "end": 44.44,
      "text": "Il fatto che noi sappiamo dell’esistenza\ndi altre ricette non dimostra che chi vede"
    },
    {
      "start": 44.44,
      "end": 46.74,
      "text": "la pagina per la prima volta proverà a\ncercarle."
    }
  ]
}
