  "cues": [
    {
      "start": 0.22,
      "end": 3.98,
      "text": "Fra una sessione e l’altra, ogni\nosservatore può scegliere i tre problemi"
    },
    {
      "start": 3.98,
      "end": 5.02,
      "text": "che considera più importanti."
    },
    {
      "start": 6.08,
      "end": 10.38,
      "text": "Per ciascuno annota anche l’episodio da\ncui deriva: che cosa stava cercando la"
    },
    {
      "start": 10.38,
      "end": 13.78,
      "text": "persona, che cosa ha fatto e quale\nconseguenza ha incontrato."
    },
    {
      "start": 15.06,
      "end": 19.52,
      "text": "Questa selezione prepara il debriefing, ma\nnon sostituisce la documentazione degli"
    },
    {
      "start": 19.52,
      "end": 20.22,
      "text": "altri episodi."
    },
    {
      "start": 20.98,
      "end": 24.82,
      "text": "Conserviamo gli appunti e distinguiamo la\ngravità dalla facilità di correzione."
    },
    {
      "start": 25.98,
      "end": 30.1,
      "text": "Un ostacolo difficile da risolvere può\ncomunque essere quello che incide di più"
    },
    {
      "start": 30.1,
      "end": 30.8,
      "text": "sul risultato."
    }
  ]
