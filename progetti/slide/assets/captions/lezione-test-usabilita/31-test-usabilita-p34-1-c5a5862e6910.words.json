  "cues": [
    {
      "start": 0.22,
      "end": 4.88,
      "text": "La coerenza permette di trasferire ciò che\nabbiamo imparato da un punto all’altro del"
    },
    {
      "start": 4.88,
      "end": 5.58,
      "text": "sistema."
    },
    {
      "start": 6.0,
      "end": 10.5,
      "text": "Se la stessa azione cambia nome a ogni\nschermata, dobbiamo capire ogni volta se"
    },
    {
      "start": 10.5,
      "end": 12.34,
      "text": "si tratta davvero della stessa operazione."
    },
    {
      "start": 14.0,
      "end": 17.32,
      "text": "Esistono una coerenza interna, fra le\nparti del nostro prodotto,"
    },
    {
      "start": 17.88,
      "end": 20.76,
      "text": "e convenzioni condivise con altri\nprodotti."
    },
    {
      "start": 20.76,
      "end": 22.96,
      "text": "Le parole della posta elettronica sono un\nesempio:"
    },
    {
      "start": 23.54,
      "end": 26.92,
      "text": "ci aspettiamo che «Posta in arrivo»\nraccolga i messaggi ricevuti."
    },
    {
      "start": 28.06,
      "end": 32.18,
      "text": "Seguire una convenzione richiede comunque\ndi comprenderne il ruolo."
    },
    {
      "start": 32.18,
      "end": 36.68,
      "text": "Su Passo, usare sempre lo stesso termine\nper la richiesta aiuta solo se quel"
    },
    {
      "start": 36.68,
      "end": 39.28,
      "text": "termine rimane distinto dalla conferma\ndella visita."
    },
    {
      "start": 40.3,
      "end": 44.78,
      "text": "Nel test possiamo osservare quando una\npersona trasferisce una regola appresa e"
    },
    {
      "start": 44.78,
      "end": 47.7,
      "text": "quando quel trasferimento la porta fuori\nstrada."
    },
    {
      "start": 47.7,
      "end": 51.38,
      "text": "L’incoerenza diventa concreta attraverso\nil lavoro che costringe a ripetere."
    }
  ]
