  "cues": [
    {
      "start": 0.24,
      "end": 4.28,
      "text": "Un gruppo può discutere se l’idea di un\nservizio è comprensibile o interessante."
    },
    {
      "start": 5.22,
      "end": 9.06,
      "text": "Per Passo potremmo esplorare come le\npersone raccontano la ricerca di una"
    },
    {
      "start": 9.06,
      "end": 11.62,
      "text": "visita e quali condizioni considerano\ndecisive."
    },
    {
      "start": 12.84,
      "end": 16.36,
      "text": "Questa conversazione può offrire domande\nda approfondire."
    },
    {
      "start": 16.36,
      "end": 20.64,
      "text": "Per sapere se nel prototipo si trova il\ncosto totale, serve però osservare il"
    },
    {
      "start": 20.64,
      "end": 25.28,
      "text": "compito. Una persona potrebbe dichiarare\nche il prezzo è chiarissimo e poi non"
    },
    {
      "start": 25.28,
      "end": 27.02,
      "text": "riconoscere che manca lo spostamento."
    },
    {
      "start": 27.84,
      "end": 31.98,
      "text": "Oppure potrebbe completare il percorso\nsolo dopo che qualcuno ha indicato dove"
    },
    {
      "start": 31.98,
      "end": 37.24,
      "text": "guardare. Il titolo della slide invita a\nescludere il focus group come sostituto"
    },
    {
      "start": 37.24,
      "end": 37.94,
      "text": "della prova d’uso."
    },
    {
      "start": 38.72,
      "end": 43.04,
      "text": "Il metodo rimane pertinente per altre\ndomande, ma una discussione collettiva non"
    },
    {
      "start": 43.04,
      "end": 45.66,
      "text": "ci mostra da sola come il singolo affronta\nl’interfaccia."
    },
    {
      "start": 46.84,
      "end": 48.06,
      "text": "Quando prepariamo la ricerca,"
    },
    {
      "start": 48.54,
      "end": 50.56,
      "text": "scriviamo dunque la domanda prima del\nmetodo."
    },
    {
      "start": 51.24,
      "end": 55.4,
      "text": "Se vogliamo capire dove il percorso si\ninterrompe o come viene interpretato un"
    },
    {
      "start": 55.4,
      "end": 58.58,
      "text": "esito, ci serve un’osservazione\nindividuale di quel percorso."
    }
  ]
}
