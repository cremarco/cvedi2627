  "cues": [
    {
      "start": 0.3,
      "end": 2.76,
      "text": "Possiamo presentare il compito a voce o\nper iscritto."
    },
    {
      "start": 3.64,
      "end": 7.98,
      "text": "La scelta deve permettere alla persona di\ncomprenderlo e di ritrovare le condizioni"
    },
    {
      "start": 7.98,
      "end": 8.92,
      "text": "mentre lavora,"
    },
    {
      "start": 9.46,
      "end": 12.26,
      "text": "senza introdurre ostacoli inutili."
    },
    {
      "start": 12.26,
      "end": 16.1,
      "text": "Leggere ad alta voce può aiutare il\nfacilitatore a sapere quale attività è"
    },
    {
      "start": 16.1,
      "end": 16.8,
      "text": "iniziata,"
    },
    {
      "start": 17.1,
      "end": 20.32,
      "text": "ma non deve diventare un obbligo che rende\ndifficile la partecipazione."
    },
    {
      "start": 21.46,
      "end": 24.64,
      "text": "Possiamo usare formati accessibili e\nmodalità adatte alla persona."
    },
    {
      "start": 25.92,
      "end": 29.98,
      "text": "Se la consegna non è chiara, una domanda\nneutra può verificare come è stata"
    },
    {
      "start": 29.98,
      "end": 34.6,
      "text": "interpretata. Dobbiamo però evitare di\nspiegare il percorso nell’interfaccia"
    },
    {
      "start": 34.6,
      "end": 40.08,
      "text": "mentre la riformuliamo. Fra le sessioni\nmanteniamo condizioni confrontabili e"
    },
    {
      "start": 40.08,
      "end": 41.7,
      "text": "annotiamo le variazioni necessarie."
    },
    {
      "start": 42.56,
      "end": 45.36,
      "text": "Se scopriamo un problema nella consegna,\nlo registriamo:"
    },
    {
      "start": 46.0,
      "end": 49.72,
      "text": "potrebbe aver contribuito alla difficoltà\nosservata quanto il prototipo stesso."
    }
  ]
}
