  "cues": [
    {
      "start": 0.2,
      "end": 5.52,
      "text": "In un test di usabilità mettiamo in\nrelazione tre elementi: una persona, un"
    },
    {
      "start": 5.52,
      "end": 7.38,
      "text": "compito e qualcuno che conduce la\nsessione."
    },
    {
      "start": 8.22,
      "end": 10.72,
      "text": "La persona prova a raggiungere un\nrisultato realistico."
    },
    {
      "start": 11.88,
      "end": 15.42,
      "text": "Il facilitatore presenta la situazione e\nosserva che cosa succede."
    },
    {
      "start": 16.44,
      "end": 21.62,
      "text": "La domanda centrale è concreta: dove il\nprogetto aiuta e dove crea un ostacolo?"
    },
    {
      "start": 22.12,
      "end": 26.66,
      "text": "Se una persona esita, torna indietro o\ninterpreta diversamente una parola,"
    },
    {
      "start": 26.82,
      "end": 28.78,
      "text": "abbiamo qualcosa da approfondire."
    },
    {
      "start": 28.78,
      "end": 32.5,
      "text": "Anche un percorso completato può\nnascondere un equivoco: potrei aver"
    },
    {
      "start": 32.5,
      "end": 36.1,
      "text": "inviato una richiesta pensando di avere\ngià un appuntamento."
    },
    {
      "start": 36.1,
      "end": 39.58,
      "text": "Per questo raccoglieremo insieme azioni,\nparole e risultati."
    },
    {
      "start": 40.46,
      "end": 43.54,
      "text": "Le spiegazioni del partecipante ci aiutano\na interpretare un"
    },
    {
      "start": 44.24,
      "end": 47.54,
      "text": "episodio; il comportamento ci permette di\nvedere come affronta il compito."
    },
    {
      "start": 48.48,
      "end": 52.26,
      "text": "Dovremo tenere collegate queste evidenze\nquando decideremo che cosa cambiare."
    }
  ]
}
