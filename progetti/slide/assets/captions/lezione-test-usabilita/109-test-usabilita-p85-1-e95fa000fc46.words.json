  "cues": [
    {
      "start": 0.14,
      "end": 3.66,
      "text": "I test moderati possono svolgersi anche a\ndistanza."
    },
    {
      "start": 3.66,
      "end": 7.56,
      "text": "La persona usa il materiale dal proprio\nambiente e il facilitatore segue"
    },
    {
      "start": 7.56,
      "end": 11.94,
      "text": "attraverso collegamento audio e\ncondivisione dello schermo."
    },
    {
      "start": 11.94,
      "end": 15.98,
      "text": "Questo può rendere più facile coinvolgere\nchi vive lontano o ha difficoltà a"
    },
    {
      "start": 15.98,
      "end": 19.84,
      "text": "raggiungere la sede. Possiamo anche\nosservare l’uso con il dispositivo"
    },
    {
      "start": 19.84,
      "end": 22.52,
      "text": "abituale, quando è adatto alla domanda di\nricerca."
    },
    {
      "start": 23.58,
      "end": 26.36,
      "text": "Il remoto introduce però condizioni da\npreparare:"
    },
    {
      "start": 27.16,
      "end": 29.16,
      "text": "connessione, strumenti accessibili,"
    },
    {
      "start": 29.78,
      "end": 30.48,
      "text": "possibilità di"
    },
    {
      "start": 30.62,
      "end": 32.06,
      "text": "condividere e distrazioni dell’ambiente."
    },
    {
      "start": 33.22,
      "end": 37.52,
      "text": "Una difficoltà tecnica può interrompere il\ncompito e va distinta da un problema del"
    },
    {
      "start": 37.52,
      "end": 42.68,
      "text": "servizio. Facciamo una breve prova del\ncollegamento e definiamo come proseguire"
    },
    {
      "start": 42.68,
      "end": 43.38,
      "text": "se si interrompe."
    },
    {
      "start": 44.4,
      "end": 49.02,
      "text": "Spieghiamo inoltre che cosa sarà visibile\ne registrato, evitando che la condivisione"
    },
    {
      "start": 49.02,
      "end": 51.62,
      "text": "includa informazioni personali non\nnecessarie."
    },
    {
      "start": 52.56,
      "end": 54.4,
      "text": "La distanza cambia l’organizzazione,"
    },
    {
      "start": 55.22,
      "end": 57.48,
      "text": "mentre restano centrali compiti\npertinenti,"
    },
    {
      "start": 58.04,
      "end": 60.18,
      "text": "conduzione neutra e documentazione degli\nepisodi."
    },
    {
      "start": 61.14,
      "end": 65.3,
      "text": "Il facilitatore può ancora approfondire\nuna risposta o chiedere chiarimenti nel"
    },
    {
      "start": 65.3,
      "end": 66.0,
      "text": "momento opportuno."
    }
  ]
}
