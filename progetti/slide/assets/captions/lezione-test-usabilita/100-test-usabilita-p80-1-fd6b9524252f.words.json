  "cues": [
    {
      "start": 0.2,
      "end": 3.94,
      "text": "Il debriefing collega l’osservazione alla\ndecisione."
    },
    {
      "start": 3.94,
      "end": 7.9,
      "text": "Appena possibile, chi ha seguito le\nsessioni mette in comune gli episodi e"
    },
    {
      "start": 7.9,
      "end": 10.3,
      "text": "sceglie quali problemi affrontare."
    },
    {
      "start": 10.3,
      "end": 13.28,
      "text": "Teniamo distinti fatti, interpretazioni e\nproposte."
    },
    {
      "start": 14.34,
      "end": 18.46,
      "text": "«È tornata tre volte ai risultati»\ndescrive un comportamento."
    },
    {
      "start": 18.46,
      "end": 22.26,
      "text": "«Non ricordava il totale» è\nun’interpretazione da sostenere con altri"
    },
    {
      "start": 22.26,
      "end": 22.96,
      "text": "elementi."
    },
    {
      "start": 23.34,
      "end": 25.92,
      "text": "«Anticipiamo il prezzo» è una proposta di\nmodifica."
    },
    {
      "start": 26.84,
      "end": 31.3,
      "text": "Conservare queste differenze permette di\ndiscutere le alternative e di sapere che"
    },
    {
      "start": 31.3,
      "end": 33.32,
      "text": "cosa verificare nel ciclo successivo."
    }
  ]
}
