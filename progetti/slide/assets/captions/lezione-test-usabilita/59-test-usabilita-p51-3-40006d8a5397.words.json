  "cues": [
    {
      "start": 0.38,
      "end": 4.5,
      "text": "Correggere presto può evitare che una\nscelta problematica si propaghi."
    },
    {
      "start": 4.5,
      "end": 7.4,
      "text": "Se distinguiamo richiesta e conferma già\nnel primo flusso,"
    },
    {
      "start": 8.18,
      "end": 12.28,
      "text": "possiamo mantenere la stessa distinzione\nnei riepiloghi, nelle notifiche e nei"
    },
    {
      "start": 12.28,
      "end": 13.1,
      "text": "messaggi di assistenza."
    },
    {
      "start": 14.44,
      "end": 17.06,
      "text": "Un test iniziale non elimina ogni problema\nfuturo."
    },
    {
      "start": 18.02,
      "end": 22.24,
      "text": "Riduce però alcune incertezze prima che il\nprogetto investa molte risorse nella"
    },
    {
      "start": 22.24,
      "end": 22.94,
      "text": "stessa direzione."
    },
    {
      "start": 23.86,
      "end": 29.1,
      "text": "Il passaggio importante è chiudere il\nciclo: osservare, scegliere una modifica e"
    },
    {
      "start": 29.1,
      "end": 33.68,
      "text": "verificare la nuova versione. Un problema\ntrovato e lasciato in un rapporto non"
    },
    {
      "start": 33.68,
      "end": 35.44,
      "text": "produce automaticamente un miglioramento."
    },
    {
      "start": 36.58,
      "end": 41.12,
      "text": "La ricerca acquista valore quando ciò che\nimpariamo entra nelle decisioni e quando"
    },
    {
      "start": 41.12,
      "end": 44.84,
      "text": "conserviamo una traccia del motivo per cui\nabbiamo cambiato qualcosa."
    }
  ]
