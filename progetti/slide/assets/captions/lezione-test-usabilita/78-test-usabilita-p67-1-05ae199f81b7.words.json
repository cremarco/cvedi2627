  "cues": [
    {
      "start": 0.2,
      "end": 4.7,
      "text": "Per una prova in presenza serve uno spazio\nin cui la persona possa concentrarsi e"
    },
    {
      "start": 4.7,
      "end": 5.88,
      "text": "usare il materiale previsto."
    },
    {
      "start": 6.76,
      "end": 10.48,
      "text": "Il computer, il mouse e la tastiera\ndescritti nella slide sono una"
    },
    {
      "start": 10.48,
      "end": 15.12,
      "text": "configurazione possibile; per un compito\nda telefono o con tecnologie assistive"
    },
    {
      "start": 15.12,
      "end": 18.76,
      "text": "serviranno condizioni coerenti con\nquell’uso."
    },
    {
      "start": 18.76,
      "end": 22.6,
      "text": "Gli osservatori possono seguire da\nun’altra stanza attraverso la condivisione"
    },
    {
      "start": 22.6,
      "end": 27.7,
      "text": "dello schermo. Prima dobbiamo provare che\nvedano e sentano abbastanza bene e che il"
    },
    {
      "start": 28.04,
      "end": 30.1,
      "text": "collegamento non interferisca con\nl’attività."
    },
    {
      "start": 30.78,
      "end": 33.4,
      "text": "La registrazione può aiutare a rivedere un\nepisodio,"
    },
    {
      "start": 33.9,
      "end": 37.42,
      "text": "ma richiede una scelta esplicita su che\ncosa raccogliere e come usarlo."
    },
    {
      "start": 38.12,
      "end": 41.54,
      "text": "Non dobbiamo accenderla come se fosse una\nparte invisibile della sessione."
    },
    {
      "start": 42.8,
      "end": 46.82,
      "text": "Una prova degli strumenti permette di\nscoprire in anticipo problemi audio,"
    },
    {
      "start": 47.18,
      "end": 49.96,
      "text": "account mancanti o stati del prototipo non\nraggiungibili."
    },
    {
      "start": 50.8,
      "end": 54.74,
      "text": "Nella prossima slide mettiamo insieme\nquesta preparazione e le informazioni da"
    },
    {
      "start": 54.74,
      "end": 55.8,
      "text": "dare al partecipante,"
    },
    {
      "start": 56.3,
      "end": 58.64,
      "text": "in modo che sappia a quale esperienza sta\naderendo."
    }
  ]
}
