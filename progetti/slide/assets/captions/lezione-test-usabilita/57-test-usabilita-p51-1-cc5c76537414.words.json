  "cues": [
    {
      "start": 0.3,
      "end": 4.04,
      "text": "Anche il confronto fra una persona\nall’inizio e cinquanta alla fine vuole"
    },
    {
      "start": 4.04,
      "end": 6.96,
      "text": "mettere in evidenza il valore del momento\nin cui impariamo qualcosa."
    },
    {
      "start": 8.02,
      "end": 11.26,
      "text": "Se scopriamo presto che il percorso parte\nda una premessa sbagliata,"
    },
    {
      "start": 11.98,
      "end": 14.14,
      "text": "possiamo cambiare una bozza con un\ninvestimento limitato."
    },
    {
      "start": 15.44,
      "end": 19.28,
      "text": "Il numero dei partecipanti rimane una\nscelta legata allo studio."
    },
    {
      "start": 19.28,
      "end": 23.58,
      "text": "La frase non autorizza a sostituire sempre\nuna ricerca ampia con una sola sessione."
    },
    {
      "start": 24.64,
      "end": 27.46,
      "text": "Per il nostro lavoro conta lasciare spazio\nalla revisione."
    },
    {
      "start": 28.06,
      "end": 32.32,
      "text": "Se il test arriva quando tutto è già\ndeciso e nessuno può più intervenire,"
    },
    {
      "start": 32.32,
      "end": 36.72,
      "text": "anche un risultato molto chiaro rischia di\nrimanere senza conseguenze."
    },
    {
      "start": 36.72,
      "end": 40.84,
      "text": "Inserire prove durante il progetto\npermette invece di collegare direttamente"
    },
    {
      "start": 40.84,
      "end": 43.36,
      "text": "una difficoltà osservata alla versione\nsuccessiva."
    }
  ]
}
