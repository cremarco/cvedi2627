  "cues": [
    {
      "start": 0.18,
      "end": 5.44,
      "text": "Chi progetta deve coordinare contenuti,\ncomportamento, dispositivi e persone con"
    },
    {
      "start": 5.44,
      "end": 6.28,
      "text": "esperienze diverse."
    },
    {
      "start": 7.32,
      "end": 11.9,
      "text": "Possiamo anticipare molte difficoltà\nusando principi e conoscenze del contesto,"
    },
    {
      "start": 11.92,
      "end": 14.1,
      "text": "ma rimangono ipotesi che devono incontrare\nl’uso."
    },
    {
      "start": 15.48,
      "end": 19.7,
      "text": "La progettazione iterativa alterna\nproposta, osservazione e revisione."
    },
    {
      "start": 20.6,
      "end": 24.62,
      "text": "Dopo una modifica ci chiediamo se il\nproblema precedente è stato ridotto e se"
    },
    {
      "start": 24.62,
      "end": 25.78,
      "text": "sono comparsi nuovi ostacoli."
    },
    {
      "start": 26.92,
      "end": 30.56,
      "text": "Il fatto che una soluzione appaia\nconvincente al gruppo di progetto è un"
    },
    {
      "start": 30.56,
      "end": 34.3,
      "text": "motivo per provarla, non un esito già\nacquisito."
    },
    {
      "start": 34.3,
      "end": 39.04,
      "text": "Su Passo, anticipare il costo nei\nrisultati potrebbe aiutare il confronto."
    },
    {
      "start": 39.04,
      "end": 43.3,
      "text": "Dobbiamo però vedere se il totale è\nriconosciuto, interpretato correttamente e"
    },
    {
      "start": 43.3,
      "end": 44.22,
      "text": "usato nella decisione."
    },
    {
      "start": 45.36,
      "end": 49.38,
      "text": "Il test entra in un percorso di ricerca\npiù ampio, insieme a interviste,"
    },
    {
      "start": 50.0,
      "end": 51.88,
      "text": "analisi dell’accessibilità e verifiche\ntecniche."
    },
    {
      "start": 52.76,
      "end": 54.98,
      "text": "La qualità dell’esperienza richiede più\nprospettive."
    },
    {
      "start": 56.02,
      "end": 60.58,
      "text": "Qui ci concentriamo sull’apporto specifico\ndell’osservazione di persone impegnate in"
    },
    {
      "start": 60.58,
      "end": 61.38,
      "text": "compiti realistici."
    }
  ]
}
