  "cues": [
    {
      "start": 0.32,
      "end": 4.14,
      "text": "Quando definiamo un prodotto facile da\nusare, dobbiamo aggiungere almeno tre"
    },
    {
      "start": 4.14,
      "end": 9.72,
      "text": "informazioni: facile per chi, per fare che\ncosa e in quale situazione."
    },
    {
      "start": 9.72,
      "end": 12.54,
      "text": "Un’interfaccia che conosco da mesi può\nsembrarmi immediata,"
    },
    {
      "start": 13.1,
      "end": 18.1,
      "text": "mentre una persona al primo accesso deve\nancora capirne le parole e i percorsi."
    },
    {
      "start": 18.1,
      "end": 20.06,
      "text": "Chi progetta ha inoltre un vantaggio:"
    },
    {
      "start": 20.86,
      "end": 24.08,
      "text": "conosce la struttura del sistema e sa già\ndove si trovano le funzioni."
    },
    {
      "start": 25.04,
      "end": 29.06,
      "text": "Questa conoscenza rende difficile\naccorgersi di alcuni ostacoli."
    },
    {
      "start": 29.1,
      "end": 33.92,
      "text": "Nel caso Passo sappiamo che prima parte\nuna richiesta e poi arriva la risposta del"
    },
    {
      "start": 33.92,
      "end": 38.4,
      "text": "professionista. Una persona potrebbe\ninvece associare la scelta di un orario a"
    },
    {
      "start": 38.4,
      "end": 39.92,
      "text": "una prenotazione già conclusa."
    },
    {
      "start": 40.8,
      "end": 44.88,
      "text": "Dobbiamo rendere comprensibile questa\ndistinzione attraverso contenuti e"
    },
    {
      "start": 44.88,
      "end": 45.58,
      "text": "comportamento,"
    },
    {
      "start": 46.2,
      "end": 47.6,
      "text": "e poi osservarne l’interpretazione."
    },
    {
      "start": 48.86,
      "end": 53.14,
      "text": "La nostra familiarità con il progetto è il\npunto da cui iniziare a formulare domande."
    }
  ]
}
