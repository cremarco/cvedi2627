  "cues": [
    {
      "start": 0.34,
      "end": 4.58,
      "text": "Questi tre obiettivi descrivono ciò che\nvogliamo ricavare da una prova."
    },
    {
      "start": 4.58,
      "end": 8.72,
      "text": "Il primo è individuare i problemi: un\ncomando che non viene riconosciuto,"
    },
    {
      "start": 9.1,
      "end": 13.22,
      "text": "un’informazione trovata troppo tardi o un\nerrore dal quale è difficile uscire."
    },
    {
      "start": 14.46,
      "end": 18.0,
      "text": "Il secondo è scoprire opportunità di\nmiglioramento."
    },
    {
      "start": 18.0,
      "end": 22.3,
      "text": "Osservando un percorso potremmo capire che\ndue informazioni devono stare vicine,"
    },
    {
      "start": 22.74,
      "end": 24.6,
      "text": "oppure che una scelta deve arrivare prima."
    },
    {
      "start": 25.24,
      "end": 29.56,
      "text": "L’opportunità nasce da un bisogno che\nriconosciamo nella situazione."
    },
    {
      "start": 29.56,
      "end": 32.68,
      "text": "Il terzo è conoscere meglio le persone a\ncui ci rivolgiamo."
    },
    {
      "start": 33.54,
      "end": 38.26,
      "text": "Le loro aspettative e le loro strategie\npossono essere diverse dalle nostre."
    },
    {
      "start": 38.28,
      "end": 42.76,
      "text": "Le preferenze dichiarate sono una parte di\nquesta conoscenza: le confronteremo con"
    },
    {
      "start": 42.76,
      "end": 43.58,
      "text": "ciò che vediamo accadere."
    },
    {
      "start": 44.54,
      "end": 49.4,
      "text": "Alla fine dovremo saper descrivere un\nepisodio, spiegare perché conta e proporre"
    },
    {
      "start": 49.4,
      "end": 50.48,
      "text": "una modifica da verificare."
    }
  ]
}
