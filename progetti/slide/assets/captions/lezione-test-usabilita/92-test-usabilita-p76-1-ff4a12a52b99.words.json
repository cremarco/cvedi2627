  "cues": [
    {
      "start": 0.24,
      "end": 4.76,
      "text": "La sessione comincia con il benvenuto e\nuna spiegazione del funzionamento."
    },
    {
      "start": 4.76,
      "end": 6.7,
      "text": "Il partecipante deve sapere che cosa\nfaremo,"
    },
    {
      "start": 7.44,
      "end": 9.34,
      "text": "quanto tempo prevediamo e chi osserverà."
    },
    {
      "start": 10.66,
      "end": 13.7,
      "text": "Riprendiamo le condizioni della\npartecipazione e l’eventuale"
    },
    {
      "start": 13.7,
      "end": 14.4,
      "text": "registrazione."
    },
    {
      "start": 15.34,
      "end": 19.72,
      "text": "Possiamo poi fare alcune domande brevi\nsull’esperienza pertinente al compito."
    },
    {
      "start": 19.72,
      "end": 23.92,
      "text": "Per Passo potrebbe essere utile sapere\ncome la persona cerca abitualmente un"
    },
    {
      "start": 23.92,
      "end": 28.62,
      "text": "servizio online, senza entrare in\ninformazioni che non servono alla prova."
    },
    {
      "start": 28.62,
      "end": 31.0,
      "text": "I minuti riportati sono una traccia\norganizzativa."
    },
    {
      "start": 31.86,
      "end": 36.36,
      "text": "La scaletta complessiva lascia anche un\nmargine per passaggi e imprevisti."
    },
    {
      "start": 36.36,
      "end": 40.58,
      "text": "Non dobbiamo affrettare le spiegazioni\niniziali solo per rispettare una divisione"
    },
    {
      "start": 40.58,
      "end": 41.28,
      "text": "rigida."
    },
    {
      "start": 41.64,
      "end": 44.04,
      "text": "Un’apertura chiara prepara il resto della\nsessione:"
    },
    {
      "start": 44.7,
      "end": 48.58,
      "text": "la persona può concentrarsi sul materiale\nsapendo che le difficoltà sono"
    },
    {
      "start": 48.58,
      "end": 52.44,
      "text": "informazioni utili sul progetto e che può\ninterrompere la partecipazione."
    }
  ]
}
