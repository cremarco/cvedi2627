  "cues": [
    {
      "start": 0.2,
      "end": 1.7,
      "text": "Cominciamo dai principi di usabilità."
    },
    {
      "start": 2.6,
      "end": 5.4,
      "text": "Ci servono per osservare un’interfaccia\ncon domande precise:"
    },
    {
      "start": 6.4,
      "end": 7.32,
      "text": "quali azioni si riconoscono?"
    },
    {
      "start": 8.54,
      "end": 10.1,
      "text": "Che cosa succederà dopo un comando?"
    },
    {
      "start": 10.98,
      "end": 12.5,
      "text": "Come si può correggere un errore?"
    },
    {
      "start": 13.38,
      "end": 15.82,
      "text": "Queste domande guidano una prima ispezione\ndel progetto."
    },
    {
      "start": 16.64,
      "end": 21.16,
      "text": "Più avanti le porteremo nella prova con le\npersone, per verificare quali difficoltà"
    },
    {
      "start": 21.16,
      "end": 22.86,
      "text": "si manifestano e in quali condizioni."
    }
  ]
