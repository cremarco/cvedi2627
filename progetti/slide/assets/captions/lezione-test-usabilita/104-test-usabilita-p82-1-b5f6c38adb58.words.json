  "cues": [
    {
      "start": 0.26,
      "end": 3.44,
      "text": "Possiamo tenere un elenco separato delle\ncorrezioni molto semplici:"
    },
    {
      "start": 4.26,
      "end": 5.34,
      "text": "un termine incoerente,"
    },
    {
      "start": 5.82,
      "end": 9.64,
      "text": "un collegamento sbagliato o una\nspiegazione mancante che sappiamo come"
    },
    {
      "start": 9.64,
      "end": 10.34,
      "text": "sistemare."
    },
    {
      "start": 11.5,
      "end": 15.46,
      "text": "La proposta di interventi inferiori a\nun’ora rende concreta l’idea di un lavoro"
    },
    {
      "start": 15.46,
      "end": 16.16,
      "text": "immediato,"
    },
    {
      "start": 16.56,
      "end": 18.5,
      "text": "ma il tempo effettivo dipende dal\nprogetto."
    },
    {
      "start": 19.38,
      "end": 23.84,
      "text": "Anche una modifica piccola deve essere\ncontrollata nel suo contesto."
    },
    {
      "start": 23.92,
      "end": 27.92,
      "text": "Separare questi interventi aiuta a non\nfarli competere impropriamente con le"
    },
    {
      "start": 27.92,
      "end": 28.96,
      "text": "criticità più importanti."
    },
    {
      "start": 29.82,
      "end": 34.4,
      "text": "Possiamo ottenere miglioramenti rapidi e,\nnello stesso tempo, dedicare risorse a un"
    },
    {
      "start": 34.4,
      "end": 36.12,
      "text": "problema più grave che richiede analisi."
    },
    {
      "start": 37.5,
      "end": 39.44,
      "text": "Per ogni cambiamento conserviamo il\nmotivo."
    },
    {
      "start": 40.16,
      "end": 44.6,
      "text": "Se correggiamo un’etichetta, indichiamo\nquale difficoltà volevamo ridurre e come"
    },
    {
      "start": 44.6,
      "end": 49.58,
      "text": "verificheremo il risultato. La facilità di\nesecuzione è una caratteristica"
    },
    {
      "start": 49.58,
      "end": 50.38,
      "text": "dell’intervento,"
    },
    {
      "start": 51.1,
      "end": 53.12,
      "text": "distinta dall’impatto del problema."
    }
  ]
}
