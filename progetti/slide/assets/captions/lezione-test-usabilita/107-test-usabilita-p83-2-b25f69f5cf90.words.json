  "cues": [
    {
      "start": 0.28,
      "end": 5.28,
      "text": "Alcune proposte possono aprire una\ndirezione che non avevamo considerato."
    },
    {
      "start": 5.28,
      "end": 9.54,
      "text": "Registriamole con il contesto: quale\nattività volevano sostenere e quale"
    },
    {
      "start": 9.54,
      "end": 11.0,
      "text": "difficoltà le ha fatte emergere?"
    },
    {
      "start": 13.1,
      "end": 16.78,
      "text": "L’impressione immediata del gruppo può\nessere utile per scegliere che cosa"
    },
    {
      "start": 16.78,
      "end": 17.48,
      "text": "esplorare,"
    },
    {
      "start": 17.94,
      "end": 20.32,
      "text": "ma la proposta deve ancora incontrare una\nverifica."
    },
    {
      "start": 21.28,
      "end": 25.64,
      "text": "Possiamo rappresentarla in una bozza e\nformulare un compito."
    },
    {
      "start": 25.68,
      "end": 30.26,
      "text": "In questo modo l’idea entra nello stesso\nciclo di osservazione e revisione che"
    },
    {
      "start": 30.26,
      "end": 32.0,
      "text": "abbiamo usato per il resto del progetto."
    }
  ]
