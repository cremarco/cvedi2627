  "cues": [
    {
      "start": 0.14,
      "end": 3.92,
      "text": "Il primo errore frequente è usare\netichette generiche."
    },
    {
      "start": 3.92,
      "end": 4.62,
      "text": "«Vai»,"
    },
    {
      "start": 4.74,
      "end": 7.98,
      "text": "«Procedi» o «Conferma» possono funzionare\nin alcuni contesti,"
    },
    {
      "start": 8.64,
      "end": 12.32,
      "text": "ma dobbiamo verificare che sia chiaro che\ncosa verrà avviato o concluso."
    },
    {
      "start": 13.5,
      "end": 18.04,
      "text": "Su Passo, dopo aver scelto una visita,\n«Invia richiesta» comunica meglio il"
    },
    {
      "start": 18.04,
      "end": 22.08,
      "text": "passaggio effettivo rispetto a una\nconferma che potrebbe sembrare definitiva."
    },
    {
      "start": 23.02,
      "end": 26.48,
      "text": "Questa informazione prima dell’azione\nviene chiamata feedforward."
    },
    {
      "start": 27.42,
      "end": 28.64,
      "text": "Aiuta a prevedere la conseguenza."
    },
    {
      "start": 29.74,
      "end": 34.62,
      "text": "Il feedback, che vedremo fra poco, arriva\ninvece dopo l’azione e ne comunica la"
    },
    {
      "start": 34.62,
      "end": 35.8,
      "text": "ricezione o l’esito."
    },
    {
      "start": 37.06,
      "end": 40.84,
      "text": "Il secondo errore è rendere troppo\npersonale un simbolo che deve essere"
    },
    {
      "start": 40.84,
      "end": 45.08,
      "text": "riconosciuto rapidamente. Se voglio\nrappresentare il taglio, una nuova"
    },
    {
      "start": 45.08,
      "end": 49.1,
      "text": "metafora può richiedere una spiegazione\nche la convenzione delle forbici spesso"
    },
    {
      "start": 49.1,
      "end": 49.8,
      "text": "evita."
    },
    {
      "start": 50.44,
      "end": 54.46,
      "text": "Anche una convenzione va però valutata\nrispetto alle persone e all’attività."
    },
    {
      "start": 54.96,
      "end": 59.2,
      "text": "La casa come accesso alla pagina iniziale\nè diffusa, ma non prova che ogni"
    },
    {
      "start": 59.2,
      "end": 62.26,
      "text": "partecipante ne conosca il significato."
    },
    {
      "start": 62.26,
      "end": 64.28,
      "text": "Possiamo chiedere che cosa si aspetta da\nun controllo,"
    },
    {
      "start": 65.08,
      "end": 67.08,
      "text": "oppure osservare come lo usa in un\ncompito."
    },
    {
      "start": 68.2,
      "end": 72.82,
      "text": "La coerenza fra segno, parola e\ncomportamento rende più facile costruire"
    },
    {
      "start": 72.82,
      "end": 73.94,
      "text": "aspettative affidabili."
    },
    {
      "start": 74.68,
      "end": 78.9,
      "text": "La creatività del progetto può esprimersi\nsenza rendere indecifrabili le azioni"
    },
    {
      "start": 78.9,
      "end": 79.6,
      "text": "necessarie."
    }
  ]
}
