  "cues": [
    {
      "start": 0.28,
      "end": 4.5,
      "text": "Flessibilità ed efficienza riguardano modi\ndiversi di raggiungere lo stesso"
    },
    {
      "start": 4.5,
      "end": 9.46,
      "text": "risultato. Nell’esempio troviamo link\nrapidi, categorie e contenuti recenti."
    },
    {
      "start": 10.46,
      "end": 15.18,
      "text": "Chi sa già che cosa cerca può usare una\nscorciatoia; chi ha bisogno di esplorare"
    },
    {
      "start": 15.18,
      "end": 16.4,
      "text": "può partire dalla struttura."
    },
    {
      "start": 17.3,
      "end": 21.66,
      "text": "La scorciatoia dovrebbe sostenere\nl’esperienza senza rendere incomprensibile"
    },
    {
      "start": 21.66,
      "end": 22.64,
      "text": "il percorso ordinario."
    },
    {
      "start": 23.54,
      "end": 25.16,
      "text": "Un comando da tastiera, per esempio,"
    },
    {
      "start": 25.68,
      "end": 28.64,
      "text": "può affiancare un’azione raggiungibile\nanche attraverso il menu."
    },
    {
      "start": 29.36,
      "end": 33.6,
      "text": "Su Passo potremmo conservare filtri\npertinenti per una nuova ricerca,"
    },
    {
      "start": 33.9,
      "end": 38.16,
      "text": "lasciando chiaro come modificarli. Il\nvantaggio dipende da ciò che la persona"
    },
    {
      "start": 38.16,
      "end": 41.32,
      "text": "deve fare e da quanto conosce il servizio."
    },
    {
      "start": 41.32,
      "end": 45.56,
      "text": "Per valutare questa euristica dobbiamo\nquindi distinguere primo uso e uso"
    },
    {
      "start": 45.56,
      "end": 46.26,
      "text": "ripetuto."
    },
    {
      "start": 46.84,
      "end": 50.9,
      "text": "Una strada efficiente per una persona\nesperta potrebbe essere difficile da"
    },
    {
      "start": 50.92,
      "end": 51.92,
      "text": "scoprire per chi comincia."
    }
  ]
}
