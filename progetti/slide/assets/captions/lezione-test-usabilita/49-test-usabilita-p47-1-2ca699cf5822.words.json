  "cues": [
    {
      "start": 0.24,
      "end": 3.46,
      "text": "La tabella confronta due modelli\norganizzativi."
    },
    {
      "start": 3.46,
      "end": 7.84,
      "text": "Nel primo, il test è un evento esteso,\nspesso vicino alla conclusione del"
    },
    {
      "start": 7.84,
      "end": 13.16,
      "text": "progetto. Nel secondo, una mattina\nricorrente viene dedicata a osservare e"
    },
    {
      "start": 13.16,
      "end": 14.98,
      "text": "discutere ciò che si sta costruendo."
    },
    {
      "start": 15.84,
      "end": 19.98,
      "text": "Il vantaggio del ciclo breve è poter\nintervenire mentre le scelte sono ancora"
    },
    {
      "start": 19.98,
      "end": 20.68,
      "text": "modificabili."
    },
    {
      "start": 21.28,
      "end": 25.78,
      "text": "Un’etichetta o un ordine dei passaggi\npossono essere rivisti prima che l’intero"
    },
    {
      "start": 25.78,
      "end": 27.28,
      "text": "servizio dipenda da quella soluzione."
    },
    {
      "start": 28.22,
      "end": 32.52,
      "text": "I tempi riportati descrivono una proposta\npratica, non una durata obbligatoria."
    },
    {
      "start": 33.42,
      "end": 34.92,
      "text": "Dobbiamo comunque preparare le consegne,"
    },
    {
      "start": 35.72,
      "end": 38.48,
      "text": "coinvolgere persone pertinenti e lasciare\ntempo all’analisi."
    },
    {
      "start": 39.42,
      "end": 43.5,
      "text": "Il confronto serve a chiedersi se\nl’organizzazione del lavoro facilita prove"
    },
    {
      "start": 43.5,
      "end": 47.28,
      "text": "frequenti oppure le rinvia fino a quando\ncambiare diventa più difficile."
    }
  ]
}
