  "cues": [
    {
      "start": 0.3,
      "end": 3.68,
      "text": "Quando riprogettiamo un servizio,\nosserviamo anche la versione esistente."
    },
    {
      "start": 4.58,
      "end": 8.88,
      "text": "Ci interessa capire quali difficoltà\naffrontare e quali elementi sostengono già"
    },
    {
      "start": 8.88,
      "end": 14.24,
      "text": "il compito. Una revisione può introdurre\nproblemi se cambia senza motivo una strada"
    },
    {
      "start": 14.24,
      "end": 19.32,
      "text": "che funzionava. Durante il progetto\nadeguiamo poi la prova al materiale."
    },
    {
      "start": 19.32,
      "end": 23.24,
      "text": "Uno schizzo può sostenere una discussione\nsulla comprensione e sulla struttura."
    },
    {
      "start": 24.0,
      "end": 28.6,
      "text": "Un prototipo navigabile permette di\nosservare sequenze, stati e recuperi."
    },
    {
      "start": 29.02,
      "end": 32.62,
      "text": "Le pagine reali aggiungono condizioni\ntecniche e contenuti effettivi."
    },
    {
      "start": 33.68,
      "end": 36.22,
      "text": "Non possiamo chiedere a ogni materiale la\nstessa evidenza."
    },
    {
      "start": 37.04,
      "end": 41.48,
      "text": "Se una schermata è statica, una domanda su\ndove si cercherebbe un comando rimane"
    },
    {
      "start": 41.48,
      "end": 43.76,
      "text": "diversa dall’osservazione del suo uso\ncompleto."
    },
    {
      "start": 44.82,
      "end": 48.62,
      "text": "Conserviamo quindi per ogni ciclo domanda,\nversione e limiti."
    },
    {
      "start": 49.52,
      "end": 53.18,
      "text": "Questo ci aiuterà a leggere correttamente\ni risultati e a scegliere la prova"
    },
    {
      "start": 53.18,
      "end": 53.88,
      "text": "successiva."
    }
  ]
}
