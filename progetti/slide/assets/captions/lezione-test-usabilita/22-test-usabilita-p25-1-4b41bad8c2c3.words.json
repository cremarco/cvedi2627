  "cues": [
    {
      "start": 0.12,
      "end": 3.46,
      "text": "Progettiamo spesso la schermata prima\ndell’invio e quella dell’esito."
    },
    {
      "start": 4.38,
      "end": 7.78,
      "text": "Fra le due c’è però un intervallo che la\npersona deve poter interpretare."
    },
    {
      "start": 9.04,
      "end": 11.5,
      "text": "Ho premuto il comando: il clic è arrivato?"
    },
    {
      "start": 12.04,
      "end": 13.12,
      "text": "La connessione funziona?"
    },
    {
      "start": 13.9,
      "end": 14.74,
      "text": "Devo aspettare?"
    },
    {
      "start": 15.36,
      "end": 18.98,
      "text": "Se manca una risposta, premere di nuovo\npuò sembrare ragionevole."
    },
    {
      "start": 19.52,
      "end": 23.86,
      "text": "Il sistema deve quindi rendere\nriconoscibile l’elaborazione e gestire gli"
    },
    {
      "start": 23.86,
      "end": 26.46,
      "text": "invii ripetuti senza creare richieste\nduplicate."
    },
    {
      "start": 27.42,
      "end": 29.48,
      "text": "Il feedback deve anche essere veritiero."
    },
    {
      "start": 30.16,
      "end": 34.12,
      "text": "Una scritta di successo mostrata troppo\npresto può far credere conclusa"
    },
    {
      "start": 34.12,
      "end": 39.34,
      "text": "un’operazione ancora incerta. Se l’invio\nfallisce, occorre dire che cosa è successo"
    },
    {
      "start": 39.34,
      "end": 40.26,
      "text": "e come riprovare,"
    },
    {
      "start": 41.02,
      "end": 43.12,
      "text": "conservando quando possibile il lavoro già\nsvolto."
    },
    {
      "start": 43.98,
      "end": 48.68,
      "text": "Nel test annoteremo attese, clic ripetuti\ne domande sullo stato."
    },
    {
      "start": 48.72,
      "end": 52.14,
      "text": "Sono episodi che ci aiutano a capire se il\npassaggio intermedio è comprensibile."
    }
  ]
}
