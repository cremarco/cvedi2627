  "cues": [
    {
      "start": 0.3,
      "end": 2.72,
      "text": "Nelle interfacce troviamo limiti di natura\ndiversa."
    },
    {
      "start": 3.58,
      "end": 7.84,
      "text": "Le dimensioni dello schermo pongono una\ncondizione materiale; l’obbligo di"
    },
    {
      "start": 7.84,
      "end": 12.7,
      "text": "compilare un dato prima dell’invio\nintroduce una regola nel percorso."
    },
    {
      "start": 12.7,
      "end": 16.22,
      "text": "Un comando disattivato comunica che\nun’azione non è disponibile,"
    },
    {
      "start": 16.76,
      "end": 18.24,
      "text": "ma può richiedere una spiegazione."
    },
    {
      "start": 18.92,
      "end": 22.0,
      "text": "La slide include anche indizi che\norientano la navigazione."
    },
    {
      "start": 23.0,
      "end": 27.26,
      "text": "Una scheda tagliata sul bordo suggerisce\nche altri contenuti proseguono fuori"
    },
    {
      "start": 27.26,
      "end": 27.96,
      "text": "dall’area visibile."
    },
    {
      "start": 28.88,
      "end": 33.26,
      "text": "La sequenza dei passaggi di un acquisto\nindica invece dove ci troviamo e quanto"
    },
    {
      "start": 33.26,
      "end": 38.26,
      "text": "rimane. Questi ultimi elementi aiutano\nsoprattutto a costruire un’interpretazione"
    },
    {
      "start": 38.26,
      "end": 42.64,
      "text": "del percorso. La porzione di scheda\nvisibile funziona come segnale;"
    },
    {
      "start": 42.64,
      "end": 46.6,
      "text": "l’indicazione dei passaggi come\norientamento e stato."
    },
    {
      "start": 46.6,
      "end": 50.0,
      "text": "Non tutto ciò che guida l’azione impedisce\nmaterialmente una scelta."
    },
    {
      "start": 51.08,
      "end": 55.48,
      "text": "Questa distinzione ci è utile nel\nprogetto: possiamo limitare le possibilità"
    },
    {
      "start": 55.54,
      "end": 57.04,
      "text": "oppure chiarire quelle disponibili."
    },
    {
      "start": 58.02,
      "end": 59.1,
      "text": "Prima di introdurre un blocco,"
    },
    {
      "start": 59.58,
      "end": 63.68,
      "text": "chiediamoci quale errore vogliamo\nprevenire e come permetteremo alla persona"
    },
    {
      "start": 63.68,
      "end": 65.72,
      "text": "di comprendere e superare la condizione."
    }
  ]
}
