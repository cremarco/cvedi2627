  "cues": [
    {
      "start": 0.3,
      "end": 2.18,
      "text": "Un’altra difficoltà riguarda il\nlinguaggio."
    },
    {
      "start": 2.98,
      "end": 6.92,
      "text": "La persona cerca una parola che il\nprogetto non usa, oppure incontra un"
    },
    {
      "start": 6.92,
      "end": 9.16,
      "text": "termine al quale attribuisce un altro\nsignificato."
    },
    {
      "start": 10.74,
      "end": 14.4,
      "text": "Ascoltiamo come descrive il proprio\nobiettivo e confrontiamolo con le"
    },
    {
      "start": 14.4,
      "end": 15.1,
      "text": "etichette dell’interfaccia."
    },
    {
      "start": 16.24,
      "end": 20.48,
      "text": "Un ritorno alla ricerca o l’apertura di\nuna sezione inattesa può aiutarci a"
    },
    {
      "start": 20.48,
      "end": 21.48,
      "text": "individuare lo scarto."
    },
    {
      "start": 22.34,
      "end": 26.48,
      "text": "La modifica potrebbe riguardare un\ntermine, una categoria o un’informazione"
    },
    {
      "start": 26.48,
      "end": 27.18,
      "text": "mancante."
    },
    {
      "start": 27.8,
      "end": 30.66,
      "text": "Dovremo verificarne l’effetto nel contesto\ndel compito."
    }
  ]
