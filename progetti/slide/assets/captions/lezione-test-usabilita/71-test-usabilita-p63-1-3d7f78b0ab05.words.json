  "cues": [
    {
      "start": 0.24,
      "end": 4.74,
      "text": "Fissare una data ricorrente riduce il\nrischio di rinviare continuamente il test"
    },
    {
      "start": 4.74,
      "end": 9.9,
      "text": "alla prossima versione pronta. Le scadenze\ndi sviluppo possono slittare; una domanda"
    },
    {
      "start": 9.9,
      "end": 13.32,
      "text": "di ricerca può invece essere affrontata\nanche con materiali parziali,"
    },
    {
      "start": 14.16,
      "end": 14.86,
      "text": "se adeguati."
    },
    {
      "start": 15.76,
      "end": 19.68,
      "text": "Potremmo testare la comprensione di un\nriepilogo mentre il resto del servizio è"
    },
    {
      "start": 19.68,
      "end": 20.56,
      "text": "ancora in costruzione."
    },
    {
      "start": 21.58,
      "end": 25.46,
      "text": "Oppure osservare come vengono interpretate\ndue formulazioni di un messaggio."
    },
    {
      "start": 26.36,
      "end": 30.72,
      "text": "Prima di ogni appuntamento dobbiamo\ncomunque scegliere che cosa studiare."
    },
    {
      "start": 30.74,
      "end": 33.86,
      "text": "La prevedibilità della data non elimina la\npreparazione."
    },
    {
      "start": 34.74,
      "end": 35.9,
      "text": "Ci aiuta a farla in anticipo:"
    },
    {
      "start": 36.9,
      "end": 40.56,
      "text": "definire la domanda, predisporre il\nmateriale e coinvolgere le persone"
    },
    {
      "start": 40.56,
      "end": 41.26,
      "text": "pertinenti."
    },
    {
      "start": 42.06,
      "end": 45.54,
      "text": "Se il progetto cambia direzione, rivediamo\nil piano."
    },
    {
      "start": 45.56,
      "end": 48.86,
      "text": "Il valore dell’abitudine è mantenere\naperto il rapporto con l’uso,"
    },
    {
      "start": 49.48,
      "end": 53.06,
      "text": "anche quando il lavoro di produzione\noccupa quasi tutto il tempo disponibile."
    }
  ]
}
