  "cues": [
    {
      "start": 0.2,
      "end": 4.2,
      "text": "Prima della sessione facciamo una prova\ncompleta del percorso."
    },
    {
      "start": 4.2,
      "end": 8.28,
      "text": "Verifichiamo che il prototipo si apra, che\ngli account di prova funzionino e che i"
    },
    {
      "start": 8.28,
      "end": 9.5,
      "text": "dispositivi siano adatti."
    },
    {
      "start": 10.44,
      "end": 13.3,
      "text": "Se registriamo, controlliamo audio e\nschermata."
    },
    {
      "start": 14.14,
      "end": 18.28,
      "text": "Prepariamo anche un modo per proseguire se\nun collegamento o una funzione non sono"
    },
    {
      "start": 18.28,
      "end": 18.98,
      "text": "disponibili."
    },
    {
      "start": 19.48,
      "end": 23.18,
      "text": "Il prototipo può simulare soltanto una\nparte del servizio."
    },
    {
      "start": 23.38,
      "end": 26.44,
      "text": "Dobbiamo conoscerne i limiti, così da\ndistinguere una difficoltà"
    },
    {
      "start": 26.44,
      "end": 29.3,
      "text": "dell’interfaccia da una funzione che non è\nstata realizzata."
    },
    {
      "start": 29.72,
      "end": 30.42,
      "text": "Quando serve spiegarli alla persona,\nevitiamo di anticipare le risposte alla"
    },
    {
      "start": 32.66,
      "end": 38.54,
      "text": "domanda di ricerca. All’inizio presentiamo\nscopo, durata e"
    },
    {
      "start": 38.54,
      "end": 43.02,
      "text": "presenza degli osservatori. Spieghiamo che\nstiamo studiando il servizio e che il"
    },
    {
      "start": 43.18,
      "end": 45.86,
      "text": "partecipante può fare domande o\ninterrompere la partecipazione."
    },
    {
      "start": 46.94,
      "end": 51.56,
      "text": "Le condizioni devono essere comprensibili\nprima di raccogliere il consenso."
    },
    {
      "start": 51.56,
      "end": 55.68,
      "text": "Chiariamo inoltre che cosa verrà\nregistrato, chi potrà accedervi e per"
    },
    {
      "start": 55.68,
      "end": 56.76,
      "text": "quanto tempo sarà conservato."
    },
    {
      "start": 58.0,
      "end": 61.62,
      "text": "Queste decisioni vanno definite\nnell’organizzazione della ricerca,"
    },
    {
      "start": 61.62,
      "end": 63.6,
      "text": "raccogliendo solo ciò che serve alla\ndomanda."
    },
    {
      "start": 64.32,
      "end": 66.8,
      "text": "Se cambiano le condizioni, dobbiamo\nrenderlo esplicito."
    },
    {
      "start": 67.74,
      "end": 70.58,
      "text": "Nel caso Passo usiamo dati di prova per la\nprenotazione."
    },
    {
      "start": 71.62,
      "end": 75.64,
      "text": "Il compito può riguardare una visita senza\nrichiedere informazioni sanitarie reali."
    },
    {
      "start": 76.32,
      "end": 80.62,
      "text": "Possiamo fornire un indirizzo fittizio,\ncontatti predisposti e una situazione"
    },
    {
      "start": 80.62,
      "end": 83.74,
      "text": "sufficientemente concreta da motivare la\nscelta."
    },
    {
      "start": 83.74,
      "end": 88.3,
      "text": "Una frase di apertura potrebbe essere:\n«Oggi proviamo questo servizio per capire"
    },
    {
      "start": 88.3,
      "end": 89.0,
      "text": "come migliorarlo."
    },
    {
      "start": 89.7,
      "end": 93.1,
      "text": "Le eventuali difficoltà ci danno\ninformazioni sul progetto."
    },
    {
      "start": 93.1,
      "end": 94.76,
      "text": "Puoi fermarti in qualsiasi momento»."
    },
    {
      "start": 95.46,
      "end": 99.54,
      "text": "Poi spieghiamo strumenti e osservatori\nnelle modalità concordate."
    },
    {
      "start": 99.54,
      "end": 102.36,
      "text": "Questa preparazione sostiene anche la\nqualità dell’osservazione:"
    },
    {
      "start": 103.44,
      "end": 108.04,
      "text": "se la persona sa che cosa aspettarsi, può\nconcentrarsi maggiormente sul compito e"
    },
    {
      "start": 108.04,
      "end": 110.96,
      "text": "mostrare con più libertà dubbi e\nincertezze."
    }
  ]
}
