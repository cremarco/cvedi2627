  "cues": [
    {
      "start": 0.24,
      "end": 3.2,
      "text": "La formulazione può suggerire\ninvolontariamente la soluzione."
    },
    {
      "start": 4.12,
      "end": 8.46,
      "text": "Se chiedo «Usa il filtro Prezzo per\ntrovare una visita», ho già indicato sia"
    },
    {
      "start": 8.46,
      "end": 10.4,
      "text": "il controllo sia la parola da cercare."
    },
    {
      "start": 11.54,
      "end": 14.22,
      "text": "Una consegna centrata sul bisogno potrebbe\ndire:"
    },
    {
      "start": 14.72,
      "end": 18.14,
      "text": "«Vorresti organizzare una visita dopo le\nventi, al domicilio indicato,"
    },
    {
      "start": 18.66,
      "end": 19.9,
      "text": "spendendo entro il limite previsto."
    },
    {
      "start": 20.82,
      "end": 21.88,
      "text": "Cerca una proposta compatibile»."
    },
    {
      "start": 22.94,
      "end": 25.38,
      "text": "Sarà la persona a decidere da dove\ncominciare."
    },
    {
      "start": 26.08,
      "end": 29.58,
      "text": "Questo effetto di orientamento viene\nrichiamato con il termine priming."
    },
    {
      "start": 30.22,
      "end": 34.72,
      "text": "Le parole della consegna possono rendere\npiù probabile una certa interpretazione o"
    },
    {
      "start": 34.72,
      "end": 38.96,
      "text": "un certo percorso. Per ridurlo rileggiamo\nil compito confrontandolo con"
    },
    {
      "start": 38.96,
      "end": 39.66,
      "text": "l’interfaccia:"
    },
    {
      "start": 40.26,
      "end": 42.14,
      "text": "stiamo copiando le etichette dei comandi?"
    },
    {
      "start": 42.44,
      "end": 44.28,
      "text": "Stiamo descrivendo una sequenza di clic?"
    },
    {
      "start": 45.02,
      "end": 48.94,
      "text": "Le condizioni necessarie devono essere\ndisponibili, mentre la strada per"
    },
    {
      "start": 48.94,
      "end": 51.14,
      "text": "soddisfarle deve poter emergere dall’uso."
    }
  ]
}
