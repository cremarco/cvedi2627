  "cues": [
    {
      "start": 0.2,
      "end": 2.16,
      "text": "Passiamo alle euristiche di Jakob Nielsen."
    },
    {
      "start": 3.1,
      "end": 7.48,
      "text": "Sono criteri generali che possiamo usare\nper esaminare un’interfaccia e formulare"
    },
    {
      "start": 7.48,
      "end": 9.04,
      "text": "ipotesi sui possibili problemi."
    },
    {
      "start": 10.0,
      "end": 11.74,
      "text": "Le leggeremo attraverso esempi concreti."
    },
    {
      "start": 12.56,
      "end": 16.6,
      "text": "Ci serviranno poi per distinguere\nl’ispezione condotta da valutatori dalla"
    },
    {
      "start": 16.6,
      "end": 19.84,
      "text": "prova in cui osserviamo persone impegnate\nin un compito."
    }
  ]
