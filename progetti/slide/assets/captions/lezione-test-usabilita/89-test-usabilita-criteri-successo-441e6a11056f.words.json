      "start": 0.28,
      "end": 4.26,
      "text": "Prima di iniziare definiamo che cosa\nconterà come successo."
    },
    {
      "start": 4.26,
      "end": 7.88,
      "text": "Il compito di Passo può richiedere di\ninviare una richiesta per una visita"
    },
    {
      "start": 7.88,
      "end": 11.44,
      "text": "compatibile con domicilio, fascia oraria e\ncosto dello scenario."
    },
    {
      "start": 12.84,
      "end": 17.18,
      "text": "Il risultato osservabile comprende allora\nuna richiesta corretta effettivamente"
    },
    {
      "start": 17.18,
      "end": 20.26,
      "text": "inviata nel prototipo. Premere un pulsante\nnon basta:"
    },
    {
      "start": 20.98,
      "end": 22.96,
      "text": "la visita scelta potrebbe essere\nincompatibile,"
    },
    {
      "start": 23.8,
      "end": 26.26,
      "text": "oppure l’invio potrebbe non essere stato\ncompletato."
    },
    {
      "start": 27.72,
      "end": 30.3,
      "text": "Registriamo poi separatamente la\ncomprensione dello stato."
    },
    {
      "start": 31.2,
      "end": 35.32,
      "text": "La persona ha raggiunto l’esito operativo,\nma sa che il professionista deve ancora"
    },
    {
      "start": 35.32,
      "end": 36.06,
      "text": "rispondere?"
    },
    {
      "start": 37.04,
      "end": 40.44,
      "text": "Questa seconda domanda ci evita di\nnascondere un equivoco dentro una"
    },
    {
      "start": 40.44,
      "end": 42.26,
      "text": "valutazione generica di successo."
    },
    {
      "start": 43.44,
      "end": 45.3,
      "text": "Concordiamo anche come annotare l’aiuto."
    },
    {
      "start": 46.0,
      "end": 50.52,
      "text": "Un completamento autonomo è diverso da uno\nraggiunto dopo che il facilitatore ha"
    },
    {
      "start": 50.74,
      "end": 51.44,
      "text": "indicato dove guardare."
    },
    {
      "start": 52.62,
      "end": 57.08,
      "text": "Possiamo documentare errori, recuperi e\nabbandono, mantenendo esplicite le"
    },
    {
      "start": 57.08,
      "end": 57.78,
      "text": "condizioni."
    },
    {
      "start": 58.64,
      "end": 62.2,
      "text": "Tempo e giudizio di facilità aggiungono\ninformazioni."
    },
    {
      "start": 62.2,
      "end": 63.88,
      "text": "Una persona può riuscire lentamente,"
    },
    {
      "start": 64.56,
      "end": 69.34,
      "text": "procedere velocemente ma fraintendere il\nrisultato oppure completare con fatica e"
    },
    {
      "start": 69.34,
      "end": 70.04,
      "text": "dirsi insoddisfatta."
    },
    {
      "start": 71.36,
      "end": 74.86,
      "text": "Se usa il pensiero ad alta voce,\nconsideriamo anche l’effetto di questa"
    },
    {
      "start": 74.86,
      "end": 79.86,
      "text": "modalità quando leggiamo i tempi. Il\ncriterio viene scritto per la ricerca,"
    },
    {
      "start": 80.04,
      "end": 81.98,
      "text": "senza inserirne la soluzione nella\nconsegna."
    },
    {
      "start": 83.1,
      "end": 87.1,
      "text": "Possiamo descrivere il bisogno e i\nvincoli, lasciando che sia la persona a"
    },
    {
      "start": 87.1,
      "end": 91.56,
      "text": "scegliere i passaggi. Dopo la prova\nconfronteremo l’esito con il criterio"
    },
    {
      "start": 91.56,
      "end": 96.16,
      "text": "preparato, evitando di cambiarlo per far\napparire riuscito il percorso che abbiamo"
    },
    {
      "start": 96.16,
      "end": 96.86,
      "text": "osservato."
    }
  ]
}
