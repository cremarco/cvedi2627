  "cues": [
    {
      "start": 0.2,
      "end": 4.72,
      "text": "La progettazione minimalista seleziona ciò\nche serve al compito e gli assegna una"
    },
    {
      "start": 4.72,
      "end": 9.56,
      "text": "gerarchia leggibile. La ricostruzione\ndella pagina di ricerca mette al centro un"
    },
    {
      "start": 9.56,
      "end": 11.02,
      "text": "campo e un’azione principale:"
    },
    {
      "start": 11.98,
      "end": 15.86,
      "text": "il confronto riguarda questa\nconcentrazione sul compito, non l’aspetto"
    },
    {
      "start": 15.86,
      "end": 17.2,
      "text": "attuale del servizio rappresentato."
    },
    {
      "start": 18.98,
      "end": 21.56,
      "text": "Togliere elementi è utile quando riduce\ninterferenze."
    },
    {
      "start": 22.44,
      "end": 26.52,
      "text": "Se però elimino costo, condizioni o\ninformazioni necessarie alla scelta,"
    },
    {
      "start": 27.14,
      "end": 29.9,
      "text": "la pagina può sembrare più pulita e\nfunzionare peggio."
    },
    {
      "start": 30.7,
      "end": 35.48,
      "text": "Su Passo una fotografia molto grande\npotrebbe sottrarre spazio a orario e"
    },
    {
      "start": 36.46,
      "end": 39.9,
      "text": "copertura; un totale assente\ncostringerebbe invece ad avanzare senza un"
    },
    {
      "start": 39.9,
      "end": 40.74,
      "text": "dato essenziale."
    },
    {
      "start": 41.46,
      "end": 44.82,
      "text": "Dobbiamo discutere le priorità rispetto\nalla decisione."
    },
    {
      "start": 44.82,
      "end": 48.96,
      "text": "Nel test osserviamo che cosa viene cercato\ne che cosa viene trascurato."
    },
    {
      "start": 49.52,
      "end": 52.62,
      "text": "La quantità di bianco da sola non misura\nla facilità d’uso."
    }
  ]
}
