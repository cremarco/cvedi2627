  "cues": [
    {
      "start": 0.28,
      "end": 1.84,
      "text": "A volte l’informazione c’è,"
    },
    {
      "start": 2.38,
      "end": 5.38,
      "text": "ma perde visibilità nel contesto della\npagina."
    },
    {
      "start": 5.38,
      "end": 10.48,
      "text": "Torniamo così a composizione e gerarchia:\ncontrasto, prossimità e ordine"
    },
    {
      "start": 10.5,
      "end": 13.1,
      "text": "contribuiscono a rendere riconoscibile ciò\nche serve."
    },
    {
      "start": 14.4,
      "end": 18.0,
      "text": "Se il costo viene ignorato, possiamo\ncontrollare come si confronta con"
    },
    {
      "start": 18.0,
      "end": 19.88,
      "text": "immagini, titoli e altre azioni."
    },
    {
      "start": 20.76,
      "end": 24.6,
      "text": "Potrebbe essere utile ridurre\ninterferenze, avvicinarlo alla scelta o"
    },
    {
      "start": 24.6,
      "end": 25.3,
      "text": "riformularlo."
    },
    {
      "start": 26.14,
      "end": 30.94,
      "text": "Il test ci mostra l’episodio; l’analisi\ndel progetto ci aiuta a formulare una"
    },
    {
      "start": 30.94,
      "end": 32.3,
      "text": "variazione da provare."
    }
  ]
