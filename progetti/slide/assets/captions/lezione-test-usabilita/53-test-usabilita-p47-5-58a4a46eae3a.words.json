  "cues": [
    {
      "start": 0.3,
      "end": 3.96,
      "text": "Anche questa riga sui costi appartiene al\nconfronto storico."
    },
    {
      "start": 4.04,
      "end": 8.26,
      "text": "Le cifre servono a mostrare quanto potesse\ncambiare l’organizzazione di un ciclo,"
    },
    {
      "start": 8.92,
      "end": 11.98,
      "text": "non a indicare il prezzo attuale di un\nservizio."
    },
    {
      "start": 11.98,
      "end": 17.02,
      "text": "Una prova interna utilizza comunque\nrisorse: preparazione, reclutamento,"
    },
    {
      "start": 17.2,
      "end": 20.24,
      "text": "conduzione, osservazione e analisi\nrichiedono tempo."
    },
    {
      "start": 21.14,
      "end": 25.2,
      "text": "Se questi passaggi vengono ignorati, il\ncosto apparente diminuisce ma può"
    },
    {
      "start": 25.2,
      "end": 27.48,
      "text": "diminuire anche l’utilità delle\nconclusioni."
    },
    {
      "start": 27.86,
      "end": 32.48,
      "text": "Quando pianifichiamo, chiediamoci quali\ndecisioni vogliamo sostenere e quale"
    },
    {
      "start": 32.48,
      "end": 33.76,
      "text": "investimento possiamo ripetere."
    },
    {
      "start": 34.68,
      "end": 37.72,
      "text": "L’obiettivo è rendere la ricerca\npraticabile nel processo."
    },
    {
      "start": 38.68,
      "end": 43.14,
      "text": "Il risparmio acquista valore se permette\ndi correggere il progetto e verificare di"
    },
    {
      "start": 43.14,
      "end": 44.4,
      "text": "nuovo ciò che abbiamo cambiato."
    }
  ]
}
