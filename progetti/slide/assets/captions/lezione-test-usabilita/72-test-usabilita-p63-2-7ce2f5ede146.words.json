  "cues": [
    {
      "start": 0.22,
      "end": 3.24,
      "text": "Un calendario prevedibile aiuta anche gli\nosservatori a partecipare."
    },
    {
      "start": 4.24,
      "end": 8.52,
      "text": "Chi sviluppa, scrive i contenuti o decide\nle priorità può riservare il tempo"
    },
    {
      "start": 8.52,
      "end": 10.6,
      "text": "necessario e vedere almeno una sessione."
    },
    {
      "start": 12.06,
      "end": 15.88,
      "text": "Perché questa presenza sia utile,\ncondividiamo prima le domande e il ruolo"
    },
    {
      "start": 15.88,
      "end": 16.58,
      "text": "degli osservatori."
    },
    {
      "start": 17.54,
      "end": 21.46,
      "text": "Devono seguire il percorso e annotare\nepisodi, lasciando al facilitatore la"
    },
    {
      "start": 21.46,
      "end": 22.16,
      "text": "conduzione."
    },
    {
      "start": 22.9,
      "end": 27.28,
      "text": "Il confronto fra le diverse letture\navverrà dopo la sessione, sulla base di"
    },
    {
      "start": 27.28,
      "end": 28.6,
      "text": "ciò che ciascuno ha documentato."
    }
  ]
