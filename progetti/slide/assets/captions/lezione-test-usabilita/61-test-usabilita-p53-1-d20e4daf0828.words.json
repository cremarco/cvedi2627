  "cues": [
    {
      "start": 0.24,
      "end": 3.0,
      "text": "Seguiamo le quattro relazioni del\ndiagramma."
    },
    {
      "start": 3.0,
      "end": 8.3,
      "text": "Il facilitatore amministra i compiti:\npresenta la situazione e le istruzioni."
    },
    {
      "start": 8.3,
      "end": 11.46,
      "text": "Il partecipante li esegue attraverso il\nmateriale che stiamo studiando."
    },
    {
      "start": 12.54,
      "end": 14.72,
      "text": "Fra le due persone c’è poi un secondo\nscambio."
    },
    {
      "start": 15.44,
      "end": 20.82,
      "text": "Il facilitatore osserva e intervista; il\npartecipante offre un riscontro attraverso"
    },
    {
      "start": 20.82,
      "end": 22.58,
      "text": "parole, azioni e risultati."
    },
    {
      "start": 23.62,
      "end": 27.86,
      "text": "Questi scambi hanno ruoli diversi:\npresentare il compito non equivale a"
    },
    {
      "start": 27.86,
      "end": 32.4,
      "text": "spiegarne la soluzione. Il cuore\ndell’osservazione rimane il rapporto fra"
    },
    {
      "start": 32.4,
      "end": 37.44,
      "text": "persona e attività. Se il facilitatore\ninterviene continuamente, può sostituirsi"
    },
    {
      "start": 37.44,
      "end": 39.14,
      "text": "all’interfaccia nel guidare il percorso."
    },
    {
      "start": 40.16,
      "end": 42.42,
      "text": "Possiamo usare lo schema come controllo\ndella preparazione:"
    },
    {
      "start": 43.44,
      "end": 47.24,
      "text": "la consegna è comprensibile, il\npartecipante è pertinente e il"
    },
    {
      "start": 47.24,
      "end": 49.4,
      "text": "facilitatore sa che cosa osservare?"
    },
    {
      "start": 49.98,
      "end": 53.32,
      "text": "Tutti e tre contribuiscono alla qualità\ndelle informazioni che ricaveremo."
    }
  ]
}
