  "cues": [
    {
      "start": 0.24,
      "end": 4.52,
      "text": "L’affordance riguarda la relazione fra le\ncaratteristiche di un oggetto e le"
    },
    {
      "start": 4.52,
      "end": 7.14,
      "text": "capacità di chi può agire su di esso."
    },
    {
      "start": 7.14,
      "end": 9.46,
      "text": "Una presa può consentire di afferrare un"
    },
    {
      "start": 10.28,
      "end": 13.88,
      "text": "contenitore; quella possibilità dipende\nanche dalla mano e dalle condizioni della"
    },
    {
      "start": 13.88,
      "end": 14.58,
      "text": "persona."
    },
    {
      "start": 15.52,
      "end": 19.18,
      "text": "Nel progetto dobbiamo poi chiederci se\nl’azione possibile viene percepita."
    },
    {
      "start": 20.18,
      "end": 23.8,
      "text": "Un controllo può funzionare al clic e\nsembrare una semplice decorazione."
    },
    {
      "start": 25.06,
      "end": 29.08,
      "text": "La possibilità tecnica esiste, ma le\nindicazioni visive possono essere"
    },
    {
      "start": 29.08,
      "end": 29.78,
      "text": "insufficienti."
    },
    {
      "start": 30.68,
      "end": 34.44,
      "text": "La slide richiama proprio questo problema\ndi riconoscibilità."
    },
    {
      "start": 34.44,
      "end": 38.66,
      "text": "Nel digitale, però, una superficie\ncolorata o un’ombra sono soprattutto"
    },
    {
      "start": 38.66,
      "end": 40.62,
      "text": "segnali che suggeriscono l’interazione."
    },
    {
      "start": 41.42,
      "end": 44.38,
      "text": "Fra poco li chiameremo significanti."
    },
    {
      "start": 44.38,
      "end": 45.76,
      "text": "Conserviamo dunque due domande:"
    },
    {
      "start": 46.58,
      "end": 49.7,
      "text": "che cosa permette di fare l’oggetto o il\nsistema?"
    },
    {
      "start": 49.7,
      "end": 52.54,
      "text": "E da che cosa la persona può capirlo?"
    },
    {
      "start": 52.68,
      "end": 57.18,
      "text": "Nel test potremmo osservare un controllo\nignorato e poi approfondire come era stato"
    },
    {
      "start": 57.18,
      "end": 57.88,
      "text": "interpretato."
    },
    {
      "start": 58.34,
      "end": 61.96,
      "text": "La sola presenza di un pulsante\nfunzionante non ci dice se verrà"
    },
    {
      "start": 61.96,
      "end": 62.66,
      "text": "riconosciuto."
    }
  ]
}
