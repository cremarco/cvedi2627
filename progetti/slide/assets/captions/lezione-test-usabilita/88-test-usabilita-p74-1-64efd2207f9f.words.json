  "cues": [
    {
      "start": 0.18,
      "end": 4.92,
      "text": "Il numero delle attività deve lasciare\ntempo ai percorsi reali, alle esitazioni e"
    },
    {
      "start": 4.92,
      "end": 9.62,
      "text": "agli approfondimenti. Prepariamo compiti\nprioritari e, se utile, attività"
    },
    {
      "start": 9.62,
      "end": 14.5,
      "text": "aggiuntive per chi termina prima. Ogni\nconsegna deve contenere le condizioni"
    },
    {
      "start": 14.5,
      "end": 15.2,
      "text": "necessarie."
    },
    {
      "start": 15.8,
      "end": 18.64,
      "text": "Se serve un account di prova, forniamo le\ncredenziali predisposte."
    },
    {
      "start": 20.0,
      "end": 23.6,
      "text": "Se la ricerca riguarda una visita a\ndomicilio, indichiamo un indirizzo"
    },
    {
      "start": 23.6,
      "end": 26.42,
      "text": "fittizio e i vincoli dello scenario."
    },
    {
      "start": 26.52,
      "end": 28.68,
      "text": "Facciamo poi una prova della sessione\ncompleta."
    },
    {
      "start": 29.22,
      "end": 33.0,
      "text": "Potremmo scoprire che un compito dura\nmolto più del previsto oppure che una"
    },
    {
      "start": 33.0,
      "end": 34.36,
      "text": "funzione non è raggiungibile."
    },
    {
      "start": 35.26,
      "end": 36.24,
      "text": "Valutiamo anche l’ordine:"
    },
    {
      "start": 36.86,
      "end": 40.38,
      "text": "ciò che una persona impara nel primo\ncompito può aiutarla nel successivo."
    },
    {
      "start": 41.18,
      "end": 45.2,
      "text": "Se vogliamo osservare il primo incontro\ncon una funzione, dobbiamo considerare le"
    },
    {
      "start": 45.2,
      "end": 47.68,
      "text": "informazioni che la sessione ha già\nfornito."
    }
  ]
}
