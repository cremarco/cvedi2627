  "cues": [
    {
      "start": 0.26,
      "end": 4.4,
      "text": "Oggi passiamo da un progetto che sappiamo\nmotivare a un progetto che possiamo"
    },
    {
      "start": 4.4,
      "end": 9.56,
      "text": "mettere alla prova. Abbiamo lavorato su\nricerca, accessibilità, linguaggio visivo"
    },
    {
      "start": 9.56,
      "end": 14.62,
      "text": "e processo di progettazione. Adesso ci\nchiediamo che cosa accade quando una"
    },
    {
      "start": 14.62,
      "end": 18.66,
      "text": "persona prova davvero a usare quello che\nabbiamo costruito."
    },
    {
      "start": 18.66,
      "end": 21.12,
      "text": "Partiremo dai principi che ci aiutano a\nleggere un’interfaccia."
    },
    {
      "start": 22.2,
      "end": 24.2,
      "text": "Poi vedremo come preparare un test,"
    },
    {
      "start": 24.9,
      "end": 29.34,
      "text": "osservare senza suggerire le risposte e\ntrasformare le difficoltà emerse in"
    },
    {
      "start": 29.34,
      "end": 34.62,
      "text": "decisioni di progetto. Torneremo anche al\ncaso Passo: una richiesta inviata e una"
    },
    {
      "start": 34.62,
      "end": 36.2,
      "text": "visita confermata, per esempio,"
    },
    {
      "start": 37.0,
      "end": 38.28,
      "text": "sono due risultati diversi."
    },
    {
      "start": 38.96,
      "end": 42.38,
      "text": "Vogliamo capire se questa differenza è\nchiara anche a chi usa il servizio."
    }
  ]
}
