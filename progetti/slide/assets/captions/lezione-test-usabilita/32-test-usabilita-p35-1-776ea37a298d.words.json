  "cues": [
    {
      "start": 0.08,
      "end": 5.34,
      "text": "Prevenire un errore significa intervenire\nsulle condizioni che potrebbero produrlo."
    },
    {
      "start": 5.34,
      "end": 9.14,
      "text": "La finestra dell’esempio riconosce che il\ntesto del messaggio cita un allegato,"
    },
    {
      "start": 9.7,
      "end": 14.48,
      "text": "ma nessun file è stato aggiunto. Prima\ndell’invio propone di correggere la"
    },
    {
      "start": 14.5,
      "end": 17.54,
      "text": "situazione oppure procedere comunque."
    },
    {
      "start": 17.54,
      "end": 21.58,
      "text": "L’avviso si concentra su una possibile\ndimenticanza e lascia il controllo alla"
    },
    {
      "start": 21.58,
      "end": 22.28,
      "text": "persona."
    },
    {
      "start": 22.84,
      "end": 26.66,
      "text": "Se chiedessimo conferma per ogni\noperazione ordinaria, rischieremmo invece"
    },
    {
      "start": 26.66,
      "end": 28.9,
      "text": "di rendere gli avvisi abituali e poco\ninformativi."
    },
    {
      "start": 30.28,
      "end": 34.4,
      "text": "Su Passo potremmo verificare la\ncompatibilità dei dati prima di accettare"
    },
    {
      "start": 34.4,
      "end": 39.14,
      "text": "la richiesta e rendere disponibili le\ncondizioni prima della scelta."
    },
    {
      "start": 39.14,
      "end": 42.68,
      "text": "Il riepilogo è utile se permette di\nriconoscere un errore e modificarlo."
    },
    {
      "start": 43.96,
      "end": 48.2,
      "text": "Quando valutiamo la prevenzione\nchiediamoci quale problema viene evitato,"
    },
    {
      "start": 48.2,
      "end": 52.52,
      "text": "quale costo introduce il controllo e come\nsi comporta la persona davanti all’avviso."
    }
  ]
