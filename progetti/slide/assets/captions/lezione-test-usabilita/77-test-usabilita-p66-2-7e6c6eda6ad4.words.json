  "cues": [
    {
      "start": 0.22,
      "end": 2.94,
      "text": "Una spiegazione chiara può aiutare anche\nle persone esperte."
    },
    {
      "start": 4.06,
      "end": 9.06,
      "text": "Chiarezza significa usare termini precisi,\nrendere disponibili le condizioni e"
    },
    {
      "start": 9.06,
      "end": 10.72,
      "text": "permettere di riconoscere le azioni."
    },
    {
      "start": 11.7,
      "end": 13.76,
      "text": "Il livello di dettaglio può però cambiare:"
    },
    {
      "start": 14.44,
      "end": 18.78,
      "text": "chi conosce il percorso potrebbe voler\naccedere rapidamente a una funzione,"
    },
    {
      "start": 18.78,
      "end": 20.42,
      "text": "mentre chi comincia cerca orientamento."
    },
    {
      "start": 21.52,
      "end": 25.76,
      "text": "Possiamo sostenere entrambe le esigenze\nattraverso gerarchie e percorsi adeguati."
    },
    {
      "start": 26.7,
      "end": 28.76,
      "text": "Dovremo verificarle con le persone\npertinenti,"
    },
    {
      "start": 29.4,
      "end": 32.7,
      "text": "invece di presumere che una soluzione\nvalida per un gruppo funzioni"
    },
    {
      "start": 32.7,
      "end": 34.46,
      "text": "automaticamente per tutti."
    }
  ]
