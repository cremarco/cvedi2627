  "cues": [
    {
      "start": 0.54,
      "end": 4.5,
      "text": "Norman ha contribuito a portare al centro\ndella progettazione il modo in cui le"
    },
    {
      "start": 4.5,
      "end": 7.7,
      "text": "persone comprendono e usano gli oggetti."
    },
    {
      "start": 7.7,
      "end": 12.06,
      "text": "Una difficoltà ricorrente può rivelare uno\nscarto fra il funzionamento previsto dal"
    },
    {
      "start": 12.06,
      "end": 14.18,
      "text": "progettista e ciò che il prodotto\ncomunica."
    },
    {
      "start": 15.52,
      "end": 19.64,
      "text": "Pensiamo a una porta sulla quale esitiamo\nfra spingere e tirare."
    },
    {
      "start": 19.64,
      "end": 20.56,
      "text": "L’azione è semplice,"
    },
    {
      "start": 21.08,
      "end": 26.22,
      "text": "ma la forma del comando può suggerire una\ndirezione diversa da quella necessaria."
    },
    {
      "start": 26.22,
      "end": 30.34,
      "text": "Nell’interfaccia può accadere qualcosa di\nsimile: troviamo un elemento, lo"
    },
    {
      "start": 30.34,
      "end": 32.58,
      "text": "interpretiamo e agiamo in base a\nquell’interpretazione."
    },
    {
      "start": 34.28,
      "end": 38.52,
      "text": "Il contributo di questi principi è\naiutarci a descrivere lo scarto."
    },
    {
      "start": 38.52,
      "end": 41.5,
      "text": "Dire che una persona non ha capito è\nsoltanto l’inizio."
    },
    {
      "start": 42.52,
      "end": 47.1,
      "text": "Dobbiamo chiederci quali indicazioni aveva\na disposizione e quale aspettativa si era"
    },
    {
      "start": 47.1,
      "end": 47.8,
      "text": "costruita."
    },
    {
      "start": 48.34,
      "end": 51.68,
      "text": "Questa domanda sarà utile anche quando\nanalizzeremo i test."
    }
  ]
}
