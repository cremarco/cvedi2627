  "cues": [
    {
      "start": 0.26,
      "end": 4.22,
      "text": "Questo esempio fornisce le informazioni di\naccesso e una ragione per modificare"
    },
    {
      "start": 4.22,
      "end": 4.92,
      "text": "un’impostazione."
    },
    {
      "start": 5.82,
      "end": 8.8,
      "text": "La persona dispone quindi dei dati\nnecessari e di un obiettivo,"
    },
    {
      "start": 9.66,
      "end": 11.36,
      "text": "mentre deve trovare il percorso\nnell’interfaccia."
    },
    {
      "start": 12.7,
      "end": 16.72,
      "text": "Il riferimento alla domanda di sicurezza\nappartiene all’esempio storico."
    },
    {
      "start": 16.72,
      "end": 20.82,
      "text": "Per la nostra prova useremo attività\ncoerenti con il servizio e credenziali"
    },
    {
      "start": 20.82,
      "end": 21.52,
      "text": "predisposte,"
    },
    {
      "start": 22.08,
      "end": 22.94,
      "text": "senza chiedere quelle personali."
    },
    {
      "start": 23.94,
      "end": 25.52,
      "text": "Ci interessa la struttura della consegna:"
    },
    {
      "start": 26.58,
      "end": 31.14,
      "text": "contesto comprensibile, dati sufficienti e\nun risultato da raggiungere senza una"
    },
    {
      "start": 31.14,
      "end": 32.66,
      "text": "sequenza suggerita di comandi."
    }
  ]
