  "cues": [
    {
      "start": 0.4,
      "end": 3.94,
      "text": "Controllo e libertà riguardano la\npossibilità di uscire da uno stato"
    },
    {
      "start": 3.94,
      "end": 6.96,
      "text": "indesiderato e correggere una scelta."
    },
    {
      "start": 6.96,
      "end": 9.72,
      "text": "Nell’interfaccia di posta un messaggio è\nstato archiviato,"
    },
    {
      "start": 10.24,
      "end": 12.88,
      "text": "ma il comando «Annulla» permette di\nripristinarlo."
    },
    {
      "start": 14.0,
      "end": 17.62,
      "text": "Il sistema rende così recuperabile\nun’azione che potrebbe essere stata"
    },
    {
      "start": 17.62,
      "end": 18.32,
      "text": "involontaria."
    },
    {
      "start": 18.9,
      "end": 23.16,
      "text": "La possibilità deve essere visibile nel\nmomento utile e le conseguenze devono"
    },
    {
      "start": 23.16,
      "end": 24.06,
      "text": "essere comprensibili."
    },
    {
      "start": 25.14,
      "end": 29.52,
      "text": "Nel caso Passo, prima dell’invio dovremmo\npoter modificare i dati del riepilogo"
    },
    {
      "start": 29.52,
      "end": 34.62,
      "text": "senza ripartire da zero. Dopo l’invio, il\npercorso di modifica o annullamento"
    },
    {
      "start": 34.62,
      "end": 39.06,
      "text": "dipenderà dalle condizioni effettive del\nservizio, che vanno spiegate."
    },
    {
      "start": 39.06,
      "end": 42.88,
      "text": "Per verificare il criterio possiamo\nproporre una situazione in cui un dato"
    },
    {
      "start": 42.88,
      "end": 43.58,
      "text": "cambia."
    },
    {
      "start": 44.02,
      "end": 48.14,
      "text": "Osserviamo se la persona trova una strada\nper correggerlo e se comprende che cosa"
    },
    {
      "start": 48.14,
      "end": 48.84,
      "text": "resterà conservato."
    }
  ]
}
