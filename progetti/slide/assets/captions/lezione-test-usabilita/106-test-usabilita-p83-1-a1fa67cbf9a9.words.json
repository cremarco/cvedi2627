  "cues": [
    {
      "start": 0.26,
      "end": 3.26,
      "text": "Le richieste di nuove funzioni sono\ninformazioni da approfondire."
    },
    {
      "start": 4.04,
      "end": 6.74,
      "text": "Se una persona dice «Vorrei salvare questa\nricerca»,"
    },
    {
      "start": 7.42,
      "end": 11.56,
      "text": "chiediamo in quale situazione le sarebbe\nutile e quale problema sta cercando di"
    },
    {
      "start": 11.56,
      "end": 16.76,
      "text": "risolvere. Potrebbe voler confrontare\nalcune visite, riprendere il percorso dopo"
    },
    {
      "start": 16.76,
      "end": 19.9,
      "text": "un’interruzione oppure evitare di\nreinserire i filtri."
    },
    {
      "start": 20.72,
      "end": 22.92,
      "text": "Questi bisogni possono richiedere\nsoluzioni diverse."
    },
    {
      "start": 23.96,
      "end": 27.26,
      "text": "La prima proposta espressa durante la\nsessione è una possibilità,"
    },
    {
      "start": 27.78,
      "end": 29.16,
      "text": "da comprendere e valutare."
    },
    {
      "start": 29.88,
      "end": 34.44,
      "text": "La frase della slide sui partecipanti e\nsul design va letta come un richiamo alla"
    },
    {
      "start": 34.44,
      "end": 39.28,
      "text": "responsabilità del progetto. Le persone\nportano esperienza e conoscenza delle"
    },
    {
      "start": 39.28,
      "end": 43.54,
      "text": "proprie attività; il gruppo deve\ncollegarle ad altri vincoli e verificare"
    },
    {
      "start": 43.54,
      "end": 44.24,
      "text": "le scelte."
    },
    {
      "start": 44.94,
      "end": 48.72,
      "text": "Anche un partecipante con competenze di\nprogettazione rimane una fonte da"
    },
    {
      "start": 48.72,
      "end": 49.84,
      "text": "ascoltare criticamente."
    },
    {
      "start": 50.94,
      "end": 54.62,
      "text": "Possiamo quindi conservare la richiesta\ninsieme all’episodio che l’ha motivata."
    },
    {
      "start": 55.28,
      "end": 57.72,
      "text": "Nel debriefing distingueremo il bisogno\nosservato,"
    },
    {
      "start": 58.32,
      "end": 60.76,
      "text": "la soluzione suggerita e le alternative da\nesplorare."
    },
    {
      "start": 61.88,
      "end": 66.44,
      "text": "Una nuova funzione sarà giustificata se\nsostiene il compito senza introdurre un"
    },
    {
      "start": 66.44,
      "end": 69.04,
      "text": "costo sproporzionato per le altre persone."
    }
  ]
}
