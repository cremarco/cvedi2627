  "cues": [
    {
      "start": 0.2,
      "end": 5.34,
      "text": "La definizione del Nielsen Norman Group\nmette al centro una situazione operativa:"
    },
    {
      "start": 5.34,
      "end": 9.02,
      "text": "il ricercatore chiede a un partecipante di\nsvolgere dei compiti attraverso"
    },
    {
      "start": 9.02,
      "end": 13.76,
      "text": "un’interfaccia, osserva il comportamento e\nascolta ciò che la persona racconta"
    },
    {
      "start": 13.76,
      "end": 14.46,
      "text": "durante l’esperienza."
    },
    {
      "start": 16.04,
      "end": 17.4,
      "text": "Possiamo tradurla in tre azioni:"
    },
    {
      "start": 18.5,
      "end": 22.76,
      "text": "proporre una situazione, lasciare che la\npersona agisca e documentare il percorso."
    },
    {
      "start": 23.8,
      "end": 27.16,
      "text": "Il compito deve rendere possibile\nosservare qualcosa che ci interessa."
    },
    {
      "start": 28.36,
      "end": 32.38,
      "text": "Il facilitatore deve poi evitare di\ntrasformare la sessione in una"
    },
    {
      "start": 32.38,
      "end": 37.82,
      "text": "dimostrazione del funzionamento. Se dico\n«apri il menu in alto e scegli la seconda"
    },
    {
      "start": 37.82,
      "end": 39.42,
      "text": "voce», sto fornendo il percorso."
    },
    {
      "start": 40.4,
      "end": 42.66,
      "text": "Se chiedo di trovare come modificare una\nrichiesta,"
    },
    {
      "start": 43.3,
      "end": 45.44,
      "text": "posso osservare come viene cercata la\nfunzione."
    },
    {
      "start": 46.52,
      "end": 50.2,
      "text": "L’esito conta insieme alle condizioni in\ncui è stato raggiunto."
    },
    {
      "start": 50.2,
      "end": 52.02,
      "text": "La persona ha completato da sola?"
    },
    {
      "start": 52.62,
      "end": 55.76,
      "text": "Ha ricevuto un suggerimento? Ha capito il\nrisultato?"
    },
    {
      "start": 56.42,
      "end": 58.42,
      "text": "Il test produce episodi da analizzare,"
    },
    {
      "start": 58.94,
      "end": 62.3,
      "text": "non soltanto una risposta finale sul\ngradimento della pagina."
    }
  ]
}
