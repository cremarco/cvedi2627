  "cues": [
    {
      "start": 0.2,
      "end": 3.18,
      "text": "Non troveremo tutti i problemi in un unico\nciclo."
    },
    {
      "start": 3.18,
      "end": 7.92,
      "text": "Ogni sessione esplora una parte dei\npossibili incontri fra persone, attività e"
    },
    {
      "start": 7.92,
      "end": 8.62,
      "text": "contesti."
    },
    {
      "start": 9.62,
      "end": 13.38,
      "text": "Il fatto che una difficoltà non emerga\nlascia aperta la possibilità che si"
    },
    {
      "start": 13.38,
      "end": 14.58,
      "text": "presenti in altre condizioni."
    },
    {
      "start": 15.54,
      "end": 18.84,
      "text": "Con poche sessioni possiamo comunque\nindividuare ostacoli importanti."
    },
    {
      "start": 19.9,
      "end": 23.36,
      "text": "Se una persona completa una richiesta\nconvinta di avere già una visita"
    },
    {
      "start": 23.36,
      "end": 27.96,
      "text": "confermata, quell’episodio merita\nattenzione anche prima di conoscerne la"
    },
    {
      "start": 27.98,
      "end": 28.76,
      "text": "frequenza nella popolazione."
    },
    {
      "start": 29.8,
      "end": 34.86,
      "text": "Le risorse per intervenire sono limitate,\nquindi scegliamo priorità motivate."
    },
    {
      "start": 35.14,
      "end": 38.6,
      "text": "Guarderemo conseguenze, possibilità di\nrecupero e ricorrenza osservata,"
    },
    {
      "start": 39.34,
      "end": 40.6,
      "text": "mantenendo esplicita l’incertezza."
    },
    {
      "start": 41.8,
      "end": 46.5,
      "text": "Il numero dei partecipanti dipende anche\ndalla varietà dei gruppi e dei compiti."
    },
    {
      "start": 46.58,
      "end": 50.76,
      "text": "Quando le condizioni differiscono molto,\nun piccolo gruppo omogeneo può lasciare"
    },
    {
      "start": 50.76,
      "end": 52.88,
      "text": "fuori proprio le situazioni che dovremmo\ncomprendere."
    }
  ]
}
