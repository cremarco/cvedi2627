  "cues": [
    {
      "start": 0.34,
      "end": 4.4,
      "text": "Partiamo da un elenco delle attività che\nle persone devono poter svolgere."
    },
    {
      "start": 4.4,
      "end": 9.08,
      "text": "Nel caso dell’accesso, la slide distingue\ncreazione dell’account, ingresso con"
    },
    {
      "start": 9.08,
      "end": 13.8,
      "text": "credenziali esistenti e recupero delle\ninformazioni dimenticate."
    },
    {
      "start": 13.8,
      "end": 18.8,
      "text": "Separare i compiti aiuta a non concentrare\ntutta la prova sul percorso più semplice."
    },
    {
      "start": 18.8,
      "end": 22.98,
      "text": "Un accesso riuscito non ci dice se il\nrecupero funziona o se la persona sa"
    },
    {
      "start": 22.98,
      "end": 25.6,
      "text": "riconoscere un messaggio di errore."
    },
    {
      "start": 25.6,
      "end": 29.38,
      "text": "L’ultima attività dell’esempio riguarda\nuna domanda di sicurezza presente nel"
    },
    {
      "start": 29.38,
      "end": 33.8,
      "text": "materiale storico. Possiamo leggerla come\nun caso di modifica di un’impostazione,"
    },
    {
      "start": 34.44,
      "end": 37.22,
      "text": "senza assumerla come indicazione per\nprogettare oggi l’autenticazione."
    },
    {
      "start": 38.94,
      "end": 41.92,
      "text": "Per Passo costruiremmo un elenco coerente\ncon il servizio:"
    },
    {
      "start": 43.06,
      "end": 46.4,
      "text": "confrontare una visita, controllare i\ndati, inviare la richiesta,"
    },
    {
      "start": 46.98,
      "end": 49.12,
      "text": "comprenderne lo stato e trovare come\nmodificarla."
    },
    {
      "start": 50.16,
      "end": 53.92,
      "text": "Sceglieremo poi le attività che rispondono\nalle domande del ciclo corrente."
    }
  ]
}
