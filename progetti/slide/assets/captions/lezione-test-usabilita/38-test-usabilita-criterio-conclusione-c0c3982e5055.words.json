  "cues": [
    {
      "start": 0.24,
      "end": 3.52,
      "text": "Con Shneiderman aggiungiamo una domanda\nsulla conclusione delle sequenze."
    },
    {
      "start": 4.54,
      "end": 8.76,
      "text": "Quando un gruppo di azioni termina, il\nsistema dovrebbe rendere comprensibile che"
    },
    {
      "start": 8.76,
      "end": 11.1,
      "text": "cosa è stato completato e quale fase\ncomincia."
    },
    {
      "start": 12.34,
      "end": 15.32,
      "text": "Nel caso Passo distinguiamo tre momenti."
    },
    {
      "start": 15.32,
      "end": 18.56,
      "text": "Viola invia la richiesta per una visita\nscelta."
    },
    {
      "start": 18.56,
      "end": 21.64,
      "text": "Il servizio la riceve e attende la\nrisposta del professionista."
    },
    {
      "start": 22.62,
      "end": 25.6,
      "text": "La visita risulta confermata quando il\nprofessionista accetta."
    },
    {
      "start": 26.6,
      "end": 30.1,
      "text": "La conclusione dell’invio apre dunque una\nfase di attesa."
    },
    {
      "start": 30.56,
      "end": 34.14,
      "text": "Se mostriamo una conferma generica,\npotremmo far interpretare il primo"
    },
    {
      "start": 34.14,
      "end": 37.08,
      "text": "risultato come se fosse già il terzo."
    },
    {
      "start": 37.08,
      "end": 40.3,
      "text": "Anche un flusso privo di errori tecnici\npuò quindi produrre un equivoco"
    },
    {
      "start": 40.3,
      "end": 45.72,
      "text": "importante. Nell’ispezione guarderemo il\nmessaggio finale, il riepilogo e le azioni"
    },
    {
      "start": 45.72,
      "end": 46.42,
      "text": "disponibili."
    },
    {
      "start": 47.02,
      "end": 51.62,
      "text": "Nel test lasceremo che la persona completi\nil compito, poi potremo chiedere: «Che"
    },
    {
      "start": 51.62,
      "end": 54.16,
      "text": "cosa pensi che succederà adesso?»."
    },
    {
      "start": 54.22,
      "end": 58.4,
      "text": "Evitiamo di inserire nella domanda la\ndistinzione che vogliamo osservare."
    },
    {
      "start": 58.4,
      "end": 63.08,
      "text": "Annoteremo separatamente l’esito\ndell’invio e la comprensione dello stato."
    },
    {
      "start": 63.08,
      "end": 66.56,
      "text": "Se la richiesta è corretta ma la persona\ncrede che il professionista abbia già"
    },
    {
      "start": 66.56,
      "end": 69.18,
      "text": "accettato, abbiamo due informazioni da\nconservare."
    },
    {
      "start": 70.16,
      "end": 73.78,
      "text": "La modifica dovrà rendere chiaro il\nrisultato raggiunto e lasciare"
    },
    {
      "start": 73.78,
      "end": 76.02,
      "text": "riconoscibile il passo ancora necessario."
    }
  ]
}
