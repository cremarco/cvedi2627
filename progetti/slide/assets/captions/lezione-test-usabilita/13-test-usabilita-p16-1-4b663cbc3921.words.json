  "cues": [
    {
      "start": 0.16,
      "end": 4.28,
      "text": "I significanti sono gli indizi che ci\naiutano a capire dove e come agire."
    },
    {
      "start": 4.94,
      "end": 10.14,
      "text": "Nel caso di una porta, un maniglione\norizzontale può suggerire la spinta."
    },
    {
      "start": 10.14,
      "end": 14.1,
      "text": "Il segnale lavora attraverso forma,\nposizione e convenzioni apprese."
    },
    {
      "start": 15.54,
      "end": 18.4,
      "text": "Nelle interfacce anche le parole svolgono\nquesta funzione."
    },
    {
      "start": 19.02,
      "end": 23.96,
      "text": "Un’etichetta come «Invia richiesta»\nanticipa un risultato diverso da «Conferma"
    },
    {
      "start": 23.96,
      "end": 24.66,
      "text": "visita»."
    },
    {
      "start": 25.6,
      "end": 30.18,
      "text": "La differenza deve corrispondere al\ncomportamento effettivo del sistema."
    },
    {
      "start": 30.18,
      "end": 34.9,
      "text": "Le icone possono contribuire, ma la loro\ninterpretazione dipende dall’esperienza e"
    },
    {
      "start": 34.9,
      "end": 39.7,
      "text": "dal contesto. Una forma familiare a chi\nprogetta potrebbe essere ambigua per altre"
    },
    {
      "start": 39.7,
      "end": 44.74,
      "text": "persone. Quando l’azione è importante,\naffiancare una parola può chiarirne il"
    },
    {
      "start": 44.74,
      "end": 45.44,
      "text": "significato."
    },
    {
      "start": 46.48,
      "end": 50.56,
      "text": "Il criterio è chiedersi quali informazioni\nsono disponibili prima di agire."
    },
    {
      "start": 51.24,
      "end": 55.64,
      "text": "Il partecipante dovrebbe poter costruire\nun’aspettativa ragionevole senza dover"
    },
    {
      "start": 55.9,
      "end": 57.16,
      "text": "provare ogni comando alla cieca."
    }
  ]
}
