  "cues": [
    {
      "start": 0.42,
      "end": 4.8,
      "text": "Riconoscere un’informazione già visibile\npuò richiedere meno lavoro che recuperarla"
    },
    {
      "start": 4.8,
      "end": 10.04,
      "text": "dalla memoria. Nell’esempio, il menu dei\ndocumenti recenti permette di ritrovare un"
    },
    {
      "start": 10.04,
      "end": 12.48,
      "text": "file attraverso il nome e il contesto\nd’uso,"
    },
    {
      "start": 13.16,
      "end": 15.78,
      "text": "senza ricordarne il percorso completo."
    },
    {
      "start": 15.78,
      "end": 20.04,
      "text": "Lo stesso principio riguarda le\ninformazioni distribuite in un flusso."
    },
    {
      "start": 20.06,
      "end": 23.26,
      "text": "Se confronto due visite, avere disponibili\norario,"
    },
    {
      "start": 23.78,
      "end": 27.9,
      "text": "copertura e costo mi evita di memorizzare\ni dati della prima mentre guardo la"
    },
    {
      "start": 27.9,
      "end": 28.6,
      "text": "seconda."
    },
    {
      "start": 29.08,
      "end": 33.66,
      "text": "Rendere tutto visibile contemporaneamente\npuò però creare confusione."
    },
    {
      "start": 33.66,
      "end": 37.8,
      "text": "Dobbiamo scegliere quali informazioni\nservono nella decisione corrente e come"
    },
    {
      "start": 37.8,
      "end": 38.5,
      "text": "raggrupparle."
    },
    {
      "start": 39.22,
      "end": 44.22,
      "text": "Nel test annotiamo i ritorni necessari a\nrecuperare dati, le richieste di conferma"
    },
    {
      "start": 44.22,
      "end": 46.06,
      "text": "e gli eventuali appunti presi dalla\npersona."
    },
    {
      "start": 47.1,
      "end": 51.08,
      "text": "Questi episodi possono indicarci dove il\npercorso sta chiedendo alla memoria un"
    },
    {
      "start": 51.08,
      "end": 51.78,
      "text": "lavoro evitabile."
    }
  ]
}
