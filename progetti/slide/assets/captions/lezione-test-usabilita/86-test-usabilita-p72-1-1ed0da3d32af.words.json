  "cues": [
    {
      "start": 0.14,
      "end": 3.14,
      "text": "I compiti dipendono anche da ciò che è\npronto."
    },
    {
      "start": 3.14,
      "end": 7.22,
      "text": "Con una bozza possiamo chiedere che cosa\nviene compreso, quali informazioni si"
    },
    {
      "start": 7.22,
      "end": 12.74,
      "text": "cercano e da dove si comincerebbe. Il\ngiudizio su una schermata è però diverso"
    },
    {
      "start": 12.74,
      "end": 16.72,
      "text": "dalla prova di un flusso. Per studiare se\nuna persona riesce a inviare una"
    },
    {
      "start": 16.72,
      "end": 20.98,
      "text": "richiesta, il materiale deve permettere di\narrivare a un esito."
    },
    {
      "start": 21.12,
      "end": 25.16,
      "text": "Definiamo prima la domanda e poi scegliamo\nun compito che il prototipo possa"
    },
    {
      "start": 25.16,
      "end": 26.1,
      "text": "effettivamente sostenere."
    }
  ]
