  "cues": [
    {
      "start": 0.22,
      "end": 4.28,
      "text": "Abbiamo usato i principi per esaminare il\nprogetto e individuare possibili"
    },
    {
      "start": 4.28,
      "end": 9.5,
      "text": "criticità. Questo lavoro è una valutazione\ndell’interfaccia condotta attraverso"
    },
    {
      "start": 9.62,
      "end": 10.32,
      "text": "criteri espliciti."
    },
    {
      "start": 12.06,
      "end": 15.08,
      "text": "La prova con utenti introduce un’altra\nfonte di conoscenza:"
    },
    {
      "start": 16.1,
      "end": 19.9,
      "text": "ciò che le persone fanno affrontando un\ncompito."
    },
    {
      "start": 19.9,
      "end": 21.98,
      "text": "I due metodi possono alimentarsi a\nvicenda."
    },
    {
      "start": 22.84,
      "end": 27.3,
      "text": "Se nell’ispezione rilevo una conferma\nambigua, formulo una domanda di ricerca"
    },
    {
      "start": 27.3,
      "end": 30.5,
      "text": "sulla comprensione dello stato."
    },
    {
      "start": 30.5,
      "end": 34.38,
      "text": "Durante il test osservo il percorso e\nraccolgo l’interpretazione del"
    },
    {
      "start": 34.38,
      "end": 37.6,
      "text": "partecipante. Potrei ritrovare il problema\nprevisto,"
    },
    {
      "start": 38.12,
      "end": 41.48,
      "text": "scoprirne una causa diversa o incontrare\nun ostacolo inatteso."
    },
    {
      "start": 43.24,
      "end": 45.86,
      "text": "Su Passo, dopo l’invio, potremmo chiedere:"
    },
    {
      "start": 46.38,
      "end": 48.34,
      "text": "«Che cosa pensi che succederà alla tua\nrichiesta?»."
    },
    {
      "start": 49.32,
      "end": 50.94,
      "text": "La domanda lascia aperta la risposta."
    },
    {
      "start": 52.72,
      "end": 54.6,
      "text": "Dire «Hai capito che non è ancora"
    },
    {
      "start": 55.42,
      "end": 58.4,
      "text": "confermata?» introdurrebbe invece\nl’informazione che volevamo verificare."
    },
    {
      "start": 60.06,
      "end": 62.06,
      "text": "L’ispezione ci permette di motivare"
    },
    {
      "start": 63.0,
      "end": 66.38,
      "text": "un’ipotesi; il test aggiunge episodi\nosservabili."
    },
    {
      "start": 66.38,
      "end": 70.52,
      "text": "Quando analizziamo i risultati, teniamo\ndistinta la previsione da ciò che è"
    },
    {
      "start": 70.66,
      "end": 71.36,
      "text": "effettivamente successo."
    },
    {
      "start": 73.16,
      "end": 77.74,
      "text": "Anche una criticità non incontrata nella\nsessione rimane una questione da valutare"
    },
    {
      "start": 77.74,
      "end": 80.7,
      "text": "rispetto a persone, compiti e condizioni\nesplorate."
    }
  ]
}
