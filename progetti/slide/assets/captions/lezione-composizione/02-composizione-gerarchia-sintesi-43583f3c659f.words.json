  "cues": [
    {
      "start": 0.2,
      "end": 5.36,
      "text": "La composizione organizza gli elementi per\nrendere chiara la funzione di ciascuno."
    },
    {
      "start": 5.36,
      "end": 9.72,
      "text": "Un titolo, una fotografia e un comando\ncontribuiscono in modi diversi al"
    },
    {
      "start": 9.72,
      "end": 10.42,
      "text": "messaggio complessivo."
    },
    {
      "start": 11.5,
      "end": 15.92,
      "text": "Possiamo farli collaborare affinché una\npersona riconosca l'argomento, trovi una"
    },
    {
      "start": 15.92,
      "end": 17.66,
      "text": "condizione e capisca come procedere."
    },
    {
      "start": 18.58,
      "end": 22.28,
      "text": "La gerarchia è la proposta di priorità che\nemerge da queste relazioni."
    },
    {
      "start": 23.16,
      "end": 25.72,
      "text": "Non coincide con una sequenza obbligatoria\ndi sguardi."
    },
    {
      "start": 26.38,
      "end": 30.68,
      "text": "Chi conosce già un'attività può cercare\ndirettamente l'orario; chi la incontra per"
    },
    {
      "start": 30.68,
      "end": 33.86,
      "text": "la prima volta deve capire di che cosa si\ntratta."
    },
    {
      "start": 33.86,
      "end": 36.56,
      "text": "Progettare significa sostenere entrambe le\nconsultazioni."
    },
    {
      "start": 37.7,
      "end": 42.62,
      "text": "Terremo quindi collegati tre passaggi:\nformulare il compito, scegliere relazioni"
    },
    {
      "start": 42.62,
      "end": 45.32,
      "text": "visive coerenti e osservare se aiutano\ndavvero."
    },
    {
      "start": 46.04,
      "end": 49.68,
      "text": "I principi già studiati diventano\nstrumenti utili per motivare queste"
    },
    {
      "start": 49.68,
      "end": 50.4,
      "text": "scelte."
    }
  ]
}
