  "cues": [
    {
      "start": 0.24,
      "end": 4.56,
      "text": "Il pattern a effe descrive un andamento\napprossimativo osservato in alcune"
    },
    {
      "start": 4.56,
      "end": 7.98,
      "text": "condizioni di esplorazione dei contenuti\nweb."
    },
    {
      "start": 7.98,
      "end": 12.52,
      "text": "Una prima fascia orizzontale, una seconda\npiù breve e una discesa lungo il margine"
    },
    {
      "start": 12.7,
      "end": 15.08,
      "text": "iniziale del testo possono ricordare\nquella lettera."
    },
    {
      "start": 15.96,
      "end": 20.5,
      "text": "Non equivale alla lettura di ogni riga e\nnon descrive automaticamente l'intera"
    },
    {
      "start": 20.5,
      "end": 24.92,
      "text": "pagina. La struttura del contenuto e il\ncompito modificano il comportamento."
    },
    {
      "start": 26.16,
      "end": 29.56,
      "text": "Titoli descrittivi, informazioni\nanticipate e paragrafi"
    },
    {
      "start": 30.08,
      "end": 33.84,
      "text": "riconoscibili possono aiutare a trovare\nciò che serve senza affidarsi a un solo"
    },
    {
      "start": 33.84,
      "end": 38.08,
      "text": "schema. La distinzione rispetto alla zeta\nè importante."
    },
    {
      "start": 38.08,
      "end": 42.46,
      "text": "La zeta può essere usata come proposta\ncompositiva; la effe proviene da"
    },
    {
      "start": 42.46,
      "end": 44.02,
      "text": "osservazioni in condizioni specifiche."
    },
    {
      "start": 45.26,
      "end": 49.22,
      "text": "Nessuna delle due sostituisce la verifica\ndi una pagina concreta."
    },
    {
      "start": 49.22,
      "end": 53.24,
      "text": "Prima di applicare lo schema al nostro\ninvito, domandiamoci quali contenuti la"
    },
    {
      "start": 53.24,
      "end": 58.14,
      "text": "persona cerchi e quale prova possa\nmostrare se li trova, li comprende e può"
    },
    {
      "start": 58.14,
      "end": 58.84,
      "text": "procedere."
    }
  ]
}
