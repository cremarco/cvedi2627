  "cues": [
    {
      "start": 0.22,
      "end": 3.8,
      "text": "Le schermate storiche mostrano due modi di\ncostruire una comunicazione."
    },
    {
      "start": 5.16,
      "end": 7.18,
      "text": "Allbirds mette in scena prodotto,"
    },
    {
      "start": 7.7,
      "end": 9.78,
      "text": "persone e ambiente attraverso la\nfotografia."
    },
    {
      "start": 10.58,
      "end": 15.58,
      "text": "Headspace usa personaggi e situazioni\nillustrati, con una famiglia coerente di"
    },
    {
      "start": 15.58,
      "end": 16.56,
      "text": "forme e colori."
    },
    {
      "start": 17.14,
      "end": 21.2,
      "text": "Non dobbiamo concludere che la fotografia\ngarantisca autenticità o che"
    },
    {
      "start": 21.2,
      "end": 24.42,
      "text": "l'illustrazione sia sempre più semplice da\ncapire."
    },
    {
      "start": 24.42,
      "end": 28.8,
      "text": "Una foto può essere costruita e un disegno\npuò descrivere accuratamente una"
    },
    {
      "start": 28.8,
      "end": 34.52,
      "text": "struttura. Confrontiamo invece pertinenza,\ndettaglio, disponibilità dei soggetti e"
    },
    {
      "start": 34.52,
      "end": 39.5,
      "text": "leggibilità nella composizione. Per il\nlaboratorio potremmo mostrare un risultato"
    },
    {
      "start": 39.52,
      "end": 42.42,
      "text": "fotografico reale oppure illustrare un\nprocedimento."
    },
    {
      "start": 43.38,
      "end": 47.14,
      "text": "Sono funzioni differenti. Prima scegliamo\nquale informazione"
    },
    {
      "start": 47.78,
      "end": 49.12,
      "text": "serve; poi valutiamo il mezzo."
    },
    {
      "start": 49.78,
      "end": 53.58,
      "text": "Le schermate sono state raccolte in\npassato e i siti potrebbero essere"
    },
    {
      "start": 53.58,
      "end": 58.1,
      "text": "cambiati. Analizziamo quindi le scelte\nvisive che vediamo in queste immagini,"
    },
    {
      "start": 58.52,
      "end": 61.06,
      "text": "senza presumere che le aziende le adottino\nancora oggi."
    }
  ]
}
