  "cues": [
    {
      "start": 0.28,
      "end": 5.72,
      "text": "Una differenza visiva diventa utile quando\ncorrisponde a una differenza di funzione."
    },
    {
      "start": 5.72,
      "end": 9.42,
      "text": "Nell'invito distinguiamo il nome\ndell'attività dalle condizioni di"
    },
    {
      "start": 9.42,
      "end": 10.88,
      "text": "partecipazione e dal comando."
    },
    {
      "start": 11.84,
      "end": 15.36,
      "text": "Per Sara distinguiamo i dati della visita\ndalle azioni possibili."
    },
    {
      "start": 16.4,
      "end": 21.02,
      "text": "Se usiamo lo stesso colore acceso per il\ncomando principale, tre promozioni e un"
    },
    {
      "start": 21.02,
      "end": 23.94,
      "text": "avviso secondario, il segnale perde\nselettività."
    },
    {
      "start": 24.68,
      "end": 28.72,
      "text": "Se invece un trattamento ritorna sempre\nper lo stesso ruolo, la persona può"
    },
    {
      "start": 28.72,
      "end": 29.58,
      "text": "imparare a riconoscerlo."
    },
    {
      "start": 30.8,
      "end": 34.5,
      "text": "Anche distanza e posizione possono\ndistinguere informazioni che hanno lo"
    },
    {
      "start": 34.5,
      "end": 38.76,
      "text": "stesso corpo tipografico. Non vogliamo\nperò rendere invisibile ciò che"
    },
    {
      "start": 38.76,
      "end": 44.4,
      "text": "consideriamo secondario. Un indirizzo, una\ncondizione o la possibilità di annullare"
    },
    {
      "start": 44.52,
      "end": 47.6,
      "text": "possono essere essenziali per alcune\npersone."
    },
    {
      "start": 47.6,
      "end": 52.38,
      "text": "Assegnare priorità significa costruire\nrelazioni comprensibili e conservare le"
    },
    {
      "start": 52.38,
      "end": 53.24,
      "text": "alternative necessarie."
    },
    {
      "start": 54.38,
      "end": 58.66,
      "text": "Questa distinzione ci guiderà sia negli\nesempi espressivi sia nei controlli di"
    },
    {
      "start": 58.66,
      "end": 59.52,
      "text": "interfaccia."
    }
  ]
}
