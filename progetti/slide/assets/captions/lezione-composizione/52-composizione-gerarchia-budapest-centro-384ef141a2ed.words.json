  "cues": [
    {
      "start": 0.18,
      "end": 4.72,
      "text": "Nel fotogramma di The Grand Budapest Hotel\nseguite la balaustra e cercate il centro"
    },
    {
      "start": 4.72,
      "end": 9.42,
      "text": "del campo. Le figure principali sono\nraccolte in quella zona, mentre quelle"
    },
    {
      "start": 9.42,
      "end": 12.16,
      "text": "laterali costruiscono corrispondenze."
    },
    {
      "start": 12.16,
      "end": 15.74,
      "text": "La simmetria offre una struttura\nriconoscibile entro cui possiamo"
    },
    {
      "start": 15.74,
      "end": 17.94,
      "text": "confrontare posture e presenze diverse."
    },
    {
      "start": 18.84,
      "end": 21.36,
      "text": "Facciamo una piccola analisi guidata."
    },
    {
      "start": 21.36,
      "end": 25.96,
      "text": "Prima descrivete una corrispondenza\nvisibile; poi indicate una differenza fra"
    },
    {
      "start": 25.96,
      "end": 30.42,
      "text": "i due lati. Un'organizzazione simmetrica\nnon richiede che ogni dettaglio sia"
    },
    {
      "start": 30.42,
      "end": 31.12,
      "text": "identico."
    },
    {
      "start": 31.7,
      "end": 35.64,
      "text": "Proprio il riferimento comune può rendere\npiù evidente uno scarto o una figura"
    },
    {
      "start": 35.64,
      "end": 39.06,
      "text": "particolare. Qui stiamo studiando un\nfotogramma."
    },
    {
      "start": 39.06,
      "end": 43.58,
      "text": "Il film aggiunge durata, montaggio, suono\ne azioni, che contribuiscono"
    },
    {
      "start": 43.58,
      "end": 45.14,
      "text": "all'interpretazione della sequenza."
    },
    {
      "start": 45.9,
      "end": 50.0,
      "text": "Per la nostra pagina trasferiamo una\ndomanda circoscritta: vogliamo rendere"
    },
    {
      "start": 50.0,
      "end": 54.44,
      "text": "confrontabili elementi di pari ruolo\noppure distinguere una priorità?"
    },
    {
      "start": 54.5,
      "end": 58.78,
      "text": "La risposta ci aiuta a scegliere fra\ncorrispondenza e differenza di peso, come"
    },
    {
      "start": 58.78,
      "end": 60.46,
      "text": "vedremo anche nel prossimo campo."
    }
  ]
}
