  "cues": [
    {
      "start": 0.34,
      "end": 4.84,
      "text": "Raccogliamo le analisi in tre domande, da\nusare anche nel laboratorio."
    },
    {
      "start": 4.84,
      "end": 7.02,
      "text": "Prima: che cosa posso indicare\nnell'immagine?"
    },
    {
      "start": 8.04,
      "end": 13.82,
      "text": "Un asse, una differenza di scala, un\ncontorno condiviso o una zona libera."
    },
    {
      "start": 13.82,
      "end": 15.84,
      "text": "Seconda: che relazione costruisce?"
    },
    {
      "start": 16.74,
      "end": 17.66,
      "text": "Un confronto fra figure,"
    },
    {
      "start": 18.38,
      "end": 20.84,
      "text": "una separazione fra dati, un richiamo al\nsoggetto."
    },
    {
      "start": 21.98,
      "end": 24.72,
      "text": "Terza: quale scelta potrei provare nella\nmia pagina?"
    },
    {
      "start": 25.64,
      "end": 26.4,
      "text": "Prendiamo l'ultima scena."
    },
    {
      "start": 27.32,
      "end": 30.06,
      "text": "Abbiamo osservato personaggi piccoli\nrispetto alla"
    },
    {
      "start": 30.6,
      "end": 34.92,
      "text": "sala; possiamo quindi ragionare sul\nrapporto fra soggetto e ambiente."
    },
    {
      "start": 34.92,
      "end": 38.8,
      "text": "Nell'invito potremmo lasciare alla\nfotografia uno spazio ampio per comunicare"
    },
    {
      "start": 38.8,
      "end": 42.7,
      "text": "l'esperienza, conservando un campo\nleggibile per i dati."
    },
    {
      "start": 42.7,
      "end": 44.8,
      "text": "È una proposta da verificare con il nostro\ncontenuto."
    },
    {
      "start": 45.86,
      "end": 48.46,
      "text": "Questo passaggio rende utilizzabile il\nrepertorio raccolto."
    },
    {
      "start": 49.44,
      "end": 53.08,
      "text": "Un riferimento visivo ci aiuta quando\nsappiamo nominare la proprietà che"
    },
    {
      "start": 53.08,
      "end": 56.02,
      "text": "interessa, oltre al suo stile complessivo."
    },
    {
      "start": 56.1,
      "end": 59.96,
      "text": "Ora lo colleghiamo a un'idea guida e a una\nraccolta di riferimenti, prima di"
    },
    {
      "start": 59.96,
      "end": 61.48,
      "text": "costruire una variazione confrontabile."
    }
  ]
}
