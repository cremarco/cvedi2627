  "cues": [
    {
      "start": 0.24,
      "end": 1.34,
      "text": "Una griglia regolare,"
    },
    {
      "start": 1.94,
      "end": 6.54,
      "text": "un carattere leggibile e colori coerenti\nsono un buon punto di partenza."
    },
    {
      "start": 6.54,
      "end": 11.6,
      "text": "Resta però una domanda: la persona capisce\nche cosa sta guardando e trova quello che"
    },
    {
      "start": 11.6,
      "end": 12.3,
      "text": "le serve?"
    },
    {
      "start": 13.0,
      "end": 17.2,
      "text": "Questa lezione riguarda il rapporto fra le\nparti di una composizione e il messaggio"
    },
    {
      "start": 17.2,
      "end": 21.96,
      "text": "che rendono disponibile. Partiremo da un\ninvito a un laboratorio e torneremo più"
    },
    {
      "start": 21.96,
      "end": 26.68,
      "text": "volte sullo stesso contenuto. Lo\nconfronteremo con immagini, manifesti,"
    },
    {
      "start": 26.68,
      "end": 28.06,
      "text": "scene di film e interfacce."
    },
    {
      "start": 28.7,
      "end": 33.06,
      "text": "Il nostro criterio sarà sempre concreto:\nquale relazione vogliamo rendere"
    },
    {
      "start": 33.06,
      "end": 35.58,
      "text": "riconoscibile, per chi e in quale\nsituazione?"
    },
    {
      "start": 36.62,
      "end": 40.58,
      "text": "Vedremo come confrontare una versione\niniziale con una variazione e come"
    },
    {
      "start": 40.58,
      "end": 42.14,
      "text": "formulare una prova con un compito."
    }
  ]
}
