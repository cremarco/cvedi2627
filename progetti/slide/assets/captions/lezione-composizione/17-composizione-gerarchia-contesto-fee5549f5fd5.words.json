  "cues": [
    {
      "start": 0.08,
      "end": 4.44,
      "text": "Osserviamo separatamente il Bacio\ndell'Hôtel de Ville di Robert Doisneau e"
    },
    {
      "start": 4.48,
      "end": 10.28,
      "text": "Tank Man di Jeff Widener. Possiamo\ndescrivere figure, posizioni, direzioni"
    },
    {
      "start": 10.28,
      "end": 15.76,
      "text": "e rapporti con lo sfondo. Per collocare\nquelle immagini in una situazione storica"
    },
    {
      "start": 15.8,
      "end": 17.74,
      "text": "servono però informazioni ulteriori."
    },
    {
      "start": 18.76,
      "end": 23.78,
      "text": "Una didascalia identifica autore, data e\ncircostanza e rende più precisa"
    },
    {
      "start": 23.78,
      "end": 28.4,
      "text": "l'interpretazione. Non vediamo\ndirettamente l'intenzione di tutte le"
    },
    {
      "start": 28.5,
      "end": 29.2,
      "text": "persone rappresentate."
    },
    {
      "start": 30.4,
      "end": 32.78,
      "text": "Un sorriso non prova la soddisfazione per\nun"
    },
    {
      "start": 33.58,
      "end": 37.7,
      "text": "servizio; un gruppo di persone non\ndimostra da solo un consenso."
    },
    {
      "start": 37.7,
      "end": 42.28,
      "text": "Nel progetto digitale questa distinzione\nevita di usare una fotografia come prova"
    },
    {
      "start": 42.28,
      "end": 43.96,
      "text": "di ciò che il testo vorrebbe affermare."
    },
    {
      "start": 45.02,
      "end": 49.66,
      "text": "Chiediamoci quali dettagli siano visibili\ne quali conclusioni dipendano invece dalla"
    },
    {
      "start": 49.66,
      "end": 50.36,
      "text": "cornice informativa."
    },
    {
      "start": 51.84,
      "end": 53.34,
      "text": "Immagine e parole possono rafforzarsi,"
    },
    {
      "start": 54.46,
      "end": 56.44,
      "text": "ma devono farlo attraverso relazioni\ngiustificabili."
    },
    {
      "start": 57.98,
      "end": 59.42,
      "text": "L'osservazione è il primo"
    },
    {
      "start": 60.28,
      "end": 64.06,
      "text": "passaggio; l'interpretazione va collegata\nal contesto e alle fonti disponibili."
    }
  ]
}
