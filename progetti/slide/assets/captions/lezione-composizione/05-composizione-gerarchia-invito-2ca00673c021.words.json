  "cues": [
    {
      "start": 0.34,
      "end": 3.18,
      "text": "Guardate le tre versioni dell'invito."
    },
    {
      "start": 3.18,
      "end": 6.0,
      "text": "La prima presenta informazioni con un peso\npiuttosto simile:"
    },
    {
      "start": 7.02,
      "end": 12.02,
      "text": "attività, giorno, orario e luogo\nrichiedono un lavoro di associazione."
    },
    {
      "start": 12.08,
      "end": 17.52,
      "text": "Nella seconda il titolo identifica il\nlaboratorio, data e orario stanno insieme,"
    },
    {
      "start": 17.58,
      "end": 20.54,
      "text": "nome e indirizzo formano il gruppo del\nluogo."
    },
    {
      "start": 20.62,
      "end": 23.44,
      "text": "La terza aggiunge un comando riconoscibile\nper l'iscrizione."
    },
    {
      "start": 24.5,
      "end": 28.76,
      "text": "Il contenuto informativo resta quasi\nidentico; cambia il modo in cui le sue"
    },
    {
      "start": 28.76,
      "end": 29.46,
      "text": "parti collaborano."
    },
    {
      "start": 30.38,
      "end": 34.7,
      "text": "Non tutto viene ingrandito. Alcuni\nelementi ricevono rilievo, altri"
    },
    {
      "start": 34.7,
      "end": 39.26,
      "text": "costruiscono un gruppo, altri mantengono\nuna funzione di supporto."
    },
    {
      "start": 39.26,
      "end": 41.84,
      "text": "Provate a cercare prima l'orario e poi il\nluogo."
    },
    {
      "start": 42.54,
      "end": 46.46,
      "text": "Sono due modi di consultare lo stesso\ninvito: cercare quando si svolge"
    },
    {
      "start": 46.46,
      "end": 51.08,
      "text": "l'attività oppure dove si tiene. La\ncomposizione deve consentirli entrambi,"
    },
    {
      "start": 51.52,
      "end": 55.32,
      "text": "senza pretendere che ogni persona legga\ntutti i blocchi nella stessa sequenza."
    },
    {
      "start": 56.04,
      "end": 60.54,
      "text": "Questo confronto tornerà nella verifica\nfinale: sapremo che cosa abbiamo cambiato"
    },
    {
      "start": 60.54,
      "end": 61.94,
      "text": "e potremo discuterne l'effetto."
    }
  ]
}
