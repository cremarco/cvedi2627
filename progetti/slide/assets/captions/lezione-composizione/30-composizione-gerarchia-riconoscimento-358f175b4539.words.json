  "cues": [
    {
      "start": 0.3,
      "end": 3.2,
      "text": "Fermiamoci sulle venature del legno."
    },
    {
      "start": 3.2,
      "end": 6.08,
      "text": "Quali segni vi fanno riconoscere un volto?"
    },
    {
      "start": 6.08,
      "end": 10.24,
      "text": "Possiamo indicare le due zone che leggiamo\ncome occhi e la linea che interpretiamo"
    },
    {
      "start": 10.24,
      "end": 15.1,
      "text": "come bocca. Non è necessario che ogni\ndettaglio sia presente perché emerga una"
    },
    {
      "start": 15.1,
      "end": 19.66,
      "text": "figura familiare. Chiamiamo pareidolia\nquesto riconoscimento in uno stimolo"
    },
    {
      "start": 19.66,
      "end": 20.36,
      "text": "ambiguo."
    },
    {
      "start": 20.68,
      "end": 25.08,
      "text": "Il caso ci aiuta a distinguere due\noperazioni: raggruppare elementi nello"
    },
    {
      "start": 25.08,
      "end": 27.2,
      "text": "spazio e attribuire loro un significato."
    },
    {
      "start": 27.96,
      "end": 32.0,
      "text": "La vicinanza può contribuire, ma non\nspiega da sola perché quelle macchie"
    },
    {
      "start": 32.0,
      "end": 33.32,
      "text": "diventino per noi un viso."
    },
    {
      "start": 34.08,
      "end": 38.4,
      "text": "Nell'analisi di un progetto chiediamo\nquindi di nominare gli indizi."
    },
    {
      "start": 38.4,
      "end": 42.92,
      "text": "Dire vedo un volto è diverso da dire\nqueste due macchie simmetriche mi"
    },
    {
      "start": 42.92,
      "end": 43.92,
      "text": "ricordano degli occhi."
    },
    {
      "start": 44.6,
      "end": 47.28,
      "text": "La seconda descrizione rende discutibile\nla lettura."
    },
    {
      "start": 48.12,
      "end": 52.24,
      "text": "Lo stesso esercizio aiuta con un'icona:\nidentifichiamo che cosa viene"
    },
    {
      "start": 52.24,
      "end": 52.94,
      "text": "riconosciuto,"
    },
    {
      "start": 53.6,
      "end": 56.42,
      "text": "poi chiediamo quale azione ci si aspetta."
    },
    {
      "start": 56.42,
      "end": 60.02,
      "text": "Riconoscere un oggetto e comprendere un\ncomando restano passaggi distinti."
    }
  ]
}
