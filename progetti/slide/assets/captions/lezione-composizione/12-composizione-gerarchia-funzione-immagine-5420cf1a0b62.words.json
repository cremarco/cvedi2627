  "cues": [
    {
      "start": 0.26,
      "end": 4.2,
      "text": "Prima di decidere fra fotografia e\nillustrazione, chiediamoci quale"
    },
    {
      "start": 4.2,
      "end": 6.24,
      "text": "informazione debba aggiungere l'immagine."
    },
    {
      "start": 7.52,
      "end": 12.52,
      "text": "In una ricetta può mostrare la consistenza\ndi un impasto; in una scheda prodotto può"
    },
    {
      "start": 12.52,
      "end": 18.5,
      "text": "documentare una finitura; in un invito può\nfar immaginare l'esperienza proposta."
    },
    {
      "start": 18.54,
      "end": 23.66,
      "text": "Distingueremo tre funzioni che possono\nanche coesistere: evocare, descrivere e"
    },
    {
      "start": 23.66,
      "end": 29.3,
      "text": "sintetizzare. La funzione di un'immagine\ndipende da come la usiamo e dal contesto"
    },
    {
      "start": 29.3,
      "end": 30.0,
      "text": "in cui compare."
    },
    {
      "start": 31.12,
      "end": 35.6,
      "text": "La stessa fotografia può essere uno sfondo\natmosferico oppure una prova visiva da"
    },
    {
      "start": 35.6,
      "end": 38.44,
      "text": "osservare accanto a una descrizione."
    },
    {
      "start": 38.44,
      "end": 41.28,
      "text": "Il criterio utile è il rapporto con la\ndomanda del lettore."
    },
    {
      "start": 42.5,
      "end": 46.68,
      "text": "Se la persona deve sapere dove si svolge\nil laboratorio, un'immagine accogliente"
    },
    {
      "start": 46.68,
      "end": 48.82,
      "text": "della sala non sostituisce l'indirizzo."
    },
    {
      "start": 49.94,
      "end": 54.2,
      "text": "Se deve osservare il risultato di una\ntecnica fotografica, un dettaglio ben"
    },
    {
      "start": 54.2,
      "end": 55.56,
      "text": "scelto può essere essenziale."
    },
    {
      "start": 56.92,
      "end": 61.16,
      "text": "Vediamo ora queste differenze in tre\nesempi, mantenendo distinta la funzione"
    },
    {
      "start": 61.16,
      "end": 62.7,
      "text": "dal semplice stile dell'immagine."
    }
  ]
}
