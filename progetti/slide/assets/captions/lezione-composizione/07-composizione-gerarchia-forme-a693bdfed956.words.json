  "cues": [
    {
      "start": 0.3,
      "end": 4.58,
      "text": "Guardate prima le linee rosse che\ndescrivono la costruzione dei marchi."
    },
    {
      "start": 4.58,
      "end": 9.52,
      "text": "Nel gruppo a sinistra possiamo riconoscere\nlati, angoli e diagonali; in quello a"
    },
    {
      "start": 9.52,
      "end": 11.86,
      "text": "destra circonferenze, centri e anelli."
    },
    {
      "start": 12.7,
      "end": 16.28,
      "text": "La geometria ci dà un linguaggio per\ndescrivere rapporti che altrimenti"
    },
    {
      "start": 16.28,
      "end": 19.7,
      "text": "chiameremmo soltanto ordinati o armoniosi."
    },
    {
      "start": 19.7,
      "end": 22.36,
      "text": "Ora confrontate i segni all'interno dello\nstesso gruppo."
    },
    {
      "start": 23.36,
      "end": 26.36,
      "text": "Condividono una struttura, ma restano\nidentità differenti."
    },
    {
      "start": 26.96,
      "end": 32.68,
      "text": "Il nome, il colore, il disegno e gli usi\naccumulati contribuiscono al significato."
    },
    {
      "start": 32.68,
      "end": 36.74,
      "text": "Non possiamo quindi assegnare a ogni\nquadrato stabilità e a ogni cerchio un"
    },
    {
      "start": 36.74,
      "end": 40.68,
      "text": "carattere amichevole: sarebbe una\nscorciatoia che elimina proprio le"
    },
    {
      "start": 40.68,
      "end": 41.46,
      "text": "differenze osservabili."
    },
    {
      "start": 42.46,
      "end": 44.8,
      "text": "Proviamo invece una domanda di progetto."
    },
    {
      "start": 44.8,
      "end": 47.56,
      "text": "Se vogliamo raccogliere più informazioni\nintorno a un centro,"
    },
    {
      "start": 48.1,
      "end": 49.72,
      "text": "quale proprietà del cerchio ci interessa?"
    },
    {
      "start": 50.62,
      "end": 55.3,
      "text": "Se dobbiamo ripetere moduli affiancati,\nquali riferimenti offre il quadrato?"
    },
    {
      "start": 55.56,
      "end": 59.5,
      "text": "Partiamo dalla relazione da costruire; il\nsignificato prenderà forma nella"
    },
    {
      "start": 59.5,
      "end": 60.7,
      "text": "composizione completa."
    }
  ]
}
