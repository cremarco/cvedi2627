  "cues": [
    {
      "start": 0.22,
      "end": 4.42,
      "text": "Lo schema a zeta propone un percorso\norizzontale in alto, un collegamento"
    },
    {
      "start": 4.42,
      "end": 8.46,
      "text": "diagonale e un secondo percorso\norizzontale più in basso."
    },
    {
      "start": 8.46,
      "end": 12.1,
      "text": "Può essere utile per ragionare sulla\ndistribuzione di pochi blocchi, per"
    },
    {
      "start": 12.1,
      "end": 14.9,
      "text": "esempio identità, messaggio e invito\nall'azione."
    },
    {
      "start": 16.0,
      "end": 19.68,
      "text": "La homepage storica di Aesop permette di\ndiscutere quella disposizione."
    },
    {
      "start": 20.64,
      "end": 23.66,
      "text": "L'immagine non registra movimenti oculari."
    },
    {
      "start": 23.66,
      "end": 27.54,
      "text": "Non possiamo presentare le linee dello\nschema come se fossero il percorso"
    },
    {
      "start": 27.84,
      "end": 32.24,
      "text": "effettivo di chi usa la pagina. Il\ncomportamento dipende da contenuto,"
    },
    {
      "start": 32.3,
      "end": 35.12,
      "text": "compito, direzione di lettura e priorità."
    },
    {
      "start": 35.12,
      "end": 38.84,
      "text": "Una persona potrebbe cercare\nimmediatamente una voce di navigazione o"
    },
    {
      "start": 38.84,
      "end": 43.4,
      "text": "un prodotto che conosce. Per l'invito\npossiamo usare la zeta come una possibile"
    },
    {
      "start": 43.4,
      "end": 44.1,
      "text": "organizzazione,"
    },
    {
      "start": 44.9,
      "end": 48.46,
      "text": "poi verificare se data e iscrizione\nvengono trovate."
    },
    {
      "start": 48.46,
      "end": 52.06,
      "text": "Il criterio di qualità resta la\ncomprensione del contenuto pertinente,"
    },
    {
      "start": 52.56,
      "end": 56.1,
      "text": "non quanto la disposizione o lo sguardo\nassomiglino a una lettera."
    }
  ]
}
