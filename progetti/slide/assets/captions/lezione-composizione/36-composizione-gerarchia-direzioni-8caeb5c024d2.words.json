  "cues": [
    {
      "start": 0.24,
      "end": 5.18,
      "text": "Una composizione statica può suggerire una\ndirezione attraverso inclinazioni, punti"
    },
    {
      "start": 5.18,
      "end": 8.1,
      "text": "allineati o forme ripetute."
    },
    {
      "start": 8.1,
      "end": 13.04,
      "text": "Nell'esempio osserviamo come le linee\ninterne colleghino zone differenti."
    },
    {
      "start": 13.04,
      "end": 16.8,
      "text": "Non serve necessariamente disegnare una\nfreccia per rendere percepibile un"
    },
    {
      "start": 16.8,
      "end": 19.58,
      "text": "rapporto. Distinguiamo però tre fenomeni."
    },
    {
      "start": 20.48,
      "end": 24.36,
      "text": "Il primo è la direzione proposta dalla\ncomposizione."
    },
    {
      "start": 24.36,
      "end": 28.62,
      "text": "Il secondo è il percorso effettivo degli\nocchi, che non possiamo ricavare soltanto"
    },
    {
      "start": 28.62,
      "end": 34.08,
      "text": "dall'immagine. Il terzo è un'animazione\nreale, che introduce cambiamenti nel tempo"
    },
    {
      "start": 34.08,
      "end": 37.48,
      "text": "e richiede controlli specifici di\naccessibilità."
    },
    {
      "start": 37.48,
      "end": 42.18,
      "text": "Nel laboratorio una diagonale potrebbe\ncollegare la fotografia al titolo."
    },
    {
      "start": 42.28,
      "end": 45.96,
      "text": "Dovremmo chiederci se facilita\nl'associazione o se attraversa i dati"
    },
    {
      "start": 45.96,
      "end": 51.24,
      "text": "rendendoli meno leggibili. La direzione è\nuna risorsa espressiva da coordinare con"
    },
    {
      "start": 51.24,
      "end": 56.32,
      "text": "il contenuto. Descriverla con precisione\nci permette di discutere l'intenzione"
    },
    {
      "start": 56.32,
      "end": 59.84,
      "text": "senza presentarla come un comportamento\nobbligatorio del lettore."
    }
  ]
}
