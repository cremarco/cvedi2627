  "cues": [
    {
      "start": 0.26,
      "end": 4.9,
      "text": "Passare da un campo orizzontale a uno\nverticale può escludere una persona, una"
    },
    {
      "start": 4.9,
      "end": 6.24,
      "text": "direzione o un indizio."
    },
    {
      "start": 7.24,
      "end": 8.66,
      "text": "Il contenitore resta ordinato,"
    },
    {
      "start": 9.18,
      "end": 13.32,
      "text": "ma l'informazione cambia. Prima di\nscegliere il ritaglio dobbiamo quindi"
    },
    {
      "start": 13.32,
      "end": 17.12,
      "text": "identificare che cosa la persona deve\npoter osservare."
    },
    {
      "start": 17.12,
      "end": 21.82,
      "text": "Una vista generale serve a comprendere le\nproporzioni di un oggetto; un dettaglio"
    },
    {
      "start": 21.82,
      "end": 23.08,
      "text": "può spiegare una finitura."
    },
    {
      "start": 23.92,
      "end": 26.26,
      "text": "La scelta dipende da ciò che il lettore\ndeve capire:"
    },
    {
      "start": 27.08,
      "end": 29.9,
      "text": "usiamo l'inquadratura che mostra meglio\nl'informazione necessaria."
    },
    {
      "start": 30.74,
      "end": 35.08,
      "text": "Nel laboratorio potremmo voler mostrare la\nrelazione fra una fonte luminosa e il"
    },
    {
      "start": 35.08,
      "end": 35.78,
      "text": "soggetto."
    },
    {
      "start": 36.16,
      "end": 40.16,
      "text": "Un taglio che conserva soltanto il\nsoggetto eliminerebbe proprio il rapporto"
    },
    {
      "start": 40.16,
      "end": 45.04,
      "text": "che stiamo spiegando. La stessa verifica\nva ripetuta alle dimensioni d'uso."
    },
    {
      "start": 45.04,
      "end": 48.86,
      "text": "Ridurre l'immagine senza tagliarla\nconserva il campo, ma può rendere il"
    },
    {
      "start": 48.86,
      "end": 54.9,
      "text": "dettaglio troppo piccolo. Il compito è\ncoordinare contenitore, scala e testo."
    },
    {
      "start": 54.92,
      "end": 59.3,
      "text": "Il confronto fra formati deve mantenere\ndisponibile il significato anche quando"
    },
    {
      "start": 59.3,
      "end": 62.96,
      "text": "cambiano disposizione e quantità di spazio\nassegnata alla figura."
    }
  ]
}
