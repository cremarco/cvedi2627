  "cues": [
    {
      "start": 0.24,
      "end": 4.74,
      "text": "Il MoMA Poster Series di Rebecca Nolte è\nun esercizio tipografico sul calendario"
    },
    {
      "start": 4.74,
      "end": 7.78,
      "text": "espositivo, non una commissione ufficiale\ndel museo."
    },
    {
      "start": 8.98,
      "end": 13.6,
      "text": "Osserviamo come dimensioni, pesi e\ndisposizione distinguano le informazioni"
    },
    {
      "start": 13.6,
      "end": 15.38,
      "text": "all'interno della stessa composizione."
    },
    {
      "start": 16.32,
      "end": 20.46,
      "text": "La lezione di tipografia ci ha fornito gli\nstrumenti per scegliere caratteri e"
    },
    {
      "start": 20.46,
      "end": 21.72,
      "text": "costruire leggibilità."
    },
    {
      "start": 22.48,
      "end": 25.32,
      "text": "Qui li confrontiamo con immagini,\ncampiture e spazio."
    },
    {
      "start": 26.28,
      "end": 30.92,
      "text": "Una sola famiglia può offrire differenze\nsufficienti fra titolo, sottotitolo e"
    },
    {
      "start": 30.92,
      "end": 35.76,
      "text": "corpo. Aggiungere continuamente nuovi\nstili può invece rendere più difficile"
    },
    {
      "start": 35.76,
      "end": 40.44,
      "text": "riconoscere i ruoli. Nel laboratorio\npotremmo mantenere una famiglia e variare"
    },
    {
      "start": 40.44,
      "end": 41.96,
      "text": "peso, corpo e distanza."
    },
    {
      "start": 42.94,
      "end": 45.22,
      "text": "La verifica deve includere la\nconsultazione rapida:"
    },
    {
      "start": 45.96,
      "end": 50.22,
      "text": "si riconoscono attività, data e luogo\nanche senza leggere tutte le righe?"
    },
    {
      "start": 50.62,
      "end": 53.44,
      "text": "In un documento digitale aggiungiamo il\nlivello semantico."
    },
    {
      "start": 54.28,
      "end": 58.14,
      "text": "Un titolo deve restare tale anche per chi\nconsulta il contenuto attraverso"
    },
    {
      "start": 58.14,
      "end": 62.96,
      "text": "tecnologie assistive. La gerarchia\nvisibile sostiene la struttura, senza"
    },
    {
      "start": 62.96,
      "end": 64.08,
      "text": "sostituirla."
    }
  ]
}
