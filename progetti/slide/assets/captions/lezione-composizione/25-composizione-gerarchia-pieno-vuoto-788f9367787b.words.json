  "cues": [
    {
      "start": 0.58,
      "end": 6.22,
      "text": "Negative Spaces di Tang Yau Hoong e il\nconcept Spartan Golf mostrano come pieni e"
    },
    {
      "start": 6.22,
      "end": 9.7,
      "text": "vuoti possano partecipare alla figura\nriconosciuta."
    },
    {
      "start": 9.7,
      "end": 13.46,
      "text": "Nel secondo esempio possiamo individuare\nun golfista e un richiamo all'elmo."
    },
    {
      "start": 14.6,
      "end": 18.82,
      "text": "La relazione nasce dall'assegnazione dei\ncontorni alle regioni della composizione."
    },
    {
      "start": 20.14,
      "end": 23.06,
      "text": "Riprendiamo il rapporto figura e sfondo\ngià discusso nella Gestalt."
    },
    {
      "start": 24.14,
      "end": 25.82,
      "text": "Qui aggiungiamo una domanda comunicativa:"
    },
    {
      "start": 26.92,
      "end": 32.22,
      "text": "quali letture vogliamo rendere disponibili\ne quale legame costruiscono fra loro?"
    },
    {
      "start": 32.22,
      "end": 35.94,
      "text": "Riconosciamo il golfista e l'elmo anche\nperché sappiamo già che aspetto hanno."
    },
    {
      "start": 37.04,
      "end": 41.24,
      "text": "Per spiegare queste immagini consideriamo\nquindi sia la familiarità con i soggetti"
    },
    {
      "start": 41.24,
      "end": 43.48,
      "text": "sia il rapporto fra figura e sfondo,"
    },
    {
      "start": 44.26,
      "end": 47.26,
      "text": "senza attribuire tutto al principio di\nchiusura."
    },
    {
      "start": 47.26,
      "end": 51.62,
      "text": "Lo spazio negativo è quello che rimane\nintorno e tra le figure, e può avere"
    },
    {
      "start": 52.06,
      "end": 52.76,
      "text": "qualsiasi colore."
    },
    {
      "start": 53.46,
      "end": 56.18,
      "text": "Anche la sua forma contribuisce a ciò che\nriconosciamo nell'immagine."
    },
    {
      "start": 57.44,
      "end": 61.58,
      "text": "Nell'invito può separare titolo, data e\nluogo, aiutandoci a distinguerli."
    },
    {
      "start": 62.76,
      "end": 67.26,
      "text": "In un marchio, lo spazio lasciato libero\npuò delineare un'altra figura."
    },
    {
      "start": 67.26,
      "end": 69.9,
      "text": "Lasciamo quindi spazio dove aiuta a\nseparare i contenuti,"
    },
    {
      "start": 70.54,
      "end": 74.68,
      "text": "far risaltare un titolo o riconoscere una\nfigura; non occorre aumentarlo ovunque."
    }
  ]
}
