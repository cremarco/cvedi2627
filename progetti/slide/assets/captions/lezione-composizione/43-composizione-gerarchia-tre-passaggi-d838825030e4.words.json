  "cues": [
    {
      "start": 0.3,
      "end": 3.48,
      "text": "Riprendiamo Sara e scomponiamo il compito."
    },
    {
      "start": 3.48,
      "end": 6.7,
      "text": "Prima deve individuare il comando\npertinente."
    },
    {
      "start": 6.7,
      "end": 10.62,
      "text": "Poi deve comprenderlo e distinguerlo dalle\nalternative."
    },
    {
      "start": 10.64,
      "end": 13.96,
      "text": "Infine deve attivarlo con il dispositivo\ndisponibile."
    },
    {
      "start": 13.96,
      "end": 17.26,
      "text": "Un risultato positivo in un passaggio non\ngarantisce gli altri."
    },
    {
      "start": 18.06,
      "end": 21.12,
      "text": "Un pulsante molto contrastato può avere\nun'etichetta ambigua."
    },
    {
      "start": 21.9,
      "end": 25.14,
      "text": "Un comando compreso può avere un'area\nattivabile troppo piccola."
    },
    {
      "start": 25.94,
      "end": 30.1,
      "text": "Una scelta facile può comunque portare\nall'appuntamento sbagliato se i dati di"
    },
    {
      "start": 30.1,
      "end": 31.36,
      "text": "contesto non sono riconoscibili."
    },
    {
      "start": 32.48,
      "end": 35.46,
      "text": "Perciò definiamo verifiche complementari."
    },
    {
      "start": 35.46,
      "end": 38.32,
      "text": "Possiamo chiedere quale controllo permette\ndi spostare la visita,"
    },
    {
      "start": 38.94,
      "end": 42.84,
      "text": "osservare se viene confuso con\nl'annullamento e verificare l'attivazione"
    },
    {
      "start": 42.84,
      "end": 43.54,
      "text": "senza errori."
    },
    {
      "start": 44.16,
      "end": 48.56,
      "text": "I modelli di Hick e Hyman e di Fitts\nriguardano aspetti differenti di questi"
    },
    {
      "start": 48.56,
      "end": 52.24,
      "text": "passaggi. Li useremo come strumenti per\nporre domande precise,"
    },
    {
      "start": 52.86,
      "end": 56.52,
      "text": "mantenendo le condizioni e i limiti dei\ncompiti sperimentali da cui derivano."
    }
  ]
}
