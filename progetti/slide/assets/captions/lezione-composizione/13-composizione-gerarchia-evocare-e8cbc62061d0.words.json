  "cues": [
    {
      "start": 0.32,
      "end": 4.64,
      "text": "Guardate la fotografia del locale prima di\nleggere la didascalia."
    },
    {
      "start": 4.64,
      "end": 9.06,
      "text": "La luce calda, il bancone e i materiali\npermettono di immaginare un ambiente."
    },
    {
      "start": 10.02,
      "end": 11.72,
      "text": "È un esempio di funzione evocativa:"
    },
    {
      "start": 12.56,
      "end": 14.72,
      "text": "l'immagine prepara un'aspettativa\nsull'esperienza,"
    },
    {
      "start": 15.62,
      "end": 18.28,
      "text": "anche quando non stiamo ancora cercando\nun'informazione operativa."
    },
    {
      "start": 19.4,
      "end": 20.56,
      "text": "Facciamo però una prova concreta:"
    },
    {
      "start": 21.32,
      "end": 24.92,
      "text": "da questa sola fotografia riusciremmo a\nsapere a che ora apre il locale?"
    },
    {
      "start": 25.76,
      "end": 29.52,
      "text": "Potremmo descrivere ciò che vediamo,\nmentre per gli orari servirebbe un'altra"
    },
    {
      "start": 29.52,
      "end": 30.22,
      "text": "informazione."
    },
    {
      "start": 31.02,
      "end": 35.54,
      "text": "Il testo può quindi completare l'immagine,\nsenza doverle chiedere di spiegare ogni"
    },
    {
      "start": 35.7,
      "end": 39.8,
      "text": "aspetto del servizio. Nell'invito al\nlaboratorio possiamo adottare lo stesso"
    },
    {
      "start": 39.8,
      "end": 43.9,
      "text": "ragionamento. Una fotografia di ombre e\nriflessi introduce il"
    },
    {
      "start": 44.46,
      "end": 48.54,
      "text": "tema; data e luogo hanno bisogno di una\ncollocazione riconoscibile."
    },
    {
      "start": 48.54,
      "end": 50.38,
      "text": "L'immagine può occupare molto spazio,"
    },
    {
      "start": 50.9,
      "end": 52.68,
      "text": "purché sia chiaro dove trovare i dati."
    },
    {
      "start": 53.24,
      "end": 54.98,
      "text": "La prossima figura cambia funzione:"
    },
    {
      "start": 55.6,
      "end": 59.86,
      "text": "passiamo da una fotografia che suggerisce\nl'atmosfera del locale a immagini che"
    },
    {
      "start": 60.0,
      "end": 61.16,
      "text": "mostrano le pietanze proposte."
    }
  ]
}
