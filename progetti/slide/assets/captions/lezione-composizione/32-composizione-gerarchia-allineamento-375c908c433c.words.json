  "cues": [
    {
      "start": 0.2,
      "end": 4.78,
      "text": "Nella campagna Adidas osservate la colonna\ncentrale delle parole e il suo rapporto"
    },
    {
      "start": 4.78,
      "end": 8.5,
      "text": "con la figura. L'asse comune tiene insieme\nelementi differenti:"
    },
    {
      "start": 9.68,
      "end": 13.78,
      "text": "possiamo descriverne l'allineamento anche\nsenza ricostruire tutta la struttura del"
    },
    {
      "start": 13.78,
      "end": 14.48,
      "text": "manifesto."
    },
    {
      "start": 15.02,
      "end": 19.1,
      "text": "Proviamo mentalmente a spostare una sola\nriga verso un bordo."
    },
    {
      "start": 19.2,
      "end": 22.62,
      "text": "Cambierebbe il rapporto con le altre e\npotrebbe acquistare un rilievo diverso."
    },
    {
      "start": 23.54,
      "end": 27.44,
      "text": "Questo piccolo esercizio mostra che\nl'allineamento non serve soltanto a"
    },
    {
      "start": 27.44,
      "end": 32.94,
      "text": "mettere in ordine: stabilisce appartenenze\ne può rendere significativa un'eccezione."
    },
    {
      "start": 32.94,
      "end": 37.22,
      "text": "Nell'invito usiamo lo stesso criterio con\ncontenuti più operativi."
    },
    {
      "start": 37.22,
      "end": 40.5,
      "text": "Quale bordo collega titolo, data e luogo?"
    },
    {
      "start": 40.5,
      "end": 43.32,
      "text": "Quali intervalli distinguono comunque i\ngruppi?"
    },
    {
      "start": 43.36,
      "end": 47.82,
      "text": "Per un testo lungo, inoltre, un inizio\nriga costante nella direzione di lettura"
    },
    {
      "start": 47.98,
      "end": 50.06,
      "text": "offre un riferimento ripetuto."
    },
    {
      "start": 50.06,
      "end": 54.2,
      "text": "Scegliamo l'asse in funzione di ciò che\ndobbiamo leggere e confrontare."
    },
    {
      "start": 54.2,
      "end": 57.96,
      "text": "Dopo aver guardato il riferimento comune,\npassiamo ora al peso degli elementi:"
    },
    {
      "start": 58.72,
      "end": 62.5,
      "text": "essere al centro e prevalere visivamente\nnon sono la stessa cosa."
    }
  ]
}
