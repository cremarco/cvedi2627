  "cues": [
    {
      "start": 0.18,
      "end": 4.92,
      "text": "Nel manifesto la parola è trattata come\nuna struttura nello spazio."
    },
    {
      "start": 4.94,
      "end": 8.8,
      "text": "Osservate la variazione d'ingombro e le\ndirezioni dei tratti: il campo"
    },
    {
      "start": 8.8,
      "end": 11.06,
      "text": "bidimensionale suggerisce una profondità."
    },
    {
      "start": 11.84,
      "end": 14.74,
      "text": "La tipografia svolge quindi anche una\nfunzione di immagine."
    },
    {
      "start": 15.7,
      "end": 17.7,
      "text": "Richiamiamo un punto della prospettiva\nlineare."
    },
    {
      "start": 18.38,
      "end": 22.28,
      "text": "Le rette parallele della scena che non\nsono parallele al piano dell'immagine"
    },
    {
      "start": 22.28,
      "end": 27.36,
      "text": "convergono verso un punto di fuga comune;\nquelle parallele a quel piano restano"
    },
    {
      "start": 27.72,
      "end": 28.76,
      "text": "parallele nella rappresentazione."
    },
    {
      "start": 29.68,
      "end": 34.74,
      "text": "A parità di dimensioni reali e condizioni\ndi proiezione, un oggetto vicino occupa"
    },
    {
      "start": 34.74,
      "end": 35.84,
      "text": "un'area visiva maggiore."
    },
    {
      "start": 36.72,
      "end": 41.1,
      "text": "Sono rapporti utili per descrivere la\ncostruzione, distinti dalla priorità che"
    },
    {
      "start": 41.1,
      "end": 43.32,
      "text": "il lettore attribuisce ai contenuti."
    },
    {
      "start": 43.32,
      "end": 47.18,
      "text": "Per il laboratorio questa possibilità\npotrebbe servire a mostrare una tecnica"
    },
    {
      "start": 47.18,
      "end": 49.82,
      "text": "fotografica o a costruire il titolo."
    },
    {
      "start": 49.82,
      "end": 53.82,
      "text": "Prima di sceglierla, controlliamo che le\nlettere restino riconoscibili alla scala"
    },
    {
      "start": 53.82,
      "end": 57.92,
      "text": "d'uso. Dalla profondità rappresentata\npassiamo ora a un'altra domanda:"
    },
    {
      "start": 58.62,
      "end": 62.16,
      "text": "che cosa permette a un segnale di\ndistinguersi nel proprio ambiente?"
    }
  ]
}
