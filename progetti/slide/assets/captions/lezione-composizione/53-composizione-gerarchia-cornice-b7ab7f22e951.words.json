  "cues": [
    {
      "start": 0.2,
      "end": 3.26,
      "text": "Nel secondo fotogramma osservate la grata\nprima dei personaggi."
    },
    {
      "start": 4.68,
      "end": 9.48,
      "text": "Le sue linee suddividono il campo e\ncostruiscono una cornice interna: vediamo"
    },
    {
      "start": 9.48,
      "end": 13.34,
      "text": "le figure attraverso una struttura che\nappartiene alla scena."
    },
    {
      "start": 13.34,
      "end": 16.92,
      "text": "Il bordo dell'immagine e quello della\ngrata svolgono ruoli diversi."
    },
    {
      "start": 17.98,
      "end": 21.86,
      "text": "Provate a immaginare un ritaglio che\nconservi soltanto i volti."
    },
    {
      "start": 21.96,
      "end": 25.56,
      "text": "Potremmo riconoscere i soggetti, ma\nperderemmo il loro rapporto con la"
    },
    {
      "start": 25.56,
      "end": 26.26,
      "text": "barriera."
    },
    {
      "start": 26.52,
      "end": 31.66,
      "text": "È una conseguenza informativa del taglio,\noltre a una variazione del formato."
    },
    {
      "start": 31.72,
      "end": 35.68,
      "text": "Porte, finestre e aperture possono\nsvolgere una funzione simile in altre"
    },
    {
      "start": 35.68,
      "end": 36.38,
      "text": "immagini."
    },
    {
      "start": 36.92,
      "end": 40.32,
      "text": "Per il laboratorio questa osservazione\ntorna utile quando scegliamo una"
    },
    {
      "start": 40.32,
      "end": 41.26,
      "text": "fotografia sulla luce."
    },
    {
      "start": 42.2,
      "end": 46.28,
      "text": "Una finestra potrebbe essere parte del\nprocedimento che vogliamo mostrare;"
    },
    {
      "start": 46.28,
      "end": 48.24,
      "text": "eliminarla cambierebbe la spiegazione."
    },
    {
      "start": 49.0,
      "end": 52.56,
      "text": "Prima di riempire il contenitore,\nindichiamo dunque il dettaglio e la"
    },
    {
      "start": 52.56,
      "end": 56.76,
      "text": "relazione da conservare. Nel prossimo\nfotogramma faremo il movimento opposto:"
    },
    {
      "start": 57.72,
      "end": 61.36,
      "text": "dal confine vicino ai soggetti passeremo\nall'ampiezza dell'ambiente che li"
    },
    {
      "start": 61.36,
      "end": 62.06,
      "text": "circonda."
    }
  ]
}
