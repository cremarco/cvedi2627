  "cues": [
    {
      "start": 0.22,
      "end": 4.38,
      "text": "Prendiamo il riferimento della luce\ncontrastata e trasformiamolo in un'ipotesi"
    },
    {
      "start": 4.38,
      "end": 8.62,
      "text": "operativa. Il riferimento riguarda la\nqualità della fotografia."
    },
    {
      "start": 9.66,
      "end": 14.18,
      "text": "La scelta potrebbe essere riservare quel\ncontrasto all'immagine e collocare i dati"
    },
    {
      "start": 14.18,
      "end": 15.02,
      "text": "su un fondo uniforme."
    },
    {
      "start": 16.04,
      "end": 20.28,
      "text": "La verifica riguarda la possibilità di\ntrovare data, luogo e iscrizione."
    },
    {
      "start": 21.34,
      "end": 25.28,
      "text": "Questo registro rende esplicito il\ncollegamento fra direzione visiva e"
    },
    {
      "start": 25.28,
      "end": 26.32,
      "text": "funzione della pagina."
    },
    {
      "start": 27.1,
      "end": 29.78,
      "text": "Non dice soltanto quale stile ci piace."
    },
    {
      "start": 30.16,
      "end": 34.26,
      "text": "Indica dove verrà tradotta una proprietà e\nquale osservazione permetterà di"
    },
    {
      "start": 34.26,
      "end": 38.46,
      "text": "valutarla. Conserviamo il registro anche\ndopo la revisione."
    },
    {
      "start": 38.46,
      "end": 43.06,
      "text": "Potremo distinguere che cosa abbiamo\nmantenuto, che cosa è cambiato e perché."
    },
    {
      "start": 43.06,
      "end": 47.36,
      "text": "Se l'immagine attira attenzione ma\nnasconde l'orario, l'ipotesi richiede una"
    },
    {
      "start": 47.36,
      "end": 48.06,
      "text": "correzione."
    },
    {
      "start": 48.52,
      "end": 52.46,
      "text": "La somiglianza fra moodboard e schermata\nnon documenta da sola un miglioramento."
    },
    {
      "start": 53.5,
      "end": 54.56,
      "text": "Servono contenuti reali,"
    },
    {
      "start": 55.06,
      "end": 58.96,
      "text": "una composizione confrontabile e\nosservazioni collegate al compito,"
    },
    {
      "start": 59.12,
      "end": 62.14,
      "text": "comprese quelle che contraddicono la\nnostra intenzione iniziale."
    }
  ]
}
