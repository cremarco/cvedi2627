  "cues": [
    {
      "start": 0.28,
      "end": 4.54,
      "text": "Guardate il viso di Carl a sinistra e\nquello di Russell a destra."
    },
    {
      "start": 4.54,
      "end": 9.02,
      "text": "Le annotazioni rendono esplicito un\nconfronto: rettangoli per leggere alcuni"
    },
    {
      "start": 9.02,
      "end": 10.28,
      "text": "tratti squadrati di Carl,"
    },
    {
      "start": 11.04,
      "end": 13.82,
      "text": "cerchi sul viso e sugli occhi di Russell."
    },
    {
      "start": 13.82,
      "end": 15.44,
      "text": "Prima di parlare del carattere dei\npersonaggi,"
    },
    {
      "start": 16.44,
      "end": 19.9,
      "text": "abbiamo individuato una differenza nella\nloro costruzione."
    },
    {
      "start": 20.06,
      "end": 24.5,
      "text": "Ora pensate a ciò che il film aggiunge a\nquei contorni: gesti, voce,"
    },
    {
      "start": 25.06,
      "end": 27.58,
      "text": "azioni e trasformazioni del racconto."
    },
    {
      "start": 27.6,
      "end": 30.98,
      "text": "È l'insieme a farci interpretare i\npersonaggi."
    },
    {
      "start": 31.0,
      "end": 35.24,
      "text": "Una geometria condivisa non renderebbe\nidentici due ruoli diversi, come abbiamo"
    },
    {
      "start": 35.24,
      "end": 40.9,
      "text": "già osservato per i marchi. L'esempio\nchiude la parte dedicata a forme e segni."
    },
    {
      "start": 40.9,
      "end": 44.6,
      "text": "Abbiamo imparato a descrivere una\nproprietà, collegarla al contenuto e"
    },
    {
      "start": 44.6,
      "end": 48.0,
      "text": "controllare quale contesto serva per\ncomprenderla."
    },
    {
      "start": 48.0,
      "end": 49.54,
      "text": "Nella prossima parte cambiamo scala:"
    },
    {
      "start": 50.2,
      "end": 53.86,
      "text": "dal profilo del soggetto passiamo al campo\nche lo contiene."
    },
    {
      "start": 53.9,
      "end": 58.26,
      "text": "Anche lasciare spazio, scegliere un bordo\no escludere un dettaglio costruisce"
    },
    {
      "start": 58.26,
      "end": 58.96,
      "text": "significato."
    }
  ]
}
