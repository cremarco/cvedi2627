  "cues": [
    {
      "start": 0.3,
      "end": 3.06,
      "text": "Proviamo ora a riunire le scelte in un\ninvito completo."
    },
    {
      "start": 4.2,
      "end": 9.16,
      "text": "I dati del laboratorio sono gli stessi\nincontrati all’inizio: giorno, orario,"
    },
    {
      "start": 9.32,
      "end": 14.42,
      "text": "luogo e iscrizione. La proposta aggiunge\nuna direzione visiva coerente con l’idea"
    },
    {
      "start": 14.42,
      "end": 18.16,
      "text": "di sperimentare con la luce. Il titolo\nrende riconoscibile"
    },
    {
      "start": 18.96,
      "end": 21.3,
      "text": "l’attività; la frase più piccola precisa\nl’idea guida."
    },
    {
      "start": 21.86,
      "end": 26.22,
      "text": "La fotografia del prisma e dei riflessi\nsostiene quel significato e bilancia il"
    },
    {
      "start": 26.22,
      "end": 31.34,
      "text": "campo del testo. I dati restano su una\nzona scura, lontano dalle parti luminose"
    },
    {
      "start": 31.34,
      "end": 36.18,
      "text": "più articolate. Un allineamento comune\ncollega le righe, mentre gli intervalli"
    },
    {
      "start": 36.18,
      "end": 39.62,
      "text": "distinguono il gruppo del giorno e\ndell’orario da quello del luogo e"
    },
    {
      "start": 39.62,
      "end": 40.32,
      "text": "dell’indirizzo."
    },
    {
      "start": 40.9,
      "end": 45.54,
      "text": "Il verde lime dà enfasi all’iscrizione; la\ngratuità resta vicina all’azione."
    },
    {
      "start": 46.34,
      "end": 49.28,
      "text": "Il comando rappresentato fa parte\ndell’immagine dimostrativa:"
    },
    {
      "start": 49.98,
      "end": 53.9,
      "text": "un invito digitale funzionante\nrichiederebbe anche un collegamento e un"
    },
    {
      "start": 53.9,
      "end": 54.6,
      "text": "controllo accessibile."
    },
    {
      "start": 55.38,
      "end": 57.36,
      "text": "Questa composizione propone delle\npriorità,"
    },
    {
      "start": 57.86,
      "end": 59.66,
      "text": "senza imporre un percorso degli occhi."
    },
    {
      "start": 60.06,
      "end": 62.86,
      "text": "Per valutarla torniamo al compito: capire\nl’attività,"
    },
    {
      "start": 63.58,
      "end": 66.82,
      "text": "trovare quando e dove si svolge e\nriconoscere come iscriversi."
    }
  ]
}
