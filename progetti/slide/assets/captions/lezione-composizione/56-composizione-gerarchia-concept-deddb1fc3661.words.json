  "cues": [
    {
      "start": 0.14,
      "end": 4.44,
      "text": "Un concept visivo è un'idea guida che\nmette in relazione le scelte espressive"
    },
    {
      "start": 4.44,
      "end": 9.96,
      "text": "del progetto. Non coincide con un colore o\nuno slogan isolato."
    },
    {
      "start": 9.96,
      "end": 14.7,
      "text": "Permette di motivare immagini, forme,\ntipografia e tono delle parole rispetto al"
    },
    {
      "start": 14.7,
      "end": 15.4,
      "text": "problema."
    },
    {
      "start": 15.84,
      "end": 19.74,
      "text": "Per il laboratorio possiamo proporre\nsperimentare con la luce."
    },
    {
      "start": 19.74,
      "end": 25.04,
      "text": "Da questa ipotesi derivano fotografie che\nconfrontano ombre e riflessi, tagli che"
    },
    {
      "start": 25.04,
      "end": 27.9,
      "text": "isolano un dettaglio e parole che invitano\na osservare."
    },
    {
      "start": 28.68,
      "end": 32.36,
      "text": "Ogni decisione deve avere una ragione\nriconoscibile."
    },
    {
      "start": 32.38,
      "end": 36.56,
      "text": "Il concept può evolvere quando incontra\ncontenuti e vincoli."
    },
    {
      "start": 36.56,
      "end": 40.9,
      "text": "Una campitura molto espressiva che rende\ndifficile leggere l'orario ostacola"
    },
    {
      "start": 40.9,
      "end": 45.5,
      "text": "comunque la funzione dell'invito. Non\nserve difenderla perché apparteneva"
    },
    {
      "start": 45.5,
      "end": 46.2,
      "text": "all'idea iniziale."
    },
    {
      "start": 47.3,
      "end": 50.44,
      "text": "Possiamo conservare la direzione e\ncambiare il modo di tradurla."
    },
    {
      "start": 51.26,
      "end": 54.84,
      "text": "Per discutere le interpretazioni del\ngruppo di progetto raccoglieremo"
    },
    {
      "start": 54.84,
      "end": 55.72,
      "text": "riferimenti visivi,"
    },
    {
      "start": 56.62,
      "end": 59.94,
      "text": "poi collegheremo ogni riferimento a una\nscelta e a una prova."
    }
  ]
}
