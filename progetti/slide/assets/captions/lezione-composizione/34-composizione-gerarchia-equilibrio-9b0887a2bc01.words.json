  "cues": [
    {
      "start": 0.24,
      "end": 4.86,
      "text": "Nel primo schema i dischi uguali si\ncorrispondono rispetto a un asse."
    },
    {
      "start": 4.9,
      "end": 7.18,
      "text": "La simmetria rende immediata questa\nrelazione."
    },
    {
      "start": 8.24,
      "end": 11.8,
      "text": "Nel secondo cambiano sia le dimensioni sia\nle distanze dall'asse:"
    },
    {
      "start": 12.7,
      "end": 15.48,
      "text": "la composizione richiede un confronto fra\nelementi differenti."
    },
    {
      "start": 16.52,
      "end": 21.38,
      "text": "La linea è un riferimento per leggere le\nposizioni, non uno strumento che misura il"
    },
    {
      "start": 21.38,
      "end": 22.08,
      "text": "peso percettivo."
    },
    {
      "start": 22.74,
      "end": 27.34,
      "text": "In una pagina reale dovremmo aggiungere\ncontenuto, colore e significato dei"
    },
    {
      "start": 27.34,
      "end": 28.04,
      "text": "soggetti."
    },
    {
      "start": 28.4,
      "end": 31.16,
      "text": "Un oggetto piccolo e isolato può avere\nmolto"
    },
    {
      "start": 31.76,
      "end": 35.06,
      "text": "rilievo; una massa ampia può confondersi\ncon lo sfondo."
    },
    {
      "start": 35.06,
      "end": 40.42,
      "text": "L'equilibrio può essere cercato o alterato\nintenzionalmente per costruire tensione."
    },
    {
      "start": 40.42,
      "end": 42.06,
      "text": "Prima di rendere simmetrico un layout,"
    },
    {
      "start": 42.66,
      "end": 44.94,
      "text": "chiediamoci quale relazione sostiene il\nmessaggio."
    },
    {
      "start": 45.88,
      "end": 50.32,
      "text": "Nell'invito una fotografia ampia potrebbe\nconfrontarsi con un titolo breve ma"
    },
    {
      "start": 50.32,
      "end": 55.16,
      "text": "contrastato. La composizione va giudicata\nattraverso questa collaborazione e"
    },
    {
      "start": 55.16,
      "end": 57.44,
      "text": "attraverso la riconoscibilità delle\npriorità,"
    },
    {
      "start": 57.94,
      "end": 61.1,
      "text": "non soltanto misurando quanto le due metà\nsi somiglino."
    }
  ]
}
