  "cues": [
    {
      "start": 0.16,
      "end": 5.14,
      "text": "I piccoli segni dell'esempio permettono di\nidentificare categorie senza rappresentare"
    },
    {
      "start": 5.14,
      "end": 10.76,
      "text": "ogni dettaglio dei soggetti. La sintesi è\nutile quando la distinzione deve essere"
    },
    {
      "start": 10.78,
      "end": 15.36,
      "text": "riconosciuta rapidamente e trova supporto\nnel contesto della pagina."
    },
    {
      "start": 15.38,
      "end": 19.92,
      "text": "Non basta però semplificare il disegno\nperché il significato diventi chiaro."
    },
    {
      "start": 19.92,
      "end": 24.88,
      "text": "Una stella, per esempio, può indicare un\npreferito, una valutazione o una categoria"
    },
    {
      "start": 24.9,
      "end": 25.6,
      "text": "di servizio."
    },
    {
      "start": 26.1,
      "end": 30.86,
      "text": "La posizione, il testo vicino e lo stato\ndel controllo precisano quale"
    },
    {
      "start": 31.36,
      "end": 35.7,
      "text": "interpretazione sia pertinente. Per questo\ndistinguiamo la categoria rappresentata"
    },
    {
      "start": 35.7,
      "end": 40.3,
      "text": "dall'azione che possiamo compiere. Nel\nlaboratorio un piccolo segno può"
    },
    {
      "start": 40.3,
      "end": 44.7,
      "text": "identificare il livello dell'attività,\nmentre il comando di iscrizione richiede"
    },
    {
      "start": 44.7,
      "end": 45.52,
      "text": "una funzione esplicita."
    },
    {
      "start": 46.68,
      "end": 50.46,
      "text": "Guardiamo la scala alla quale il segno\nverrà usato e proviamo se resta"
    },
    {
      "start": 50.46,
      "end": 55.58,
      "text": "distinguibile dagli altri. La sintesi\nelimina dettaglio, ma deve conservare"
    },
    {
      "start": 55.58,
      "end": 58.38,
      "text": "proprio quello che serve alla relazione\nfra contenuti."
    }
  ]
}
