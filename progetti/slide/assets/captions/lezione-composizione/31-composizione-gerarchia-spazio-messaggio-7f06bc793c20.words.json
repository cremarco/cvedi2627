  "cues": [
    {
      "start": 0.18,
      "end": 4.56,
      "text": "Nel manifesto del Melbourne Food and Wine\nFestival provate a descrivere prima il"
    },
    {
      "start": 4.56,
      "end": 6.84,
      "text": "nero, poi lo spazio chiaro fra le\ncampiture."
    },
    {
      "start": 7.84,
      "end": 12.42,
      "text": "La relazione fa emergere bottiglie e\nforchetta, collegando visivamente i due"
    },
    {
      "start": 12.42,
      "end": 16.46,
      "text": "termini del festival. Il contorno\ncontribuisce a più di una lettura."
    },
    {
      "start": 17.52,
      "end": 21.62,
      "text": "Questo è un uso dello spazio negativo\ndiverso da quello che separa semplicemente"
    },
    {
      "start": 21.62,
      "end": 22.32,
      "text": "due paragrafi."
    },
    {
      "start": 22.82,
      "end": 24.68,
      "text": "Il vuoto partecipa al soggetto:"
    },
    {
      "start": 25.26,
      "end": 29.04,
      "text": "se cambiamo troppo un profilo, possiamo\nperdere una delle figure."
    },
    {
      "start": 29.04,
      "end": 33.18,
      "text": "Il messaggio dipende quindi da come pieni\ne vuoti si definiscono reciprocamente."
    },
    {
      "start": 34.32,
      "end": 38.12,
      "text": "Per trasferire il ragionamento alla\npagina, scegliamo quale ruolo affidare"
    },
    {
      "start": 38.12,
      "end": 42.5,
      "text": "allo spazio. Nell'invito ci interessa\nsoprattutto distinguere gruppi e"
    },
    {
      "start": 42.5,
      "end": 46.54,
      "text": "conservare rapporti chiari fra titolo,\ndati e comando."
    },
    {
      "start": 46.54,
      "end": 50.66,
      "text": "Nel marchio o nel manifesto possiamo\ncercare anche una seconda figura."
    },
    {
      "start": 50.66,
      "end": 52.96,
      "text": "In entrambi i casi valutiamo una relazione\nspecifica."
    },
    {
      "start": 54.22,
      "end": 58.32,
      "text": "Aggiungere una grande area libera, senza\ncurare i suoi confini, non chiarirebbe"
    },
    {
      "start": 58.32,
      "end": 60,
      "text": "automaticamente il contenuto."
    }
  ]
}
