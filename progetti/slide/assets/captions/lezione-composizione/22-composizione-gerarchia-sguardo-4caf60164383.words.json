  "cues": [
    {
      "start": 0.22,
      "end": 2.82,
      "text": "In questo ritratto la persona guarda verso\nsinistra."
    },
    {
      "start": 4.18,
      "end": 8.8,
      "text": "La misura orizzontale indica lo spazio\nlasciato davanti al volto: è la looking"
    },
    {
      "start": 8.8,
      "end": 9.5,
      "text": "room."
    },
    {
      "start": 9.78,
      "end": 14.2,
      "text": "La misura verticale, invece, parte dalla\nsommità dei capelli e arriva al bordo"
    },
    {
      "start": 14.2,
      "end": 16.72,
      "text": "superiore dell'inquadratura: è la\nheadroom."
    },
    {
      "start": 17.52,
      "end": 22.02,
      "text": "La testa è interamente visibile, perciò\npossiamo distinguere i due spazi senza"
    },
    {
      "start": 22.02,
      "end": 22.72,
      "text": "ambiguità."
    },
    {
      "start": 23.14,
      "end": 26.84,
      "text": "Lo spazio laterale dietro la testa non è\nheadroom."
    },
    {
      "start": 26.84,
      "end": 29.8,
      "text": "La quantità di spazio dipende dal taglio e\ndall'effetto"
    },
    {
      "start": 30.6,
      "end": 34.24,
      "text": "cercato; non esiste una misura unica\nvalida per tutti i ritratti."
    },
    {
      "start": 34.24,
      "end": 38.84,
      "text": "In una pagina, orientare il volto verso un\ntesto può suggerire una relazione fra"
    },
    {
      "start": 38.84,
      "end": 43.6,
      "text": "immagine e parole. È un'ipotesi\ncompositiva, non la prova del percorso"
    },
    {
      "start": 43.6,
      "end": 44.46,
      "text": "degli occhi del lettore."
    },
    {
      "start": 45.38,
      "end": 48.98,
      "text": "Quando adattiamo il ritaglio a uno schermo\nstretto, controlliamo di nuovo la"
    },
    {
      "start": 48.98,
      "end": 52.34,
      "text": "direzione dello sguardo e ciò che rimane\nsopra la testa."
    }
  ]
}
