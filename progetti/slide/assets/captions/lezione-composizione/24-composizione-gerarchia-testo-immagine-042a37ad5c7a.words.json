  "cues": [
    {
      "start": 0.44,
      "end": 4.94,
      "text": "Barthes distingue due funzioni delle\nparole rispetto all'immagine."
    },
    {
      "start": 4.94,
      "end": 9.26,
      "text": "Nell'ancoraggio il testo orienta\nl'interpretazione: una didascalia"
    },
    {
      "start": 9.26,
      "end": 14.82,
      "text": "identifica persone, luogo o circostanza e\nrestringe le letture possibili."
    },
    {
      "start": 14.82,
      "end": 18.86,
      "text": "Nel relais, parole e immagini\ncontribuiscono insieme allo sviluppo di un"
    },
    {
      "start": 18.86,
      "end": 21.52,
      "text": "racconto, come nei dialoghi di un fumetto."
    },
    {
      "start": 21.52,
      "end": 25.4,
      "text": "Per una pagina informativa questa\ndistinzione aiuta a decidere che cosa"
    },
    {
      "start": 25.4,
      "end": 27.06,
      "text": "mostrare e che cosa esplicitare."
    },
    {
      "start": 27.96,
      "end": 32.72,
      "text": "Nell'invito la fotografia può rendere\nvisibile un'esperienza di luce; il titolo"
    },
    {
      "start": 32.72,
      "end": 35.54,
      "text": "chiarisce che si tratta di un laboratorio."
    },
    {
      "start": 35.64,
      "end": 39.76,
      "text": "Data, luogo e iscrizione aggiungono\ninformazioni che l'immagine non può"
    },
    {
      "start": 39.76,
      "end": 40.46,
      "text": "sostituire."
    },
    {
      "start": 41.12,
      "end": 43.7,
      "text": "Anche la distanza partecipa al rapporto."
    },
    {
      "start": 43.7,
      "end": 47.0,
      "text": "Un testo lontano dalla propria figura può\nessere associato a un'altra,"
    },
    {
      "start": 47.82,
      "end": 49.96,
      "text": "soprattutto se le immagini sono simili."
    },
    {
      "start": 49.96,
      "end": 52.42,
      "text": "Non basta dunque possedere una buona\ndidascalia:"
    },
    {
      "start": 52.98,
      "end": 56.72,
      "text": "dobbiamo collocarla in modo che\nl'associazione resti riconoscibile, anche"
    },
    {
      "start": 56.72,
      "end": 59.88,
      "text": "dopo un adattamento del layout o un\nallungamento delle parole."
    }
  ]
}
