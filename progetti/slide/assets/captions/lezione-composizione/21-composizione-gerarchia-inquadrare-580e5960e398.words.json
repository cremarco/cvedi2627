  "cues": [
    {
      "start": 0.28,
      "end": 5.48,
      "text": "La griglia sovrapposta al paesaggio divide\nil campo in tre parti per ogni asse."
    },
    {
      "start": 5.48,
      "end": 9.38,
      "text": "Possiamo descrivere la posizione\ndell'albero vicino alla verticale destra e"
    },
    {
      "start": 9.38,
      "end": 10.56,
      "text": "la montagna sulla sinistra."
    },
    {
      "start": 11.34,
      "end": 16.1,
      "text": "La griglia ci aiuta a descrivere e\nvalutare la posizione dei soggetti, ma una"
    },
    {
      "start": 16.1,
      "end": 19.82,
      "text": "fotografia non diventa migliore solo\nperché rispetta la regola dei terzi."
    },
    {
      "start": 20.58,
      "end": 22.78,
      "text": "La regola dei terzi offre riferimenti,"
    },
    {
      "start": 23.48,
      "end": 26.56,
      "text": "mentre il messaggio stabilisce quali\nrelazioni ci interessano."
    },
    {
      "start": 27.24,
      "end": 31.18,
      "text": "Una composizione centrata può essere\naltrettanto pertinente se vogliamo"
    },
    {
      "start": 31.18,
      "end": 34.5,
      "text": "evidenziare un asse o costruire una\nsimmetria."
    },
    {
      "start": 34.5,
      "end": 36.96,
      "text": "Non serve spostare ogni soggetto su\nun'intersezione."
    },
    {
      "start": 37.72,
      "end": 42.6,
      "text": "Per l'invito dovremo decidere quale parte\ndella fotografia lascia spazio al titolo e"
    },
    {
      "start": 42.6,
      "end": 44.46,
      "text": "quale dettaglio deve rimanere visibile."
    },
    {
      "start": 45.08,
      "end": 49.88,
      "text": "La domanda non è soltanto dove mettere\nl'immagine nel reticolo della pagina."
    },
    {
      "start": 49.98,
      "end": 53.88,
      "text": "Dobbiamo osservare anche l'organizzazione\ninterna del suo campo."
    },
    {
      "start": 53.88,
      "end": 58.98,
      "text": "Inquadratura e layout sono due scale della\nstessa relazione fra ciò che mostriamo e"
    },
    {
      "start": 58.98,
      "end": 60.5,
      "text": "ciò che chiediamo di capire."
    }
  ]
}
