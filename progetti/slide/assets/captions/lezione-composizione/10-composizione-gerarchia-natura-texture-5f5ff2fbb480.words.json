  "cues": [
    {
      "start": 0.18,
      "end": 0.88,
      "text": "Nella foglia,"
    },
    {
      "start": 1.36,
      "end": 6.0,
      "text": "nel fiore e nella conchiglia possiamo\nosservare ramificazioni, simmetrie,"
    },
    {
      "start": 6.04,
      "end": 10.28,
      "text": "ripetizioni e spirali. Queste strutture\npossono ispirare il progetto,"
    },
    {
      "start": 11.14,
      "end": 14.7,
      "text": "senza presumere che tutte le forme\nnaturali seguano la stessa formula"
    },
    {
      "start": 14.7,
      "end": 15.4,
      "text": "matematica."
    },
    {
      "start": 16.18,
      "end": 21.2,
      "text": "Il richiamo alla natura, inoltre, non\ndocumenta la sostenibilità di un prodotto."
    },
    {
      "start": 21.2,
      "end": 24.38,
      "text": "La texture riguarda l'organizzazione\nvisibile della superficie:"
    },
    {
      "start": 25.64,
      "end": 27.82,
      "text": "grana, venature, trama o rilievi."
    },
    {
      "start": 28.46,
      "end": 33.14,
      "text": "La fotografia del legno può suggerire una\nqualità tattile, ma sullo schermo vediamo"
    },
    {
      "start": 33.14,
      "end": 35.86,
      "text": "la rappresentazione di quel materiale."
    },
    {
      "start": 35.86,
      "end": 41.0,
      "text": "Questa distinzione aiuta a leggere\nconfezione, immagine e pagina digitale."
    },
    {
      "start": 41.0,
      "end": 45.22,
      "text": "Per il laboratorio una superficie può\nsuggerire un'atmosfera e unificare la"
    },
    {
      "start": 45.22,
      "end": 45.92,
      "text": "comunicazione."
    },
    {
      "start": 46.64,
      "end": 48.78,
      "text": "La prova va però fatta con i testi reali:"
    },
    {
      "start": 49.48,
      "end": 53.24,
      "text": "una trama interessante nel campione\ningrandito può competere con le lettere"
    },
    {
      "start": 53.24,
      "end": 57.96,
      "text": "quando diventa uno sfondo. Osserviamo\nquindi insieme dettaglio, scala e"
    },
    {
      "start": 57.96,
      "end": 58.66,
      "text": "leggibilità,"
    },
    {
      "start": 59.32,
      "end": 63.2,
      "text": "evitando di attribuire alla sola materia\nil compito di comunicare tutte le"
    },
    {
      "start": 63.2,
      "end": 63.9,
      "text": "informazioni."
    }
  ]
}
