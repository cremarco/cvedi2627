  "cues": [
    {
      "start": 0.22,
      "end": 2.64,
      "text": "Una prova utile parte da una consegna\nconcreta."
    },
    {
      "start": 3.94,
      "end": 7.7,
      "text": "Per l'invito possiamo chiedere in quale\ngiorno si svolge il laboratorio, dove"
    },
    {
      "start": 7.7,
      "end": 8.92,
      "text": "andare e come iscriversi."
    },
    {
      "start": 10.0,
      "end": 13.5,
      "text": "Per Sara possiamo chiedere di spostare la\nvisita."
    },
    {
      "start": 13.5,
      "end": 17.82,
      "text": "La formulazione deve permettere di\nosservare la risposta senza suggerire il"
    },
    {
      "start": 17.82,
      "end": 21.16,
      "text": "controllo da usare. Annotiamo ciò che\nviene individuato,"
    },
    {
      "start": 21.66,
      "end": 25.88,
      "text": "le esitazioni, le associazioni fra parole\ne controlli e l'esito dell'azione."
    },
    {
      "start": 26.74,
      "end": 30.44,
      "text": "Non basta chiedere quale versione piaccia\ndi più se il problema riguarda"
    },
    {
      "start": 30.44,
      "end": 33.34,
      "text": "comprensione e possibilità di agire."
    },
    {
      "start": 33.34,
      "end": 37.64,
      "text": "Anche una risposta corretta va\ninterpretata nelle condizioni della prova."
    },
    {
      "start": 37.64,
      "end": 42.24,
      "text": "Molte esitazioni possono segnalare una\ndifficoltà diversa da un'azione rapida sul"
    },
    {
      "start": 42.24,
      "end": 42.94,
      "text": "comando sbagliato."
    },
    {
      "start": 43.84,
      "end": 48.04,
      "text": "Il percorso degli occhi, se disponibile,\nnon dimostra da solo la comprensione."
    },
    {
      "start": 48.76,
      "end": 52.12,
      "text": "Le osservazioni vanno lette insieme al\ncontesto."
    },
    {
      "start": 52.18,
      "end": 56.48,
      "text": "Manteniamo dunque una domanda precisa,\nconfrontiamo le varianti e registriamo"
    },
    {
      "start": 56.48,
      "end": 58.98,
      "text": "anche i risultati che richiedono di\ncambiare l'ipotesi."
    }
  ]
