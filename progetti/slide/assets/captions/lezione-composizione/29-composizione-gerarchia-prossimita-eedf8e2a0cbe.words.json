  "cues": [
    {
      "start": 0.24,
      "end": 4.1,
      "text": "Dopo aver distinto i ruoli, dobbiamo\nrendere riconoscibile a quale gruppo"
    },
    {
      "start": 4.1,
      "end": 5.32,
      "text": "appartenga ogni informazione."
    },
    {
      "start": 6.96,
      "end": 11.94,
      "text": "Nell'invito data e orario formano una\nrelazione diversa da quella fra nome e"
    },
    {
      "start": 11.94,
      "end": 16.92,
      "text": "indirizzo del luogo. Le distanze possono\nconfermare questa struttura oppure"
    },
    {
      "start": 16.92,
      "end": 17.7,
      "text": "renderla ambigua."
    },
    {
      "start": 18.46,
      "end": 22.86,
      "text": "In un modulo, un'etichetta troppo vicina\nal campo successivo potrebbe sembrare"
    },
    {
      "start": 22.86,
      "end": 23.82,
      "text": "riferita a quello."
    },
    {
      "start": 24.52,
      "end": 27.7,
      "text": "Non basta applicare la stessa quantità di\nspazio a ogni intervallo."
    },
    {
      "start": 28.84,
      "end": 32.44,
      "text": "Serve distinguere distanze interne al\ngruppo e separazioni fra gruppi,"
    },
    {
      "start": 33.0,
      "end": 36.94,
      "text": "in rapporto al contenuto concreto. La\nprova deve includere le variazioni."
    },
    {
      "start": 37.9,
      "end": 42.36,
      "text": "Una traduzione può allungare un'etichetta,\nun messaggio di errore può introdurre una"
    },
    {
      "start": 42.36,
      "end": 43.06,
      "text": "nuova riga."
    },
    {
      "start": 43.46,
      "end": 47.66,
      "text": "Se l'associazione dipendeva soltanto da\nuna distanza molto precisa, potrebbe"
    },
    {
      "start": 47.66,
      "end": 48.36,
      "text": "perdersi."
    },
    {
      "start": 48.94,
      "end": 52.6,
      "text": "Perciò verifichiamo la composizione con\ntesti reali e stati diversi."
    },
    {
      "start": 53.46,
      "end": 56.7,
      "text": "La prossimità diventa una scelta\nprogettuale quando sostiene"
    },
    {
      "start": 56.7,
      "end": 59.58,
      "text": "un'appartenenza che possiamo spiegare e\ncontrollare."
    }
  ]
}
