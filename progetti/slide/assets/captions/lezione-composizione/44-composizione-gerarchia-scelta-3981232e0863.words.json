  "cues": [
    {
      "start": 0.26,
      "end": 4.76,
      "text": "Negli esperimenti di scelta, le persone\ndevono rispondere rapidamente a segnali"
    },
    {
      "start": 4.76,
      "end": 5.46,
      "text": "diversi."
    },
    {
      "start": 6.24,
      "end": 11.24,
      "text": "La legge di Hick e Hyman descrive una\ntendenza: maggiore è l'incertezza su quale"
    },
    {
      "start": 11.24,
      "end": 14.92,
      "text": "risposta sarà richiesta, più lungo è il\ntempo medio di reazione."
    },
    {
      "start": 15.78,
      "end": 20.42,
      "text": "Per esempio, quattro alternative\nugualmente probabili creano più incertezza"
    },
    {
      "start": 20.42,
      "end": 23.74,
      "text": "di quattro alternative tra cui una è\nrichiesta quasi sempre."
    },
    {
      "start": 24.72,
      "end": 29.0,
      "text": "Nel progetto di un menu questo invita a\norganizzare gruppi ed etichette in modo"
    },
    {
      "start": 29.0,
      "end": 29.7,
      "text": "prevedibile."
    },
    {
      "start": 30.38,
      "end": 35.66,
      "text": "Non permette però di ricavare il tempo di\nuna decisione reale contando i pulsanti."
    },
    {
      "start": 35.66,
      "end": 39.6,
      "text": "Cercare un nome familiare, confrontare un\nacquisto e rispondere a uno stimolo"
    },
    {
      "start": 39.68,
      "end": 42.7,
      "text": "sperimentale sono condizioni differenti."
    },
    {
      "start": 42.7,
      "end": 46.86,
      "text": "Per Sara chiediamoci quali alternative\nsiano pertinenti e come vengano"
    },
    {
      "start": 46.86,
      "end": 51.98,
      "text": "presentate. Modifica, indicazioni e\nannullamento possono restare tutte"
    },
    {
      "start": 51.98,
      "end": 55.84,
      "text": "disponibili, ma con relazioni che ne\nchiariscono il ruolo."
    },
    {
      "start": 56.0,
      "end": 60.08,
      "text": "Eliminare informazioni necessarie soltanto\nper ridurre il numero delle voci non"
    },
    {
      "start": 60.08,
      "end": 64.28,
      "text": "risolve il compito. La domanda utile\nriguarda ciò che la persona deve"
    },
    {
      "start": 64.28,
      "end": 68.94,
      "text": "distinguere, quali conoscenze porta e\nquali conseguenze associa alla propria"
    },
    {
      "start": 68.94,
      "end": 69.64,
      "text": "scelta."
    }
  ]
}
