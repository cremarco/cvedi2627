  "cues": [
    {
      "start": 0.2,
      "end": 2.78,
      "text": "Una persona non esplora la pagina in modo\npassivo."
    },
    {
      "start": 3.86,
      "end": 8.1,
      "text": "Può cercare un nome, riconoscere una\nfotografia già vista o rivolgersi alla"
    },
    {
      "start": 8.1,
      "end": 11.02,
      "text": "zona dove si aspetta di trovare un\ncomando."
    },
    {
      "start": 11.02,
      "end": 15.32,
      "text": "Il modello Guided Search di Wolfe\nconsidera una guida dell'attenzione che"
    },
    {
      "start": 15.32,
      "end": 20.06,
      "text": "integra caratteristiche dello stimolo,\nobiettivi, esperienza precedente e"
    },
    {
      "start": 20.06,
      "end": 23.86,
      "text": "conoscenza della scena. Questo completa il\nconfronto appena visto."
    },
    {
      "start": 24.9,
      "end": 26.94,
      "text": "Rendere un elemento distinguibile è\nimportante,"
    },
    {
      "start": 27.6,
      "end": 31.14,
      "text": "ma non stabilisce l'ordine completo della\nconsultazione."
    },
    {
      "start": 31.18,
      "end": 35.4,
      "text": "Se Sara cerca la data della visita, può\nconcentrarsi su quel gruppo anche quando"
    },
    {
      "start": 35.4,
      "end": 38.1,
      "text": "un altro blocco ha un colore più intenso."
    },
    {
      "start": 38.1,
      "end": 40.96,
      "text": "Nel nostro invito distinguiamo quindi\nvisibilità,"
    },
    {
      "start": 41.56,
      "end": 42.68,
      "text": "attenzione e comprensione."
    },
    {
      "start": 43.54,
      "end": 48.4,
      "text": "Una grande fotografia può essere evidente\nsenza chiarire di che attività si tratta."
    },
    {
      "start": 48.4,
      "end": 52.0,
      "text": "Un titolo può essere trovato e\ninterpretato in modo diverso da quello"
    },
    {
      "start": 52.0,
      "end": 52.7,
      "text": "previsto."
    },
    {
      "start": 53.02,
      "end": 57.4,
      "text": "La verifica deve mantenere la domanda del\nlettore e osservare insieme ciò che"
    },
    {
      "start": 57.4,
      "end": 60.38,
      "text": "individua, ciò che capisce e ciò che\nriesce a fare."
    }
  ]
}
