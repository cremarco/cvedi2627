  "cues": [
    {
      "start": 0.22,
      "end": 4.02,
      "text": "Nel manifesto della Nona Triennale di\nMilano individuate tre componenti:"
    },
    {
      "start": 4.82,
      "end": 8.38,
      "text": "il grande numero, le campiture e i testi."
    },
    {
      "start": 8.38,
      "end": 11.28,
      "text": "Osservate quali bordi condividono e dove\ncambiano scala."
    },
    {
      "start": 12.66,
      "end": 16.62,
      "text": "Possiamo leggere il risultato attraverso i\nriferimenti della griglia studiati nella"
    },
    {
      "start": 16.62,
      "end": 17.32,
      "text": "lezione precedente."
    },
    {
      "start": 18.7,
      "end": 20.86,
      "text": "Qui il nuovo passaggio riguarda la\ngerarchia."
    },
    {
      "start": 21.98,
      "end": 27.24,
      "text": "Il reticolo offre posizioni possibili;\ndimensione e contrasto assegnano ruoli ai"
    },
    {
      "start": 27.24,
      "end": 32.46,
      "text": "contenuti che le occupano. Una struttura\nregolare non decide da sola se il titolo"
    },
    {
      "start": 32.46,
      "end": 35.74,
      "text": "debba prevalere o se due informazioni\ndebbano essere confrontate."
    },
    {
      "start": 37.1,
      "end": 41.22,
      "text": "Per il nostro invito possiamo quindi\nconservare i riferimenti di allineamento e"
    },
    {
      "start": 41.22,
      "end": 42.8,
      "text": "cambiare il peso di un solo gruppo."
    },
    {
      "start": 43.8,
      "end": 46.82,
      "text": "È un modo concreto di distinguere\nstruttura e priorità."
    },
    {
      "start": 47.9,
      "end": 52.14,
      "text": "Quando discutiamo la proposta, indichiamo\nsia il riferimento mantenuto sia la"
    },
    {
      "start": 52.14,
      "end": 57.24,
      "text": "differenza introdotta. Nella prossima\ncoppia il testo diventa più denso e le"
    },
    {
      "start": 57.24,
      "end": 58.3,
      "text": "direzioni si sovrappongono:"
    },
    {
      "start": 59.18,
      "end": 62.9,
      "text": "il confronto ci mostrerà un'altra\npossibilità di costruire ruoli"
    },
    {
      "start": 62.9,
      "end": 63.6,
      "text": "riconoscibili."
    }
  ]
}
