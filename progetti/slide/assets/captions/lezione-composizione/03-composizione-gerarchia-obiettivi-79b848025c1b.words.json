  "cues": [
    {
      "start": 0.18,
      "end": 3.56,
      "text": "Gli obiettivi seguono il lavoro che faremo\ninsieme."
    },
    {
      "start": 3.56,
      "end": 8.24,
      "text": "Il primo è leggere le relazioni:\nindividuare che cosa compone una pagina e"
    },
    {
      "start": 8.24,
      "end": 12.32,
      "text": "descrivere come forme, immagini e parole\nsi collegano."
    },
    {
      "start": 12.32,
      "end": 15.32,
      "text": "Prima di interpretare, dobbiamo\ndistinguere ciò che possiamo"
    },
    {
      "start": 15.32,
      "end": 19.36,
      "text": "effettivamente osservare. Il secondo è\ncostruire le priorità."
    },
    {
      "start": 20.04,
      "end": 24.74,
      "text": "Useremo differenze di scala, contrasto e\nspazio per assegnare ruoli ai contenuti."
    },
    {
      "start": 25.3,
      "end": 29.78,
      "text": "Non dovremo applicare ogni strumento in\nogni pagina: sceglieremo quelli pertinenti"
    },
    {
      "start": 29.78,
      "end": 30.86,
      "text": "alla domanda del lettore."
    },
    {
      "start": 31.68,
      "end": 36.62,
      "text": "Il terzo è verificare il compito. Una\ncomposizione può apparire convincente e"
    },
    {
      "start": 36.62,
      "end": 38.32,
      "text": "lasciare comunque incerta un'azione."
    },
    {
      "start": 39.2,
      "end": 41.48,
      "text": "Confronteremo una versione iniziale e una\nvariazione,"
    },
    {
      "start": 42.54,
      "end": 45.54,
      "text": "poi formuleremo una consegna che permetta\ndi osservarne l'uso."
    },
    {
      "start": 46.22,
      "end": 50.72,
      "text": "Metteremo quindi in pratica i principi di\nricerca e accessibilità già studiati,"
    },
    {
      "start": 50.78,
      "end": 52.48,
      "text": "usandoli per guidare le scelte visive."
    }
  ]
}
