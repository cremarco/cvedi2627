  "cues": [
    {
      "start": 0.2,
      "end": 4.52,
      "text": "Nel primo campo un solo disco interrompe\nuna serie regolare."
    },
    {
      "start": 4.52,
      "end": 8.12,
      "text": "Nel secondo numerose differenze di colore\ne dimensione competono."
    },
    {
      "start": 9.26,
      "end": 11.34,
      "text": "Il confronto rende visibili due\ncondizioni,"
    },
    {
      "start": 12.16,
      "end": 14.6,
      "text": "senza rappresentare tempi o risultati\nmisurati."
    },
    {
      "start": 15.44,
      "end": 18.4,
      "text": "La salienza è il rilievo di un elemento\nrispetto all'ambiente."
    },
    {
      "start": 19.5,
      "end": 22.08,
      "text": "Perciò un segnale non è evidente in\nassoluto:"
    },
    {
      "start": 22.8,
      "end": 24.28,
      "text": "dipende dalle differenze già presenti."
    },
    {
      "start": 25.28,
      "end": 28.8,
      "text": "Treisman e Gelade studiano come cerchiamo\nun oggetto tra altri oggetti,"
    },
    {
      "start": 29.72,
      "end": 33.28,
      "text": "distinguendo la ricerca di una singola\ncaratteristica dalla ricerca di una"
    },
    {
      "start": 33.28,
      "end": 38.16,
      "text": "combinazione di caratteristiche. Per\nesempio, un cerchio rosso tra cerchi verdi"
    },
    {
      "start": 38.16,
      "end": 42.72,
      "text": "si distingue per il colore; tra cerchi\nverdi e quadrati rossi occorre riconoscere"
    },
    {
      "start": 42.72,
      "end": 47.96,
      "text": "insieme colore e forma. Secondo la loro\nteoria, l'attenzione permette di collegare"
    },
    {
      "start": 47.96,
      "end": 50.02,
      "text": "queste caratteristiche allo stesso\noggetto."
    },
    {
      "start": 50.9,
      "end": 55.0,
      "text": "Il nostro schema suggerisce una domanda\nprogettuale, non riproduce quei dati."
    },
    {
      "start": 55.66,
      "end": 59.66,
      "text": "Se aggiungiamo accenti a ogni blocco\ndell'invito, potremmo indebolire proprio"
    },
    {
      "start": 59.66,
      "end": 62.14,
      "text": "la distinzione che volevamo ottenere."
    },
    {
      "start": 62.14,
      "end": 66.06,
      "text": "Conviene chiedersi quale segnale deve\nessere riconoscibile e in quale campo"
    },
    {
      "start": 66.06,
      "end": 66.76,
      "text": "viene cercato."
    },
    {
      "start": 67.42,
      "end": 71.34,
      "text": "Per completare il ragionamento dobbiamo\nperò considerare anche gli obiettivi della"
    },
    {
      "start": 71.34,
      "end": 72.04,
      "text": "persona,"
    },
    {
      "start": 72.36,
      "end": 76.2,
      "text": "perché l'attenzione non è guidata soltanto\ndalle proprietà dello stimolo."
    }
  ]
}
