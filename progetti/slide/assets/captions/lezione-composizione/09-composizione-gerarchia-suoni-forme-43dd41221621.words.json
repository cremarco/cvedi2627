  "cues": [
    {
      "start": 0.28,
      "end": 4.26,
      "text": "Questi profili riprendono i disegni\nassociati da Köhler ai nomi inventati"
    },
    {
      "start": 4.26,
      "end": 7.16,
      "text": "Takete e Maluma. Uno è angoloso,"
    },
    {
      "start": 7.88,
      "end": 11.88,
      "text": "l'altro curvilineo. L'associazione più\nfrequente fra il primo e Takete,"
    },
    {
      "start": 12.46,
      "end": 17.74,
      "text": "fra il secondo e Maluma, è un esempio di\ncorrispondenza fra modalità sensoriali."
    },
    {
      "start": 17.74,
      "end": 22.32,
      "text": "Una ricerca successiva su bouba e kiki ha\ncoinvolto novecentodiciassette"
    },
    {
      "start": 22.32,
      "end": 23.16,
      "text": "partecipanti,"
    },
    {
      "start": 23.74,
      "end": 26.16,
      "text": "venticinque lingue e dieci sistemi di\nscrittura."
    },
    {
      "start": 26.92,
      "end": 31.22,
      "text": "Ha trovato una robusta tendenza\ncomplessiva nell'associazione fra suono e"
    },
    {
      "start": 31.22,
      "end": 35.02,
      "text": "forma, insieme a differenze fra persone e\ngruppi."
    },
    {
      "start": 35.02,
      "end": 39.94,
      "text": "La ricerca mostra che molte persone\nassociano certi suoni a certe forme."
    },
    {
      "start": 40.06,
      "end": 44.62,
      "text": "Questo non significa che tutte le forme\ncurve comunichino lo stesso messaggio: per"
    },
    {
      "start": 44.62,
      "end": 46.98,
      "text": "capire che cosa comunica un marchio\narrotondato,"
    },
    {
      "start": 47.48,
      "end": 51.18,
      "text": "dobbiamo considerare il servizio in cui\ncompare e le persone che lo useranno."
    },
    {
      "start": 51.86,
      "end": 55.46,
      "text": "Nel progetto possiamo usare queste\nassociazioni come ipotesi da discutere,"
    },
    {
      "start": 56.26,
      "end": 60.08,
      "text": "poi verificare nome, forma e contesto con\nle persone a cui ci rivolgiamo."
    }
  ]
}
