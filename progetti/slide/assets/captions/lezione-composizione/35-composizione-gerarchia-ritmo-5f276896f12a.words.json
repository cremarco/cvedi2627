  "cues": [
    {
      "start": 0.2,
      "end": 3.26,
      "text": "Nella campagna Coca-Cola guardate prima le\nsingole bottiglie,"
    },
    {
      "start": 4.16,
      "end": 7.02,
      "text": "poi il contorno che costruiscono insieme."
    },
    {
      "start": 7.02,
      "end": 12.56,
      "text": "Ripetizione, variazione di dimensione e\ndisposizione suggeriscono un sorriso."
    },
    {
      "start": 12.56,
      "end": 14.04,
      "text": "Il risultato emerge dal gruppo:"
    },
    {
      "start": 14.76,
      "end": 17.92,
      "text": "una bottiglia isolata non avrebbe la\nstessa funzione."
    },
    {
      "start": 17.92,
      "end": 19.84,
      "text": "Il ritmo comprende anche gli intervalli."
    },
    {
      "start": 20.62,
      "end": 22.42,
      "text": "Se cambiamo la distanza fra due elementi,"
    },
    {
      "start": 23.14,
      "end": 26.4,
      "text": "possiamo interrompere una continuità o\nmettere in evidenza una zona."
    },
    {
      "start": 26.98,
      "end": 31.4,
      "text": "Una ripetizione riconoscibile offre dunque\nun riferimento rispetto al quale la"
    },
    {
      "start": 31.4,
      "end": 36.26,
      "text": "differenza acquista significato. Per\napplicarlo all'invito, manteniamo costanti"
    },
    {
      "start": 36.26,
      "end": 39.32,
      "text": "i trattamenti dei dati che hanno lo stesso\nruolo."
    },
    {
      "start": 39.36,
      "end": 43.12,
      "text": "Possiamo poi riservare una variazione al\ncomando o a un elemento che vogliamo"
    },
    {
      "start": 43.12,
      "end": 43.82,
      "text": "distinguere."
    },
    {
      "start": 44.34,
      "end": 47.64,
      "text": "Prima di aggiungere un nuovo stile,\nchiediamoci quale funzione segnala."
    },
    {
      "start": 48.58,
      "end": 50.38,
      "text": "Questo collega il ritmo alla gerarchia:"
    },
    {
      "start": 50.98,
      "end": 53.32,
      "text": "la coerenza rende interpretabile\nl'eccezione."
    },
    {
      "start": 54.18,
      "end": 58.74,
      "text": "La direzione che emerge dalla disposizione\nci porta al prossimo esempio, dove le"
    },
    {
      "start": 58.74,
      "end": 61.88,
      "text": "linee dell'architettura suggeriscono un\nmovimento nello spazio."
    }
  ]
}
