  "cues": [
    {
      "start": 0.2,
      "end": 5.62,
      "text": "Il controllo chiamato squint test riduce i\ndettagli per osservare masse, contrasti e"
    },
    {
      "start": 5.62,
      "end": 10.68,
      "text": "raggruppamenti. Possiamo socchiudere gli\nocchi oppure applicare una lieve sfocatura"
    },
    {
      "start": 10.68,
      "end": 15.34,
      "text": "a una copia della composizione. Qui\nl'originale e la copia sono mantenuti alla"
    },
    {
      "start": 15.34,
      "end": 16.04,
      "text": "stessa scala."
    },
    {
      "start": 16.8,
      "end": 20.74,
      "text": "Il confronto può rendere evidente\nun'immagine secondaria che prevale sul"
    },
    {
      "start": 20.74,
      "end": 24.22,
      "text": "titolo o un comando che si confonde con il\nfondo."
    },
    {
      "start": 24.22,
      "end": 28.72,
      "text": "Tra varianti diverse dobbiamo mantenere la\nstessa intensità del filtro."
    },
    {
      "start": 28.88,
      "end": 32.28,
      "text": "Altrimenti cambieremmo anche le condizioni\ndel controllo."
    },
    {
      "start": 32.28,
      "end": 36.14,
      "text": "Questa osservazione non misura la\ncomprensione, non registra il percorso"
    },
    {
      "start": 36.14,
      "end": 39.38,
      "text": "degli occhi e non dimostra la possibilità\ndi completare un'azione."
    },
    {
      "start": 40.46,
      "end": 42.04,
      "text": "Quando le parole non sono più leggibili,"
    },
    {
      "start": 42.66,
      "end": 45.98,
      "text": "abbiamo appunto escluso una parte\nimportante del compito."
    },
    {
      "start": 46.04,
      "end": 48.82,
      "text": "Usiamo il risultato per formulare domande\nsui pesi visivi,"
    },
    {
      "start": 49.58,
      "end": 54.52,
      "text": "poi torniamo al contenuto integro. Il\ncontrollo prepara la revisione; la prova"
    },
    {
      "start": 54.52,
      "end": 58.44,
      "text": "con una consegna concreta permette di\nverificare se la gerarchia sostiene"
    },
    {
      "start": 58.44,
      "end": 59.72,
      "text": "davvero il lettore."
    }
  ]
}
