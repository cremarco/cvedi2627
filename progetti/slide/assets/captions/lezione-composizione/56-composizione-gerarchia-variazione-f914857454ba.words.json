  "cues": [
    {
      "start": 0.28,
      "end": 4.5,
      "text": "Qui il confronto è diverso dalle tre\nversioni viste all'inizio."
    },
    {
      "start": 4.5,
      "end": 9.12,
      "text": "Allora cambiavano insieme scala, gruppi e\npresenza del comando."
    },
    {
      "start": 9.12,
      "end": 14.42,
      "text": "In questi due inviti testi, caratteri,\ncolori, comando e dimensioni rimangono"
    },
    {
      "start": 14.42,
      "end": 15.12,
      "text": "identici."
    },
    {
      "start": 15.78,
      "end": 20.04,
      "text": "Si sposta soltanto il gruppo del luogo,\nformato da Spazio Officina e indirizzo."
    },
    {
      "start": 21.16,
      "end": 23.36,
      "text": "Guardate l'intervallo fra l'orario e il\nluogo."
    },
    {
      "start": 24.24,
      "end": 28.72,
      "text": "Nella versione iniziale è simile agli\nintervalli interni dei dati; nella seconda"
    },
    {
      "start": 28.72,
      "end": 33.16,
      "text": "la separazione è più ampia. Possiamo così\nformulare un'ipotesi circoscritta:"
    },
    {
      "start": 34.24,
      "end": 38.58,
      "text": "quella distanza dovrebbe rendere più\ndistinguibili le informazioni su quando e"
    },
    {
      "start": 38.58,
      "end": 39.32,
      "text": "dove partecipare."
    },
    {
      "start": 40.44,
      "end": 43.4,
      "text": "Lo spostamento cambia anche lo spazio\nrimasto prima dell'iscrizione:"
    },
    {
      "start": 44.64,
      "end": 45.6,
      "text": "osserviamolo nel campo completo."
    },
    {
      "start": 46.94,
      "end": 51.26,
      "text": "Conservare entrambe le versioni permette\ndi discutere l'effetto senza attribuirlo a"
    },
    {
      "start": 51.26,
      "end": 53.1,
      "text": "una nuova palette o a testi riscritti."
    },
    {
      "start": 54.4,
      "end": 57.26,
      "text": "Questa è la logica di un confronto\ncontrollato."
    },
    {
      "start": 57.26,
      "end": 61.64,
      "text": "Scegliete una relazione, dichiarate che\ncosa cambia e confrontate il risultato con"
    },
    {
      "start": 61.64,
      "end": 66.06,
      "text": "un compito. Prima della prova possiamo\nancora controllare i pesi complessivi."
    }
  ]
}
