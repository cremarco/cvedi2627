  "cues": [
    {
      "start": 0.26,
      "end": 4.5,
      "text": "Nelle composizioni Diesel provate a\nindividuare prima il testo, poi la"
    },
    {
      "start": 4.5,
      "end": 9.14,
      "text": "situazione rappresentata. Nel primo\nannuncio una persona ha le gambe sollevate"
    },
    {
      "start": 9.14,
      "end": 14.1,
      "text": "sopra una cassetta postale; nel secondo\nuna persona indossa un cono stradale sulla"
    },
    {
      "start": 14.1,
      "end": 18.66,
      "text": "testa. Le parole mettono queste scene\ninsolite in relazione con il messaggio"
    },
    {
      "start": 18.66,
      "end": 19.42,
      "text": "della campagna."
    },
    {
      "start": 20.38,
      "end": 25.0,
      "text": "Possiamo descrivere posizione, scala e\ncontrasto e discutere il legame fra"
    },
    {
      "start": 25.0,
      "end": 25.94,
      "text": "scritta e scena."
    },
    {
      "start": 26.66,
      "end": 30.1,
      "text": "Che cosa servirebbe invece per sapere dove\nha guardato una persona?"
    },
    {
      "start": 31.1,
      "end": 35.16,
      "text": "Una registrazione pertinente del\ncomportamento, insieme al compito e alle"
    },
    {
      "start": 35.16,
      "end": 40.12,
      "text": "condizioni della prova. Le immagini della\ncampagna non sono mappe oculari e non"
    },
    {
      "start": 40.12,
      "end": 44.72,
      "text": "documentano il pattern a effe. Questa\ndistinzione evita di trasformare una"
    },
    {
      "start": 44.72,
      "end": 46.72,
      "text": "lettura compositiva in una misurazione."
    },
    {
      "start": 47.52,
      "end": 51.48,
      "text": "È il passaggio che ci interessa prima\ndelle analisi successive."
    },
    {
      "start": 51.62,
      "end": 56.28,
      "text": "Possiamo motivare una scelta dicendo quale\nrelazione propone; per valutarne l'uso"
    },
    {
      "start": 56.28,
      "end": 59.48,
      "text": "dobbiamo osservare una persona che svolge\nun compito."
    },
    {
      "start": 59.62,
      "end": 61.72,
      "text": "Passiamo ora a una lettura guidata del\nCenacolo,"
    },
    {
      "start": 62.5,
      "end": 64.9,
      "text": "collegando posizione, direzioni e\nracconto."
    }
  ]
}
