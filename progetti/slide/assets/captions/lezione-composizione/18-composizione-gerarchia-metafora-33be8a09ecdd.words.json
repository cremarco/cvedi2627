  "cues": [
    {
      "start": 0.18,
      "end": 2.76,
      "text": "Il messaggio simulato è una pausa caffè\nper ripartire."
    },
    {
      "start": 4.16,
      "end": 7.92,
      "text": "Nella prima variante una batteria\nsostituisce la tazza."
    },
    {
      "start": 7.92,
      "end": 11.28,
      "text": "Nella seconda tazza e batteria vengono\nfuse."
    },
    {
      "start": 11.28,
      "end": 13.82,
      "text": "La relazione condivisa è l'idea del\nricaricarsi,"
    },
    {
      "start": 14.54,
      "end": 19.06,
      "text": "che qui ha un significato figurato. La\nfrase aiuta a delimitare la lettura."
    },
    {
      "start": 20.06,
      "end": 24.36,
      "text": "Senza contesto potremmo riconoscere la\nbatteria e non capire il riferimento alla"
    },
    {
      "start": 24.36,
      "end": 28.9,
      "text": "pausa. Una metafora può sintetizzare un\nmessaggio quando i due ambiti sono"
    },
    {
      "start": 28.9,
      "end": 29.6,
      "text": "familiari,"
    },
    {
      "start": 29.82,
      "end": 32.3,
      "text": "ma può diventare oscura se manca quella\nconoscenza."
    },
    {
      "start": 33.28,
      "end": 37.82,
      "text": "Le interfacce usano a loro volta cartelle,\ncestini e scrivanie per rendere"
    },
    {
      "start": 37.82,
      "end": 40.22,
      "text": "rappresentabili organizzazione e azioni."
    },
    {
      "start": 41.16,
      "end": 45.24,
      "text": "Il richiamo iniziale non spiega però tutto\nil comportamento digitale."
    },
    {
      "start": 45.24,
      "end": 49.84,
      "text": "Un cestino può permettere il ripristino;\nun invio può avere conseguenze specifiche."
    },
    {
      "start": 50.64,
      "end": 52.68,
      "text": "Il testo deve chiarire l'azione effettiva."
    },
    {
      "start": 53.58,
      "end": 57.86,
      "text": "Per il nostro invito sceglieremmo una\nmetafora soltanto se aiuta a comprendere"
    },
    {
      "start": 57.86,
      "end": 60.56,
      "text": "il tema senza sostituire le informazioni\nnecessarie."
    }
  ]
