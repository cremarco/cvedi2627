  "cues": [
    {
      "start": 0.2,
      "end": 4.6,
      "text": "Le fotografie delle pietanze mostrano\nun'offerta e aiutano a distinguere le"
    },
    {
      "start": 4.6,
      "end": 10.48,
      "text": "alternative. Nella funzione descrittiva\nconta ciò che viene reso osservabile:"
    },
    {
      "start": 10.48,
      "end": 14.04,
      "text": "proporzioni, composizione, materiali o\nrisultato di un passaggio."
    },
    {
      "start": 15.1,
      "end": 20.24,
      "text": "La sola qualità tecnica della fotografia\nnon garantisce che risponda alla domanda."
    },
    {
      "start": 20.3,
      "end": 21.02,
      "text": "Pensiamo a un prodotto:"
    },
    {
      "start": 21.7,
      "end": 26.44,
      "text": "una vista generale può mostrare\nl'ingombro, un dettaglio la finitura."
    },
    {
      "start": 26.44,
      "end": 31.12,
      "text": "Aggiungere cinque immagini quasi identiche\npotrebbe fornire meno informazione di una"
    },
    {
      "start": 31.12,
      "end": 32.28,
      "text": "coppia scelta con criterio."
    },
    {
      "start": 33.18,
      "end": 37.52,
      "text": "Prima di aggiungere un'immagine, annotiamo\nquale informazione offre in più rispetto a"
    },
    {
      "start": 37.52,
      "end": 38.26,
      "text": "quelle già presenti."
    },
    {
      "start": 39.22,
      "end": 41.66,
      "text": "Anche il taglio fa parte della scelta."
    },
    {
      "start": 41.66,
      "end": 45.72,
      "text": "Nel laboratorio possiamo, per esempio,\nconfrontare due ritratti della stessa"
    },
    {
      "start": 45.72,
      "end": 49.56,
      "text": "persona: uno con lo sfondo nitido e\nl'altro con lo sfondo sfocato."
    },
    {
      "start": 50.34,
      "end": 54.82,
      "text": "Se mostriamo soltanto un dettaglio del\nvolto, eliminiamo lo sfondo e nascondiamo"
    },
    {
      "start": 54.82,
      "end": 57.62,
      "text": "proprio la differenza che vogliamo\nspiegare."
    },
    {
      "start": 57.62,
      "end": 61.08,
      "text": "Mostriamo quindi i due ritratti alla\nstessa dimensione e con la stessa"
    },
    {
      "start": 61.08,
      "end": 65.56,
      "text": "inquadratura, lasciando visibile lo\nsfondo: il confronto deve far capire"
    },
    {
      "start": 65.56,
      "end": 69.98,
      "text": "l'effetto della sfocatura, senza\nintrodurre differenze dovute a ritagli o"
    },
    {
      "start": 69.98,
      "end": 70.68,
      "text": "ingrandimenti."
    }
  ]
}
