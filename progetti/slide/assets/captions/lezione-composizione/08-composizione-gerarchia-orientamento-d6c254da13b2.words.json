  "cues": [
    {
      "start": 0.2,
      "end": 4.44,
      "text": "Un triangolo appoggiato su un lato e lo\nstesso triangolo appoggiato su un vertice"
    },
    {
      "start": 4.44,
      "end": 8.36,
      "text": "hanno la medesima geometria, ma un\nrapporto differente con lo spazio"
    },
    {
      "start": 8.36,
      "end": 12.96,
      "text": "circostante. Possiamo descrivere\nl'appoggio e la direzione prima di"
    },
    {
      "start": 12.96,
      "end": 16.48,
      "text": "attribuire impressioni di stabilità o\ntensione."
    },
    {
      "start": 16.48,
      "end": 20.8,
      "text": "L'esagono regolare permette invece di\ncostruire ripetizioni senza interstizi."
    },
    {
      "start": 21.8,
      "end": 24.04,
      "text": "L'esagono può essere usato come modulo\nripetuto,"
    },
    {
      "start": 24.74,
      "end": 29.5,
      "text": "ma la sua presenza non basta a spiegare\nche cosa comunicano i marchi mostrati."
    },
    {
      "start": 29.64,
      "end": 33.56,
      "text": "Contano le combinazioni, le distanze e ciò\nche riconosciamo nel segno."
    },
    {
      "start": 34.36,
      "end": 35.8,
      "text": "Il passaggio progettuale è semplice:"
    },
    {
      "start": 36.7,
      "end": 40.38,
      "text": "scegliere una proprietà che serva al\nmessaggio e provarla nella composizione."
    },
    {
      "start": 41.24,
      "end": 45.9,
      "text": "Per un invito possiamo cercare una\ndirezione che colleghi immagine e titolo;"
    },
    {
      "start": 45.9,
      "end": 49.98,
      "text": "per un sistema di categorie possiamo\ncercare una famiglia coerente."
    },
    {
      "start": 50.0,
      "end": 54.28,
      "text": "Il fatto che una forma consenta una certa\norganizzazione non la rende obbligatoria"
    },
    {
      "start": 54.28,
      "end": 55.58,
      "text": "per tutti i progetti."
    }
  ]
}
