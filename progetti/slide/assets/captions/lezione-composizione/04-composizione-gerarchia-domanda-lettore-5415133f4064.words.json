  "cues": [
    {
      "start": 0.34,
      "end": 1.28,
      "text": "Immaginiamo due situazioni."
    },
    {
      "start": 2.76,
      "end": 5.48,
      "text": "Una persona riceve un invito a un\nlaboratorio di fotografia."
    },
    {
      "start": 6.66,
      "end": 10.9,
      "text": "Deve capire l'argomento, verificare se può\npartecipare e trovare il passo successivo."
    },
    {
      "start": 12.02,
      "end": 14.2,
      "text": "Sara, invece, conosce già il servizio:"
    },
    {
      "start": 14.96,
      "end": 16.46,
      "text": "vuole spostare una visita prenotata."
    },
    {
      "start": 17.4,
      "end": 22.12,
      "text": "Una grande immagine atmosferica potrebbe\nessere utile nel primo caso e sottrarre"
    },
    {
      "start": 22.12,
      "end": 24.76,
      "text": "spazio ai dati necessari nel secondo."
    },
    {
      "start": 24.96,
      "end": 28.14,
      "text": "Prima di disporre i blocchi, scriviamo\ndunque la domanda del lettore."
    },
    {
      "start": 28.96,
      "end": 33.42,
      "text": "Non basta dire che vogliamo una pagina\nchiara: dobbiamo precisare che cosa deve"
    },
    {
      "start": 33.42,
      "end": 38.18,
      "text": "diventare riconoscibile e quali\ninformazioni devono restare disponibili."
    },
    {
      "start": 38.18,
      "end": 42.3,
      "text": "Questa formulazione permette anche di\ndiscutere il progetto senza fermarsi al"
    },
    {
      "start": 42.3,
      "end": 43.0,
      "text": "gusto."
    },
    {
      "start": 43.26,
      "end": 47.58,
      "text": "Se il titolo attira l'attenzione ma\nl'orario diventa difficile da trovare,"
    },
    {
      "start": 47.58,
      "end": 49.96,
      "text": "ostacoliamo chi vuole sapere quando\npartecipare."
    },
    {
      "start": 50.42,
      "end": 54.54,
      "text": "Nel nostro caso guida conserveremo gli\nstessi dati proprio per osservare"
    },
    {
      "start": 54.54,
      "end": 55.96,
      "text": "l'effetto dei rapporti visivi."
    }
  ]
}
