{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typst: booklet",
      "type": "process",
      "command": "pnpm",
      "args": ["build:booklet"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Typst: anteprima aperture",
      "type": "process",
      "command": "pnpm",
      "args": ["build:booklet", "--target", "aperture"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Typst: verifica booklet",
      "type": "process",
      "command": "pnpm",
      "args": ["check:booklet"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
