270 0 obj
  << /ActualText (Nel corso della storia\054 le pratiche progettuali hanno assunto forme diverse\054 combinando esigenze d\031uso\054 significati simbolici\054 disponibilit\340 tecniche e criteri estetici\056 Non si tratta di un\031evoluzione lineare dalla funzione all\031estetica\056 Le culture greca e romana elaborarono principi di proporzione\054 equilibrio e simmetria che furono ripresi\054 con interpretazioni differenti\054 nel Rinascimento e nei revival classici\056 Le monete antiche offrono un esempio dell\031intreccio tra funzione pratica\054 riconoscibilit\340 e rappresentazione dell\031autorit\340\054 aspetti ancora rilevanti nella progettazione della moneta\056)
     /K [ 0 ]
     /P 269 0 R
     /Pg 258 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

