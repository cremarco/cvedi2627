      "name": "02 · Titolo editoriale",
      "visible": true
    },
    "content": {
      "id": "3126:846",
      "name": "Contenuto · commenti/mappa-wcag",
      "visible": true,
      "x": 60,
      "y": 135,
      "w": 363,
      "h": 416,
      "texts": [
        {
          "id": "3126:849",
          "text": "Quattro principi organizzano tredici linee guida. I criteri di successo precisano requisiti, livelli ed eccezioni."
        },
        {
          "id": "3126:853",
          "text": "01 · Percepibile"
        },
        {
          "id": "3126:854",
          "text": "Le informazioni possono essere percepite attraverso canali diversi."
        },
        {
          "id": "3126:856",
          "text": "1.1 Alternative testuali"
        },
        {
          "id": "3126:857",
          "text": "1.2 Media temporali"
        },
        {
          "id": "3126:858",
          "text": "1.3 Adattabilità"
        },
        {
          "id": "3126:859",
          "text": "1.4 Distinguibilità"
        },
        {
          "id": "3126:861",
          "text": "02 · Utilizzabile"
        },
        {
          "id": "3126:862",
          "text": "Le azioni e la navigazione sono disponibili con modalità di input diverse."
        },
        {
          "id": "3126:864",
          "text": "2.1 Accessibile da tastiera"
        },
        {
          "id": "3126:865",
          "text": "2.2 Tempo sufficiente"
        },
        {
          "id": "3126:866",
          "text": "2.3 Convulsioni e reazioni fisiche"
        },
        {
          "id": "3126:867",
          "text": "2.4 Navigabile"
        },
        {
          "id": "3126:868",
          "text": "2.5 Modalità di input"
        },
        {
          "id": "3126:871",
          "text": "03 · Comprensibile"
        },
        {
          "id": "3126:872",
          "text": "Testo e comportamento dell’interfaccia sono comprensibili e prevedibili."
        },
        {
          "id": "3126:874",
          "text": "3.1 Leggibile"
        },
        {
          "id": "3126:875",
          "text": "3.2 Prevedibile"
        },
        {
          "id": "3126:876",
          "text": "3.3 Assistenza nell’inserimento"
        },
        {
          "id": "3126:878",
          "text": "04 · Robusto"
        },
        {
          "id": "3126:879",
          "text": "Il contenuto è compatibile con strumenti e tecnologie assistive."
        },
        {
          "id": "3126:881",
          "text": "4.1 Compatibilità"
        },
        {
          "id": "3126:882",
          "text": "Mappa di orientamento: mostra tutte le linee guida, non l’elenco completo dei criteri. Per livelli A, AA e AAA, requisiti ed eccezioni consulta il testo ufficiale WCAG 2.2."
        }
      ]
    },
