{
  "name": "cvedi-2026-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "elevenlabs:voices": "node --env-file=.env.local progetti/slide/scripts/elevenlabs-voices.mjs",
    "build:booklet": "node progetti/booklet/scripts/booklet.mjs build",
    "check:booklet": "node progetti/booklet/scripts/booklet.mjs check",
    "preview:booklet": "node progetti/booklet/scripts/booklet.mjs preview",
    "clean": "node scripts/clean.mjs",
    "css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./progetti/slide/styles/daisy.css -o ./progetti/slide/styles/daisy-built.css",
    "css:caffe-luce": "node progetti/caffe-ttc/scripts/build/caffe-ttc-css.mjs",
    "build:caffe-ttc": "node progetti/caffe-ttc/scripts/build/caffe-ttc-assets.mjs && node progetti/caffe-ttc/scripts/build/caffe-ttc-catalogue.mjs && node progetti/caffe-ttc/scripts/build/caffe-ttc-notes.mjs && node progetti/caffe-ttc/scripts/build/caffe-ttc.mjs && pnpm css:caffe-luce",
    "build:ilmeteo": "node progetti/ilmeteo/scripts/build-redesign.mjs",
    "gallery": "node progetti/slide/scripts/build/project-gallery.mjs",
    "prepare:assets": "node scripts/build/shared-assets.mjs",
    "dev": "pnpm prepare:assets && pnpm build:caffe-ttc && node progetti/slide/scripts/dev.mjs",
    "build": "pnpm prepare:assets && pnpm build:caffe-ttc && pnpm run css && node progetti/slide/scripts/build/lesson-decks.mjs progetti/slide/dist && node progetti/slide/scripts/build/web-design-examples.mjs progetti/slide/dist && node scripts/build/noindex.mjs progetti/slide/dist",
    "build:pages": "pnpm prepare:assets && pnpm build:caffe-ttc && pnpm build:ilmeteo && pnpm build:fisioterapia && pnpm run css && pnpm run css:home && node scripts/build/pages.mjs",
    "export": "pnpm prepare:assets && pnpm run css && node ./node_modules/@slidev/cli/bin/slidev.mjs export progetti/slide/slides.md",
    "check": "node progetti/slide/scripts/check/slides.mjs",
    "check:source": "pnpm prepare:assets && node progetti/slide/scripts/check/slide-source.mjs",
    "check:exercises": "node progetti/slide/scripts/check/exercises.mjs",
    "check:exercise-native": "node progetti/slide/scripts/check/exercise-native.mjs",
    "check:exercise-code": "node progetti/slide/scripts/check/exercise-code.mjs",
    "check:pagination": "node --test progetti/slide/scripts/check/lesson-pagination.test.mjs",
    "check:clean": "node --test scripts/check/clean.test.mjs",
    "check:publication": "node progetti/slide/scripts/check/publication.mjs",
    "check:publication:browser": "node progetti/slide/scripts/check/lesson-decks-browser.mjs",
    "check:progress": "node progetti/slide/scripts/check/progress.mjs",
    "check:motion": "node progetti/slide/scripts/check/motion.mjs",
    "check:color-wheels": "node progetti/slide/scripts/check/color-wheels.mjs",
    "check:frameworks": "node progetti/slide/scripts/check/framework-examples.mjs",
    "check:covers": "node progetti/slide/scripts/check/covers.mjs",
    "check:typography": "node progetti/slide/scripts/check/typography.mjs",
    "check:acronyms": "node progetti/slide/scripts/check/acronyms.mjs",
    "check:font-previews": "node progetti/slide/scripts/check/font-previews.mjs",
    "check:layout": "node progetti/slide/scripts/check/layout.mjs",
    "check:caffe-luce": "node progetti/caffe-ttc/scripts/check/caffe-luce.mjs",
    "check:caffe-motion": "node progetti/caffe-ttc/scripts/check/caffe-ttc-motion.mjs",
    "check:caffe-notes": "node progetti/caffe-ttc/scripts/check/caffe-ttc-notes.mjs",
    "check:web-examples": "node progetti/slide/scripts/check/web-design-examples.mjs",
    "check:indexing": "node --test scripts/check/indexing.test.mjs && node scripts/check/indexing.mjs",
    "check:ux-course": "node progetti/slide/scripts/check/ux-course.mjs",
    "check:gestalt": "node progetti/slide/scripts/check/gestalt.mjs",
    "check:accessibility-demos": "node progetti/slide/scripts/check/accessibility-demos.mjs",
    "check:archive": "node scripts/check/project-archive.mjs",
    "check:ilmeteo:source": "node --test progetti/ilmeteo/scripts/check/ilmeteo-publication.test.mjs && node progetti/ilmeteo/scripts/check-home.mjs",
    "check:ilmeteo": "pnpm build:ilmeteo && pnpm check:ilmeteo:source && node progetti/ilmeteo/scripts/check-navigation.mjs && node progetti/ilmeteo/scripts/check-home-modules.mjs && node progetti/ilmeteo/scripts/check-primary-weather-map.mjs && node progetti/ilmeteo/scripts/check-forecast-interactive.mjs",
    "dev:full": "pnpm prepare:assets && node progetti/slide/scripts/dev.mjs --full",
    "build:full": "pnpm prepare:assets && pnpm css && node ./node_modules/@slidev/cli/bin/slidev.mjs build progetti/slide/slides.md --out dist",
    "check:decks": "node --test progetti/slide/scripts/check/lesson-decks.test.mjs progetti/slide/scripts/check/presenter-navigation.test.mjs",
    "check:presenter": "node progetti/slide/scripts/check/presenter-navigation.mjs",
    "check:decks:browser": "node progetti/slide/scripts/check/lesson-decks-browser.mjs",
    "check:grids": "node progetti/slide/scripts/check/grids.mjs",
    "check:audio": "node progetti/slide/scripts/check/slide-audio.mjs",
    "css:home": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./progetti/home/home.source.css -o ./progetti/home/home.css --minify",
    "check:home": "node progetti/home/scripts/check/course-home.mjs",
    "build:composition": "python3 progetti/slide/scripts/build/composizione-assets.py && node progetti/slide/scripts/build/composizione-slides.mjs",
    "check:composition": "node progetti/slide/scripts/check/composition.mjs",
    "build:ux-process": "python3 progetti/slide/scripts/build/processo-ux-ui-assets.py && node progetti/slide/scripts/build/processo-ux-ui-slides.mjs",
    "check:ux-process": "node progetti/slide/scripts/check/processo-ux-ui.mjs",
    "check:ux-tables": "node progetti/slide/scripts/check/processo-ux-ui-tables.mjs",
    "check:ux-process-map": "node progetti/slide/scripts/check/ux-process-map.mjs",
    "check:ux-service": "node progetti/slide/scripts/check/ux-service.mjs",
    "build:fisioterapia": "node progetti/fisioterapia/scripts/build.mjs",
    "dev:fisioterapia": "pnpm build:fisioterapia && node progetti/fisioterapia/scripts/serve.mjs",
    "check:fisioterapia": "node progetti/fisioterapia/scripts/check.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@fontsource/inter": "^5.2.8",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.46",
    "playwright-chromium": "^1.63.0",
    "shiki": "4.4.3",
    "tailwindcss": "^4.3.3"
  }
}
