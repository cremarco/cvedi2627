{
  "name": "cvedi-2026-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./styles/daisy.css -o ./styles/daisy-built.css",
    "css:projects": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./progetti/gallery.source.css -o ./progetti/gallery.css --minify",
    "css:home": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./home/home.source.css -o ./home/home.css --minify",
    "css:caffe-luce": "node scripts/build/caffe-ttc-css.mjs",
    "build:caffe-ttc": "node scripts/build/caffe-ttc-assets.mjs && node scripts/build/caffe-ttc-catalogue.mjs && node scripts/build/caffe-ttc-notes.mjs && node scripts/build/caffe-ttc.mjs && pnpm css:caffe-luce",
    "gallery": "node scripts/build/project-gallery.mjs",
    "dev": "pnpm build:caffe-ttc && node scripts/dev.mjs",
    "build": "pnpm build:caffe-ttc && pnpm run css && node ./node_modules/@slidev/cli/bin/slidev.mjs build && node scripts/build/web-design-examples.mjs dist",
    "build:pages": "pnpm build:caffe-ttc && pnpm run css && pnpm run css:projects && pnpm run css:home && node scripts/build/pages.mjs",
    "export": "pnpm run css && node ./node_modules/@slidev/cli/bin/slidev.mjs export",
    "check": "node scripts/check/slides.mjs",
    "check:source": "node scripts/check/slide-source.mjs",
    "check:publication": "node scripts/check/publication.mjs",
    "check:publication:browser": "node scripts/check/publication-browser.mjs",
    "check:progress": "node scripts/check/progress.mjs",
    "check:motion": "node scripts/check/motion.mjs",
    "check:covers": "node scripts/check/covers.mjs",
    "check:typography": "node scripts/check/typography.mjs",
    "check:layout": "node scripts/check/layout.mjs",
    "check:projects": "node scripts/check/projects.mjs",
    "check:caffe-luce": "node scripts/check/caffe-luce.mjs",
    "check:caffe-motion": "node scripts/check/caffe-ttc-motion.mjs",
    "check:caffe-notes": "node scripts/check/caffe-ttc-notes.mjs",
    "check:web-examples": "node scripts/check/web-design-examples.mjs",
    "check:home": "node scripts/check/course-home.mjs",
    "check:links": "python3 scripts/check/site-links.py",
    "check:ux-course": "node scripts/check/ux-course.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.46",
    "playwright-chromium": "^1.63.0",
    "tailwindcss": "^4.3.3"
  }
}
