{
  "name": "cvedi-2026-2027",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./styles/daisy.css -o ./styles/daisy-built.css",
    "gallery": "node scripts/build-project-gallery.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run css && node ./node_modules/@slidev/cli/bin/slidev.mjs build",
    "build:pages": "pnpm run css && node scripts/build-pages.mjs",
    "export": "pnpm run css && node ./node_modules/@slidev/cli/bin/slidev.mjs export",
    "check": "node scripts/check-slides.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/merriweather": "^5.2.8",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.46",
    "playwright-chromium": "^1.63.0",
    "tailwindcss": "^4.3.3"
  }
}
